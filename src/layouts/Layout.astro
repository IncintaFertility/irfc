---
import '../styles/global.css';
import FloatingContact from '../components/FloatingContact.astro';
import {
  BRAND_ABBREV,
  LEGAL_ENTITY,
  SITE_URL,
  SITE_PHONE,
  DEFAULT_DESCRIPTION,
  ORG_DESCRIPTION,
} from '../config/brand';
import {
  getLocaleFromPath,
  stripLocale,
  linkLabel,
  localeMeta,
  type Locale,
} from '../i18n/index';
import { isTranslated } from '../i18n/routes';

interface Props {
  title: string;
  description?: string;
  image?: string;
  schema?: object | object[];
  /** 内部 / 未定稿页面（如设计稿 demo）：禁止索引 */
  noindex?: boolean;
  /** 當前語言；不傳則從路徑前綴自動判斷（en 預設、zh-hant 掛前綴） */
  locale?: Locale;
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image = '/images/lobby-wide.webp',
  schema,
  noindex = false,
  locale = getLocaleFromPath(Astro.url.pathname),
} = Astro.props;

const siteBase = SITE_URL;
const ogImage = image.startsWith('http') ? image : `${siteBase}${image}`;

// ── 語言相關 ──
const htmlLang = localeMeta[locale].htmlLang;
const ogLocale = localeMeta[locale].ogLocale;
const ogLocaleAlt = locale === 'zh-hant' ? 'en_US' : 'zh_Hant';

// hreflang 互鏈：以「去 locale 前綴的基準路徑」為準，分別生成 en 與 zh-hant 絕對網址
// 基準路徑統一帶尾端斜線（home 為 /），與 canonicalURL（Astro.url.pathname）保持一致。
const basePathRaw = stripLocale(Astro.url.pathname) || '/';
const basePath = basePathRaw === '/' ? '/' : basePathRaw.replace(/\/+$/, '') + '/';
const hreflangEn = new URL(basePath, SITE_URL).href;
const hreflangZh = new URL('/zh-hant' + (basePath === '/' ? '' : basePath), SITE_URL).href;
// 僅當該基準路徑確實有繁體版本時，才輸出 zh-hant 的 hreflang / og:locale 互鏈，
// 避免英文頁指向尚未建置的 /zh-hant/<page> 造成 404 的錯誤 alternate。
const zhExists = isTranslated(basePath);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalOrganization',
  name: `${BRAND_ABBREV} — ${LEGAL_ENTITY}`,
  alternateName: 'INCINTA',
  url: SITE_URL,
  logo: { '@type': 'ImageObject', url: `${SITE_URL}/favicon.svg` },
  telephone: SITE_PHONE,
  description: ORG_DESCRIPTION,
  medicalSpecialty: 'Reproductive Medicine',
  hasCredential: 'Kaiser Permanente Center of Excellence',
  areaServed: { '@type': 'State', name: 'California' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: '16300 Sand Canyon Avenue, 9th Floor',
    addressLocality: 'Irvine',
    addressRegion: 'CA',
    postalCode: '92618',
    addressCountry: 'US',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: SITE_PHONE,
    contactType: 'customer service',
    availableLanguage: ['English', 'Chinese', 'Japanese', 'Korean', 'Spanish'],
  },
};

const canonicalURL = new URL(Astro.url.pathname, Astro.site || SITE_URL);

// Brand suffix for <title> / social cards uses the full legal entity name
// (Incinta Reproductive Fertility Center) for branded-search consistency with
// Google Business Profile / Yelp. The homepage title already leads with the
// full name, so skip the suffix there to avoid a duplicated brand in the SERP.
const fullTitle = title.includes(LEGAL_ENTITY) ? title : `${title} | ${LEGAL_ENTITY}`;

// BreadcrumbList — 從當前路徑推導，標籤隨語言切換（linkLabel 單一來源）
const segs = Astro.url.pathname.split('/').filter(Boolean);
const crumbItems = [{ '@type': 'ListItem', position: 1, name: linkLabel(locale, '/'), item: SITE_URL }];
if (segs.length) {
  let acc = '';
  segs.forEach((seg, i) => {
    acc += '/' + seg;
    const label = linkLabel(locale, acc);
    crumbItems.push({
      '@type': 'ListItem',
      position: i + 2,
      name: label,
      item: new URL(acc + '/', SITE_URL).href,
    });
  });
}
const breadcrumbSchema = segs.length
  ? { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbItems }
  : null;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- hreflang 互鏈（en ↔ zh-hant），x-default 指向英文基準 -->
    <link rel="alternate" hreflang="en" href={hreflangEn} />
    {zhExists && <link rel="alternate" hreflang="zh-hant" href={hreflangZh} />}
    <link rel="alternate" hreflang="x-default" href={hreflangEn} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    {zhExists && <meta property="og:locale:alternate" content={ogLocaleAlt} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={LEGAL_ENTITY} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)}></script>
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>}

    <!-- Fonts: non-render-blocking so the page paints immediately even when
         Google Fonts is unreachable (e.g. behind the iKuai+daed proxy).
         Falls back to Georgia / system-ui, then swaps in the web fonts onload. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap"
      />
    </noscript>

    {/* 繁體中文頁才載入 Noto TC；Google Fonts 按 unicode-range 子集化，英文頁不會下載 CJK 字體 */}
    {locale === 'zh-hant' && (
      <link
        rel="preload"
        as="style"
        href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@300;400;500;600&family=Noto+Sans+TC:wght@300;400;500;600&display=swap"
        onload="this.onload=null;this.rel='stylesheet'"
      />
    )}
    {locale === 'zh-hant' && (
      <noscript>
        <link
          rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@300;400;500;600&family=Noto+Sans+TC:wght@300;400;500;600&display=swap"
        />
      </noscript>
    )}

  </head>
  <body>
    <slot />
    <FloatingContact />
  </body>
</html>
