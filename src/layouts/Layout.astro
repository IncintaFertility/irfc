---
import '../styles/global.css';
import FloatingContact from '../components/FloatingContact.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  schema?: object | object[];
}

const {
  title,
  description = 'IRFC — Where Science Meets Compassionate Care. World-class fertility treatments across Southern California, bringing together the expertise of Incinta Fertility and Reproductive Fertility Center.',
  image = '/images/lobby-wide.jpg',
  schema,
} = Astro.props;

const siteBase = 'https://irfc.com';
const ogImage = image.startsWith('http') ? image : `${siteBase}${image}`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalOrganization',
  name: 'IRFC — Innovative Reproductive & Fertility Center',
  alternateName: 'IRFC',
  url: 'https://irfc.com',
  logo: { '@type': 'ImageObject', url: 'https://irfc.com/favicon.svg' },
  telephone: '+19494538600',
  description: 'World-class fertility treatments across Southern California — IVF, IUI, egg freezing, PGT, donor egg, and surrogacy. Merger of Incinta Fertility and Reproductive Fertility Center.',
  medicalSpecialty: 'Reproductive Medicine',
  hasCredential: 'Kaiser Permanente Center of Excellence',
  areaServed: { '@type': 'State', name: 'California' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: '16300 Sand Canyon Avenue, 9th Floor',
    addressLocality: 'Irvine',
    addressRegion: 'CA',
    postalCode: '92618',
    addressCountry: 'US',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+19494538600',
    contactType: 'customer service',
    availableLanguage: ['English', 'Chinese', 'Japanese', 'Korean', 'Spanish'],
  },
};

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://irfc.com');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} | IRFC</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | IRFC`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="IRFC" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | IRFC`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)}></script>
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />

  </head>
  <body>
    <slot />
    <FloatingContact />
  </body>
</html>
