---
import '../styles/global.css';
import FloatingContact from '../components/FloatingContact.astro';
import {
  BRAND_ABBREV,
  LEGAL_ENTITY,
  SITE_URL,
  SITE_PHONE,
  DEFAULT_DESCRIPTION,
  ORG_DESCRIPTION,
} from '../config/brand';

interface Props {
  title: string;
  description?: string;
  image?: string;
  schema?: object | object[];
  /** 内部 / 未定稿页面（如设计稿 demo）：禁止索引 */
  noindex?: boolean;
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image = '/images/lobby-wide.webp',
  schema,
  noindex = false,
} = Astro.props;

const siteBase = SITE_URL;
const ogImage = image.startsWith('http') ? image : `${siteBase}${image}`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalOrganization',
  name: `${BRAND_ABBREV} — ${LEGAL_ENTITY}`,
  alternateName: 'INCINTA',
  url: SITE_URL,
  logo: { '@type': 'ImageObject', url: `${SITE_URL}/favicon.svg` },
  telephone: SITE_PHONE,
  description: ORG_DESCRIPTION,
  medicalSpecialty: 'Reproductive Medicine',
  hasCredential: 'Kaiser Permanente Center of Excellence',
  areaServed: { '@type': 'State', name: 'California' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: '16300 Sand Canyon Avenue, 9th Floor',
    addressLocality: 'Irvine',
    addressRegion: 'CA',
    postalCode: '92618',
    addressCountry: 'US',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: SITE_PHONE,
    contactType: 'customer service',
    availableLanguage: ['English', 'Chinese', 'Japanese', 'Korean', 'Spanish'],
  },
};

const canonicalURL = new URL(Astro.url.pathname, Astro.site || SITE_URL);

// Brand suffix for <title> / social cards uses the full legal entity name
// (Incinta Reproductive Fertility Center) for branded-search consistency with
// Google Business Profile / Yelp. The homepage title already leads with the
// full name, so skip the suffix there to avoid a duplicated brand in the SERP.
const fullTitle = title.includes(LEGAL_ENTITY) ? title : `${title} | ${LEGAL_ENTITY}`;

// BreadcrumbList — derived from the current path so every interior page earns
// navigational rich results without hand-maintaining markup per page.
const crumbLabels = {
  services: 'Treatments & Services', ivf: 'In Vitro Fertilization (IVF)', iui: 'Intrauterine Insemination (IUI)',
  'egg-freezing': 'Egg Freezing & Fertility Preservation', pgt: 'Preimplantation Genetic Testing (PGT)',
  icsi: 'Intracytoplasmic Sperm Injection (ICSI)', 'recurrent-pregnancy-loss': 'Recurrent Pregnancy Loss',
  'donors-surrogacy': 'Donors & Surrogacy', lgbtqia: 'LGBTQIA+ Family Building',
  standards: 'The INCINTA Standard', team: 'Our Team', locations: 'Locations',
  financing: 'Financing', insurance: 'Insurance & Coverage', consultation: 'Phone & Online Consultation',
  resources: 'Resources', 'patient-resources': 'Patient Resources', testimonials: 'Patient Reviews',
  about: 'About', contact: 'Contact', appointment: 'Appointment', faq: 'FAQ',
  'patient-journey': 'Patient Journey', conditions: 'Conditions', technology: 'Lab Technology',
  outcomes: 'Outcomes', privacy: 'Privacy Policy', terms: 'Terms of Use', accessibility: 'Accessibility',
  'patient-portal': 'Patient Portal', 'international-patients': 'International Patients', 'why-irfc': 'Why IRFC',
};
const segs = Astro.url.pathname.split('/').filter(Boolean);
const crumbItems = [{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL }];
if (segs.length) {
  let acc = '';
  segs.forEach((seg, i) => {
    acc += '/' + seg;
    const label = crumbLabels[seg] || seg.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
    crumbItems.push({
      '@type': 'ListItem',
      position: i + 2,
      name: label,
      item: new URL(acc + '/', SITE_URL).href,
    });
  });
}
const breadcrumbSchema = segs.length
  ? { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbItems }
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={LEGAL_ENTITY} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)}></script>
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>}

    <!-- Fonts: non-render-blocking so the page paints immediately even when
         Google Fonts is unreachable (e.g. behind the iKuai+daed proxy).
         Falls back to Georgia / system-ui, then swaps in the web fonts onload. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap"
      />
    </noscript>

  </head>
  <body>
    <slot />
    <FloatingContact />
  </body>
</html>
