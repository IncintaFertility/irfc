---
import '../styles/global.css';
import FloatingContact from '../components/FloatingContact.astro';
import {
  BRAND_NAME,
  BRAND_ABBREV,
  LEGAL_ENTITY,
  SITE_URL,
  SITE_PHONE,
  DEFAULT_DESCRIPTION,
  ORG_DESCRIPTION,
} from '../config/brand';

interface Props {
  title: string;
  description?: string;
  image?: string;
  schema?: object | object[];
  /** 内部 / 未定稿页面（如设计稿 demo）：禁止索引 */
  noindex?: boolean;
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image = '/images/lobby-wide.jpg',
  schema,
  noindex = false,
} = Astro.props;

const siteBase = SITE_URL;
const ogImage = image.startsWith('http') ? image : `${siteBase}${image}`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalOrganization',
  name: `${BRAND_ABBREV} — ${LEGAL_ENTITY}`,
  alternateName: BRAND_NAME,
  url: SITE_URL,
  logo: { '@type': 'ImageObject', url: `${SITE_URL}/favicon.svg` },
  telephone: SITE_PHONE,
  description: ORG_DESCRIPTION,
  medicalSpecialty: 'Reproductive Medicine',
  hasCredential: 'Kaiser Permanente Center of Excellence',
  areaServed: { '@type': 'State', name: 'California' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: '16300 Sand Canyon Avenue, 9th Floor',
    addressLocality: 'Irvine',
    addressRegion: 'CA',
    postalCode: '92618',
    addressCountry: 'US',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: SITE_PHONE,
    contactType: 'customer service',
    availableLanguage: ['English', 'Chinese', 'Japanese', 'Korean', 'Spanish'],
  },
};

const canonicalURL = new URL(Astro.url.pathname, Astro.site || SITE_URL);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} | {BRAND_NAME}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | ${BRAND_NAME}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={BRAND_NAME} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${BRAND_NAME}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)}></script>
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />

  </head>
  <body>
    <slot />
    <FloatingContact />
  </body>
</html>
