---
const locations = [
  { city: 'Torrance', address: '21545 Hawthorne Blvd, Pavilion B', state: 'CA 90503', phone: '(424) 212-4087' },
  { city: 'Alhambra', address: '723 S Garfield Ave, Suite 203', state: 'CA 91801', phone: '(626) 588-2885' },
  { city: 'Beverly Hills', address: '8635 W 3rd St, Suite 1170W', state: 'Los Angeles, CA 90048', phone: '(213) 600-8088' },
  { city: 'Corona', address: '400 E Rincon St, Suite 108', state: 'CA 92879', phone: '(951) 272-2221' },
  { city: 'Irvine', address: '16300 Sand Canyon Ave, 9th Floor', state: 'CA 92618', phone: '(949) 453-8600' },
];

const services = [
  { label: 'In Vitro Fertilization (IVF)', href: '/services/ivf' },
  { label: 'Intrauterine Insemination (IUI)', href: '/services/iui' },
  { label: 'Fertility Preservation', href: '/services/preservation' },
  { label: 'Genetic Testing (PGT)', href: '/services/genetic-testing' },
  { label: 'Donors & Surrogacy', href: '/services/donors-surrogacy' },
  { label: 'LGBTQIA+ Family Building', href: '/services/lgbtqia' },
];
---

<footer class="bg-stone-900 text-stone-300">
  <!-- Top border accent -->
  <div class="h-px" style="background: linear-gradient(90deg, transparent, var(--color-gold-500), transparent);"></div>

  <div class="max-w-screen-xl mx-auto px-6 lg:px-10 pt-16 pb-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">

      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href="/" class="block mb-6">
          <img src="/images/irfc-logo-white.svg" alt="IRFC" class="h-10 w-auto" onerror="this.src='/images/irfc-logo.svg'; this.style.filter='brightness(0) invert(1)'" />
        </a>
        <p class="text-sm text-stone-400 leading-relaxed mb-6">
          Where science meets compassionate care. Helping families grow across Southern California.
        </p>
        <div class="flex items-center gap-1 text-xs text-stone-500 mb-1">
          <svg class="w-3.5 h-3.5 text-gold-500" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
          <span style="color: var(--color-gold-400);">(949) 453-8600</span>
        </div>
        <div class="flex items-center gap-1 text-xs text-stone-500 mb-1">
          <svg class="w-3.5 h-3.5 text-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <a href="mailto:contact@irfc.com" class="hover:text-gold-400 transition-colors">contact@irfc.com</a>
        </div>
        <div class="flex items-center gap-1 text-xs text-stone-500">
          <span>Mandarin:</span>
          <a href="tel:+16263886022" style="color: var(--color-gold-400);" class="hover:opacity-80 transition-opacity">(626) 388-6022</a>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h4 class="text-xs tracking-widest uppercase text-stone-400 mb-5" style="font-family: var(--font-sans);">Services</h4>
        <ul class="space-y-3">
          {services.map(s => (
            <li>
              <a href={s.href} class="text-sm text-stone-400 hover:text-stone-200 transition-colors">{s.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="text-xs tracking-widest uppercase text-stone-400 mb-5" style="font-family: var(--font-sans);">Company</h4>
        <ul class="space-y-3">
          {[
            { label: 'About IRFC', href: '/about' },
            { label: 'Our Team', href: '/team' },
            { label: 'Locations', href: '/locations' },
            { label: 'Patient Resources', href: '/patient-resources' },
            { label: 'Contact Us', href: '/contact' },
            { label: 'Book a Consultation', href: '/contact' },
          ].map(link => (
            <li>
              <a href={link.href} class="text-sm text-stone-400 hover:text-stone-200 transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Locations -->
      <div>
        <h4 class="text-xs tracking-widest uppercase text-stone-400 mb-5" style="font-family: var(--font-sans);">Locations</h4>
        <ul class="space-y-4">
          {locations.map(loc => (
            <li>
              <a href="/locations" class="group block">
                <p class="text-sm text-stone-300 group-hover:text-white transition-colors font-medium mb-0.5">{loc.city}</p>
                <p class="text-xs text-stone-500">{loc.address}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom -->
    <div class="border-t border-stone-800 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs text-stone-600">
        © {new Date().getFullYear()} IRFC — Incinta Reproductive Fertility Center. All rights reserved.
      </p>
      <div class="flex items-center gap-6">
        <a href="/privacy" class="text-xs text-stone-600 hover:text-stone-400 transition-colors">Privacy Policy</a>
        <a href="/terms" class="text-xs text-stone-600 hover:text-stone-400 transition-colors">Terms of Use</a>
        <a href="/accessibility" class="text-xs text-stone-600 hover:text-stone-400 transition-colors">Accessibility</a>
      </div>
    </div>

    <!-- Medical Disclaimer -->
    <p class="mt-6 text-xs text-stone-700 leading-relaxed max-w-3xl">
      The information on this website is for general informational purposes only and does not constitute medical advice. Please consult with a qualified healthcare provider regarding your individual circumstances.
    </p>
  </div>
</footer>
