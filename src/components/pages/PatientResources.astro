      class="w-full h-full object-cover object-top"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(20,18,15,0.5) 0%, transparent 55%);"></div>
    <div class="absolute inset-0 flex items-center px-10 lg:px-20">
      <p style="font-family: var(--font-serif);" class="text-2xl font-light text-white max-w-sm leading-relaxed">
        {ZH ? '每個問題都值得誠實的答案。' : 'Every question deserves an honest answer.'}
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-14">
          <div class="h-px w-12 mx-auto mb-6" style="background: var(--color-gold-500);"></div>
          <h2 style="font-family: var(--font-serif);" class="text-4xl font-light text-stone-800">
            {ZH ? '常見問題' : 'Frequently Asked Questions'}
