---
// 預約（英文 / 繁體中文共用元件）— 純預約頁（方案 C 簡化）
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ZohoForm from '../../components/ZohoForm.astro';
import { getLocaleFromPath, t, type Locale } from '../../i18n';
import MainPhone from '../MainPhone.astro';

const locale = getLocaleFromPath(Astro.url.pathname);
const ZH = locale === 'zh-hant';

const locations = [
  { city: 'Torrance', address: '21545 Hawthorne Blvd, Pavilion B, CA 90503', phone: '(424) 212-4087' },
  { city: 'Beverly Hills', address: '8635 W 3rd St, Suite 1170W, Los Angeles, CA 90048', phone: '(213) 600-8088' },
  { city: 'Corona', address: '400 E Rincon St, Suite 108, CA 92879', phone: '(951) 272-2221' },
  { city: 'Irvine', address: '16300 Sand Canyon Ave, 9th Fl, CA 92618', phone: '(949) 453-8600' },
];

const title = ZH ? '預約諮詢' : 'Schedule a Consultation';
const description = ZH
  ? '在 IRFC 預約您的生育諮詢。從我們南加州的診所中選擇，並認識為您的目標而組建的照護團隊。'
  : 'Book your fertility consultation at IRFC. Choose from our Southern California clinics and meet a care team built around your goals.';
---

<Layout title={title} description={description}>
  <Nav />

  <!-- Hero -->
  <section class="pt-40 pb-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-6">
          <div class="h-px w-12" style="background: var(--color-gold-500);"></div>
          <span class="text-xs tracking-widest uppercase" style="color: var(--color-gold-600); font-family: var(--font-sans);">{title}</span>
        </div>
        <h1 style="font-family: var(--font-serif);" class="text-5xl md:text-6xl font-light text-stone-800 mb-6 leading-none">
          {ZH ? <>從一場<br/><em class="not-italic" style="color: var(--color-gold-500);">對話開始。</em></> : <>Begin with<br/><em class="not-italic" style="color: var(--color-gold-500);">a Conversation.</em></>}
        </h1>
        <p class="text-lg text-stone-500 font-light leading-relaxed max-w-2xl mb-10">
          {ZH ? '每段生育旅程都始於一場對話。告訴我們您的故事，我們的協調員將協助您自信地邁出下一步。' : 'Every fertility journey starts with a conversation. Tell us your story, and our coordinators will help you take the next step with confidence.'}
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="#request" class="btn-primary inline-flex items-center gap-2">
            {ZH ? '提出預約' : 'Request an Appointment'}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <MainPhone class="btn-outline inline-flex items-center gap-2" />
        </div>
      </div>
    </div>
  </section>

  <!-- Request form (minimal fields — clinical history is collected in the patient portal) -->
  <section id="request" class="py-20 lg:py-28 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-5 gap-14 items-start">
        <div class="lg:col-span-2">
          <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-stone-400); font-family: var(--font-sans);">{ZH ? '線上開始' : 'Start Online'}</p>
          <h2 style="font-family: var(--font-serif);" class="text-3xl lg:text-4xl font-light text-stone-800 mb-6">{ZH ? '提出預約' : 'Request an appointment'}</h2>
          <p class="text-sm leading-relaxed mb-8" style="color: var(--color-stone-500);">
            {ZH ? '告訴我們如何與您聯繫，以及哪間診所最方便。我們的協調員通常會在一個工作日內，與您確認合適的醫師與時間。' : 'Tell us how to reach you and which clinic works best. Our coordinators will confirm a time with the right physician — usually within one business day.'}
          </p>
          <!-- Compact contact directory + Zoom + portal, folded in from the old standalone blocks -->
          <div class="border-t border-stone-200 pt-6 space-y-4">
            <div class="flex items-baseline justify-between gap-4">
              <p class="text-xs tracking-widest uppercase" style="color: var(--color-stone-400); font-family: var(--font-sans);">{ZH ? '總機' : 'Main line'}</p>
              <MainPhone withLabel={false} class="text-lg font-light" style="font-family: var(--font-serif); color: var(--color-gold-600);" />
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <p class="text-xs tracking-widest uppercase" style="color: var(--color-stone-400); font-family: var(--font-sans);">{ZH ? '國語（普通話）' : 'Mandarin Chinese'}</p>
              <a href="tel:+16263886022" class="text-lg font-light" style="font-family: var(--font-serif); color: var(--color-gold-600);">(626) 388-6022</a>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <p class="text-xs tracking-widest uppercase" style="color: var(--color-stone-400); font-family: var(--font-sans);">{ZH ? '電子郵件' : 'Email'}</p>
              <a href="mailto:info@irfc.com" class="text-lg font-light" style="font-family: var(--font-serif); color: var(--color-gold-600);">info@irfc.com</a>
            </div>
            <p class="text-sm leading-relaxed pt-2" style="color: var(--color-stone-500);">
              <span class="font-medium" style="color: var(--color-stone-800);">{ZH ? '到院或 Zoom。' : 'In person or by Zoom.'}</span>
              {ZH ? '首診建議親自到院——檢查、超音波與實驗室檢驗皆在同一處完成；若行程不便，也可透過安全的 Zoom 視訊諮詢（費用與到院相同）。' : 'We recommend an in-person first visit — exams, ultrasound, and lab work are all on site. If travel is hard, a secure Zoom visit is available at the same consultation fee.'}
            </p>
            <p class="text-sm leading-relaxed" style="color: var(--color-stone-500);">
              <span class="font-medium" style="color: var(--color-stone-800);">{ZH ? '以隱私為本。' : 'Private by design.'}</span>
              {ZH ? '此表單僅收集您的聯絡資料。病史與同意書將於病人專區中安全地完成。' : 'This form collects contact details only. Your medical history and consents are completed securely in the patient portal.'}
            </p>
            <p class="text-sm leading-relaxed" style="color: var(--color-stone-500);">
              {ZH ? '已是病人？' : 'Already a patient?'}<a href="/patient-portal" class="font-medium ml-1" style="color: var(--color-gold-600);">{ZH ? '開啟病人專區' : 'Open the patient portal'}</a>
            </p>
          </div>
        </div>
        <div class="lg:col-span-3 p-8 lg:p-10 border border-stone-200">
          <ZohoForm />
        </div>
      </div>
    </div>
  </section>

  <!-- Choose your clinic -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="mb-12">
        <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-stone-400); font-family: var(--font-sans);">{ZH ? '我們的診所' : 'Our Clinics'}</p>
        <h2 style="font-family: var(--font-serif);" class="text-3xl font-light text-stone-800">{ZH ? '選擇您的地點' : 'Choose your location'}</h2>
        <p class="mt-3 text-sm max-w-xl" style="color: var(--color-stone-500);">
          {ZH ? '南加州的診所，同一套照護標準。請致電任一據點預約，或選擇下方路線。' : 'Southern California clinics, one standard of care. Call any location to schedule, or select directions below.'}
        </p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {locations.map(loc => (
          <div class="p-8 border border-stone-200 card-hover">
            <div class="flex items-start justify-between gap-4 mb-4">
              <div>
                <h3 style="font-family: var(--font-serif);" class="text-2xl font-light text-stone-800 mb-1">{loc.city}</h3>
                <p class="text-sm text-stone-500 leading-relaxed">{loc.address}</p>
              </div>
              <a
                href={`https://maps.google.com/?q=${encodeURIComponent(loc.address + ', ' + loc.city)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs tracking-widest uppercase flex-shrink-0 mt-1" style="color: var(--color-gold-600);"
              >
                {ZH ? '路線' : 'Directions'}
              </a>
            </div>
            <a href={`tel:${loc.phone.replace(/\D/g,'')}`} class="inline-flex items-center gap-2 text-sm font-medium" style="color: var(--color-gold-600);">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              {loc.city} · {loc.phone}
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
