---
import Layout from '../../layouts/Layout.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import { blogPosts } from '../../data/blog';
import { getLocaleFromPath, type Locale } from '../../i18n/index';
import { localeHref } from '../../i18n/routes';

const locale = getLocaleFromPath(Astro.url.pathname);
const ZH = locale === 'zh-hant';

const posts = [...blogPosts].sort((a, b) => (a.date < b.date ? 1 : -1));

const fmtDate = (iso: string) =>
  new Date(iso + 'T00:00:00').toLocaleDateString(ZH ? 'zh-Hant' : 'en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

const catMap: Record<string, string> = {
  'IVF & Treatment': 'IVF 與療程',
  'IVF & Genetics': 'IVF 與基因',
  Preservation: '生育保存',
};
const cat = (c: string) => (ZH ? catMap[c] ?? c : c);
const reading = (r: string) => (ZH ? r.replace(/(\d+)\s*min read/i, '約 $1 分鐘') : r);
---

<Layout
  title={ZH ? '生育洞察與病人指南' : 'Fertility Insights & Patient Guides'}
  description={ZH
    ? '由 Incinta Reproductive Fertility Center (IRFC) 醫師撰寫、以實證為基礎的 IVF、基因檢測與生育保存指南——協助你做出明智的決定。'
    : 'Evidence-based guides on IVF, genetic testing, and fertility preservation from the physicians at Incinta Reproductive Fertility Center (IRFC) — written to help you make informed decisions.'}
>
  <Nav />

  <!-- Hero -->
  <section class="pt-40 pb-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-6">
          <div class="h-px w-12" style="background: var(--color-gold-500);"></div>
          <span class="text-xs tracking-widest uppercase" style="color: var(--color-gold-600); font-family: var(--font-sans);">{ZH ? '生育洞察' : 'Fertility Insights'}</span>
        </div>
        <h1 style="font-family: var(--font-serif);" class="text-5xl md:text-6xl font-light text-stone-800 mb-6 leading-none">
          {ZH ? <>為你的生育旅程<br/><em class="not-italic" style="color: var(--color-gold-500);">而寫的指南與解答。</em></> : <>Guides &amp; answers<br/><em class="not-italic" style="color: var(--color-gold-500);">for your fertility journey.</em></>}
        </h1>
        <p class="text-lg text-stone-500 font-light leading-relaxed">
          {ZH
            ? '由醫師審閱、清晰易懂的 IVF、基因檢測與生育保存說明——讓你面前的決定更容易做。我們會定期新增指南。'
            : 'Clear, physician-reviewed explainers on IVF, genetic testing, and preservation — so the decisions ahead of you are easier to make. New guides are added regularly.'}
        </p>
      </div>
    </div>
  </section>

  <!-- Articles grid -->
  <section class="pb-20" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => (
          <a class="group block bg-white border border-stone-200 card-hover overflow-hidden" href={localeHref(`/blog/${post.slug}`, locale)}>
            <div class="aspect-[3/2] overflow-hidden bg-stone-100">
              <img
                src={post.cover}
                alt={ZH ? post.coverAltZh ?? post.coverAlt : post.coverAlt}
                loading="lazy"
                decoding="async"
                width="600"
                height="400"
                class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
              />
            </div>
            <div class="p-7">
              <span class="text-xs tracking-widest uppercase mb-3 block" style="color: var(--color-gold-600); font-family: var(--font-sans);">{cat(post.category)}</span>
              <h2 style="font-family: var(--font-serif);" class="text-2xl font-light text-stone-800 mb-3 leading-snug">{ZH ? post.titleZh ?? post.title : post.title}</h2>
              <p class="text-sm text-stone-500 leading-relaxed mb-5">{ZH ? post.excerptZh ?? post.excerpt : post.excerpt}</p>
              <p class="text-xs tracking-wide" style="color: var(--color-stone-400); font-family: var(--font-sans);">{fmtDate(post.date)} · {reading(post.readingTime)}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Full-bleed image band (rhythm, echoes the rest of the site) -->
  <section class="relative overflow-hidden" style="height: 360px;">
    <img
      src="/images/lobby-wide.webp"
      srcset="/images/lobby-wide-800.webp 800w, /images/lobby-wide-1280.webp 1280w, /images/lobby-wide.webp 2400w"
      sizes="(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 1200px"
      alt={ZH ? 'IRFC 診所' : 'IRFC clinic'}
      class="w-full h-full object-cover object-center"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(20,18,15,0.55) 0%, transparent 60%);"></div>
    <div class="absolute inset-0 flex items-center px-10 lg:px-20">
      <p style="font-family: var(--font-serif);" class="text-3xl font-light text-white max-w-md leading-relaxed">
        {ZH ? '知識，是安心做出決定的第一步。' : 'Knowledge is the first step toward a confident decision.'}
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10 text-center">
      <h2 style="font-family: var(--font-serif);" class="text-4xl font-light text-stone-800 mb-4">
        {ZH ? '對你自己的路有疑問？' : 'Have a question about your own path?'}
      </h2>
      <p class="text-sm leading-relaxed mb-8 max-w-lg mx-auto" style="color: var(--color-stone-500);">
        {ZH
          ? '這些指南是一般衛教，並非醫療建議。下一步是與醫師對談——親自前往我們南加州四間診所任一處，或透過安全視訊。'
          : 'These guides are general education, not medical advice. The next step is a conversation with a physician — in person at one of our four Southern California clinics, or by secure video visit.'}
      </p>
      <a href={localeHref('/appointment', locale)} class="btn-primary">{ZH ? '與醫師交談' : 'Talk with a Physician'}</a>
    </div>
  </section>

  <Footer />
</Layout>
