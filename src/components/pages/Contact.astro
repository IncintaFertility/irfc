---
// 聯絡我們（英文 / 繁體中文共用元件）
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import RequestForm from '../../components/RequestForm.astro';
import { getLocaleFromPath, t, type Locale } from '../../i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const ZH = locale === 'zh-hant';

const title = ZH ? '聯絡我們' : 'Contact';
const description = ZH
  ? '與 IRFC 預約諮詢。請以電話、電子郵件或線上表單與我們聯繫。提供遠距醫療選項。'
  : 'Schedule a consultation with IRFC. Reach our team by phone, email, or online form. Telehealth options available.';
---

<Layout title={title} description={description}>
  <Nav />

  <!-- Hero -->
  <section class="pt-40 pb-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="max-w-2xl">
        <div class="flex items-center gap-3 mb-6">
          <div class="h-px w-12" style="background: var(--color-gold-500);"></div>
          <span class="text-xs tracking-widest uppercase" style="color: var(--color-gold-600); font-family: var(--font-sans);">{ZH ? '聯絡與諮詢' : 'Contact &amp; Consultations'}</span>
        </div>
        <h1 style="font-family: var(--font-serif);" class="text-5xl md:text-6xl font-light text-stone-800 mb-6 leading-none">
          {ZH ? <>讓我們<br/><em class="not-italic" style="color: var(--color-gold-500);">一起開始。</em></> : <>Let's Begin<br/><em class="not-italic" style="color: var(--color-gold-500);">Together.</em></>}
        </h1>
        <p class="text-lg text-stone-500 font-light leading-relaxed">
          {ZH ? '請以電話、電子郵件或下方表單與我們聯繫——我們會儘快與您聯繫，安排適合您的時間。' : 'Reach out by phone, email, or the form below — we\'ll be in touch promptly to schedule a time that works for you.'}
        </p>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden" style="height: 340px;">
    <img src="/images/surgery-center.webp" srcset="/images/surgery-center-800.webp 800w, /images/surgery-center-1280.webp 1280w, /images/surgery-center.webp 2560w" sizes="(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 1200px" alt={ZH ? 'IRFC 診所內部' : 'IRFC clinic interior'} class="w-full h-full object-cover object-center" />
    <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(20,18,15,0.5) 0%, transparent 60%);"></div>
    <div class="absolute inset-0 flex items-center px-10 lg:px-20">
      <p style="font-family: var(--font-serif);" class="text-2xl font-light text-white max-w-sm leading-relaxed">
        {ZH ? '提供遠距醫療諮詢。' : 'Telehealth consultations available.'}
      </p>
    </div>
  </section>

  <!-- Contact Grid -->
  <section class="py-20" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-2 gap-16">

        <!-- Contact Form -->
        <div id="consultation">
          <h2 style="font-family: var(--font-serif);" class="text-3xl font-light text-stone-800 mb-8">{ZH ? '提出諮詢' : 'Request a Consultation'}</h2>
          <RequestForm />
        </div>

        <!-- Contact Info -->
        <div>
          <div class="mb-8 overflow-hidden rounded-sm">
            <img
              src="/images/care-team-followup.webp" srcset="/images/care-team-followup-800.webp 800w, /images/care-team-followup-1280.webp 1280w, /images/care-team-followup.webp 1498w" sizes="(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 1200px"
              alt={ZH ? 'IRFC 醫師在追蹤看診時關心病人' : 'IRFC physician checking in with a patient during a follow-up visit'}
              width="1498" height="1000"
              class="w-full h-auto object-cover"
            />
          </div>
          <h2 style="font-family: var(--font-serif);" class="text-3xl font-light text-stone-800 mb-8">{ZH ? '與我們聯繫' : 'Get in Touch'}</h2>

          <div class="space-y-8 mb-12">
            <div>
              <p class="text-xs tracking-widest uppercase mb-3" style="color: var(--color-stone-400); font-family: var(--font-sans);">{ZH ? '爾灣診所' : 'Irvine Clinic'}</p>
              <a href="tel:+14244324732" class="text-2xl font-light" style="font-family: var(--font-serif); color: var(--color-gold-600);">(424) 432-4732</a>
            </div>
            <div>
              <p class="text-xs tracking-widest uppercase mb-3" style="color: var(--color-stone-400); font-family: var(--font-sans);">{ZH ? '國語（普通話）' : 'Mandarin Chinese'}</p>
              <a href="tel:+16263886022" class="text-2xl font-light" style="font-family: var(--font-serif); color: var(--color-gold-600);">(626) 388-6022</a>
            </div>
            <div>
              <p class="text-xs tracking-widest uppercase mb-3" style="color: var(--color-stone-400); font-family: var(--font-sans);">WhatsApp</p>
              <a href="https://wa.me/14244324732" class="text-2xl font-light" style="font-family: var(--font-serif); color: var(--color-gold-600);">+1 (424) 432-4732</a>
            </div>
            <div>
              <p class="text-xs tracking-widest uppercase mb-3" style="color: var(--color-stone-400); font-family: var(--font-sans);">{ZH ? '電子郵件' : 'Email'}</p>
              <a href="mailto:info@irfc.com" class="text-2xl font-light" style="font-family: var(--font-serif); color: var(--color-gold-600);">info@irfc.com</a>
            </div>
          </div>

          <div class="border-t border-stone-200 pt-8">
            <h3 style="font-family: var(--font-serif);" class="text-xl font-light text-stone-800 mb-5">{ZH ? '我們的診所地點' : 'Our Locations'}</h3>
            <div class="space-y-5">
              {[
                { city: 'Torrance', address: '21545 Hawthorne Blvd, Pavilion B, CA 90503', phone: '(424) 212-4087' },
                { city: 'Beverly Hills', address: '8635 W 3rd St, Suite 1170W, Los Angeles, CA 90048', phone: '(213) 600-8088' },
                { city: 'Corona', address: '400 E Rincon St, Suite 108, CA 92879', phone: '(951) 272-2221' },
                { city: 'Irvine', address: '16300 Sand Canyon Ave, 9th Fl, CA 92618', phone: '(949) 453-8600' },
              ].map(loc => (
                <div class="flex items-start gap-4">
                  <svg class="w-4 h-4 mt-0.5 flex-shrink-0" style="color: var(--color-gold-500);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  <div>
                    <p class="text-sm font-medium text-stone-800">{loc.city}</p>
                    <p class="text-xs text-stone-500 leading-relaxed">{loc.address}</p>
                    <a href={`tel:${loc.phone.replace(/\D/g,'')}`} class="text-xs" style="color: var(--color-gold-600);">{loc.phone}</a>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="mt-8 p-6 bg-stone-50 border border-stone-200">
            <p class="text-xs tracking-widest uppercase mb-3" style="color: var(--color-stone-400); font-family: var(--font-sans);">{ZH ? '我們說您的語言' : 'We Speak Your Language'}</p>
            <div class="flex flex-wrap gap-2">
              {['English', 'Chinese', 'Japanese', 'Korean', 'Spanish'].map(lang => (
                <span class="text-xs px-3 py-1.5 border" style="color: var(--color-stone-600); border-color: var(--color-stone-300);">{lang}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
