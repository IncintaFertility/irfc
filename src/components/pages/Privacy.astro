---
// 隱私權告知（英文 / 繁體中文共用元件）
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getLocaleFromPath, type Locale } from '../../i18n';
import { LEGAL_ENTITY, BRAND_ABBREV, PRIVACY_RETENTION_MONTHS } from '../../config/brand';
import MainPhone from '../MainPhone.astro';

const locale = getLocaleFromPath(Astro.url.pathname);
const ZH = locale === 'zh-hant';

const sections = [
  {
    id: 'collect',
    title: 'Information We Collect',
    titleZh: '我們蒐集的資訊',
    body: [
      'When you submit an appointment request through this website, we collect the contact details you provide: your name, email address, phone number, preferred location, visit type, and preferred language. We do not ask for medical history or clinical information on this website — your medical history, consents, and health records are collected and stored only in our HIPAA-compliant patient portal (eIVF), which is accessed over an encrypted connection.',
      'Like most websites, we may also collect technical information such as browser type, device type, and pages visited. This information is used only to understand how the site is used and to improve it.',
    ],
    bodyZh: [
      '當您透過本網站提交預約請求時，我們會蒐集您提供的聯絡資料：姓名、電子郵件、電話號碼、偏好診所、看診類型與偏好語言。我們不會在本網站索取病史或臨床資訊——您的病史、同意書與健康紀錄，僅在符合 HIPAA 規範的線上病人入口（eIVF）中蒐集與儲存，並經加密連線存取。',
      '與大多數網站相同，我們也可能蒐集技術性資訊，例如瀏覽器類型、裝置類型與瀏覽頁面。這些資訊僅用於了解網站使用方式並加以改善。',
    ],
  },
  {
    id: 'use',
    title: 'How We Use Your Information',
    titleZh: '我們如何使用您的資訊',
    body: [
      'Information you submit is used to respond to your consultation request, schedule appointments, and provide the clinical care and communication you have asked for.',
      'We do not sell your personal information. We do not share it with third parties for their own marketing purposes.',
    ],
    bodyZh: [
      '您提交的資訊，用於回應您的諮詢請求、安排預約，以及提供您所要求的臨床照護與溝通。',
      '我們不會出售您的個人資訊，也不會為第三方的行銷目的而與其分享。',
    ],
  },
  {
    id: 'hipaa',
    title: 'Your Rights Under HIPAA',
    titleZh: '您在 HIPAA 下的權利',
    body: [
      'Once you become a patient, the health information we create and maintain about you is protected health information under the Health Insurance Portability and Accountability Act (HIPAA). You have the right to:',
    ],
    bodyZh: [
      '一旦成為我們的病人，我們為您建立與保存的健康資訊，即受《健康保險流通與責任法案》（HIPAA）保護，屬受保護健康資訊。您享有以下權利：',
    ],
    list: [
      'Receive a copy of this Notice of Privacy Practices',
      'Inspect and obtain a copy of your medical record',
      'Request corrections to your health information',
      'Request restrictions on certain uses and disclosures',
      'Receive an accounting of disclosures we have made',
      'Request confidential communications by alternative means or locations',
      'File a complaint if you believe your privacy rights have been violated',
    ],
    listZh: [
      '取得本隱私權告知的副本',
      '檢視並取得您的病歷副本',
      '要求更正您的健康資訊',
      '要求限制某些使用與揭露',
      '取得我們已進行揭露的帳目清單',
      '要求以替代方式或地點進行保密通訊',
      '若您認為隱私權受侵害，提出申訴',
    ],
  },
  {
    id: 'security',
    title: 'How We Protect Your Information',
    titleZh: '我們如何保護您的資訊',
    body: [
      'We maintain administrative, physical, and technical safeguards designed to protect the confidentiality, integrity, and availability of your information, including access controls, encrypted transmission, and workforce training on privacy obligations.',
      'Please note that no method of transmission over the internet is entirely secure. For this reason, we ask that you do not send sensitive medical details through the general contact form on this site — those are best discussed directly with your care team.',
    ],
    bodyZh: [
      '我們維持行政、實體與技術層面的防護措施，以保護您資訊的機密性、完整性與可用性，包括存取控制、加密傳輸，以及針對隱私義務的員工訓練。',
      '請注意，網際網路上的任何傳輸方式都無法完全確保安全。因此，我們請您勿透過本網站的一般聯絡表單傳送敏感醫療細節——這類內容最適合直接與您的照護團隊討論。',
    ],
  },
  {
    id: 'retention',
    title: 'How Long We Keep Your Information',
    titleZh: '我們保留資訊的期間',
    body: [
      `Appointment-request contact details submitted through this website are sent to and stored in our CRM platform (Zoho), where they are used only to respond to your inquiry and schedule your care. We review and purge these records on a routine basis, and no later than ${PRIVACY_RETENTION_MONTHS} months after the matter is resolved, unless a longer period is required by law or to defend a legal claim.`,
      'No medical records or protected health information are created or stored on this public website. All clinical records are maintained in our HIPAA-compliant patient portal (eIVF) and follow its own retention schedule.',
    ],
    bodyZh: [
      `透過本網站提交的預約請求聯絡資料，會送交並儲存於我們的 CRM 平台（Zoho），僅用於回應您的諮詢與安排照護。我們會定期檢視並刪除這些紀錄，最遲於案件結案後 ${PRIVACY_RETENTION_MONTHS} 個月內清除，法律要求或為防衛法律主張而須較長保留者除外。`,
      '本公開網站不建立或儲存任何病歷或受保護健康資訊。所有臨床紀錄均保存於我們符合 HIPAA 規範的病人專區（eIVF），並依其保留時程處理。',
    ],
  },

  {
    id: 'disclosure',
    title: 'How We Use and Disclose Health Information',
    titleZh: '我們如何使用與揭露健康資訊',
    body: [
      'Once you become a patient, your protected health information (PHI) may be used and disclosed for treatment, payment, and health care operations (TPO) — for example, coordinating care among our physicians, laboratories, and clinics; obtaining payment from your insurer; and conducting quality and safety activities.',
      'For uses and disclosures of PHI that are not for TPO, we will obtain your written authorization, except where HIPAA permits or requires disclosure without authorization (such as to public health authorities, as required by law, or in response to a lawful subpoena). You may revoke an authorization in writing at any time, subject to limited exceptions.',
    ],
    bodyZh: [
      '一旦成為我們的病人，您的受保護健康資訊（PHI）可能為了治療、付款與醫療營運（TPO）而被使用與揭露——例如在我們的醫師、實驗室與診所之間協調照護、向您的保險公司請款，以及執行品質與安全活動。',
      '對於非屬 TPO 的 PHI 使用與揭露，我們會取得您的書面授權，但 HIPAA 允許或要求無須授權之揭露（例如向公共衛生主管機關、依法要求，或回應合法傳票）者除外。您得隨時以書面撤銷授權，受限於少數例外情形。',
    ],
  },

  {
    id: 'breach',
    title: 'Breach Notification',
    titleZh: '資訊外洩通知',
    body: [
      'If a breach of unsecured protected health information affecting you occurs, we will notify you without unreasonable delay and no later than 60 calendar days after we discover the breach, as required by the HIPAA Breach Notification Rule. Notification will be delivered by mail or email, as appropriate.',
    ],
    bodyZh: [
      '若發生影響您的未加密受保護健康資訊外洩事件，我們將依 HIPAA 資訊外洩通知規則，在不合理延遲的情況下、且最遲於發現外洩後 60 個日曆日內通知您。通知將視情況以郵寄或電子郵件方式送達。',
    ],
  },

  {
    id: 'associates',
    title: 'Our Business Associates',
    titleZh: '我們的業務夥伴',
    body: [
      'We engage service providers who perform functions on our behalf involving the use or disclosure of PHI. These business associates are bound by written Business Associate Agreements (BAAs) requiring them to safeguard your information. They include our patient-portal and electronic health-record platform (eIVF), our secure email and productivity provider, and our cloud hosting and content-delivery provider (Cloudflare).',
    ],
    bodyZh: [
      '我們委託的服務提供者，會代表我們執行涉及 PHI 使用或揭露的功能。這些業務夥伴均受書面《業務夥伴協議》（BAA）約束，須對您的資訊採取保護措施。包含我們的病人專區與電子病歷平台（eIVF）、安全的電子郵件與生產力工具提供商，以及雲端託管與內容傳遞提供商（Cloudflare）。',
    ],
  },

  {
    id: 'analytics',
    title: 'Third-Party Analytics',
    titleZh: '第三方分析工具',
    body: [
      'This website uses Google Tag Manager (container GTM-TLN399PK) to measure site traffic and improve content on our general marketing pages. Google is not a HIPAA business associate, so we do not transmit, and will never instruct you to enter, any protected health information (PHI) through this site to Google.',
      'To protect your information, analytics are switched off on the pages where you may submit personal or health-related details — specifically our contact and appointment-request forms. On those pages the Google tags do not load at all, so no form data or page activity from them is sent to Google. The contact details you submit through the form are sent to our customer-relationship-management (CRM) platform (Zoho) so our care team can respond and schedule your visit — they are not routed through Google.',
      'On other pages, analytics may record technical information such as pages visited, device and browser type, and approximate location derived from your IP address. You can limit tracking by enabling "Do Not Track" in your browser or using a content blocker. For Google\'s own data practices, see Google\'s Privacy & Terms.',
    ],
    bodyZh: [
      '本網站在一般行銷頁面使用 Google Tag Manager（容器 GTM-TLN399PK）來衡量流量並改善內容。Google 並非 HIPAA 商務夥伴，因此我們不會傳送、也不會引導您經由本網站向 Google 提供任何受保護健康資訊（PHI）。',
      '為保護您的資料，在您可能提交個人或健康相關資訊的頁面——亦即我們的聯絡表單與預約表單頁——分析功能會完全關閉。這些頁面根本不會載入 Google 標籤，因此不會有任何表單資料或頁面活動被送往 Google。您透過表單提供的聯絡資料，會送交我們的客戶關係管理（CRM）平台（Zoho），以便照護團隊回應並安排您的看診——這些資料不經由 Google 傳輸。',
      '在其餘頁面，分析工具可能記錄技術性資訊，例如瀏覽頁面、裝置與瀏覽器類型，以及由 IP 位址推得的概略位置。您可在瀏覽器中啟用「勿追蹤」（Do Not Track）或使用內容封鎖工具來限制追蹤。有關 Google 自身的資料處理方式，請參閱 Google 隱私與條款。',
    ],
  },

  {
    id: 'ccpa',
    title: 'California Privacy Rights',
    titleZh: '加州隱私權',
    body: [
      'If you are a California resident, you have the right to know what personal information we collect, to request deletion of that information, to opt out of any sale or sharing, and to receive equal service regardless of whether you exercise these rights. To make a request, contact us using the information below.',
    ],
    bodyZh: [
      '若您是加州居民，您有權知悉我們蒐集哪些個人資訊、要求刪除該資訊、選擇退出任何出售或分享，並在行使這些權利時仍獲得同等服務。如提出請求，請以下方資訊與我們聯絡。',
    ],
  },
  {
    id: 'contact',
    title: 'Questions or Requests',
    titleZh: '問題或請求',
    body: [
      `If you have questions about this notice, or wish to exercise any of the rights described above, please contact our Privacy Officer at ${LEGAL_ENTITY} using the phone number or address listed below, or by email at privacy@irfc.com.`,
    ],
    bodyZh: [
      `若您對本告知有疑問，或希望行使上述任一權利，請透過以下電話或地址，或電子郵件 privacy@irfc.com，聯絡 ${LEGAL_ENTITY} 的隱私權負責人。`,
    ],
  },
];

const title = ZH ? '隱私權告知' : 'Notice of Privacy Practices';
const description = ZH
  ? `${LEGAL_ENTITY}（${BRAND_ABBREV}）如何蒐集、使用與保護您的個人及健康資訊，包含您在 HIPAA 與加州隱私法下的權利。`
  : `How ${LEGAL_ENTITY} (${BRAND_ABBREV}) collects, uses, and protects your personal and health information, including your rights under HIPAA and California privacy law.`;
---

<Layout title={title} description={description}>
  <Nav />

  <section class="pt-40 pb-16" style="background: var(--color-pearl-100);">
    <div class="max-w-3xl mx-auto px-6 lg:px-10">
      <p class="text-xs tracking-widest uppercase mb-5" style="color: var(--color-champagne-600); font-family: var(--font-sans);">
        {ZH ? '法律' : 'Legal'}
      </p>
      <h1 style="font-family: var(--font-serif);" class="text-4xl md:text-5xl font-light text-stone-800 mb-6 leading-tight">
        {title}
      </h1>
      <p class="text-lg text-stone-500 font-light leading-relaxed">
        {ZH
          ? '我們極為重視您付託給我們的信任。本告知說明我們蒐集哪些資訊、如何運用，以及您對這些資訊所擁有的權利。'
          : 'We take the trust you place in us seriously. This notice explains what information we collect, how it is used, and the rights you have over it.'}
      </p>
      <p class="text-sm text-stone-400 font-light mt-4">{ZH ? '生效日期：2026 年 8 月' : 'Effective date: August 2026'}</p>
    </div>
  </section>

  <section class="py-16" style="background: var(--color-pearl-50);">
    <div class="max-w-3xl mx-auto px-6 lg:px-10">

      {sections.map((section) => (
        <div class="mb-12" id={section.id}>
          <h2 style="font-family: var(--font-serif);" class="text-2xl font-light text-stone-800 mb-4">
            {ZH ? section.titleZh : section.title}
          </h2>
          {(ZH ? section.bodyZh : section.body).map((para) => (
            <p class="text-stone-500 font-light leading-relaxed mb-4">{para}</p>
          ))}
          {section.list && (
            <ul class="space-y-2 mt-4 ml-1">
              {(ZH ? section.listZh : section.list).map((item) => (
                <li class="flex gap-3 text-stone-500 font-light leading-relaxed">
                  <span style="color: var(--color-champagne-500);">—</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}

      <div class="pt-10" style="border-top: 1px solid var(--color-pearl-300);">
        <h2 style="font-family: var(--font-serif);" class="text-2xl font-light text-stone-800 mb-4">
          {ZH ? '聯絡方式' : 'Contact'}
        </h2>
        <p class="text-stone-500 font-light leading-relaxed mb-2">{LEGAL_ENTITY} ({BRAND_ABBREV})</p>
        <p class="text-stone-500 font-light leading-relaxed mb-2">
          16300 Sand Canyon Avenue, 9th Floor, Irvine, CA 92618
        </p>
        <p class="text-stone-500 font-light leading-relaxed">
          <MainPhone withLabel={false} style="color: var(--color-champagne-700);" />
        </p>
      </div>

      <p class="text-xs text-stone-400 font-light mt-12 leading-relaxed">
        {ZH
          ? '本告知僅供一般資訊之用，不構成契約或法律保證，亦不得取代針對您個別情況之專業法律意見。'
          : 'This notice is provided for general information. It does not create a contractual or legal guarantee, and it is not a substitute for advice from qualified counsel on your specific situation.'}
      </p>

    </div>
  </section>

  <Footer />
</Layout>
