---
import Layout from '../../layouts/Layout.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import { blogPosts, type BlogPost } from '../../data/blog';
import { SITE_URL, LEGAL_ENTITY, BRAND_ABBREV } from '../../config/brand';
import { getLocaleFromPath, type Locale } from '../../i18n/index';
import { localeHref } from '../../i18n/routes';

interface Props {
  post: BlogPost;
}
const { post } = Astro.props;

const locale = getLocaleFromPath(Astro.url.pathname);
const ZH = locale === 'zh-hant';

const title = ZH ? post.titleZh ?? post.title : post.title;
const description = ZH ? post.descriptionZh ?? post.description : post.description;

const fmtDate = (iso: string) =>
  new Date(iso + 'T00:00:00').toLocaleDateString(ZH ? 'zh-Hant' : 'en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

const catMap: Record<string, string> = {
  'IVF & Treatment': 'IVF 與療程',
  'IVF & Genetics': 'IVF 與基因',
  Preservation: '生育保存',
};
const cat = (c: string) => (ZH ? catMap[c] ?? c : c);
const reading = (r: string) => (ZH ? r.replace(/(\d+)\s*min read/i, '約 $1 分鐘') : r);

// Localize internal links to the zh-hant version when on the Traditional Chinese page
const rawBody = ZH ? post.bodyZh ?? post.body : post.body;
const body = ZH
  ? rawBody.replace(
      /href="(\/(?:services|consultation|locations|about|team|contact|appointment|blog)[^"]*)"/g,
      'href="/zh-hant$1"',
    )
  : rawBody;

const url = new URL(Astro.url.pathname, SITE_URL).href;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: post.date,
  dateModified: post.date,
  author: { '@type': 'Organization', name: `${BRAND_ABBREV} — ${LEGAL_ENTITY}` },
  publisher: {
    '@type': 'Organization',
    name: `${BRAND_ABBREV} — ${LEGAL_ENTITY}`,
    logo: { '@type': 'ImageObject', url: `${SITE_URL}/favicon.ico` },
  },
  image: `${SITE_URL}${post.cover}`,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
};

const related = blogPosts.filter((p) => p.slug !== post.slug).slice(0, 2);
---

<Layout title={title} description={description} schema={articleSchema}>
  <Nav />

  <main class="pt-40 pb-20 bg-white">
    <article class="max-w-3xl mx-auto px-6 lg:px-10">
      <header class="mb-10">
        <div class="flex items-center gap-3 mb-5">
          <div class="h-px w-12" style="background: var(--color-gold-500);"></div>
          <span class="text-xs tracking-widest uppercase" style="color: var(--color-gold-600); font-family: var(--font-sans);">{cat(post.category)}</span>
        </div>
        <h1 style="font-family: var(--font-serif);" class="text-4xl md:text-5xl font-light text-stone-800 mb-4 leading-tight">{title}</h1>
        <p class="text-sm tracking-wide" style="color: var(--color-stone-400); font-family: var(--font-sans);">{fmtDate(post.date)} · {reading(post.readingTime)}</p>
      </header>

      <figure class="mb-10 aspect-[16/9] overflow-hidden rounded-2xl bg-stone-100">
        <img src={post.cover} alt={ZH ? post.coverAltZh ?? post.coverAlt : post.coverAlt} width="1200" height="675" decoding="async" class="w-full h-full object-cover" />
      </figure>

      <div class="blog-prose" set:html={body}></div>

      <p class="article-disclaimer">
        {ZH
          ? '本文僅供一般資訊參考，不構成醫療建議。請就你的個別情況諮詢合格的醫療提供者。'
          : 'This article is for general informational purposes only and does not constitute medical advice. Please consult with a qualified healthcare provider about your individual circumstances.'}
      </p>
    </article>

    <section class="py-16 mt-16" style="background: var(--color-stone-50);">
      <div class="max-w-screen-xl mx-auto px-6 lg:px-10 text-center">
        <h2 style="font-family: var(--font-serif);" class="text-3xl font-light text-stone-800 mb-3">
          {ZH ? '準備好與醫師好好談談了？' : 'Ready to talk it through with a physician?'}
        </h2>
        <p class="text-sm leading-relaxed mb-7 max-w-lg mx-auto" style="color: var(--color-stone-500);">
          {ZH
            ? '在我們南加州四間診所任一處預約諮詢，或透過安全視訊會面——兩種方式諮詢費相同。'
            : 'Book a consultation at any of our four Southern California clinics, or meet by secure video visit — same consultation fee either way.'}
        </p>
        <a class="btn-primary" href={localeHref('/appointment', locale)}>
          {ZH ? '預約諮詢' : 'Schedule a Consultation'}
        </a>
      </div>
    </section>

    {related.length > 0 && (
      <section class="pt-20">
        <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
          <div class="flex items-center gap-3 mb-8">
            <div class="h-px w-12" style="background: var(--color-gold-500);"></div>
            <h2 style="font-family: var(--font-serif);" class="text-3xl font-light text-stone-800">{ZH ? '更多洞察' : 'More insights'}</h2>
          </div>
          <div class="grid md:grid-cols-2 gap-6">
            {related.map((r) => (
              <a class="group block bg-white border border-stone-200 card-hover overflow-hidden" href={localeHref(`/blog/${r.slug}`, locale)}>
                <div class="aspect-[3/2] overflow-hidden bg-stone-100">
                  <img
                    src={r.cover}
                    alt={ZH ? r.coverAltZh ?? r.coverAlt : r.coverAlt}
                    loading="lazy"
                    decoding="async"
                    width="600"
                    height="400"
                    class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                  />
                </div>
                <div class="p-7">
                  <span class="text-xs tracking-widest uppercase mb-3 block" style="color: var(--color-gold-600); font-family: var(--font-sans);">{cat(r.category)}</span>
                  <h3 style="font-family: var(--font-serif);" class="text-2xl font-light text-stone-800 mb-3 leading-snug">{ZH ? r.titleZh ?? r.title : r.title}</h3>
                  <p class="text-xs tracking-wide" style="color: var(--color-stone-400); font-family: var(--font-sans);">{fmtDate(r.date)} · {reading(r.readingTime)}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
</Layout>

<style>
  /* Prose — set:html content is opted into global scope */
  .blog-prose :global(p) {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-stone-700);
    margin: 0 0 1.4rem;
  }
  .blog-prose :global(h2) {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.6rem;
    line-height: 1.3;
    color: var(--color-stone-800);
    margin: 2.5rem 0 1rem;
  }
  .blog-prose :global(ul) { margin: 0 0 1.4rem; padding-left: 1.25rem; }
  .blog-prose :global(li) {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-stone-700);
    margin-bottom: 0.5rem;
  }
  .blog-prose :global(strong) { color: var(--color-stone-900); font-weight: 600; }
  .blog-prose :global(a) {
    color: var(--color-gold-600);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .blog-prose :global(a:hover) { color: var(--color-gold-700); }
  .blog-prose :global(blockquote) {
    margin: 0 0 1.4rem;
    padding: 0.9rem 1.4rem;
    border-left: 3px solid var(--color-gold-400);
    background: var(--color-champagne-50);
    border-radius: 0 10px 10px 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--color-stone-800);
  }

  .article-disclaimer {
    margin-top: 2.5rem;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--color-stone-400);
    border-top: 1px solid var(--color-stone-200);
    padding-top: 1.25rem;
  }
</style>
