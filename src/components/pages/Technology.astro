---
// 實驗室技術（英文 / 繁體中文共用元件）
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getLocaleFromPath, type Locale } from '../../i18n';
import { localeHref } from '../../i18n/routes';

const locale = getLocaleFromPath(Astro.url.pathname);
const ZH = locale === 'zh-hant';

const technologies = [
  {
    id: 'embryoscope',
    name: 'EmbryoScope+',
    tagline: 'Time-Lapse Embryo Monitoring',
    taglineZh: '縮時胚胎監測',
    color: 'gold',
    intro: 'The EmbryoScope+ is the world\'s first time-lapse incubator designed to provide a stable, undisturbed environment for embryo development while continuously capturing high-resolution images — without ever removing the embryo from incubation. IRFC was among the first fertility centers in Orange County to offer this technology.',
    introZh: 'EmbryoScope+ 是全球首款縮時培養箱，旨在提供穩定、不受干擾的胚胎發育環境，同時持續拍攝高解析度影像——從未將胚胎移出培養環境。IRFC 是橙縣最早提供這項技術的生育中心之一。',
    how: [
      { title: 'Stable Environment', titleZh: '穩定環境', desc: 'Direct-contact heating and HEPA/VOC air filtration maintain optimal, uninterrupted incubation conditions. Integrated gas mixing enables reduced oxygen levels proven to support embryo health.', descZh: '接觸式加熱與 HEPA/VOC 空氣過濾，維持最佳、不中斷的培養條件。整合式氣體混合，可實現經證實有助胚胎健康的低氧環境。' },
      { title: 'Continuous Imaging', titleZh: '持續成像', desc: 'High-resolution optics capture multi-plane images at regular intervals throughout development — validated as safe at the light wavelength and energy levels used.', descZh: '高解析度光學系統，在整個發育過程中定期捕捉多平面影像——在所使用的光波長與能量等級下，經驗證為安全。' },
      { title: 'Intelligent Selection', titleZh: '智慧篩選', desc: 'The resulting time-lapse video allows our embryologists to assess each embryo\'s developmental pattern and select the most viable candidates for transfer — a level of insight impossible with traditional spot-checking.', descZh: '所產生的縮時影片，讓我們的胚胎學家得以評估每個胚胎的發育模式，並挑選最具活力的候選者進行植入——這是傳統抽樣檢查無法達到的洞察層次。' },
    ],
    benefits: [
      'Improved implantation rates through better embryo selection',
      'Reduced pregnancy loss by identifying the most viable embryos',
      'No disruption to incubation — embryos are never exposed to environmental stress',
      'Shortened average time to pregnancy',
    ],
    benefitsZh: [
      '透過更好的胚胎篩選提升著床率',
      '辨識最具活力的胚胎，降低妊娠流失',
      '不干擾培養環境——胚胎永遠不會暴露於環境壓力',
      '縮短平均懷孕所需時間',
    ],
  },
  {
    id: 'tmrw',
    name: 'TMRW Vault',
    tagline: 'Smart Cryogenic Storage',
    taglineZh: '智慧冷凍儲存',
    color: 'gold',
    intro: 'The TMRW Vault replaces traditional handwritten labeling with a fully digital specimen management system. Each patient receives a unique digital ID; every egg and embryo is assigned an RFID beacon that maintains its location and complete history in real time — so your future family is protected with military-grade precision.',
    introZh: 'TMRW Vault 以全數位化的檢體管理系統，取代傳統的手寫標籤。每位病人都獲得專屬數位 ID；每顆卵子與胚胎都配備 RFID 信標，即時維護其位置與完整歷程——讓你未來的家庭，以軍規等級的精準受到保護。',
    how: [
      { title: 'Digital Identification', titleZh: '數位辨識', desc: 'Every specimen is assigned a unique RFID beacon linked to the patient\'s digital ID. No handwritten labels — no human error in identification.', descZh: '每個檢體都配備連結至病人數位 ID 的專屬 RFID 信標。沒有手寫標籤——也就沒有辨識上的人為錯誤。' },
      { title: '24/7 Active Monitoring', titleZh: '24/7 主動監測', desc: 'Thousands of system checks are performed daily by both automated systems and a dedicated remote expert team. Anomalies are flagged and addressed before they become problems.', descZh: '自動化系統與專屬遠端專家團隊，每日執行數千次系統檢查。異常會在演變成問題之前被標記並處理。' },
      { title: 'Military-Grade Security', titleZh: '軍規等級安全', desc: 'All patient data and specimen records are protected with HIPAA-compliant, military-grade encryption. Your most private medical information stays private.', descZh: '所有病人資料與檢體紀錄，皆以符合 HIPAA、軍規等級的加密保護。你最私密的醫療資訊，始終保持私密。' },
    ],
    benefits: [
      'Eliminates risk of specimen mix-ups through digital rather than analog tracking',
      'Continuous oversight by both automated systems and expert personnel',
      'Real-time location history for every stored egg and embryo',
      'HIPAA-compliant encryption protects your medical records',
    ],
    benefitsZh: [
      '以數位而非類比追蹤，消除檢體混淆的風險',
      '由自動化系統與專家人員共同持續監督',
      '每顆儲存卵子與胚胎的即時位置歷程',
      '符合 HIPAA 的加密，保護你的醫療紀錄',
    ],
  },
  {
    id: 'riwitness',
    name: 'RI Witness™',
    tagline: 'Electronic Witnessing System',
    taglineZh: '電子見證系統',
    color: 'gold',
    intro: 'The RI Witness™ ART Management System uses RFID technology to track every patient sample — eggs, sperm, and embryos — through every step of the IVF process. Readers positioned throughout the lab automatically verify that the right samples are being used for the right patient, every time.',
    introZh: 'RI Witness™ ART 管理系統運用 RFID 技術，在 IVF 流程的每一步追蹤每位病人的檢體——卵子、精子與胚胎。實驗室內佈建的讀取器，會在每一次自動確認正確的檢體被用於正確的病人。',
    how: [
      { title: 'RFID Sample Tracking', titleZh: 'RFID 檢體追蹤', desc: 'Every dish, tube, and container is tagged with an RFID chip linked to the patient\'s identity. Lab readers automatically confirm correct matching without requiring manual checks.', descZh: '每個培養皿、試管與容器都貼有連結至病人身分的 RFID 晶片。實驗室讀取器會自動確認正確配對，無須人工檢查。' },
      { title: 'Automated Lab Workflow', titleZh: '自動化實驗室流程', desc: 'The system integrates into standard lab procedures without adding steps for embryologists — reducing administrative burden and freeing them to focus entirely on patient care.', descZh: '系統整合進標準實驗室流程，不增加胚胎學家的步驟——減輕行政負擔，讓他們能全心專注於病人照護。' },
      { title: 'Research-Validated', titleZh: '經研究驗證', desc: 'Endorsed by the American Society for Reproductive Medicine (ASRM), RI Witness is recognized for significantly reducing the risk of laboratory errors in ART procedures.', descZh: '獲美國生殖醫學會（ASRM）認可，RI Witness 因顯著降低 ART 程序中實驗室錯誤的風險而受到肯定。' },
    ],
    benefits: [
      'Prevents sample mix-ups — the most serious risk in any IVF laboratory',
      'Automatic verification at every stage: egg retrieval, fertilization, biopsy, transfer',
      'Reduces reliance on manual double-checking without sacrificing safety',
      'Used in leading IVF centers worldwide',
    ],
    benefitsZh: [
      '防止檢體混淆——任何 IVF 實驗室中最嚴重的風險',
      '在每個階段自動驗證：取卵、受精、切片、植入',
      '在不犧牲安全的前提下，減少對人工雙重檢查的依賴',
      '全球頂尖 IVF 中心皆採用',
    ],
  },
];

const title = ZH ? '生育實驗室技術與胚胎學' : 'Fertility Lab Technology & Embryology';
const description = ZH
  ? 'IRFC 的胚胎學實驗室採用 EmbryoScope+、TMRW Vault 與 RI Witness——IVF 實驗室技術在安全、精準與卓越結果上的黃金標準。'
  : "IRFC's embryology laboratory uses EmbryoScope+, TMRW Vault, and RI Witness — the gold standard in IVF laboratory technology for safety, precision, and superior outcomes.";
---
<!-- marked: component for /technology and /zh-hant/technology -->
<Layout title={title} description={description}>
  <Nav />

  <!-- Hero -->
  <section class="pt-40 pb-24 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-6">
          <div class="h-px w-12" style="background: var(--color-gold-500);"></div>
          <span class="text-xs tracking-widest uppercase" style="color: var(--color-gold-600); font-family: var(--font-sans);">{ZH ? '實驗室技術' : 'Laboratory Technology'}</span>
        </div>
        <h1 style="font-family: var(--font-serif);" class="text-5xl md:text-6xl font-light text-stone-800 mb-6 leading-none">
          {ZH ? (
            <>成就每一次成功的<br/><em class="not-italic" style="color: var(--color-gold-500);">背後科學。</em></>
          ) : (
            <>The Science Behind<br/><em class="not-italic" style="color: var(--color-gold-500);">Every Success.</em></>
          )}
        </h1>
        <p class="text-lg text-stone-500 font-light leading-relaxed max-w-2xl">
          {ZH
            ? '我們的胚胎學實驗室配備了生殖醫學最先進的技術。這些工具不會取代科學家的專業——而是放大它，讓每顆胚胎都擁有最佳的發育條件，也讓每位病人擁有最大的成功機會。'
            : 'Our embryology laboratory is equipped with the most advanced technologies in reproductive medicine. These tools don’t replace the expertise of our scientists — they amplify it, giving every embryo the best possible conditions to develop and every patient the best possible chance of success.'}
        </p>
      </div>
    </div>
  </section>

  <!-- Lab Achievement Banner -->
  <section class="py-10 border-y border-stone-100" style="background: var(--color-stone-900);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="flex flex-col md:flex-row items-center justify-center gap-6 md:gap-16 text-center md:text-left">
        <div>
          <p class="text-4xl font-light mb-1" style="font-family: var(--font-serif); color: var(--color-gold-400);">#1</p>
          <p class="text-xs tracking-widest uppercase" style="color: var(--color-stone-400);">{ZH ? '全美 IVF 成功率，2016' : 'US IVF Success Rate, 2016'}</p>
        </div>
        <div class="h-px w-12 md:h-12 md:w-px" style="background: var(--color-stone-700);"></div>
        <div>
          <p class="text-sm leading-relaxed max-w-md" style="color: var(--color-stone-300);">
            {ZH
              ? '我們的實驗室團隊於 <strong class="text-white">2016 年榮登全美 IVF 成功率第一</strong>——這份榮譽，源於對科學人才與支援技術永不停歇的投入。'
              : 'Our laboratory team ranked <strong class="text-white">#1 in US IVF success rates in 2016</strong> — a distinction earned through relentless investment in both scientific talent and the technology that supports it.'}
          </p>
        </div>
        <div class="h-px w-12 md:h-12 md:w-px" style="background: var(--color-stone-700);"></div>
        <div>
          <p class="text-xs tracking-widest uppercase mb-1" style="color: var(--color-stone-500);">{ZH ? 'CAP 認證' : 'CAP Certified'}</p>
          <p class="text-xs tracking-widest uppercase" style="color: var(--color-stone-500);">{ZH ? 'CLIA 認證' : 'CLIA Accredited'}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Embryology in action -->
  <section class="relative overflow-hidden" style="height: 360px;">
    <img src="/images/care-team-embryologist.webp" srcset="/images/care-team-embryologist-800.webp 800w, /images/care-team-embryologist.webp 1024w" sizes="(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 1200px" alt="An embryology professional working in the IRFC laboratory" class="w-full h-full object-cover object-center" />
    <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(20,18,15,0.55) 0%, transparent 60%);"></div>
    <div class="absolute inset-0 flex items-center px-10 lg:px-20">
      <div class="max-w-sm">
        <p class="text-xs tracking-widest uppercase mb-3" style="color: var(--color-gold-400); font-family: var(--font-sans);">{ZH ? '走進胚胎學實驗室' : 'Inside the Embryology Lab'}</p>
        <p style="font-family: var(--font-serif);" class="text-2xl font-light text-white leading-relaxed">
          {ZH ? '每顆胚胎都經雙手呵護——並由科技持續守護。' : 'Every embryo is cared for by hand — and watched, continuously, by technology.'}
        </p>
      </div>
    </div>
  </section>

  <!-- Technology Deep Dives -->
  {technologies.map((tech, i) => (
    <section
      id={tech.id}
      class={`py-24 lg:py-28 ${i % 2 === 0 ? 'bg-white' : ''}`}
      style={i % 2 !== 0 ? 'background: var(--color-stone-50);' : ''}
    >
      <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
        <!-- Header -->
        <div class="grid lg:grid-cols-3 gap-10 lg:gap-16 mb-14">
          <div>
            <p class="text-xs tracking-widest uppercase mb-3" style={`color: var(--color-${tech.color}-600); font-family: var(--font-sans);`}>{ZH ? tech.taglineZh : tech.tagline}</p>
            <h2 style="font-family: var(--font-serif);" class="text-4xl font-light text-stone-800 mb-5">{tech.name}</h2>
            <div class="w-8 h-px" style={`background: var(--color-${tech.color}-500);`}></div>
          </div>
          <div class="lg:col-span-2">
            <p class="text-stone-600 leading-relaxed">{ZH ? tech.introZh : tech.intro}</p>
          </div>
        </div>

        <!-- How It Works -->
        <div class="grid lg:grid-cols-2 gap-8 mb-10">
          <div>
            <p class="text-xs tracking-widest uppercase mb-6" style="color: var(--color-stone-400); font-family: var(--font-sans);">{ZH ? '運作方式' : 'How It Works'}</p>
            <div class="space-y-6">
              {tech.how.map((step, idx) => (
                <div class="flex gap-5">
                  <div class="flex-shrink-0 w-8 h-8 flex items-center justify-center border text-xs font-medium" style={`border-color: var(--color-${tech.color}-300); color: var(--color-${tech.color}-600); font-family: var(--font-sans);`}>
                    {String(idx + 1).padStart(2, '0')}
                  </div>
                  <div>
                    <h3 style="font-family: var(--font-serif);" class="text-lg font-light text-stone-800 mb-1">{ZH ? step.titleZh : step.title}</h3>
                    <p class="text-sm text-stone-500 leading-relaxed">{ZH ? step.descZh : step.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="border border-stone-200 p-8" style={i % 2 !== 0 ? 'background: white;' : 'background: var(--color-stone-50);'}>
            <p class="text-xs tracking-widest uppercase mb-6" style="color: var(--color-stone-400); font-family: var(--font-sans);">{ZH ? '病人益處' : 'Patient Benefits'}</p>
            <ul class="space-y-4">
              {(ZH ? tech.benefitsZh : tech.benefits).map(b => (
                <li class="flex items-start gap-3">
                  <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style={`color: var(--color-${tech.color}-500);`}>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                  </svg>
                  <span class="text-sm text-stone-600 leading-relaxed">{b}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- Lab Photo -->
  <section class="relative overflow-hidden" style="height: 380px;">
    <img
      src="/images/surgery-center.webp" srcset="/images/surgery-center-800.webp 800w, /images/surgery-center-1280.webp 1280w, /images/surgery-center.webp 2560w" sizes="(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 1200px"
      alt="IRFC surgery center and embryology lab"
      class="w-full h-full object-cover object-center"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(20,18,15,0.55) 0%, transparent 60%);"></div>
    <div class="absolute inset-0 flex items-center px-10 lg:px-20">
      <div class="max-w-sm">
        <p class="text-xs tracking-widest uppercase mb-3" style="color: var(--color-gold-400); font-family: var(--font-sans);">{ZH ? '手術中心與胚胎學實驗室' : 'Surgery Center & Embryology Lab'}</p>
        <p style="font-family: var(--font-serif);" class="text-2xl font-light text-white leading-relaxed">
          {ZH ? 'Irvine 與 Corona 據點，皆設有完整的現場 IVF 實驗室與通過認證的手術中心。' : 'Irvine and Corona locations feature fully on-site IVF laboratories and accredited surgery centers.'}
        </p>
      </div>
    </div>
  </section>

  <!-- Lab Director -->
  <section class="py-20" style="background: var(--color-stone-900);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-2 gap-14 items-center">
        <div class="flex items-start gap-8">
          <img
            src="/images/team/dr-yufen-xie.png"
            alt="Dr. Yufen Xie, IVF Laboratory Director"
            class="flex-shrink-0 w-24 h-24 object-cover rounded-full"
          />
          <div>
            <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-gold-500); font-family: var(--font-sans);">{ZH ? 'IVF 實驗室主任' : 'IVF Laboratory Director'}</p>
            <h3 style="font-family: var(--font-serif);" class="text-2xl font-light text-white mb-1">Yufen Xie, PhD</h3>
            <p class="text-sm mb-5" style="color: var(--color-stone-400);">{ZH ? '胚胎學家 · 20 年以上經驗' : 'Embryologist · 20+ Years Experience'}</p>
            <p class="text-sm leading-relaxed" style="color: var(--color-stone-300);">
              {ZH
                ? 'Xie 醫師帶領 IRFC 實驗室團隊，於 2016 年榮登全美 IVF 成功率第一。她對胚胎學技術的專精，加上對現有最先進實驗室系統的掌握，為每一個經手我們實驗室的個案立下標準。'
                : 'Dr. Xie led the IRFC laboratory team to achieve the #1 ranking in US IVF success rates in 2016. Her expertise in embryology technique, combined with her command of the most advanced laboratory systems available, sets the standard for every case that passes through our lab.'}
            </p>
          </div>
        </div>
        <blockquote class="border-l-2 pl-8" style="border-color: var(--color-gold-600);">
          <p class="text-xl font-light italic leading-relaxed mb-4" style="font-family: var(--font-serif); color: var(--color-stone-200);">
            {ZH ? '科技給我們資訊。科學與經驗，告訴我們如何運用它。兩者結合，為我們的病人帶來最大的成功機會。' : 'Technology gives us the information. Science and experience tell us what to do with it. Together, they give our patients their best possible chance.'}
          </p>
          <cite class="text-xs tracking-widest uppercase not-italic" style="color: var(--color-gold-500);">{ZH ? '— Yufen Xie 博士，IVF 實驗室主任' : '— Yufen Xie, PhD, IVF Laboratory Director'}</cite>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10 text-center">
      <h2 style="font-family: var(--font-serif);" class="text-4xl font-light text-stone-800 mb-4">
        {ZH ? '體驗與眾不同' : 'Experience the Difference'}
      </h2>
      <p class="text-sm leading-relaxed mb-8 max-w-lg mx-auto" style="color: var(--color-stone-500);">
        {ZH
          ? '我們的技術，結合團隊的專業，意味著實驗室中的每顆胚胎都擁有最大的機會。預約諮詢，了解更多。'
          : 'Our technology, combined with our team’s expertise, means every embryo in our lab has the best possible chance. Schedule a consultation to learn more.'}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={localeHref('/contact', locale)} class="btn-primary">{ZH ? '預約諮詢' : 'Schedule a Consultation'}</a>
        <a href={localeHref('/team', locale)} class="btn-outline">{ZH ? '認識我們的實驗室團隊' : 'Meet Our Lab Team'}</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
