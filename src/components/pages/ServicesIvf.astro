---
import Layout from '../../layouts/Layout.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import { getLocaleFromPath, t, type Locale } from '../../i18n';
import { localeHref } from '../../i18n/routes';

const locale = getLocaleFromPath(Astro.url.pathname);
const ZH = locale === 'zh-hant';

const steps = [
  { n: '01', title: ZH ? '初次諮詢與評估' : 'Initial Consultation & Evaluation', desc: ZH ? '醫師會詳閱你的完整病史，並安排基礎檢查：抽血（荷爾蒙檢測、AMH、CBC）、超音波測量竇卵泡數；若是伴侶，則包含精液分析。在做出任何決定前，這些檢查能勾勒出完整的全貌。' : 'Your physician reviews your complete medical history and orders baseline tests: bloodwork (hormonal panel, AMH, CBC), antral follicle count via ultrasound, and — for couples — a semen analysis. This workup paints a complete picture before any decision is made.' },
  { n: '02', title: ZH ? '卵巢刺激' : 'Ovarian Stimulation', desc: ZH ? '在 8–14 天期間，注射藥物會刺激卵巢發育多個成熟卵泡。我們的護理師會指導你每一次注射，你也會回診進行監測超音波與抽血，以追蹤反應並精準調整劑量。' : 'Over 8–14 days, injectable medications stimulate your ovaries to develop multiple mature follicles. Our nurses guide you through every injection, and you return for monitoring ultrasounds and blood draws to track response and adjust dosing precisely.' },
  { n: '03', title: ZH ? '破卵針與取卵' : 'Trigger Shot & Egg Retrieval', desc: ZH ? '當卵泡達到理想大小，會施打精準計時的破卵針以促使卵子成熟。約 36 小時後，在輕度鎮靜下以經陰道超音波導引的細針取出卵子。手術約 20 分鐘，多數病患當天上午即可返家。' : 'When follicles reach optimal size, a precisely timed trigger shot matures the eggs. Approximately 36 hours later, eggs are retrieved under light sedation via a transvaginal ultrasound-guided needle. The procedure takes about 20 minutes; most patients go home the same morning.' },
  { n: '04', title: ZH ? '受精與胚胎培養' : 'Fertilization & Embryo Culture', desc: ZH ? '成熟卵子與處理過的精子結合受精——可採傳統授精或 ICSI（卵胞質內單精子注入）。形成的胚胎在我們的 EmbryoScope+ 培養箱中發育，能在不干擾培養環境的情況下記錄縮時影像。' : 'Mature eggs are fertilized with prepared sperm — either by conventional insemination or ICSI (intracytoplasmic sperm injection). Resulting embryos develop in our EmbryoScope+ incubators, which capture time-lapse video without disturbing the culture environment.' },
  { n: '05', title: ZH ? '胚胎監測與挑選' : 'Embryo Monitoring & Selection', desc: ZH ? '我們的胚胎師每日觀察發育情形。到了第 5–6 天，會評估已達囊胚階段的胚胎品質。若安排 PGT-A 檢測，會在植入前取出少量細胞進行染色體分析。' : 'Our embryologists observe development daily. By day 5–6, embryos that have reached the blastocyst stage are assessed for quality. If PGT-A testing is ordered, embryos are biopsied and sent for chromosomal analysis before transfer.' },
  { n: '06', title: ZH ? '胚胎植入' : 'Embryo Transfer', desc: ZH ? '品質最佳的胚胎會經由細軟導管置入子宮——這是一項在超音波導引下、快速且無痛的程序。多數病患只植入一顆胚胎，以在維持優異成功率的同时，將安全性最大化。' : 'The highest-quality embryo is placed into the uterus through a thin catheter — a quick, painless procedure performed under ultrasound guidance. Most patients transfer one embryo to maximize safety while preserving excellent success rates.' },
  { n: '07', title: ZH ? '驗孕與早期監測' : 'Pregnancy Test & Early Monitoring', desc: ZH ? '植入後 10–12 天進行抽血驗孕。若呈陽性，我們會密切追蹤 HCG 數值並安排早期超音波，之後再將照護交棒給你的婦產科或母胎醫學專科醫師。' : 'A blood pregnancy test is performed 10–12 days after transfer. If positive, we monitor closely with HCG levels and an early ultrasound before transitioning care to your OB-GYN or Maternal-Fetal Medicine specialist.' },
];

const faqs = [
  { q: ZH ? '我需要進行幾次 IVF 療程？' : 'How many IVF cycles will I need?', a: ZH ? '多數病患在 1–3 個療程內成功懷孕，但個別結果會因年齡、診斷與胚胎品質而異。醫師會在諮詢時，依你的個別狀況給出務實的成功率評估。' : 'Most patients conceive within 1–3 cycles, though individual outcomes vary based on age, diagnosis, and embryo quality. Your physician will give you a realistic success rate estimate based on your specific profile during your consultation.' },
  { q: ZH ? 'IVF 會痛嗎？' : 'Is IVF painful?', a: ZH ? '刺激階段的注射很輕微——多數病患形容就像被輕捏一下。取卵在手術鎮靜下進行，因此你不會有感覺。取卵後腹脹與輕微絞痛屬常見現象，通常一兩天內緩解。' : 'The stimulation injections are mild — most patients describe them as similar to a pinch. The egg retrieval is performed under sedation, so you will not feel it. Post-retrieval bloating and mild cramping are common and typically resolve within a day or two.' },
  { q: ZH ? '新鮮胚胎植入與冷凍胚胎植入有何不同？' : 'What is the difference between fresh and frozen embryo transfer?', a: ZH ? '新鮮植入與取卵在同一療程內進行；冷凍植入（FET）則先冷凍胚胎，於之後獨立的療程再植入——對部分病患可提升子宮著床環境。醫師會為你建議最合適的方式。' : 'A fresh transfer occurs within the same cycle as egg retrieval. A frozen transfer (FET) freezes the embryo and transfers it in a subsequent, separate cycle — which can improve uterine receptivity in some patients. Your physician will recommend the best approach for you.' },
  { q: ZH ? 'IRFC 是否提供低刺激或迷你 IVF？' : 'Does IRFC offer low-stimulation or mini-IVF?', a: ZH ? '有的。劉醫師專精於溫和刺激方案，能在維持良好成效的同時降低藥物劑量，適合特定診斷或偏好的病患。這類方案可能適合部分病患。' : 'Yes. Dr. Liu specializes in mild stimulation protocols that reduce medication doses while maintaining strong outcomes for appropriate candidates. These protocols may be a good fit for patients with certain diagnoses or preferences.' },
  { q: ZH ? 'IVF 可以使用捐卵或捐精嗎？' : 'Can I use donor eggs or donor sperm for IVF?', a: ZH ? '當然可以。IRFC 透過與 Fairfax EggBank 合作，提供完整的捐卵方案，並經由合法冷凍精子銀行協助挑選捐精者。我們的第三方協調師會全程引導。' : 'Absolutely. IRFC has a comprehensive donor egg program through our partnership with Fairfax EggBank, and coordinates sperm donor selection through licensed cryobanks. Our third-party coordinator guides every step.' },
];

const indications = [
  ZH ? '輸卵管阻塞或缺失' : 'Blocked or absent fallopian tubes',
  ZH ? '重度或中度男性因素不孕' : 'Severe or moderate male factor infertility',
  ZH ? '卵巢庫存量偏低（AMH 或竇卵泡數偏低）' : 'Ovarian reserve concerns (low AMH or antral follicle count)',
  ZH ? '影響生育的子宮內膜異位症' : 'Endometriosis affecting fertility',
  ZH ? 'IUI 療程失敗（通常 3 次以上）' : 'Failed IUI cycles (typically 3+ attempts)',
  ZH ? '檢查後仍屬不明原因不孕' : 'Unexplained infertility after evaluation',
  ZH ? '需要進行胚胎著床前基因檢測（PGT）' : 'A need for preimplantation genetic testing (PGT)',
  ZH ? '計畫使用捐卵或代理孕母' : 'Plans to use donor eggs or gestational surrogacy',
];
---

<Layout
  title={ZH ? '體外受精 (IVF)' : 'In Vitro Fertilization (IVF)'}
  description={ZH ? 'IRFC 的 IVF 療程——結合 EmbryoScope+ 監控的體外受精逐步指南。了解過程、適應對象，以及如何開始。' : 'IVF at IRFC — step-by-step guide to in vitro fertilization with EmbryoScope+ monitoring. Learn what to expect, who is a candidate, and how to get started.'}
>
  <Nav />

  <!-- Hero -->
  <section class="pt-40 pb-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-4">
          <div class="h-px w-12" style="background: var(--color-gold-500);"></div>
          <a href={localeHref('/services', locale)} class="text-xs tracking-widest uppercase hover:underline" style="color: var(--color-stone-400); font-family: var(--font-sans);">{ZH ? '全部療程' : 'All Services'}</a>
          <span style="color: var(--color-stone-300);">/</span>
          <span class="text-xs tracking-widest uppercase" style="color: var(--color-gold-600); font-family: var(--font-sans);">IVF</span>
        </div>
        <h1 style="font-family: var(--font-serif);" class="text-5xl md:text-6xl font-light text-stone-800 mb-5 leading-none">
          {ZH ? '體外受精' : 'In Vitro Fertilization'}
        </h1>
        <p class="text-xs tracking-widest uppercase mb-6" style="color: var(--color-stone-400); font-family: var(--font-sans);">{ZH ? '輔助生殖技術' : 'Assisted Reproductive Technology'}</p>
        <p class="text-lg text-stone-500 font-light leading-relaxed max-w-2xl">
          {ZH ? '體外受精（IVF）是目前成功率最高的生育治療方式；在 IRFC，它由全美排名第一的實驗室團隊、EmbryoScope+ 縮時監控技術，以及曾協助數千個家庭圓夢的醫師共同把關。' : 'IVF is the most effective fertility treatment available — and at IRFC, it is supported by a #1-ranked laboratory team, EmbryoScope+ time-lapse monitoring, and physicians who have guided thousands of families to success.'}
        </p>
      </div>
    </div>
  </section>
  <!-- Care Team Spotlight -->
  <section class="py-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-2 gap-14 items-center">
        <div class="overflow-hidden">
          <img src="/images/care-team-physician.webp" srcset="/images/care-team-physician-800.webp 800w, /images/care-team-physician-1280.webp 1280w, /images/care-team-physician.webp 1800w" sizes="(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 1200px" alt="IRFC fertility physician consulting with a patient" width="1800" height="1200" class="w-full h-auto object-cover" />
        </div>
        <div>
          <div class="h-px w-12 mb-5" style="background: var(--color-gold-500);"></div>
          <h2 style="font-family: var(--font-serif);" class="text-3xl font-light text-stone-800 mb-5">{ZH ? '每一步，都是同一個團隊' : 'One team, every step'}</h2>
          <p class="text-sm text-stone-500 leading-relaxed mb-4">{ZH ? '從初次諮詢、每次回診監測，到胚胎植入，都由同一批醫師、護理師與胚胎師陪伴你。緊密銜接的照護，讓你的治療過程不會有一絲落差。' : 'From your first consultation through every monitoring visit and embryo transfer, the same physicians, nurses, and embryologists stay with you. Connected care means nothing about your treatment gets lost in translation.'}</p>
          <a href={localeHref('/team', locale)} class="text-xs tracking-widest uppercase flex items-center gap-2 mt-2" style="color: var(--color-gold-600);">{ZH ? '認識我們的團隊' : 'Meet our team'} <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg></a>
        </div>
      </div>
    </div>
  </section>

  <!-- What Is IVF -->
  <section class="py-20" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-2 gap-14 items-start">
        <div>
          <h2 style="font-family: var(--font-serif);" class="text-3xl font-light text-stone-800 mb-5">{ZH ? '什麼是體外受精（IVF）？' : 'What Is IVF?'}</h2>
          <p class="text-stone-600 leading-relaxed mb-4 text-sm">
            {ZH ? '體外受精（IVF）是一種將卵子自卵巢取出，在實驗室中與精子結合受精，再將形成的胚胎培養數日後，挑選最優質者植入子宮的過程。' : 'In vitro fertilization (IVF) is a process in which eggs are retrieved from the ovaries, fertilized with sperm in the laboratory, and the resulting embryos are cultured for several days before the best candidate is transferred to the uterus.'}
          </p>
          <p class="text-stone-600 leading-relaxed mb-4 text-sm">
            {ZH ? 'IVF 在嚴謹、優化的實驗室環境中讓卵子與精子相遇，因此能繞過最常見的不孕原因——包含輸卵管阻塞、男性因素、排卵障礙，以及不明原因不孕。' : 'IVF bypasses the most common causes of infertility — including blocked fallopian tubes, male factor, ovulation disorders, and unexplained infertility — by bringing the egg and sperm together under controlled, optimized laboratory conditions.'}
          </p>
          <p class="text-stone-600 leading-relaxed text-sm">
            {ZH ? 'IRFC 的 IVF 療程可視需求搭配多項加值技術，例如 ICSI、輔助孵化、胚胎著床前基因檢測（PGT），以及溫和刺激方案——皆依每位病患的個別狀況量身規劃。' : 'IRFC\'s IVF program includes optional add-ons such as ICSI, assisted hatching, preimplantation genetic testing (PGT), and mild-stimulation protocols — all tailored to each patient\'s individual profile.'}
          </p>
        </div>

        <div class="space-y-4">
          <p class="text-xs tracking-widest uppercase mb-4" style="color: var(--color-stone-400); font-family: var(--font-sans);">{ZH ? '下列情況可能建議接受 IVF：' : 'IVF may be recommended if you have:'}</p>
          {indications.map(item => (
            <div class="flex items-start gap-3 p-4 bg-white border border-stone-200">
              <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color: var(--color-gold-500);">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
              </svg>
              <span class="text-sm text-stone-600">{item}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Step-by-Step Process -->
  <section class="py-24 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="mb-14">
        <h2 style="font-family: var(--font-serif);" class="text-3xl font-light text-stone-800 mb-3">{ZH ? '你的 IVF 療程，一步步來' : 'Your IVF Journey, Step by Step'}</h2>
        <p class="text-sm max-w-xl" style="color: var(--color-stone-500);">{ZH ? '沒有兩個療程完全相同，但每位 IRFC 病患都遵循一套為安全、舒適與最佳結果而精心設計的結構化流程。' : 'No two cycles are identical, but every IRFC patient follows a carefully structured process designed for safety, comfort, and the best possible outcome.'}</p>
      </div>
      <div class="space-y-4">
        {steps.map(step => (
          <div class="grid lg:grid-cols-12 gap-6 p-8 border border-stone-200 bg-stone-50">
            <div class="lg:col-span-1">
              <span class="text-xs font-medium tracking-widest" style="color: var(--color-gold-500); font-family: var(--font-sans);">{step.n}</span>
            </div>
            <div class="lg:col-span-11">
              <h3 style="font-family: var(--font-serif);" class="text-xl font-light text-stone-800 mb-2">{step.title}</h3>
              <p class="text-sm text-stone-500 leading-relaxed">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Transfer Room Photo -->
  <section class="relative overflow-hidden" style="height: 420px;">
    <img
      src="/images/transfer-room.webp" srcset="/images/transfer-room-800.webp 800w, /images/transfer-room-1280.webp 1280w, /images/transfer-room.webp 1707w" sizes="(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 1200px"
      alt="IRFC embryo transfer suite"
      class="w-full h-full object-cover object-center"
    />
    <div class="absolute inset-0 flex items-end p-10 lg:p-16" style="background: linear-gradient(to top, rgba(20,18,15,0.65) 0%, transparent 55%);">
      <p style="font-family: var(--font-serif);" class="text-2xl font-light text-white max-w-lg leading-relaxed">
        {ZH ? '每間植入室都以平和為設計核心——因為植入當下的環境，與植入背後的科學同樣重要。' : 'Every transfer suite is designed for calm — because the environment around the transfer matters as much as the science inside it.'}
      </p>
    </div>
  </section>

  <!-- Technology Callout -->
  <section class="py-16" style="background: var(--color-stone-900);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="grid md:grid-cols-3 gap-6">
        {[
          { name: 'EmbryoScope+', desc: ZH ? '縮時培養箱能在不干擾培養環境的情況下，持續記錄胚胎發育影像。' : 'Time-lapse incubation captures continuous embryo development images without disturbing the culture environment.' },
          { name: 'RI Witness™', desc: ZH ? '電子見證系統確保你的卵子、精子與胚胎在每一個步驟都正確配對。' : 'Electronic witnessing system ensures your eggs, sperm, and embryos are correctly matched at every step.' },
          { name: 'TMRW Vault', desc: ZH ? '具備 RFID 追蹤的軍規等級冷凍保存系統，守護你未來可用的冷凍胚胎。' : 'Military-grade cryogenic storage with RFID tracking protects any frozen embryos for your future use.' },
        ].map(tech => (
          <div class="p-7 border" style="border-color: var(--color-stone-800);">
            <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-gold-500); font-family: var(--font-sans);">{ZH ? '技術' : 'Technology'}</p>
            <h3 style="font-family: var(--font-serif);" class="text-lg font-light text-white mb-2">{tech.name}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-stone-400);">{tech.desc}</p>
          </div>
        ))}
      </div>
      <div class="mt-6 text-center">
        <a href={localeHref('/technology', locale)} class="text-xs tracking-widest uppercase flex items-center justify-center gap-2" style="color: var(--color-gold-400);">
          {ZH ? '進一步了解我們的實驗室技術' : 'Learn more about our lab technology'}
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-24" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="max-w-3xl mx-auto">
        <h2 style="font-family: var(--font-serif);" class="text-3xl font-light text-stone-800 mb-10">{ZH ? 'IVF 常見問題' : 'Common IVF Questions'}</h2>
        <div class="border border-stone-200">
          {faqs.map(faq => (
            <details class="group border-b border-stone-200 last:border-b-0">
              <summary class="flex items-center justify-between px-7 py-5 cursor-pointer list-none">
                <h3 class="text-base font-medium text-stone-800 pr-4">{faq.q}</h3>
                <svg class="w-4 h-4 flex-shrink-0 transition-transform group-open:rotate-45" style="color: var(--color-gold-500);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                </svg>
              </summary>
              <div class="px-7 pb-6">
                <p class="text-sm text-stone-500 leading-relaxed">{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10 text-center">
      <h2 style="font-family: var(--font-serif);" class="text-4xl font-light text-stone-800 mb-4">{ZH ? '準備進一步了解？' : 'Ready to Learn More?'}</h2>
      <p class="text-sm leading-relaxed mb-8 max-w-lg mx-auto" style="color: var(--color-stone-500);">
        {ZH ? '與我們的醫師預約諮詢。我們會詳閱你的病史、回答每一個問題，並誠實評估你的可行方案。' : 'Schedule a consultation with one of our physicians. We\'ll review your history, answer every question, and give you an honest assessment of your options.'}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={localeHref('/contact', locale)} class="btn-primary">{t(locale, 'nav.cta')}</a>
        <a href={localeHref('/services', locale)} class="btn-outline">{ZH ? '全部療程' : 'All Services'}</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
