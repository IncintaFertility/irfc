---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getLocaleFromPath, t, type Locale } from '../../i18n';
import { SITE_URL, LEGAL_ENTITY } from '../../config/brand';
import { localeHref } from '../../i18n/routes';

const locale = getLocaleFromPath(Astro.url.pathname);
const ZH = locale === 'zh-hant';

const steps = [
  { n: '1.', title: ZH ? 'IUI 準備' : 'IUI Preparation', desc: ZH ? 'IUIs 可以使用伴侶的精子或捐贈精子進行。建議病人在術前兩到三天禁慾。IUI 通常在排卵週期進行。若週期不規則，女性可能需要服用藥物來誘發排卵。' : 'IUIs can be performed either with the partner’s sperm or with donor sperm. It is recommended that the patient abstain from sexual intercourse for two to three days before the procedure. IUI is typically performed during the ovulation cycle. In some cases, it may be necessary for the female to take medication to induce ovulation if her cycles are not regular.' },
  { n: '2.', title: ZH ? '精液分析' : 'Semen Analysis', desc: ZH ? '男性會在手術前一到兩小時提供精液樣本。精液將經過洗滌——即將精子與精漿分離的程序——並分析精子品質。精子製備由高度專業的男科學家在我們的實驗室中進行，他們利用細緻的樣本處理和品質控制措施來確保安全。' : 'The male will provide a semen sample one to two hours before the procedure is to be performed. The semen will be washed, a procedure in which the sperm is separated from the seminal fluid, and the quality of the sperm is analyzed. Sperm preparation is performed in our laboratory by highly trained andrologists, who utilize meticulous specimen handling and quality control measures to ensure safety.' },
  { n: '3.', title: ZH ? '授精' : 'Insemination', desc: ZH ? '洗滌程序後即為授精手術，只需幾分鐘，且對女性而言不會造成太多（若有的話）不適。醫師會透過子宮頸將小導管插入子宮腔，直接將精子注入子宮。' : 'Following the wash is the insemination procedure, which only takes a few minutes and does not cause much, if any, discomfort for the female. The doctor will insert a small catheter into the uterine cavity through the cervix and inject sperm directly into the uterus.' },
  { n: '4.', title: ZH ? '授精後' : 'Post-Insemination', desc: ZH ? '授精程序完成後，病人在躺下幾分鐘後即可恢復正常活動。如果初次 IUI 未成功受孕，可能會在接下來的週期中重複此程序。' : 'Following the insemination process, the patient is able to resume normal activity after lying down for a few minutes. If pregnancy does not result from the initial IUI, the procedure may be repeated during the following cycles.' },
];

const faqs = [
  { q: ZH ? 'IUI 會痛嗎？' : 'Does IUI hurt?', a: ZH ? '宮腔內人工授精（IUI）通常是一個無痛的手術。有些病人可能會經歷輕微痙攣和點狀出血，但大多數病人不會感到任何不適。' : 'Intrauterine Insemination (IUI) is generally a pain-free procedure. Some patients may experience slight cramping and spotting, but the majority of patients do not experience any discomfort.' },
  { q: ZH ? 'IUI 後多久可以驗孕？' : 'How soon can I take a pregnancy test after IUI?', a: ZH ? 'IUI 後，我們建議等待至少 14 天再進行驗孕，以確保結果準確。' : 'After IUI, we recommend waiting at least 14 days before taking a pregnancy test to ensure an accurate result.' },
  { q: ZH ? 'IUI 後應該做什麼？' : 'What should I do after IUI?', a: ZH ? '手術後，您會被指示躺下幾分鐘，然後就可以恢復日常活動。' : 'After the procedure, you’ll be instructed to lie down for a few minutes and then you can resume your regular day-to-day activities.' },
  { q: ZH ? 'IUI 後行房會影響機率嗎？' : 'Does sexual intercourse after IUI affect my chances?', a: ZH ? 'IUI 後行房不會影響您的機會。IUI 後您應該能夠回到平常的日常活動。' : 'Sexual intercourse after IUI will not affect your chances. After IUI, you should be able to go back to your regular daily activities.' },
];

const considerations = [
  {
    title: ZH ? '低精子數或活動力不足' : 'Low Sperm Count or Poor Motility',
    desc: ZH ? '在 IUI 過程中，會收集、處理並濃縮精子。這種濃縮增加了可用於受精的活動精子數量。直接將精子放入子宮減少了牠們游向卵子的距離，即使初始精子數較低，也能提高受精機率。' : 'During IUI, sperm is collected, processed, and concentrated. This concentration increases the number of motile (actively moving) sperm available for fertilization. Directly placing sperm in the uterus reduces the distance they must swim to reach the egg, increasing the likelihood of fertilization, even with a low initial sperm count.'
  },
  {
    title: ZH ? '子宮頸黏液排斥' : 'Cervical Mucus Incompatibility',
    desc: ZH ? '子宮頸黏液排斥發生在子宮頸液體與伴侶的精子不相容時。由於這種不相容，精子會被直接放置到子宮中，繞過子宮頸。透過繞過子宮頸進行授精，精子不會接觸到子宮頸黏液，從而增加了精子使卵子受精的機率。' : 'Cervical mucus incompatibility is when cervical fluid is not compatible with your partner’s sperm. Because of this incompatibility, the sperm is placed directly into the uterus, bypassing the cervix. By inseminating past the cervix, the sperm does not come in contact with the cervical mucus, and the chances of the sperm fertilizing an egg are increased.'
  },
  {
    title: ZH ? '其他狀況' : 'Other Conditions',
    desc: ZH ? '如果有妨礙射精的醫療狀況，可以執行睪丸精子抽吸術（TESA）、經皮附睪精子抽吸術（PESA）、顯微附睪精子抽吸術（MESA）或睪丸精子萃取術（TESE）等精子取回手術。一旦取出精子，就會進行洗滌並準備授精。' : 'If there are medical conditions preventing ejaculation, there are procedures like Testicular Sperm Aspiration (TESA), Percutaneous Epididymal Sperm Aspiration (PESA), Microsurgical Epididymal Sperm Aspiration (MESA), or Testicular Sperm Extraction (TESE) that can be performed for sperm retrieval. Once the sperm is retrieved, it will be washed and ready for insemination.'
  }
];

const schemaTitle = ZH ? '宮腔內人工授精 (IUI)' : 'Intrauterine Insemination (IUI)';
const schemaDesc = ZH ? 'IRFC 的 IUI 療程——一項微創的第一線生育治療。了解宮腔內人工授精如何運作、適用對象，以及過程中會發生什麼。' : 'IUI at IRFC — a minimally invasive first-line fertility treatment. Learn how intrauterine insemination works, who it helps, and what to expect.';

const schemaUrl = new URL(Astro.url.pathname, SITE_URL).href;
const treatmentSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalProcedure',
  name: schemaTitle,
  alternateName: 'IUI',
  description: schemaDesc,
  url: schemaUrl,
  provider: { '@type': 'MedicalOrganization', name: LEGAL_ENTITY, url: SITE_URL },
  howPerformed: steps.map((s) => s.title + ': ' + s.desc).join(' '),
};
const faqPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const pageSchema = [treatmentSchema, faqPageSchema];
---

<Layout
  title={ZH ? '宮腔內人工授精 (IUI)' : 'Intrauterine Insemination (IUI)'}
  description={schemaDesc}
  schema={pageSchema}
>
  <Nav />

  <!-- Hero Section using Global CSS utility classes -->
  <section class="relative pt-40 pb-20 overflow-hidden bg-white">
    <!-- Reusable background container (Hidden on mobile via 'hidden lg:block') -->
    <div class="hero-bg-split">
      <div class="hero-bg-gradient"></div>
      <img 
        src="https://www.irfc.com/images/IUI-Small.jpg" 
        alt="IUI Diagram" 
        class="absolute inset-0 h-full w-full object-cover object-center opacity-85"
      />
    </div>

    <div class="max-w-screen-xl mx-auto px-6 lg:px-10 relative z-20">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-4">
          <div class="h-px w-12" style="background: var(--color-gold-500);"></div>
          <a href={localeHref('/services', locale)} class="text-xs tracking-widest uppercase hover:underline" style="color: var(--color-stone-400); font-family: var(--font-sans);">{ZH ? '全部療程' : 'All Services'}</a>
          <span style="color: var(--color-stone-300);">/</span>
          <span class="text-xs tracking-widest uppercase" style="color: var(--color-gold-text); font-family: var(--font-sans);">IUI</span>
        </div>
        <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-stone-400); font-family: var(--font-sans);">{ZH ? '治療選項' : 'Treatment Options'}</p>
        <h1 style="font-family: var(--font-serif);" class="text-5xl md:text-6xl font-light text-stone-800 mb-6 leading-none">
          {ZH ? '宮腔內人工授精' : 'Intrauterine Insemination'}<br/>(IUI)
        </h1>
        
        <div class="bg-white/90 backdrop-blur-sm p-6 sm:p-8 border border-stone-200 shadow-sm">
          <h2 style="font-family: var(--font-serif);" class="text-2xl font-light text-stone-800 mb-4">{ZH ? '什麼是宮腔內人工授精 (IUI)？' : 'What is Intrauterine Insemination (IUI)?'}</h2>
          <p class="text-stone-600 font-light leading-relaxed text-base">
            {ZH ? '宮腔內人工授精（IUI），又稱人工授精，是一種透過導管在接近排卵期時將精子直接放置到子宮腔內的程序。IUI 透過將精子直接放入子宮來增加您懷孕的機會，縮短精子必須行進的距離，繞過子宮頸並改善精子輸送到卵子的效果。' : 'Intrauterine insemination (IUI), also known as artificial insemination, is a procedure where sperm is placed directly into the uterine cavity through a catheter near the time of ovulation. IUI increases your chances of pregnancy as the sperm is placed directly into the uterus, lessening the distance sperm must travel by bypassing the cervix and improving the delivery of the sperm to the egg.'}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- How does IUI work -->
  <section class="py-20 bg-stone-50">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="max-w-2xl mb-14">
        <div class="h-px w-12 mb-4" style="background: var(--color-gold-500);"></div>
        <h2 style="font-family: var(--font-serif);" class="text-3xl lg:text-4xl font-light text-stone-800">{ZH ? '宮腔內人工授精是如何運作的？' : 'How does Intrauterine Insemination work?'}</h2>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {steps.map(step => (
          <div class="bg-white p-8 border border-stone-200 flex flex-col justify-between">
            <div>
              <span class="text-xs font-medium tracking-widest block mb-3" style="color: var(--color-gold-text); font-family: var(--font-sans);">{step.n}</span>
              <h3 style="font-family: var(--font-serif);" class="text-xl font-light text-stone-800 mb-3">{step.title}</h3>
              <p class="text-sm text-stone-600 leading-relaxed font-light">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Should I consider IUI -->
  <section class="py-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="max-w-3xl mb-14">
        <div class="h-px w-12 mb-4" style="background: var(--color-gold-500);"></div>
        <h2 style="font-family: var(--font-serif);" class="text-3xl lg:text-4xl font-light text-stone-800 mb-4">{ZH ? '我應該考慮宮腔內人工授精嗎？' : 'Should I consider Intrauterine Insemination?'}</h2>
        <p class="text-stone-600 font-light leading-relaxed text-sm">
          {ZH ? '宮腔內人工授精（IUI）通常建議用於正在與不孕症搏鬥的人士。當解決男性生育問題時，IUI 是一個值得探討的深思熟慮選項。當遇到精子健康挑戰（如低精子數或活動力不佳），或精子與子宮頸黏液之間存在相容性問題時，通常會推薦此程序。此外，它還能幫助克服因勃起功能障礙、早洩或其他醫療疑慮等狀況而難以在陰道內射精所造成的障礙。' : 'Intrauterine insemination (IUI) is a procedure that is commonly recommended for those who are struggling with infertility. IUI is a thoughtful option to explore when addressing male fertility issues. This procedure is often recommended when encountering challenges with sperm health, such as low sperm count or poor motility, or when there is a compatibility issue between the sperm and cervical mucus. Additionally, it can help overcome obstacles arising from difficulty in ejaculating inside the vagina due to conditions like erectile dysfunction, premature ejaculation, or other medical concerns.'}
        </p>
      </div>

      <div class="grid lg:grid-cols-3 gap-6">
        {considerations.map(item => (
          <div class="p-8 bg-stone-50 border border-stone-200">
            <h3 style="font-family: var(--font-serif);" class="text-xl font-light text-stone-800 mb-3">{item.title}</h3>
            <p class="text-sm text-stone-600 leading-relaxed font-light">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="py-20 bg-stone-50">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <div class="h-px w-12 mx-auto mb-4" style="background: var(--color-gold-500);"></div>
          <h2 style="font-family: var(--font-serif);" class="text-3xl font-light text-stone-800">{ZH ? '常見問題 (FAQs)' : 'Frequently Asked Questions (FAQs)'}</h2>
        </div>

        <div class="border border-stone-200 bg-white">
          {faqs.map(faq => (
            <details class="group border-b border-stone-200 last:border-b-0">
              <summary class="flex items-center justify-between px-7 py-5 cursor-pointer list-none">
                <h3 class="text-base font-medium text-stone-800 pr-4">{faq.q}</h3>
                <svg aria-hidden="true" class="w-4 h-4 flex-shrink-0 transition-transform group-open:rotate-45" style="color: var(--color-gold-text);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                </svg>
              </summary>
              <div class="px-7 pb-6">
                <p class="text-sm text-stone-500 leading-relaxed">{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10 text-center">
      <h2 style="font-family: var(--font-serif);" class="text-4xl font-light text-stone-800 mb-4">{ZH ? '準備好展開下一步了嗎？' : 'Ready to Take the Next Step?'}</h2>
      <p class="text-sm leading-relaxed mb-8 max-w-lg mx-auto" style="color: var(--color-stone-500);">
        {ZH ? '聯絡我們的團隊，安排您的諮詢，深入了解 IUI 是否適合您的生育計畫。' : 'Contact our team to schedule your consultation and learn more about whether IUI is right for your family-building plan.'}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={localeHref('/appointment', locale)} class="btn-primary">{t(locale, 'nav.cta')}</a>
        <a href={localeHref('/services', locale)} class="btn-outline">{ZH ? '查看全部療程' : 'See More Services'}</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
