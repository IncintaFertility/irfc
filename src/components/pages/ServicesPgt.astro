---
import Layout from '../../layouts/Layout.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import { getLocaleFromPath, t, type Locale } from '../../i18n';
import { SITE_URL, LEGAL_ENTITY } from '../../config/brand';
import { localeHref } from '../../i18n/routes';

const locale = getLocaleFromPath(Astro.url.pathname);
const ZH = locale === 'zh-hant';

const types = [
  {
    abbr: 'PGT-A',
    name: ZH ? '染色體數目篩檢' : 'Aneuploidy Screening',
    desc: ZH ? '檢測胚胎染色體數目是否正確（共 46 條）。結果描述取樣細胞，並非胚胎每個細胞。可能出現嵌合或無法判讀的結果，不保證懷孕或活產。' : 'Tests embryos for the correct number of chromosomes (46 total). Results describe sampled cells, not every cell in an embryo. The test can produce mosaic or inconclusive findings and does not guarantee pregnancy or live birth.',
    best: ZH ? '高齡、反覆流產、屢次 IVF 失敗' : 'Advanced maternal age, recurrent pregnancy loss, repeated IVF failure',
  },
  {
    abbr: 'PGT-M',
    name: ZH ? '單基因疾病檢測' : 'Monogenic Disease Testing',
    desc: ZH ? '當父母一方或雙方為已知帶因者時，篩檢胚胎是否帶有特定單基因疾病——例如囊腫性纖維化、鐮刀型貧血、BRCA 突變、亨丁頓舞蹈症等數百種疾病。' : 'Screens embryos for specific single-gene disorders — such as cystic fibrosis, sickle cell disease, BRCA mutations, Huntington\'s disease, and hundreds of others — when one or both parents are known carriers.',
    best: ZH ? '已知帶有特定遺傳疾病者' : 'Known carriers of a specific inherited condition',
  },
  {
    abbr: 'PGT-SR',
    name: ZH ? '結構重排檢測' : 'Structural Rearrangement',
    desc: ZH ? '辨識可能造成 IVF 失敗或反覆流產的染色體結構變化（轉位、倒位）——即使父母一方為無明顯健康影響的平衡型帶因者亦然。' : 'Identifies chromosomal structural changes (translocations, inversions) that can cause IVF failure or recurrent miscarriage, even when one parent is a balanced carrier with no apparent health impact.',
    best: ZH ? '已知有染色體結構重排的伴侶' : 'Couples with a known chromosomal structural rearrangement',
  },
];

const faqs = [
  { q: ZH ? 'PGT 能保證生下健康寶寶嗎？' : 'Does PGT guarantee a healthy baby?', a: ZH ? 'PGT 能顯著降低特定染色體或基因疾病的風險——但無法篩檢所有可能異常。它是一項重要的風險降低工具，而非絕對保證。醫師會與你討論務實的期待。' : 'PGT significantly reduces the risk of specific chromosomal or genetic conditions — but it cannot screen for all possible abnormalities. It is an important risk-reduction tool, not an absolute guarantee. Your physician will discuss realistic expectations.' },
  { q: ZH ? '胚胎切片是如何進行的？' : 'How is the embryo biopsy performed?', a: ZH ? '在囊胚階段（第 5–6 天），胚胎師以雷射取出少量滋養外胚層細胞（日後形成胎盤，而非胎兒）。胚胎隨後冷凍，等待切片結果。切片可能損傷胚胎。請向團隊詢問這項風險、結果準確性，以及可植入胚胎可能減少的情況。' : 'At the blastocyst stage (day 5–6), an embryologist uses a laser to remove a small number of trophectoderm cells (which become the placenta, not the baby). The embryo is then frozen while biopsy results are awaited. Biopsy can damage an embryo. Ask your team about this risk, result accuracy, and the possibility of having fewer embryos available for transfer.' },
  { q: ZH ? 'PGT 需要多久？' : 'How long does PGT take?', a: ZH ? '回報時間依檢測與實驗室而定。請向協調員確認預計時間與植入安排。醫師會與你一起解讀結果。' : 'Turnaround time depends on the test and laboratory. Ask your coordinator for the expected timeline and transfer schedule. Your physician will interpret the results with you.' },
  { q: ZH ? 'PGT 能提升成功率嗎？' : 'Does PGT improve success rates?', a: ZH ? 'PGT-A 並非能提高每個人生下寶寶的機會。HFEA 指出，隨機試驗未證實對多數 IVF 病人的益處。某些情況下可能降低流產，但也可能減少可植入胚胎。請討論適用於你情況的證據、風險與費用。' : 'PGT-A does not improve the chance of having a baby for everyone. HFEA reports no evidence from randomized trials of benefit for most IVF patients. It may reduce miscarriage in some circumstances, but may reduce embryos available for transfer. Discuss the evidence, risks, and costs for your situation.' },
  { q: ZH ? '未通過 PGT 的胚胎會如何處理？' : 'What happens to embryos that don\'t pass PGT?', a: ZH ? '決定胚胎植入或處置前，請與醫師及遺傳諮詢師一起檢視異常、嵌合或無法判讀的結果。結果有其限制，需要結合實際情況解讀。' : 'Review abnormal, mosaic, or inconclusive findings with your physician and a genetic counselor before making decisions about embryo transfer or disposition. Results have limitations and must be interpreted in context.' },
];

const schemaTitle = ZH ? '胚胎著床前基因檢測 (PGT)' : 'Preimplantation Genetic Testing (PGT)';
const schemaDesc = ZH ? 'IRFC 的 PGT——在植入前篩檢胚胎的染色體異常與遺傳疾病。了解 PGT-A、PGT-M 與 PGT-SR。' : 'PGT at IRFC — screen embryos for chromosomal abnormalities and inherited conditions before transfer. Learn about PGT-A, PGT-M, and PGT-SR.';

// ── Structured data (JSON-LD)：Google / AI 可讀的療程結構化資料 ──
// schemaDescription 與下方 <Layout> 的 meta description 同源，避免兩處文案漂移。
const schemaUrl = new URL(Astro.url.pathname, SITE_URL).href;
const treatmentSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalProcedure',
  name: schemaTitle,
  alternateName: 'PGT',
  description: schemaDesc,
  url: schemaUrl,
  provider: { '@type': 'MedicalOrganization', name: LEGAL_ENTITY, url: SITE_URL },
};
const faqPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const pageSchema = [treatmentSchema, faqPageSchema];
---

<Layout
  title={ZH ? '胚胎著床前基因檢測 (PGT)' : 'Preimplantation Genetic Testing (PGT)'}
  description={ZH ? 'IRFC 的 PGT——在植入前篩檢胚胎的染色體異常與遺傳疾病。了解 PGT-A、PGT-M 與 PGT-SR。' : 'PGT at IRFC — screen embryos for chromosomal abnormalities and inherited conditions before transfer. Learn about PGT-A, PGT-M, and PGT-SR.'}
  schema={pageSchema}
>
  <Nav />

  <section class="pt-40 pb-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-4">
          <div class="h-px w-12" style="background: var(--color-gold-500);"></div>
          <a href={localeHref('/services', locale)} class="text-xs tracking-widest uppercase hover:underline" style="color: var(--color-stone-400); font-family: var(--font-sans);">{ZH ? '全部療程' : 'All Services'}</a>
          <span style="color: var(--color-stone-300);">/</span>
          <span class="text-xs tracking-widest uppercase" style="color: var(--color-gold-text); font-family: var(--font-sans);">PGT</span>
        </div>
        <h1 style="font-family: var(--font-serif);" class="text-5xl md:text-6xl font-light text-stone-800 mb-5 leading-none">
          {ZH ? '胚胎著床前' : 'Preimplantation'}<br/>{ZH ? '基因檢測' : 'Genetic Testing'}
        </h1>
        <p class="text-xs tracking-widest uppercase mb-6" style="color: var(--color-stone-400); font-family: var(--font-sans);">{ZH ? '胚胎基因分析' : 'Embryo Genetic Analysis'}</p>
        <p class="text-lg text-stone-500 font-light leading-relaxed max-w-2xl">
          {ZH ? '在胚胎植入前，基因檢測能辨識最健康的胚胎——降低流產風險、提升著床率，並讓你對遺傳疾病多一份安心。' : 'Before an embryo is transferred, genetic testing can identify the healthiest candidates — reducing miscarriage risk, improving implantation rates, and offering peace of mind about inherited conditions.'}
        </p>
      </div>
    </div>
  </section>
  <!-- Care Team Spotlight -->
  <section class="py-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-2 gap-14 items-center">
        <div class="overflow-hidden">
          <img src="/images/care-team-physician.webp" srcset="/images/care-team-physician-800.webp 800w, /images/care-team-physician-1280.webp 1280w, /images/care-team-physician.webp 1800w" sizes="(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 1200px" alt="IRFC fertility physician consulting with a patient" width="1800" height="1200" class="w-full h-auto object-cover" />
        </div>
        <div>
          <div class="h-px w-12 mb-5" style="background: var(--color-gold-500);"></div>
          <h2 style="font-family: var(--font-serif);" class="text-3xl font-light text-stone-800 mb-5">{ZH ? '每一步，都是同一個團隊' : 'One team, every step'}</h2>
          <p class="text-sm text-stone-500 leading-relaxed mb-4">{ZH ? '從初次諮詢、每次回診監測，到胚胎植入，都由同一批醫師、護理師與胚胎師陪伴你。緊密銜接的照護，讓你的治療過程不會有一絲落差。' : 'From your first consultation through every monitoring visit and embryo transfer, the same physicians, nurses, and embryologists stay with you. Connected care means nothing about your treatment gets lost in translation.'}</p>
          <a href={localeHref('/team', locale)} class="text-xs tracking-widest uppercase flex items-center gap-2 mt-2" style="color: var(--color-gold-text);">{ZH ? '認識我們的團隊' : 'Meet our team'} <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg></a>
        </div>
      </div>
    </div>
  </section>

  <!-- What & Why -->
  <section class="py-20" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-2 gap-14 items-start">
        <div>
          <h2 style="font-family: var(--font-serif);" class="text-3xl font-light text-stone-800 mb-5">{ZH ? '什麼是 PGT？' : 'What Is PGT?'}</h2>
          <p class="text-stone-600 leading-relaxed mb-4 text-sm">
            {ZH ? '胚胎著床前基因檢測（PGT）是一項在 IVF 形成的胚胎植入子宮前，於實驗室中進行的程序。會從囊胚取出少量細胞，送往基因實驗室分析。' : 'Preimplantation Genetic Testing (PGT) is a laboratory procedure performed on embryos created through IVF before transfer to the uterus. A small number of cells are biopsied from the blastocyst and sent to a genetics laboratory for analysis.'}
          </p>
          <p class="text-stone-600 leading-relaxed text-sm">
            {ZH ? '檢測提供取樣細胞的資訊，供團隊結合其他評估解讀。它無法篩檢每種疾病、預測每個胚胎的結果，或保證健康妊娠。' : 'Testing provides information about the sampled cells for your team to interpret alongside other assessments. It cannot screen for every condition, predict every embryo outcome, or guarantee a healthy pregnancy.'}
          </p>
        </div>
        <div class="p-8 bg-white border border-stone-200">
          <h3 class="text-xl text-stone-800 mb-4">{ZH ? '決定檢測前的問題' : 'Questions Before Choosing Testing'}</h3>
          <ul class="space-y-3 text-sm text-stone-600 leading-relaxed">
            <li>{ZH ? '檢測針對的是染色體數目、特定單基因疾病，還是結構重排？' : 'Does the test address chromosome number, a specific single-gene condition, or a structural rearrangement?'}</li>
            <li>{ZH ? '它對我的整體活產機會有何證據，而不只是每次植入的結果？' : 'What evidence applies to my overall chance of live birth, rather than only outcomes per transfer?'}</li>
            <li>{ZH ? '如何解讀嵌合或無法判讀的結果？切片與誤判有哪些風險？' : 'How are mosaic or inconclusive results interpreted, and what are the biopsy and testing risks?'}</li>
            <li>{ZH ? '費用、等待時間與不進行檢測的替代方案是什麼？' : 'What are the costs, waiting time, and alternatives without testing?'}</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Types -->
  <section class="py-24 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <h2 style="font-family: var(--font-serif);" class="text-3xl font-light text-stone-800 mb-12">{ZH ? 'IRFC 提供的 PGT 類型' : 'Types of PGT at IRFC'}</h2>
      <div class="space-y-6">
        {types.map(t => (
          <div class="border border-stone-200 p-8 lg:p-10">
            <div class="grid lg:grid-cols-3 gap-8">
              <div>
                <span class="inline-block text-xs px-3 py-1 mb-4 border tracking-widest" style="color: var(--color-gold-text); border-color: var(--color-gold-300); font-family: var(--font-sans);">{t.abbr}</span>
                <h3 style="font-family: var(--font-serif);" class="text-2xl font-light text-stone-800">{t.name}</h3>
              </div>
              <div class="lg:col-span-2">
                <p class="text-sm text-stone-600 leading-relaxed mb-4">{t.desc}</p>
                <p class="text-xs" style="color: var(--color-stone-400);"><strong class="text-stone-600">{ZH ? '適用對象：' : 'Best for:'}</strong> {t.best}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden" style="height: 380px;">
    <img src="/images/reception-desk.webp" srcset="/images/reception-desk-800.webp 800w, /images/reception-desk-1280.webp 1280w, /images/reception-desk.webp 2560w" sizes="(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 1200px" alt="IRFC clinic reception" class="w-full h-full object-cover object-center" />
    <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(20,18,15,0.5) 0%, transparent 60%);"></div>
    <div class="absolute inset-0 flex items-center px-10 lg:px-20">
      <p style="font-family: var(--font-serif);" class="text-2xl font-light text-white max-w-sm leading-relaxed">
        {ZH ? '在植入前，給你科學的安心。' : 'Science that gives you confidence before transfer.'}
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-24" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="max-w-3xl mx-auto">
        <h2 style="font-family: var(--font-serif);" class="text-3xl font-light text-stone-800 mb-10">{ZH ? 'PGT 常見問題' : 'PGT Questions'}</h2>
        <div class="border border-stone-200">
          {faqs.map(faq => (
            <details class="group border-b border-stone-200 last:border-b-0">
              <summary class="flex items-center justify-between px-7 py-5 cursor-pointer list-none">
                <h3 class="text-base font-medium text-stone-800 pr-4">{faq.q}</h3>
                <svg aria-hidden="true" class="w-4 h-4 flex-shrink-0 transition-transform group-open:rotate-45" style="color: var(--color-gold-text);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                </svg>
              </summary>
              <div class="px-7 pb-6">
                <p class="text-sm text-stone-500 leading-relaxed">{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10 text-center">
      <h2 style="font-family: var(--font-serif);" class="text-4xl font-light text-stone-800 mb-4">{ZH ? '植入前，先了解清楚' : 'Know Before You Transfer'}</h2>
      <p class="text-sm leading-relaxed mb-8 max-w-lg mx-auto" style="color: var(--color-stone-500);">
        {ZH ? '對合適的病患，PGT 是一項強大的工具。我們的醫師會協助你判斷它是否適合你的狀況。' : 'PGT is a powerful tool for the right patients. Our physicians will help you determine whether it makes sense for your situation.'}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={localeHref('/appointment', locale)} class="btn-primary">{t(locale, 'nav.cta')}</a>
        <a href={localeHref('/services', locale)} class="btn-outline">{ZH ? '全部療程' : 'All Services'}</a>
      </div>
    </div>
  </section>

  <section class="py-8 bg-white"><div class="max-w-screen-xl mx-auto px-6 lg:px-10 text-sm text-stone-600">
    <a href="https://www.hfea.gov.uk/treatments/treatment-add-ons/pre-implantation-genetic-testing-for-aneuploidy-pgt-a/" class="underline underline-offset-4">{ZH ? '資料來源：HFEA — PGT-A 的證據、限制與風險' : 'Source: HFEA — PGT-A evidence, limitations, and risks'}</a>
  </div></section>
  <Footer />
</Layout>
