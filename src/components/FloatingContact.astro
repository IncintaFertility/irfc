---
import { getLocaleFromPath, t } from '../i18n/index';
const locale = getLocaleFromPath(Astro.url.pathname);
const ZH = locale === 'zh-hant';
---

<div id="floating-contact" class="fixed bottom-6 right-6 z-40 flex flex-col items-end gap-3 hidden md:flex">

  <!-- Phone -->
  <a
    href="tel:+14244324732"
    aria-label={t(locale, 'floating.call') + ' IRFC'}
    class="floating-btn group flex items-center gap-3"
  >
    <span class="floating-label hidden lg:block opacity-0 group-hover:opacity-100 transition-opacity duration-200 text-xs tracking-wide bg-white text-stone-700 px-3 py-1.5 shadow border border-stone-100 whitespace-nowrap">
      (424) 432-4732
    </span>
    <div class="w-12 h-12 rounded-full flex items-center justify-center shadow-lg transition-transform duration-200 group-hover:-translate-y-0.5" style="background: linear-gradient(135deg, var(--color-gold-500), var(--color-gold-700));">
      <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
      </svg>
    </div>
  </a>

</div>
