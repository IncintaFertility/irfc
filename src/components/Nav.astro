---
const pathname = Astro.url.pathname;

const navGroups = [
  {
    label: 'Treatments',
    children: [
      { href: '/services/ivf',          label: 'In Vitro Fertilization (IVF)' },
      { href: '/services/iui',           label: 'Intrauterine Insemination (IUI)' },
      { href: '/services/egg-freezing',  label: 'Fertility Preservation' },
      { href: '/services/pgt',           label: 'Genetic Testing (PGT)' },
      { href: '/services/icsi',                    label: 'Intracytoplasmic Sperm Injection (ICSI)' },
      { href: '/services/recurrent-pregnancy-loss', label: 'Recurrent Pregnancy Loss' },
      { href: '/services/donors-surrogacy',         label: 'Donors & Surrogacy' },
      { href: '/services/lgbtqia',                  label: 'LGBTQIA+ Family Building' },
      { href: '/services',                          label: 'All Treatments →' },
    ],
  },
  {
    label: 'Our Team',
    children: [
      { href: '/team/dr-james-lin',  label: 'Dr. James P. Lin, MD' },
      { href: '/team/dr-zitao-liu',  label: 'Dr. Zitao Liu, MD' },
      { href: '/team/dr-yufen-xie',  label: 'Dr. Yufen Xie, PhD' },
      { href: '/team',               label: 'All Physicians →' },
    ],
  },
  {
    label: 'For Patients',
    children: [
      { href: '/patient-journey',    label: 'Patient Journey' },
      { href: '/outcomes',           label: 'Success Rates' },
      { href: '/financing',          label: 'Financing & Cost' },
      { href: '/patient-resources',  label: 'Patient Resources' },
      { href: '/testimonials',          label: 'Patient Stories' },
      { href: '/faq',                   label: 'FAQ' },
      { href: '/international-patients', label: 'International Patients' },
    ],
  },
  {
    label: 'About',
    children: [
      { href: '/about',      label: 'About IRFC' },
      { href: '/why-irfc',   label: 'Why Choose Us' },
      { href: '/why-irfc#standards', label: 'Our Standard' },
      { href: '/technology', label: 'Lab Technology' },
      { href: '/locations',  label: 'Locations' },
    ],
  },
];

const isActive = (group: typeof navGroups[0]) =>
  group.children.some(c => c.href !== '#' && (pathname === c.href || pathname.startsWith(c.href.split('#')[0] + '/')));
---

<header id="site-header" class="site-nav">
  <!-- Logo -->
  <a href="/" class="nav-logo" aria-label="INCINTA Home">
    <img src="/images/incinta-logo.png" alt="INCINTA" class="nav-logo-img" />
  </a>

  <!-- Desktop navigation with dropdowns -->
  <nav class="nav-links" aria-label="Main navigation">
    {navGroups.map(group => (
      <div class="nav-group">
        <button class={`nav-group-btn${isActive(group) ? ' nav-group-btn--active' : ''}`} aria-haspopup="true">
          {group.label}
          <svg class="nav-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="nav-dropdown">
          <div class="nav-dropdown-card">
            {group.children.map(child => (
              <a
                href={child.href}
                class={`nav-dropdown-item${child.label.endsWith('→') ? ' nav-dropdown-item--all' : ''}${pathname === child.href ? ' nav-dropdown-item--active' : ''}`}
              >
                {child.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    ))}
  </nav>

  <!-- Desktop right -->
  <div class="nav-right">
    <a href="/contact" class="nav-cta">Schedule a Consultation</a>
  </div>

  <!-- Hamburger (mobile) -->
  <button class="nav-hamburger" id="nav-hamburger" aria-label="Open menu" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
</header>

<!-- Mobile fullscreen overlay -->
<div class="nav-mobile-menu" id="nav-mobile-menu" aria-hidden="true">
  <div class="nav-mobile-inner">
    <nav class="nav-mobile-links">
      {navGroups.map(group => (
        <details class="nav-mobile-group">
          <summary class="nav-mobile-group-label">
            {group.label}
            <svg class="nav-mobile-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <div class="nav-mobile-children">
            {group.children.map(child => (
              <a href={child.href} class={`nav-mobile-child${child.label.endsWith('→') ? ' nav-mobile-child--all' : ''}`}>
                {child.label}
              </a>
            ))}
          </div>
        </details>
      ))}
    </nav>
    <div class="nav-mobile-bottom">
      <a href="tel:+19494538600" class="nav-mobile-phone">(949) 453-8600</a>
      <a href="/contact" class="btn-primary nav-mobile-cta">Schedule a Consultation</a>
    </div>
  </div>
</div>

<style>
/* ═══ SITE NAV ═══ */
.site-nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  height: 4.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10vw;
  background: rgba(253,250,243,0.88);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(214,209,197,0.5);
  transition: background 0.4s ease, border-color 0.4s ease;
}

.site-nav.nav--solid {
  background: rgba(253,250,243,0.98);
  border-bottom-color: #e7e4df;
}

/* Logo */
.nav-logo { display: block; flex-shrink: 0; }
.nav-logo-img {
  height: 2.4rem;
  max-width: 220px;
  width: auto;
  object-fit: contain;
  object-position: left center;
  display: block;
}
@media (max-width: 1024px) {
  .nav-logo-img { max-width: 170px; height: 2rem; }
}

/* Desktop links */
.nav-links {
  display: flex;
  align-items: center;
  gap: 2.5rem;
}

.nav-group { position: relative; }

.nav-group-btn {
  display: flex;
  align-items: center;
  gap: 0.3rem;
  font-size: 0.6rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  font-family: var(--font-sans);
  color: var(--color-stone-700);
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.5rem 0;
  transition: color 0.2s;
  white-space: nowrap;
}

.nav-group-btn:hover,
.nav-group-btn--active { color: var(--color-gold-600); }

.nav-chevron {
  width: 0.65rem;
  height: 0.65rem;
  transition: transform 0.2s;
}

.nav-group:hover .nav-chevron { transform: rotate(180deg); }

/* Dropdown */
.nav-dropdown {
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  padding-top: 0.5rem;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.2s, visibility 0s 0.2s;
  z-index: 10;
}

.nav-group:hover .nav-dropdown {
  opacity: 1;
  visibility: visible;
  transition: opacity 0.2s, visibility 0s 0s;
}

.nav-dropdown-card {
  background: white;
  border: 1px solid var(--color-stone-200);
  box-shadow: 0 8px 24px -4px rgba(0,0,0,0.08);
  min-width: 210px;
}

.nav-dropdown-item {
  display: block;
  padding: 0.625rem 1.25rem;
  font-size: 0.6rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-family: var(--font-sans);
  color: var(--color-stone-600);
  text-decoration: none;
  transition: color 0.15s, background 0.15s;
  white-space: nowrap;
}

.nav-dropdown-item + .nav-dropdown-item {
  border-top: 1px solid var(--color-stone-100);
}

.nav-dropdown-item:hover,
.nav-dropdown-item--active {
  color: var(--color-gold-600);
  background: var(--color-stone-50);
}

.nav-dropdown-item--all {
  border-top: 1px solid var(--color-stone-200) !important;
  color: var(--color-gold-600);
  font-size: 0.55rem;
  letter-spacing: 0.22em;
  background: var(--color-stone-50);
}

.nav-dropdown-item--all:hover {
  background: #f0ede6;
}

/* Right side */
.nav-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.nav-phone {
  font-size: 0.62rem;
  letter-spacing: 0.08em;
  font-family: var(--font-sans);
  text-decoration: none;
  color: var(--color-stone-500);
  transition: color 0.2s;
  white-space: nowrap;
}

.nav-phone:hover { color: var(--color-gold-600); }

.nav-cta {
  display: inline-flex;
  align-items: center;
  font-size: 0.6rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  font-family: var(--font-sans);
  text-decoration: none;
  padding: 0.6rem 1.4rem;
  border: 1px solid var(--color-gold-500);
  color: var(--color-gold-700);
  transition: border-color 0.25s, color 0.25s, background 0.25s;
  white-space: nowrap;
}

.nav-cta:hover {
  background: var(--color-gold-500);
  color: white;
}

/* Hamburger */
.nav-hamburger {
  display: none;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 5px;
  width: 2.25rem;
  height: 2.25rem;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.25rem;
  flex-shrink: 0;
}

.nav-hamburger span {
  display: block;
  width: 22px;
  height: 1.5px;
  background: var(--color-stone-700);
  transition: transform 0.3s ease, opacity 0.3s ease;
  transform-origin: center;
}

.nav-hamburger.is-open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
.nav-hamburger.is-open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
.nav-hamburger.is-open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

/* Mobile fullscreen menu */
.nav-mobile-menu {
  position: fixed;
  inset: 0;
  z-index: 99;
  background: #fdfaf3;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-8px);
  transition: opacity 0.3s ease, transform 0.3s ease, visibility 0s 0.3s;
  overflow-y: auto;
}

.nav-mobile-menu.is-open {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  transition: opacity 0.3s ease, transform 0.3s ease, visibility 0s 0s;
}

.nav-mobile-inner {
  display: flex;
  flex-direction: column;
  min-height: 100%;
  padding: 5.5rem 6vw 3rem;
}

.nav-mobile-links {
  display: flex;
  flex-direction: column;
  flex: 1;
}

/* Mobile accordion groups */
.nav-mobile-group {
  border-bottom: 1px solid var(--color-stone-100);
}

.nav-mobile-group-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-family: var(--font-serif);
  font-size: 1.7rem;
  font-weight: 300;
  color: var(--color-stone-800);
  padding: 0.85rem 0;
  cursor: pointer;
  list-style: none;
  user-select: none;
}

.nav-mobile-group-label::-webkit-details-marker { display: none; }

.nav-mobile-group[open] .nav-mobile-group-label {
  color: var(--color-gold-600);
}

.nav-mobile-chevron {
  width: 1rem;
  height: 1rem;
  flex-shrink: 0;
  transition: transform 0.25s;
  color: var(--color-stone-400);
}

.nav-mobile-group[open] .nav-mobile-chevron {
  transform: rotate(180deg);
  color: var(--color-gold-500);
}

.nav-mobile-children {
  display: flex;
  flex-direction: column;
  padding-bottom: 0.5rem;
}

.nav-mobile-child {
  font-family: var(--font-sans);
  font-size: 0.65rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-stone-500);
  text-decoration: none;
  padding: 0.6rem 0 0.6rem 1rem;
  border-left: 2px solid var(--color-stone-100);
  transition: color 0.2s, border-color 0.2s, padding-left 0.2s;
}

.nav-mobile-child:hover,
.nav-mobile-child:active {
  color: var(--color-gold-600);
  border-left-color: var(--color-gold-400);
  padding-left: 1.3rem;
}

.nav-mobile-child--all {
  color: var(--color-gold-600);
  border-left-color: var(--color-stone-200);
  margin-top: 0.25rem;
}

.nav-mobile-bottom {
  margin-top: 3rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.nav-mobile-phone {
  font-size: 0.72rem;
  letter-spacing: 0.1em;
  color: var(--color-stone-400);
  font-family: var(--font-sans);
  text-decoration: none;
  text-align: center;
  padding: 0.75rem;
  border: 1px solid var(--color-stone-200);
  transition: color 0.2s;
}

.nav-mobile-phone:hover { color: var(--color-gold-600); }

.nav-mobile-cta { display: flex; justify-content: center; }

/* Responsive */
@media (max-width: 1024px) {
  .site-nav { padding: 0 5vw; }
  .nav-links,
  .nav-phone,
  .nav-cta { display: none; }
  .nav-hamburger { display: flex; }
}
</style>

<script>
  const header = document.getElementById('site-header');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 40) header?.classList.add('nav--solid');
    else header?.classList.remove('nav--solid');
  }, { passive: true });

  const hamburger = document.getElementById('nav-hamburger');
  const mobileMenu = document.getElementById('nav-mobile-menu');

  const openMenu = () => {
    hamburger?.classList.add('is-open');
    mobileMenu?.classList.add('is-open');
    hamburger?.setAttribute('aria-expanded', 'true');
    mobileMenu?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  };

  const closeMenu = () => {
    hamburger?.classList.remove('is-open');
    mobileMenu?.classList.remove('is-open');
    hamburger?.setAttribute('aria-expanded', 'false');
    mobileMenu?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  };

  hamburger?.addEventListener('click', () => {
    hamburger.classList.contains('is-open') ? closeMenu() : openMenu();
  });

  mobileMenu?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
</script>
