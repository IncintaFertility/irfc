---
const pathname = Astro.url.pathname;

const navGroups = [
  {
    label: 'About',
    children: [
      { href: '/about', label: 'About IRFC' },
      { href: '/why-irfc', label: 'Why Choose Us' },
      { href: '/technology', label: 'Lab Technology' },
      { href: '/team', label: 'Our Team' },
      { href: '/locations', label: 'Locations' },
    ],
  },
  {
    label: 'Services',
    children: [
      { href: '/services', label: 'All Services' },
      { href: '/services/ivf', label: 'IVF' },
      { href: '/services/egg-freezing', label: 'Egg Freezing' },
      { href: '/services/iui', label: 'IUI' },
      { href: '/services/pgt', label: 'Genetic Testing (PGT)' },
    ],
  },
  {
    label: 'Resources',
    children: [
      { href: '/patient-resources', label: 'Patient Resources' },
      { href: '/financing', label: 'Financing & Cost' },
      { href: '/testimonials', label: 'Patient Stories' },
    ],
  },
];

const isActive = (group: typeof navGroups[0]) =>
  group.children.some(c => pathname === c.href || pathname.startsWith(c.href + '/'));
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500">
  <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
    <nav class="flex items-center justify-between h-20 lg:h-24">

      <!-- Logo -->
      <a href="/" class="flex-shrink-0" aria-label="IRFC Home">
        <img
          src="/images/irfc-logo.svg"
          alt="IRFC"
          class="h-10 lg:h-12 w-auto transition-opacity duration-300"
          id="nav-logo"
        />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-10">
        {navGroups.map(group => (
          <div class="relative group">
            <button
              class={`nav-link flex items-center gap-1 ${isActive(group) ? 'text-gold-600' : ''}`}
              aria-haspopup="true"
            >
              {group.label}
              <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
              <div class="bg-white border border-stone-200 shadow-xl py-2 min-w-[210px]">
                {group.children.map(child => (
                  <a
                    href={child.href}
                    class={`block px-5 py-2.5 text-xs tracking-wider uppercase transition-colors hover:bg-stone-50 ${pathname === child.href ? 'text-gold-600' : 'text-stone-600 hover:text-gold-600'}`}
                    style="font-family: var(--font-sans);"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Desktop CTA -->
      <div class="hidden lg:flex items-center gap-4">
        <a href="tel:+19494538600" class="text-sm text-stone-500 tracking-wide hover:text-gold-600 transition-colors">
          (949) 453-8600
        </a>
        <a href="/contact" class="btn-primary text-xs py-3 px-6">
          Book Consultation
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 text-stone-700"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg id="menu-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="lg:hidden hidden bg-white border-t border-stone-100 shadow-xl">
    <div class="max-w-screen-xl mx-auto px-6 py-4 flex flex-col overflow-y-auto" style="max-height: calc(100vh - 5rem);">
      {navGroups.map(group => (
        <details class="border-b border-stone-100">
          <summary class="flex items-center justify-between py-3.5 cursor-pointer list-none select-none">
            <span
              class={`text-sm tracking-wider uppercase ${isActive(group) ? 'text-gold-600' : 'text-stone-700'}`}
              style="font-family: var(--font-sans);"
            >
              {group.label}
            </span>
            <svg class="details-chevron w-3.5 h-3.5 text-stone-400 transition-transform duration-200 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <div class="pb-3 pl-3 flex flex-col gap-0.5">
            {group.children.map(child => (
              <a
                href={child.href}
                class={`text-xs tracking-wider uppercase py-2 px-2 transition-colors ${pathname === child.href ? 'text-gold-600' : 'text-stone-500 hover:text-gold-600'}`}
                style="font-family: var(--font-sans);"
              >
                {child.label}
              </a>
            ))}
          </div>
        </details>
      ))}
      <div class="pt-5 pb-2 flex flex-col gap-3 mt-1">
        <a href="tel:+19494538600" class="text-sm text-stone-500">(949) 453-8600</a>
        <a href="/contact" class="btn-primary text-center text-xs">Book Consultation</a>
      </div>
    </div>
  </div>
</header>

<style>
  details[open] .details-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 60) {
      header?.classList.add('bg-white/95', 'backdrop-blur-md', 'shadow-sm', 'border-b', 'border-stone-100');
    } else {
      header?.classList.remove('bg-white/95', 'backdrop-blur-md', 'shadow-sm', 'border-b', 'border-stone-100');
    }
  });

  mobileBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden', !isOpen);
    closeIcon?.classList.toggle('hidden', isOpen);
    mobileBtn.setAttribute('aria-expanded', String(isOpen));
  });
</script>
