---
import { standards } from '../data/standards';

const pathname = Astro.url.pathname;

// Top navigation = six functional categories (one per standard). Each
// category's dropdown lists the content pages filed under that standard.
const navGroups = standards.map((s) => ({
  label: s.navLabel,
  standard: s,
  children: s.related.flatMap((g) => g.items.map((i) => ({ href: i.href, label: i.label }))),
}));

const isActive = (group: typeof navGroups[0]) =>
  group.children.some(c => c.href !== '#' && (pathname === c.href || pathname.startsWith(c.href.split('#')[0] + '/')));
---

<header id="site-header" class="site-nav">
  <!-- Logo -->
  <a href="/" class="nav-logo" aria-label="INCINTA Home">
    <img src="/images/incinta-logo.png" alt="INCINTA" class="nav-logo-img" />
  </a>

  <!-- Desktop navigation with dropdowns -->
  <nav class="nav-links" aria-label="Main navigation">
    {navGroups.map(group => (
      <div class="nav-group">
        <button class={`nav-group-btn${isActive(group) ? ' nav-group-btn--active' : ''}`} aria-haspopup="true">
          {group.label}
          <svg class="nav-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="nav-dropdown">
          <div class="nav-dropdown-card">
            <div class="nav-dropdown-std">
              <span class="nav-dropdown-std-num">{group.standard.number} · The Standard</span>
              <h3 class="nav-dropdown-std-title">{group.standard.title}</h3>
              <p class="nav-dropdown-std-lead">{group.standard.lead}</p>
              <a class="nav-dropdown-std-link" href={`/standards/${group.standard.slug}`}>Explore this standard &rarr;</a>
            </div>
            <div class="nav-dropdown-links">
              {group.standard.related.map(g => (
                <div class="nav-dropdown-group">
                  <p class="nav-dropdown-group-heading">{g.heading}</p>
                  {g.items.map(i => (
                    <a
                      href={i.href}
                      class={`nav-dropdown-item${pathname === i.href ? ' nav-dropdown-item--active' : ''}`}
                    >
                      {i.label}
                    </a>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    ))}
  </nav>

  <!-- Desktop right -->
  <div class="nav-right">
    <a href="/contact" class="nav-cta">
      <span class="nav-cta-full">Schedule a Consultation</span>
      <span class="nav-cta-short">Schedule</span>
    </a>
  </div>

  <!-- Hamburger (mobile) -->
  <button class="nav-hamburger" id="nav-hamburger" aria-label="Open menu" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
</header>

<!-- Mobile fullscreen overlay -->
<div class="nav-mobile-menu" id="nav-mobile-menu" aria-hidden="true">
  <div class="nav-mobile-inner">
    <nav class="nav-mobile-links">
      {navGroups.map(group => (
        <details class="nav-mobile-group">
          <summary class="nav-mobile-group-label">
            <span class="nav-mobile-group-text">
              <span class="nav-mobile-group-primary">{group.label}</span>
              <span class="nav-mobile-group-sub">{group.standard.number} · {group.standard.title}</span>
            </span>
            <svg class="nav-mobile-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <div class="nav-mobile-children">
            {group.standard.related.map(g => (
              <div class="nav-mobile-subgroup">
                <p class="nav-mobile-subgroup-heading">{g.heading}</p>
                {g.items.map(i => (
                  <a href={i.href} class="nav-mobile-child">
                    {i.label}
                  </a>
                ))}
              </div>
            ))}
          </div>
        </details>
      ))}
    </nav>
    <div class="nav-mobile-bottom">
      <a href="tel:+19494538600" class="nav-mobile-phone">(949) 453-8600</a>
      <a href="/contact" class="btn-primary nav-mobile-cta">Schedule a Consultation</a>
    </div>
  </div>
</div>

<style>
/* ═══ SITE NAV ═══ */
.site-nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  height: 4.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4vw;
  background: rgba(253,250,243,0.88);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(214,209,197,0.5);
  transition: background 0.4s ease, border-color 0.4s ease;
}

.site-nav.nav--solid {
  background: rgba(253,250,243,0.98);
  border-bottom-color: #e7e4df;
}

/* Logo */
.nav-logo { display: block; flex-shrink: 0; }
.nav-logo-img {
  height: 2.4rem;
  max-width: 220px;
  width: auto;
  object-fit: contain;
  object-position: left center;
  display: block;
}
@media (max-width: 1024px) {
  .nav-logo-img { max-width: 170px; height: 2rem; }
}

/* Desktop links */
.nav-links {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.nav-group { position: relative; }

.nav-group-btn {
  display: flex;
  align-items: center;
  gap: 0.3rem;
  font-family: var(--font-sans);
  font-size: 0.82rem;
  font-weight: 500;
  letter-spacing: 0.02em;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.55rem 0.4rem;
  color: var(--color-stone-700);
  transition: color 0.2s;
  white-space: nowrap;
}

.nav-group-btn:hover,
.nav-group-btn--active { color: var(--color-gold-600); }

.nav-chevron {
  width: 0.65rem;
  height: 0.65rem;
  transition: transform 0.2s;
}

.nav-group:hover .nav-chevron { transform: rotate(180deg); }

/* Dropdown */
.nav-dropdown {
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  padding-top: 0.5rem;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.2s, visibility 0s 0.2s;
  z-index: 10;
}

.nav-group:hover .nav-dropdown {
  opacity: 1;
  visibility: visible;
  transition: opacity 0.2s, visibility 0s 0s;
}

.nav-dropdown-card {
  background: white;
  border: 1px solid var(--color-stone-200);
  box-shadow: 0 8px 24px -4px rgba(0,0,0,0.08);
  border-radius: 12px;
  overflow: hidden;
  display: grid;
  grid-template-columns: 240px 1fr;
  min-width: 540px;
  max-width: 660px;
}

.nav-dropdown-std {
  background: #FAEEDA;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
}

.nav-dropdown-std-num {
  font-size: 0.6rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-family: var(--font-sans);
  color: var(--color-gold-600);
}

.nav-dropdown-std-title {
  font-family: var(--font-serif);
  font-size: 1.15rem;
  font-weight: 400;
  line-height: 1.25;
  color: var(--color-stone-800);
  margin: 0.5rem 0 0.6rem;
}

.nav-dropdown-std-lead {
  font-size: 0.8rem;
  line-height: 1.6;
  color: var(--color-stone-600);
  margin: 0;
}

.nav-dropdown-std-link {
  margin-top: auto;
  padding-top: 1.25rem;
  font-size: 0.72rem;
  letter-spacing: 0.03em;
  font-family: var(--font-sans);
  color: var(--color-gold-600);
  text-decoration: none;
  white-space: nowrap;
}

.nav-dropdown-std-link:hover { color: var(--color-gold-700); }

.nav-dropdown-links {
  padding: 1.25rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
}

.nav-dropdown-group { }

.nav-dropdown-group-heading {
  font-size: 0.6rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  font-family: var(--font-sans);
  color: var(--color-stone-400);
  margin: 0 0 0.35rem;
}

.nav-dropdown-item {
  display: block;
  padding: 0.22rem 0;
  font-size: 0.82rem;
  font-family: var(--font-sans);
  color: var(--color-stone-700);
  text-decoration: none;
  transition: color 0.15s;
  white-space: nowrap;
}

.nav-dropdown-item:hover,
.nav-dropdown-item--active {
  color: var(--color-gold-600);
}

/* Right side */
.nav-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.nav-phone {
  font-size: 0.62rem;
  letter-spacing: 0.08em;
  font-family: var(--font-sans);
  text-decoration: none;
  color: var(--color-stone-500);
  transition: color 0.2s;
  white-space: nowrap;
}

.nav-phone:hover { color: var(--color-gold-600); }

.nav-cta {
  display: inline-flex;
  align-items: center;
  font-size: 0.72rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-family: var(--font-sans);
  text-decoration: none;
  padding: 0.6rem 1.1rem;
  border: 1px solid var(--color-gold-500);
  color: var(--color-gold-700);
  transition: border-color 0.25s, color 0.25s, background 0.25s;
  white-space: nowrap;
}

.nav-cta-short { display: inline; }
.nav-cta-full { display: none; }

@media (min-width: 1200px) {
  .nav-cta-short { display: none; }
  .nav-cta-full { display: inline; }
}

/* Medium laptops: tighten so the six items still fit comfortably */
@media (max-width: 1279px) {
  .nav-links { gap: 0.6rem; }
  .nav-group-btn { padding: 0.5rem 0.3rem; font-size: 0.76rem; }
}

/* Wider screens: let the nav breathe */
@media (min-width: 1280px) {
  .nav-links { gap: 1.1rem; }
  .nav-group-btn { padding: 0.6rem 0.5rem; font-size: 0.9rem; }
  .nav-cta { font-size: 0.78rem; padding: 0.65rem 1.25rem; }
}

.nav-cta:hover {
  background: var(--color-gold-500);
  color: white;
}

/* Hamburger */
.nav-hamburger {
  display: none;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 5px;
  width: 2.25rem;
  height: 2.25rem;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.25rem;
  flex-shrink: 0;
}

.nav-hamburger span {
  display: block;
  width: 22px;
  height: 1.5px;
  background: var(--color-stone-700);
  transition: transform 0.3s ease, opacity 0.3s ease;
  transform-origin: center;
}

.nav-hamburger.is-open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
.nav-hamburger.is-open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
.nav-hamburger.is-open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

/* Mobile fullscreen menu */
.nav-mobile-menu {
  position: fixed;
  inset: 0;
  z-index: 99;
  background: #fdfaf3;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-8px);
  transition: opacity 0.3s ease, transform 0.3s ease, visibility 0s 0.3s;
  overflow-y: auto;
}

.nav-mobile-menu.is-open {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  transition: opacity 0.3s ease, transform 0.3s ease, visibility 0s 0s;
}

.nav-mobile-inner {
  display: flex;
  flex-direction: column;
  min-height: 100%;
  padding: 5.5rem 6vw 3rem;
}

.nav-mobile-links {
  display: flex;
  flex-direction: column;
  flex: 1;
}

/* Mobile accordion groups */
.nav-mobile-group {
  border-bottom: 1px solid var(--color-stone-100);
}

.nav-mobile-group-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-family: var(--font-serif);
  font-size: 1.7rem;
  font-weight: 300;
  color: var(--color-stone-800);
  padding: 0.85rem 0;
  cursor: pointer;
  list-style: none;
  user-select: none;
}

.nav-mobile-group-label::-webkit-details-marker { display: none; }

.nav-mobile-group-text {
  display: flex;
  flex-direction: column;
  line-height: 1.2;
}

.nav-mobile-group-primary {
  font-family: var(--font-serif);
  font-size: 1.7rem;
  font-weight: 300;
  color: inherit;
}

.nav-mobile-group-sub {
  font-family: var(--font-sans);
  font-size: 0.58rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-stone-400);
  margin-top: 3px;
}

.nav-mobile-group[open] .nav-mobile-group-label {
  color: var(--color-gold-600);
}

.nav-mobile-chevron {
  width: 1rem;
  height: 1rem;
  flex-shrink: 0;
  transition: transform 0.25s;
  color: var(--color-stone-400);
}

.nav-mobile-group[open] .nav-mobile-chevron {
  transform: rotate(180deg);
  color: var(--color-gold-500);
}

.nav-mobile-children {
  display: flex;
  flex-direction: column;
  padding-bottom: 0.5rem;
}

.nav-mobile-child {
  font-family: var(--font-sans);
  font-size: 0.65rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-stone-500);
  text-decoration: none;
  padding: 0.6rem 0 0.6rem 1rem;
  border-left: 2px solid var(--color-stone-100);
  transition: color 0.2s, border-color 0.2s, padding-left 0.2s;
}

.nav-mobile-child:hover,
.nav-mobile-child:active {
  color: var(--color-gold-600);
  border-left-color: var(--color-gold-400);
  padding-left: 1.3rem;
}

.nav-mobile-subgroup { padding-top: 0.4rem; }

.nav-mobile-subgroup-heading {
  font-family: var(--font-sans);
  font-size: 0.56rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-stone-400);
  margin: 0 0 0.3rem;
}

.nav-mobile-bottom {
  margin-top: 3rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.nav-mobile-phone {
  font-size: 0.72rem;
  letter-spacing: 0.1em;
  color: var(--color-stone-400);
  font-family: var(--font-sans);
  text-decoration: none;
  text-align: center;
  padding: 0.75rem;
  border: 1px solid var(--color-stone-200);
  transition: color 0.2s;
}

.nav-mobile-phone:hover { color: var(--color-gold-600); }

.nav-mobile-cta { display: flex; justify-content: center; }

/* Responsive */
@media (max-width: 1024px) {
  .site-nav { padding: 0 5vw; }
  .nav-links,
  .nav-phone,
  .nav-cta { display: none; }
  .nav-hamburger { display: flex; }
}
</style>

<script>
  const header = document.getElementById('site-header');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 40) header?.classList.add('nav--solid');
    else header?.classList.remove('nav--solid');
  }, { passive: true });

  const hamburger = document.getElementById('nav-hamburger');
  const mobileMenu = document.getElementById('nav-mobile-menu');

  const openMenu = () => {
    hamburger?.classList.add('is-open');
    mobileMenu?.classList.add('is-open');
    hamburger?.setAttribute('aria-expanded', 'true');
    mobileMenu?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  };

  const closeMenu = () => {
    hamburger?.classList.remove('is-open');
    mobileMenu?.classList.remove('is-open');
    hamburger?.setAttribute('aria-expanded', 'false');
    mobileMenu?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  };

  hamburger?.addEventListener('click', () => {
    hamburger.classList.contains('is-open') ? closeMenu() : openMenu();
  });

  mobileMenu?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
</script>
