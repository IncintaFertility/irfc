<style>
/* ═══ HERO ═══ */
.idx-hero {
  position: relative;
  height: 100vh;
  min-height: 600px;
  overflow: hidden;
}

.idx-hero-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: right center;
}

.idx-hero-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(to bottom, rgba(8,5,2,0.55) 0%, rgba(8,5,2,0.2) 18%, transparent 32%, transparent 40%, rgba(8,5,2,0.42) 62%, rgba(8,5,2,0.82) 100%),
    linear-gradient(to right, rgba(8,5,2,0.18) 0%, rgba(8,5,2,0.06) 45%, transparent 70%);
}

.idx-hero-top {
  position: absolute;
  top: 7rem;
  left: 10vw;
  z-index: 2;
}

.idx-hero-eyebrow {
  display: flex;
  align-items: center;
  gap: 1rem;
  font-size: 0.56rem;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.75);
  font-family: var(--font-sans);
}

.idx-hero-line {
  display: inline-block;
  width: 2.5rem;
  height: 1px;
  background: var(--color-gold-400);
  flex-shrink: 0;
}

.idx-hero-body {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 2;
  padding: 0 10vw 5rem;
}

.idx-hero-h1 {
  font-family: var(--font-serif);
  font-weight: 300;
  line-height: 0.88;
  color: white;
  margin-bottom: 3rem;
  letter-spacing: -0.015em;
}

.idx-hero-h1 span {
  display: block;
  font-size: clamp(3.2rem, 7.2vw, 9rem);
}

.idx-hero-h1 em {
  font-style: italic;
  color: var(--color-gold-400);
  font-size: inherit;
}

.idx-hero-ctas {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.idx-ghost-btn {
  display: inline-flex;
  align-items: center;
  border: 1px solid rgba(255,255,255,0.4);
  color: rgba(255,255,255,0.9);
  padding: 0.875rem 2rem;
  font-size: 0.75rem;
  letter-spacing: 0.12em;
  text-decoration: none;
  text-transform: uppercase;
  font-family: var(--font-sans);
  transition: border-color 0.25s;
}

.idx-ghost-btn:hover { border-color: rgba(255,255,255,0.7); }

/* ═══ STATS STRIP ═══ */
.idx-stats {
  display: flex;
  background: #fdfaf3;
  border-bottom: 1px solid #e7e4df;
}

.idx-stat {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  padding: 1.75rem 2.75rem;
  border-right: 1px solid #e7e4df;
  flex: 1;
}

.idx-stat strong {
  font-family: var(--font-serif);
  font-size: 1.75rem;
  font-weight: 300;
  color: var(--color-gold-600);
}

.idx-stat--purple strong { color: var(--color-purple-400); }

.idx-stat span {
  font-size: 0.55rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-stone-400);
  font-family: var(--font-sans);
}

/* ═══ RESPONSIVE ═══ */
@media (max-width: 768px) {
  .idx-hero-bg { object-position: 85% center; }
  .idx-hero-body { padding: 0 5vw 3.5rem; }
  .idx-hero-top { left: 5vw; top: 6rem; }
  .idx-hero-h1 { margin-bottom: 2rem; }

  .idx-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .idx-stat { padding: 1.25rem 1.5rem; flex: unset; }
}

@media (max-width: 480px) {
  .idx-hero-h1 span { font-size: clamp(2.6rem, 11vw, 3.2rem); }
}
</style>
