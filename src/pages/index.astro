---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const stats = [
  { number: '20+', label: 'Years of Excellence' },
  { number: '5', label: 'Southern California Clinics' },
  { number: '#1', label: 'US IVF Success Rate, 2016' },
  { number: 'Free', label: 'Initial Consultation' },
];

const services = [
  {
    icon: '◈',
    title: 'In Vitro Fertilization',
    abbr: 'IVF',
    desc: 'Advanced IVF with EmbryoScope+ monitoring and AI-assisted embryo selection for the highest success rates.',
    href: '/services/ivf',
  },
  {
    icon: '◇',
    title: 'Fertility Preservation',
    abbr: 'Egg & Embryo Freezing',
    desc: 'Preserve your fertility future with state-of-the-art vitrification technology secured in the TMRW Vault.',
    href: '/services/egg-freezing',
  },
  {
    icon: '◉',
    title: 'Genetic Testing',
    abbr: 'PGT',
    desc: 'Preimplantation Genetic Testing to identify the healthiest embryos before transfer, maximizing success.',
    href: '/services/pgt',
  },
  {
    icon: '◎',
    title: 'Donors & Surrogacy',
    abbr: 'Third-Party Reproduction',
    desc: 'Comprehensive support for egg donation and gestational surrogacy, including LGBTQIA+ family building.',
    href: '/services#donors',
  },
  {
    icon: '○',
    title: 'Intrauterine Insemination',
    abbr: 'IUI',
    desc: 'A minimally invasive first-line fertility treatment for select candidates, guided by expert diagnostics.',
    href: '/services/iui',
  },
  {
    icon: '◐',
    title: 'Surgical Services',
    abbr: 'Minimally Invasive',
    desc: 'Diagnostic and therapeutic procedures including hysteroscopy and laparoscopy at accredited surgery centers.',
    href: '/services#surgical',
  },
];

const team = [
  {
    name: 'James P. Lin, MD',
    role: 'Founder & Medical Director',
    bio: 'Award-winning reproductive endocrinologist with 20+ years of expertise. Founder of RFC and architect of IRFC\'s patient-first model of care.',
    initial: 'J',
    color: 'gold',
    photo: '/images/team/dr-james-lin-circle.png',
  },
  {
    name: 'Zitao Liu, MD',
    role: 'Associate Chief Medical Officer',
    bio: 'Fertility specialist pioneering mild stimulation protocols and AI-assisted reproductive tools. Now accepting new patients.',
    initial: 'Z',
    color: 'purple',
    photo: '/images/team/dr-zitao-liu-circle.png',
  },
  {
    name: 'Yufen Xie, PhD',
    role: 'IVF Laboratory Director',
    bio: 'Led the team ranked #1 in US IVF success rates in 2016. Brings world-class embryology expertise to every case.',
    initial: 'Y',
    color: 'gold',
    photo: '/images/team/dr-yufen-xie.png',
  },
];

const recognitions = [
  'Kaiser Permanente Center of Excellence',
  'Top IVF Center — California, IVF Authority',
  'Fairfax EggBank Premier Partner',
  'Highly Rated on FertilityIQ',
];

const testimonials = [
  {
    quote: "After three and a half years of trying, I finally found a team that never gave up on us. IRFC made my dream of having a family come true. I can't imagine having gone through this journey anywhere else.",
    name: 'Mary T.',
    treatment: 'IVF',
    color: 'gold',
  },
  {
    quote: "As a same-sex couple, we needed a clinic that truly understood our path. The reciprocal IVF process was explained so clearly, and every step felt supported. We are now holding our daughter thanks to this incredible team.",
    name: 'Lisa & Elsien',
    treatment: 'Reciprocal IVF',
    color: 'purple',
  },
  {
    quote: "I started with IUI and when that didn't work, Dr. Lin's team moved us to IVF with complete compassion — no pressure, just clear guidance. Five months later, I'm almost 9 weeks pregnant. We are overjoyed.",
    name: 'Anonymous Patient',
    treatment: 'IUI → IVF',
    color: 'gold',
  },
  {
    quote: "At 41, I was told my chances were around 10%. Dr. Lin was honest with me, which I appreciated more than false hope. He designed a protocol specifically for me — and it worked. My baby is now 6 months old.",
    name: 'Patient, Age 41',
    treatment: 'IVF',
    color: 'gold',
  },
];
---

<Layout
  title="Southern California IVF & Fertility Specialists"
  description="IRFC — Award-winning IVF and fertility care across Southern California. The union of Incinta Fertility and Reproductive Fertility Center. Free initial consultations. 5 locations."
>
  <Nav />

  <!-- Hero — full-bleed dark vignette, bottom-anchored text -->
  <section class="idx-hero">
    <img src="/images/lobby-wide.jpg" alt="IRFC Clinic" class="idx-hero-bg" />
    <div class="idx-hero-overlay"></div>

    <div class="idx-hero-top">
      <span class="idx-hero-eyebrow">
        <span class="idx-hero-line"></span>
        Incinta Fertility &nbsp;·&nbsp; Reproductive Fertility Center &nbsp;·&nbsp; Southern California
      </span>
    </div>

    <div class="idx-hero-body">
      <h1 class="idx-hero-h1">
        <span>Where</span>
        <span>Science <em>Meets</em></span>
        <span>Compassion.</span>
      </h1>
      <div class="idx-hero-ctas">
        <a href="/contact" class="btn-primary">
          Schedule a Free Consultation
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a href="/about" class="idx-ghost-btn">Our Story</a>
      </div>
    </div>
  </section>

  <!-- Stats strip -->
  <div class="idx-stats">
    <div class="idx-stat">
      <strong>20+</strong><span>Years of Excellence</span>
    </div>
    <div class="idx-stat idx-stat--purple">
      <strong>#1</strong><span>US IVF Lab · 2016</span>
    </div>
    <div class="idx-stat">
      <strong>5</strong><span>SoCal Locations</span>
    </div>
    <div class="idx-stat">
      <strong>Free</strong><span>Initial Consultation</span>
    </div>
  </div>

  <!-- The Union -->
  <section class="overflow-hidden" style="background: var(--color-stone-50);">
    <div class="lg:grid lg:grid-cols-2">
      <!-- Image: full-height left column -->
      <div class="relative hidden lg:block" style="min-height: 640px;">
        <img
          src="/images/lobby-detail.jpg"
          alt="IRFC clinic interior"
          class="absolute inset-0 w-full h-full object-cover"
        />
      </div>
      <!-- Text + stats right column -->
      <div class="py-24 lg:py-28 px-6 lg:px-16">
        <div class="max-w-xl">
          <div class="section-divider mb-6"></div>
          <h2 style="font-family: var(--font-serif);" class="text-4xl md:text-5xl font-light text-stone-800 mb-6">
            A New Chapter<br/>
            <em class="not-italic" style="color: var(--color-purple-400);">in Fertility Care</em>
          </h2>
          <p class="text-stone-600 leading-relaxed mb-5">
            IRFC was born from the union of two pioneering fertility centers: <strong style="color: var(--color-purple-500); font-weight: 500;">Incinta Fertility</strong> and <strong class="text-stone-800 font-medium">Reproductive Fertility Center (RFC)</strong>. Together, we bring over two decades of combined clinical excellence, a nationally top-ranked IVF laboratory, and a philosophy that sees every patient as a whole person.
          </p>
          <p class="text-stone-600 leading-relaxed mb-8">
            Our founder, Dr. James P. Lin, built RFC on the belief that a fertility clinic should feel like "both a family and a home." That spirit now lives within IRFC.
          </p>
          <a href="/about" class="btn-outline">Learn Our Story</a>
          <div class="grid grid-cols-2 gap-8 mt-12 pt-10 border-t border-stone-200">
            {stats.map(stat => (
              <div>
                <p class="text-3xl lg:text-4xl font-light mb-1" style={`font-family: var(--font-serif); color: var(--color-gold-600);`}>{stat.number}</p>
                <p class="text-xs" style="color: var(--color-stone-400);">{stat.label}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-24 lg:py-32 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="text-center mb-16">
        <div class="flex items-center justify-center gap-3 mb-5">
          <div class="h-px w-12" style="background: linear-gradient(90deg, transparent, var(--color-gold-500));"></div>
          <span class="text-xs tracking-widest uppercase" style="color: var(--color-stone-400); font-family: var(--font-sans);">Treatments &amp; Services</span>
          <div class="h-px w-12" style="background: linear-gradient(90deg, var(--color-gold-500), transparent);"></div>
        </div>
        <h2 style="font-family: var(--font-serif);" class="text-4xl md:text-5xl font-light text-stone-800">
          Comprehensive Fertility Care
        </h2>
      </div>

      <!-- Featured: IVF -->
      <div class="overflow-hidden border border-stone-200 lg:grid lg:grid-cols-2 mb-3">
        <div class="relative" style="min-height: 400px;">
          <img src="/images/transfer-room.jpg" alt="IVF transfer suite" class="absolute inset-0 w-full h-full object-cover" />
        </div>
        <div class="p-10 lg:p-14 bg-white flex flex-col justify-center">
          <p class="text-xs tracking-widest uppercase mb-3" style="color: var(--color-stone-400); font-family: var(--font-sans);">Assisted Reproductive Technology</p>
          <h3 class="text-3xl font-light text-stone-800 mb-4" style="font-family: var(--font-serif);">In Vitro Fertilization</h3>
          <p class="text-sm text-stone-500 leading-relaxed mb-8">Advanced IVF with EmbryoScope+ monitoring and AI-assisted embryo selection. Our lab ranked #1 in US IVF success rates in 2016.</p>
          <a href="/services/ivf" class="btn-primary self-start">IVF Details
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>

      <!-- Featured: Egg Freezing (reversed) -->
      <div class="overflow-hidden border border-stone-200 lg:grid lg:grid-cols-2 mb-6">
        <div class="p-10 lg:p-14 bg-stone-50 flex flex-col justify-center order-2 lg:order-1">
          <p class="text-xs tracking-widest uppercase mb-3" style="color: var(--color-stone-400); font-family: var(--font-sans);">Fertility Preservation</p>
          <h3 class="text-3xl font-light text-stone-800 mb-4" style="font-family: var(--font-serif);">Egg & Embryo Freezing</h3>
          <p class="text-sm text-stone-500 leading-relaxed mb-8">Preserve your fertility future with vitrification technology secured in the TMRW Vault with 24/7 RFID monitoring.</p>
          <a href="/services/egg-freezing" class="btn-outline self-start">Preservation Details
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
        <div class="relative order-1 lg:order-2" style="min-height: 400px;">
          <img src="/images/patient-portrait.jpg" alt="Fertility preservation patient" class="absolute inset-0 w-full h-full object-cover object-top" />
        </div>
      </div>

      <!-- Remaining 4 services -->
      <div class="grid md:grid-cols-2 gap-px" style="background: var(--color-stone-100);">
        {services.slice(2).map(service => (
          <a href={service.href} class="group bg-white p-10 lg:p-12 flex flex-col">
            <p class="text-xs tracking-widest uppercase mb-3" style={`color: var(--color-stone-400); font-family: var(--font-sans);`}>{service.abbr}</p>
            <h3 class="text-xl font-light mb-3 flex-1" style={`font-family: var(--font-serif); color: var(--color-stone-800);`}>{service.title}</h3>
            <p class="text-sm leading-relaxed mb-6" style="color: var(--color-stone-500);">{service.desc}</p>
            <div class="flex items-center gap-2 text-xs tracking-wider uppercase" style={`color: var(--color-gold-600);`}>
              <span>Learn more</span>
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-10 text-center">
        <a href="/services" class="btn-outline">View All Services</a>
      </div>
    </div>
  </section>

  <!-- Three Pillars -->
  <section class="py-24 lg:py-32 bg-white border-y border-stone-100">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="text-center mb-16">
        <div class="flex items-center justify-center gap-3 mb-5">
          <div class="h-px w-12" style="background: linear-gradient(90deg, transparent, var(--color-gold-500));"></div>
          <span class="text-xs tracking-widest uppercase" style="color: var(--color-stone-400); font-family: var(--font-sans);">Our Foundation</span>
          <div class="h-px w-12" style="background: linear-gradient(90deg, var(--color-gold-500), transparent);"></div>
        </div>
        <h2 style="font-family: var(--font-serif);" class="text-4xl md:text-5xl font-light text-stone-800">
          Built on Three Pillars
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-px" style="background: var(--color-stone-100);">
        {[
          {
            title: 'Safety',
            desc: 'State-of-the-art technology in professionally accredited surgery centers. Every procedure follows the highest clinical standards.',
            num: '01',
          },
          {
            title: 'Quality',
            desc: 'CAP-certified laboratories staffed by world-class embryologists. Excellence isn\'t a goal — it\'s our standard.',
            num: '02',
          },
          {
            title: 'Integrity',
            desc: 'Award-winning, internationally-renowned physicians who lead with transparency, authenticity, and unwavering dedication.',
            num: '03',
          },
        ].map((pillar) => (
          <div class="bg-white p-10 lg:p-14">
            <p class="text-6xl font-light mb-8 leading-none" style="font-family: var(--font-serif); color: var(--color-gold-200);">{pillar.num}</p>
            <h3 class="text-2xl font-light text-stone-800 mb-4" style="font-family: var(--font-serif);">{pillar.title}</h3>
            <div class="w-8 h-px mb-6" style="background: var(--color-gold-500);"></div>
            <p class="text-sm leading-relaxed text-stone-500">{pillar.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Team Preview -->
  <section class="py-24 lg:py-32" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-2 gap-16 items-start">
        <div class="lg:sticky" style="top: 8rem;">
          <div class="section-divider mb-6"></div>
          <h2 style="font-family: var(--font-serif);" class="text-4xl md:text-5xl font-light text-stone-800 mb-6">
            Expert Physicians.<br/>
            <em class="not-italic" style="color: var(--color-purple-400);">Trusted Partners.</em>
          </h2>
          <a href="/team" class="btn-primary">Meet the Full Team</a>
        </div>

        <div class="space-y-4">
          {team.map((member) => (
            <div class="bg-white border border-stone-200 overflow-hidden card-hover">
              <div class="grid grid-cols-3">
                <div class="relative" style="min-height: 180px;">
                  {member.photo ? (
                    <img
                      src={member.photo}
                      alt={member.name}
                      class="absolute inset-0 w-full h-full object-cover object-top"
                    />
                  ) : (
                    <div
                      class="absolute inset-0 flex items-center justify-center text-2xl font-light text-white"
                      style={`background: linear-gradient(135deg, var(--color-${member.color}-500), var(--color-${member.color}-700));`}
                    >
                      {member.initial}
                    </div>
                  )}
                </div>
                <div class="col-span-2 p-6 flex flex-col justify-center">
                  <h3 class="text-xl font-light text-stone-800 mb-1" style="font-family: var(--font-serif);">{member.name}</h3>
                  <p class="text-xs tracking-wider uppercase mb-3" style={`color: var(--color-${member.color}-600); font-family: var(--font-sans);`}>{member.role}</p>
                  <p class="text-sm text-stone-500 leading-relaxed">{member.bio}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Recognition Bar -->
  <section class="py-10 bg-white border-y border-stone-100">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="flex flex-col lg:flex-row items-center gap-6 lg:gap-12">
        <p class="text-xs tracking-widest uppercase flex-shrink-0 lg:w-36 text-center lg:text-left" style="color: var(--color-stone-400); font-family: var(--font-sans);">
          Recognized<br/>Excellence
        </p>
        <div class="h-px w-full lg:h-12 lg:w-px" style="background: var(--color-stone-200);"></div>
        <div class="flex flex-wrap justify-center lg:justify-start gap-x-10 gap-y-3">
          {recognitions.map(rec => (
            <div class="flex items-center gap-2">
              <svg class="w-3 h-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" style="color: var(--color-gold-500);">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
              <span class="text-sm" style="color: var(--color-stone-500);">{rec}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Advanced Technology -->
  <section class="overflow-hidden" style="background: var(--color-stone-50);">
    <div class="lg:grid lg:grid-cols-2">
      <!-- Text column -->
      <div class="py-24 lg:py-28 px-6 lg:px-16">
        <div class="max-w-xl">
          <div class="section-divider mb-6"></div>
          <h2 style="font-family: var(--font-serif);" class="text-4xl md:text-5xl font-light text-stone-800 mb-14">
            Advanced Laboratory Technology
          </h2>
          <div class="space-y-8">
            {[
              { name: 'EmbryoScope+', desc: 'Time-lapse incubation with continuous embryo monitoring — without disturbing the culture environment.' },
              { name: 'RI Witness™', desc: 'RFID electronic witnessing that ensures biological samples are precisely matched to patients at every IVF step.' },
              { name: 'TMRW Vault', desc: 'Military-grade cryogenic storage with 24/7 real-time monitoring and full traceability for frozen eggs and embryos.' },
            ].map(tech => (
              <div class="flex gap-6 items-start">
                <div class="flex-shrink-0 w-10 h-10 flex items-center justify-center border" style="border-color: var(--color-gold-400);">
                  <div class="w-2.5 h-2.5" style="background: var(--color-gold-500);"></div>
                </div>
                <div>
                  <h3 class="text-lg font-light text-stone-800 mb-1" style="font-family: var(--font-serif);">{tech.name}</h3>
                  <p class="text-sm leading-relaxed" style="color: var(--color-stone-500);">{tech.desc}</p>
                </div>
              </div>
            ))}
          </div>
          <a href="/technology" class="btn-outline mt-12 inline-flex items-center gap-2">
            See Our Technology
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>
      <!-- Image column -->
      <div class="relative hidden lg:block" style="min-height: 580px;">
        <img
          src="/images/surgery-center.jpg"
          alt="IRFC laboratory"
          class="absolute inset-0 w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Locations -->
  <section class="py-24 lg:py-32 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-3 gap-12 items-start">
        <div>
          <div class="section-divider mb-6"></div>
          <h2 style="font-family: var(--font-serif);" class="text-4xl font-light text-stone-800 mb-4">
            Five Locations<br/>Across Southern<br/>California
          </h2>
          <p class="text-sm leading-relaxed mb-8" style="color: var(--color-stone-500);">
            With clinics in Torrance, Alhambra, Beverly Hills, Corona, and Irvine, expert fertility care is always within reach.
          </p>
          <a href="/locations" class="btn-outline">Find a Location</a>
        </div>

        <div class="lg:col-span-2 grid sm:grid-cols-2 gap-4">
          {[
            { city: 'Torrance', code: 'CA', phone: '(424) 212-4087', types: 'Clinic' },
            { city: 'Alhambra', code: 'CA', phone: '(626) 588-2885', types: 'Clinic' },
            { city: 'Beverly Hills', code: 'CA', phone: '(213) 600-8088', types: 'Clinic' },
            { city: 'Corona', code: 'CA', phone: '(951) 272-2221', types: 'Clinic · Surgery · Lab' },
            { city: 'Irvine', code: 'CA', phone: '(949) 453-8600', types: 'Clinic · Surgery · Lab' },
          ].map(loc => (
            <a href="/locations" class="group p-6 border border-stone-200 block" style="transition: border-color 0.2s;">
              <div class="flex items-start justify-between mb-4">
                <div>
                  <h3 class="text-lg font-light text-stone-800" style="font-family: var(--font-serif);">{loc.city}</h3>
                  <p class="text-xs" style="color: var(--color-stone-400);">{loc.code}</p>
                </div>
                <svg class="w-4 h-4 mt-1" style="color: var(--color-stone-300);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
              <p class="text-xs mb-2" style="color: var(--color-stone-400);">{loc.types}</p>
              <p class="text-sm" style="color: var(--color-gold-600);">{loc.phone}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Inclusive Care -->
  <section class="py-24 lg:py-32 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="grid md:grid-cols-2 gap-6">
        <div class="p-10 lg:p-12 border border-stone-200 bg-stone-50">
          <div class="w-8 h-px mb-8" style="background: var(--color-purple-400);"></div>
          <h3 class="text-2xl font-light text-stone-800 mb-4" style="font-family: var(--font-serif);">LGBTQIA+ Family Building</h3>
          <p class="text-sm leading-relaxed mb-8 text-stone-500">
            Inclusive, affirming care for same-sex couples and single individuals — sperm donation, egg donation, and gestational surrogacy.
          </p>
          <a href="/services#lgbtqia" class="text-xs tracking-widest uppercase flex items-center gap-2" style="color: var(--color-gold-600);">
            Learn More
