---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const stats = [
  { number: '20+', label: 'Years of Excellence' },
  { number: '5', label: 'Southern California Clinics' },
  { number: '#1', label: 'US IVF Success Rate, 2016' },
  { number: '5', label: 'Languages Spoken' },
];



const recognitions = [
  'Kaiser Permanente Center of Excellence',
  'Top IVF Center — California, IVF Authority',
  'Fairfax EggBank Premier Partner',
  'Highly Rated on FertilityIQ',
];



---

<Layout
  title="Southern California IVF & Fertility Specialists"
  description="INCINTA — Life Is the Ultimate Art. Award-winning IVF and fertility care across Southern California at Incinta Reproductive Fertility Center (IRFC). 5 locations."
>
  <Nav />

  <!-- 01 / HERO — First impression should convey the brand, not a row of treatment buttons -->
  <section class="idx-hero">
    <video class="idx-hero-bg" autoplay muted loop playsinline preload="auto" poster="/images/lobby-wide.webp">
      <source src="/videos/brand-promo.mp4" type="video/mp4" />
    </video>
    <div class="idx-hero-overlay"></div>

    <div class="idx-hero-body">
      <h1 class="idx-hero-h1">
        <span>Life Is</span>
        <span>the <em>Ultimate</em> Art.</span>
      </h1>
      <div class="idx-hero-ctas">
        <a href="/contact" class="btn-primary">
          Schedule a Consultation
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a href="/about" class="idx-ghost-btn">Our Story</a>
      </div>
    </div>
  </section>

  <!-- 02 / Meaning — The Meaning of Life: deep interpretation & value -->
  <section class="idx-meaning" aria-label="The Meaning of Life">
    <div class="idx-meaning-inner">
      <p class="idx-meaning-eyebrow">02 / Meaning</p>
      <h2 class="idx-meaning-title">
        <span class="idx-meaning-en">Every life deserves an extraordinary beginning</span>
      </h2>
      <div class="idx-meaning-body">
        <p class="idx-meaning-lead">
          <span class="en">A thought blooms. The future is already within.</span>
        </p>
        <p>
          <span class="en">Every life begins with a thought of the future.</span>
        </p>
        <p>
          <span class="en">The moment you imagine a child, that story has already begun.</span>
        </p>
        <p class="idx-meaning-lotus">
          <span class="en">Like the lotus&mdash;when the flower blooms, the fruit is already within.</span>
        </p>
      </div>
    </div>
  </section>

  <!-- 03 / The INCINTA Standard — six standards as alternating editorial rows -->
  <section class="idx-standards" aria-label="The INCINTA Standard">
    <div class="idx-standards-head max-w-screen-xl mx-auto px-6 lg:px-10">
      <p class="idx-standards-eyebrow">03 / The INCINTA Standard</p>
      <h2 class="idx-standards-title">Six standards help patients establish their own criteria.</h2>
      <p class="idx-standards-lead">A fertility center worth trusting should pass six tests. These are the standards we help every patient hold their care to.</p>
    </div>

    <div class="idx-standards-rows max-w-screen-xl mx-auto px-6 lg:px-10">
      <article class="std-row">
        <div class="std-row-media">
          <img src="/images/standards/01-collective-expertise.jpg" alt="INCINTA reception and care team welcoming patients" loading="lazy" decoding="async" />
        </div>
        <div class="std-row-body">
          <span class="std-row-index">01</span>
          <h3 class="std-row-title">Collective expertise</h3>
          <p class="std-row-lead">One patient. The expertise of an entire team.</p>
          <p class="std-row-text">When a patient chooses INCINTA, the strength of our entire team carries that trust&mdash;together, we strive for the best possible outcome.</p>
        </div>
      </article>

      <article class="std-row">
        <div class="std-row-media">
          <img src="/images/standards/02-precision-personalization.jpg" alt="Hands poised in careful movement, representing personalized care" loading="lazy" decoding="async" />
        </div>
        <div class="std-row-body">
          <span class="std-row-index">02</span>
          <h3 class="std-row-title">Precision &amp; personalization</h3>
          <p class="std-row-lead">No two patients are the same. Their care shouldn't be either.</p>
          <p class="std-row-text">Care is never one-size-fits-all. It is a plan crafted for your life.</p>
        </div>
      </article>

      <article class="std-row">
        <div class="std-row-media">
          <img src="/images/standards/03-lab-excellence.jpg" alt="INCINTA embryology laboratory with advanced equipment" loading="lazy" decoding="async" />
        </div>
        <div class="std-row-body">
          <span class="std-row-index">03</span>
          <h3 class="std-row-title">Laboratory excellence</h3>
          <p class="std-row-lead">Where life begins, standards matter most.</p>
          <p class="std-row-text">With exacting rigor in every laboratory detail, we safeguard every extraordinary beginning.</p>
        </div>
      </article>

      <article class="std-row">
        <div class="std-row-media">
          <img src="/images/standards/04-privacy-transparency.jpg" alt="Glass staircase in the INCINTA clinic" loading="lazy" decoding="async" />
        </div>
        <div class="std-row-body">
          <span class="std-row-index">04</span>
          <h3 class="std-row-title">Privacy &amp; transparency</h3>
          <p class="std-row-lead">Private, yet completely open.</p>
          <p class="std-row-text">Your body and choices remain absolutely private; our standards and processes are completely open. True trust is built through clear boundaries.</p>
        </div>
      </article>

      <article class="std-row">
        <div class="std-row-media">
          <img src="/images/standards/05-art-of-care.jpg" alt="A warm, supportive conversation between patient and care team" loading="lazy" decoding="async" />
        </div>
        <div class="std-row-body">
          <span class="std-row-index">05</span>
          <h3 class="std-row-title">The art of care</h3>
          <p class="std-row-lead">More than clinical rigor, it holds the beauty of art and the warmth of nature.</p>
          <p class="std-row-text">From the texture of pearl to the imagery of the lotus, from light to material&mdash;a space carefully created for life.</p>
        </div>
      </article>

      <article class="std-row">
        <div class="std-row-media">
          <img src="/images/standards/06-care-within-reach.jpg" alt="A couple welcomed in the INCINTA clinic" loading="lazy" decoding="async" />
        </div>
        <div class="std-row-body">
          <span class="std-row-index">06</span>
          <h3 class="std-row-title">Exceptional care, within reach</h3>
          <p class="std-row-lead">Beyond distance and resources.</p>
          <p class="std-row-text">Exceptional care truly reaches every family in need.</p>
        </div>
      </article>
    </div>
  </section>

  <!-- 04 / Brand DNA — Science, Art, Life: the philosophy behind every standard -->
  <section class="idx-dna" aria-label="Brand DNA">
    <div class="idx-dna-inner max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="idx-dna-head">
        <div class="idx-dna-rule"></div>
        <p class="idx-dna-eyebrow">04 / Brand DNA</p>
        <div class="idx-dna-rule"></div>
      </div>
      <h2 class="idx-dna-title">Science<span class="idx-dna-dot">&middot;</span><span class="idx-dna-art">Art</span><span class="idx-dna-dot">&middot;</span>Life</h2>
      <p class="idx-dna-body">Science makes life possible. Art refines every detail. Life gives every technology its meaning.</p>
      <p class="idx-dna-note">In fertility medicine, ART is both Assisted Reproductive Technology and an art of precision.</p>
    </div>
  </section>

  <!-- 05 / WHY — A beginning of life should be more than a medical procedure -->
  <section id="why" class="py-24 lg:py-32 lotus-watermark" style="background: var(--color-pearl-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="max-w-3xl">
        <p class="brand-eyebrow mb-7">05 / Why INCINTA</p>
        <h2 style="font-family: var(--font-serif);" class="text-4xl md:text-5xl font-light text-stone-800 mb-7 leading-tight">
          The beginning of life deserves<br />
          <em class="not-italic" style="color: var(--color-champagne-600);">more than a medical process.</em>
        </h2>
        <p class="text-lg text-stone-500 font-light leading-relaxed">
          The beginning of life deserves the care of a work of art. True art is never accidental —
          it is shaped by scientific rigor, purposeful environments, meticulous detail,
          and reverence for every possibility of life.
        </p>
      </div>
    </div>
  </section>


  <!-- Recognition Bar -->
  <section class="py-10 bg-white border-y border-stone-100">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="flex flex-col lg:flex-row items-center gap-6 lg:gap-12">
        <p class="text-xs tracking-widest uppercase flex-shrink-0 lg:w-36 text-center lg:text-left" style="color: var(--color-stone-400); font-family: var(--font-sans);">
          Recognized<br/>Excellence
        </p>
        <div class="h-px w-full lg:h-12 lg:w-px" style="background: var(--color-stone-200);"></div>
        <div class="flex flex-wrap justify-center lg:justify-start gap-x-10 gap-y-3">
          {recognitions.map(rec => (
            <div class="flex items-center gap-2">
              <svg class="w-3 h-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" style="color: var(--color-gold-500);">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
              <span class="text-sm" style="color: var(--color-stone-500);">{rec}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 06 / Action -->
  <section class="relative overflow-hidden py-32">
    <img src="/images/couple-clinic.webp" srcset="/images/couple-clinic-800.webp 800w, /images/couple-clinic-1280.webp 1280w, /images/couple-clinic.webp 2292w" sizes="(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 1200px" alt="" class="absolute inset-0 w-full h-full object-cover" aria-hidden="true" />
    <div class="absolute inset-0" style="background: rgba(20,18,15,0.68);"></div>
    <div class="relative z-10 max-w-screen-xl mx-auto px-6 lg:px-10 text-center">
      <div class="max-w-2xl mx-auto">
        <div class="flex items-center justify-center gap-3 mb-6">
          <div class="h-px w-12" style="background: linear-gradient(90deg, transparent, var(--color-gold-500));"></div>
          <span class="text-xs tracking-widest uppercase" style="color: var(--color-gold-400);">06 / Action</span>
          <div class="h-px w-12" style="background: linear-gradient(90deg, var(--color-gold-500), transparent);"></div>
        </div>
        <h2 style="font-family: var(--font-serif);" class="text-4xl md:text-5xl font-light text-white mb-5">
          Your Beginning Starts Here.
        </h2>
        <p class="text-white/70 font-light leading-relaxed mb-9 max-w-xl mx-auto">
          Every Extraordinary Life Deserves an Extraordinary Beginning.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="btn-primary">Schedule a Consultation</a>
          <a href="tel:+19494538600" class="btn-outline" style="border-color: rgba(255,255,255,0.4); color: white;">Call (949) 453-8600</a>
        </div>
        <p class="mt-6 text-xs" style="color: rgba(255,255,255,0.4);">
          Telehealth available. Telehealth options for out-of-area patients.
        </p>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
/* ═══ HERO ═══ */
.idx-hero {
  position: relative;
  height: 100vh;
  height: 100dvh;
  min-height: 600px;
  overflow: hidden;
  background: #0b0710;
}

.idx-hero-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  -webkit-object-fit: cover;
  object-fit: cover;
  object-position: center;
}

.idx-hero-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(to bottom, rgba(8,5,2,0.55) 0%, rgba(8,5,2,0.2) 18%, transparent 32%, transparent 40%, rgba(8,5,2,0.42) 62%, rgba(8,5,2,0.82) 100%),
    linear-gradient(to right, rgba(8,5,2,0.18) 0%, rgba(8,5,2,0.06) 45%, transparent 70%);
}

.idx-hero-body {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 2;
  /* Reserve a bigger bottom band so the CTA clears the video subtitles */
  padding: 0 10vw clamp(6.5rem, 16vh, 11rem);
}

.idx-hero-h1 {
  font-family: var(--font-serif);
  font-weight: 300;
  line-height: 0.88;
  color: white;
  margin-bottom: 3rem;
  letter-spacing: -0.015em;
}

.idx-hero-h1 span {
  display: block;
  font-size: clamp(3.2rem, 7.2vw, 9rem);
  /* Keep the headline to at most two lines on desktop */
  white-space: nowrap;
}

.idx-hero-h1 em {
  font-style: italic;
  color: var(--color-gold-400);
  font-size: inherit;
}

.idx-hero-ctas {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.idx-ghost-btn {
  display: inline-flex;
  align-items: center;
  border: 1px solid rgba(255,255,255,0.4);
  color: rgba(255,255,255,0.9);
  padding: 0.875rem 2rem;
  font-size: 0.75rem;
  letter-spacing: 0.12em;
  text-decoration: none;
  text-transform: uppercase;
  font-family: var(--font-sans);
  transition: border-color 0.25s;
}

.idx-ghost-btn:hover { border-color: rgba(255,255,255,0.7); }

/* ═══ SCREEN 2 — THE MEANING OF LIFE ═══ */
.idx-meaning {
  position: relative;
  padding: 7rem 10vw 8.5rem;
  background:
    linear-gradient(90deg, rgba(251,249,246,0.96) 0%, rgba(251,249,246,0.82) 38%, rgba(251,249,246,0.18) 100%),
    url('/images/meaning-bg.jpg') center right / cover no-repeat;
  background-color: var(--color-pearl-50);
  border-bottom: 1px solid var(--color-pearl-200);
}
.idx-meaning-inner {
  max-width: 62rem;
  margin: 0 auto;
}
.idx-meaning-eyebrow {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin: 0 0 2.75rem;
  font-family: var(--font-sans);
  font-size: 0.7rem;
  letter-spacing: 0.34em;
  text-transform: uppercase;
  color: var(--color-purple-400);
}
.idx-meaning-eyebrow::before {
  content: "";
  width: 2.5rem;
  height: 1px;
  background: var(--color-gold-500);
  flex-shrink: 0;
}
.idx-meaning-title {
  position: relative;
  margin: 0 0 3.75rem;
  padding-bottom: 2.25rem;
  font-family: var(--font-serif);
  font-weight: 400;
  line-height: 1.06;
  color: var(--color-purple-800);
}
.idx-meaning-title::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0;
  width: 4rem;
  height: 1px;
  background: linear-gradient(90deg, var(--color-champagne-500), transparent);
}
.idx-meaning-en {
  display: block;
  font-size: clamp(2.5rem, 5.8vw, 4.9rem);
  letter-spacing: -0.018em;
}
.idx-meaning-body {
  display: flex;
  flex-direction: column;
  gap: 2.5rem;
  max-width: 48rem;
}
.idx-meaning-body p {
  margin: 0;
  line-height: 1.95;
}
.idx-meaning-body .en {
  display: block;
  font-family: var(--font-serif);
  font-style: italic;
  font-size: clamp(1.1rem, 2.1vw, 1.5rem);
  color: var(--color-champagne-600);
}
.idx-meaning-lead .en {
  font-size: clamp(1.35rem, 2.4vw, 1.75rem);
  color: var(--color-champagne-700);
}
.idx-meaning-lotus .en {
  color: var(--color-purple-500);
}

/* ═══ STANDARDS — alternating editorial rows (Screen 3) ═══ */
.idx-standards {
  background: var(--color-pearl-50);
  border-bottom: 1px solid var(--color-pearl-200);
  padding: 6rem 0 7rem;
  overflow: hidden;
}

.idx-standards-eyebrow {
  display: flex;
  align-items: center;
  gap: 0.9rem;
  font-size: 0.6rem;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--color-purple-400);
  font-family: var(--font-sans);
  margin-bottom: 1.25rem;
}
.idx-standards-eyebrow::before {
  content: "";
  width: 2.5rem;
  height: 1px;
  background: var(--color-gold-500);
  flex-shrink: 0;
}

.idx-standards-title {
  font-family: var(--font-serif);
  font-size: clamp(2.1rem, 4.4vw, 3.4rem);
  font-weight: 300;
  line-height: 1.1;
  color: var(--color-purple-800);
  margin: 1.5rem 0 1.25rem;
}

.idx-standards-lead {
  font-size: 1.05rem;
  line-height: 1.7;
  color: var(--color-stone-600);
  max-width: 44rem;
  margin: 0;
}

/* Screen 4 (why) eyebrow — match the numbered-screen purple + gold system */
#why .brand-eyebrow { color: var(--color-purple-400); }

/* Screen 3 — six standards as alternating editorial rows */
.idx-standards-head {
  max-width: 62rem;
  margin: 0 auto 4.5rem;
}

.idx-standards-rows {
  display: flex;
  flex-direction: column;
  gap: 5.5rem;
}

.std-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  align-items: center;
  gap: 4rem;
}

.std-row-media {
  position: relative;
  overflow: hidden;
  border-radius: 18px;
  aspect-ratio: 4 / 3;
  background: var(--color-pearl-100);
}

.std-row-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  filter: saturate(0.9) contrast(1.03) brightness(1.02);
  transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
}

.std-row:hover .std-row-media img { transform: scale(1.045); }

.std-row-body { max-width: 30rem; }

.std-row-index {
  display: block;
  font-family: var(--font-serif);
  font-size: 2.5rem;
  font-weight: 300;
  line-height: 1;
  color: var(--color-purple-400);
  margin-bottom: 0.9rem;
}

.std-row-title {
  font-family: var(--font-serif);
  font-size: clamp(1.55rem, 2.6vw, 2.1rem);
  font-weight: 400;
  line-height: 1.15;
  color: var(--color-purple-800);
  margin: 0 0 1rem;
}

.std-row-lead {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 1.12rem;
  line-height: 1.5;
  color: var(--color-champagne-600);
  margin: 0 0 0.9rem;
}

.std-row-text {
  font-size: 0.98rem;
  line-height: 1.75;
  color: var(--color-stone-600);
  margin: 0;
}

.std-row:nth-child(even) .std-row-media { order: 2; }
.std-row:nth-child(even) .std-row-body { order: 1; }

/* ═══ RESPONSIVE ═══ */
@media (max-width: 1024px) {
  .idx-standards-rows { gap: 4.5rem; }
}

@media (max-width: 768px) {
  .idx-hero {
    height: 70dvh;
    min-height: 460px;
  }
  .idx-hero-bg {
    object-fit: cover;
    object-position: center;
  }
  /* Screen 2 — tighten on phones */
  .idx-meaning { padding: 4.5rem 6vw 5.5rem; }
  .idx-meaning-eyebrow { margin-bottom: 2rem; }
  .idx-meaning-title { margin-bottom: 2.75rem; }
  .idx-meaning-body { gap: 1.5rem; max-width: none; }
  /* Reserve a bigger bottom band so the CTA clears the video subtitles */
  .idx-hero-body { padding: 0 5vw clamp(4.5rem, 14vh, 7rem); }
  .idx-hero-h1 { margin-bottom: 1.5rem; }
  .idx-hero-h1 span { font-size: clamp(2.3rem, 9.5vw, 2.85rem); white-space: nowrap; }
  /* Smaller booking button on phones — don't let it dominate the screen */
  .idx-hero-ctas .btn-primary {
    padding: 0.625rem 1.25rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }
  .idx-ghost-btn {
    padding: 0.75rem 1.75rem;
    font-size: 0.7rem;
  }

  .idx-standards { padding: 3.5rem 0 4.5rem; }
  .idx-standards-rows { gap: 3.5rem; }
  .std-row {
    grid-template-columns: 1fr;
    gap: 1.6rem;
  }
  .std-row:nth-child(even) .std-row-media,
  .std-row:nth-child(even) .std-row-body { order: 0; }
  .std-row-media { aspect-ratio: 16 / 10; }
  .std-row-body { max-width: none; }
}

@media (max-width: 480px) {
  .idx-hero-h1 span { font-size: clamp(2.1rem, 9vw, 2.6rem); }
  /* Keep the booking button compact on the smallest screens */
  .idx-hero-ctas { gap: 0.5rem; }
  .idx-hero-ctas .btn-primary {
    padding: 0.55rem 1rem;
    font-size: 0.65rem;
  }
  .idx-ghost-btn {
    padding: 0.6rem 1.25rem;
    font-size: 0.65rem;
  }
  .idx-meaning { padding: 3.75rem 5vw 4.5rem; }
  .idx-standards-title { font-size: clamp(1.8rem, 8vw, 2.4rem); }
}

  /* ═══ BRAND DNA — Science · Art · Life (Screen 4) ═══ */
  .idx-dna {
    background: var(--color-pearl-50);
    border-bottom: 1px solid var(--color-pearl-200);
    padding: 6.5rem 0 7rem;
    overflow: hidden;
  }
  .idx-dna-inner { text-align: center; }
  .idx-dna-head {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .idx-dna-rule {
    height: 1px;
    width: 3rem;
