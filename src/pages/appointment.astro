---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const locations = [
  { city: 'Torrance', address: '21545 Hawthorne Blvd, Pavilion B, CA 90503', phone: '(424) 432-4732' },
  { city: 'Beverly Hills', address: '8635 W 3rd St, Suite 1170W, Los Angeles, CA 90048', phone: '(424) 432-4732' },
  { city: 'Corona', address: '400 E Rincon St, Suite 108, CA 92879', phone: '(424) 432-4732' },
  { city: 'Irvine', address: '16300 Sand Canyon Ave, 9th Fl, CA 92618', phone: '(424) 432-4732' },
];

const steps = [
  {
    n: '01',
    title: 'Choose your clinic',
    body: 'Select the IRFC location most convenient to you. Every clinic offers the full range of fertility services with the same standard of care.',
  },
  {
    n: '02',
    title: 'Request a consultation',
    body: 'Call our scheduling team, message us on WhatsApp, or sign in to the patient portal. We will match you with the right physician for your goals.',
  },
  {
    n: '03',
    title: 'Meet your care team',
    body: 'At your first visit we review your history, discuss options, and begin building a personalized plan — with warmth and clarity at every step.',
  },
];
---

<Layout
  title="Schedule a Consultation"
  description="Book your fertility consultation at IRFC. Choose from our Southern California clinics and meet a care team built around your goals."
>
  <Nav />

  <!-- Hero -->
  <section class="pt-40 pb-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-6">
          <div class="h-px w-12" style="background: var(--color-gold-500);"></div>
          <span class="text-xs tracking-widest uppercase" style="color: var(--color-gold-600); font-family: var(--font-sans);">Schedule a Consultation</span>
        </div>
        <h1 style="font-family: var(--font-serif);" class="text-5xl md:text-6xl font-light text-stone-800 mb-6 leading-none">
          Begin with<br/>
          <em class="not-italic" style="color: var(--color-gold-500);">a Conversation.</em>
        </h1>
        <p class="text-lg text-stone-500 font-light leading-relaxed max-w-2xl mb-10">
          Every fertility journey starts with a conversation. Tell us your story, and our coordinators will help you take the next step with confidence.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="tel:+14244324732" class="btn-primary inline-flex items-center gap-2">
            Call (424) 432-4732
          </a>
          <a href="https://wa.me/14244324732" target="_blank" rel="noopener noreferrer" class="btn-outline inline-flex items-center gap-2">
            Message Us on WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Steps -->
  <section class="py-20 lg:py-28" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="mb-14">
        <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-stone-400); font-family: var(--font-sans);">How to get started</p>
        <h2 style="font-family: var(--font-serif);" class="text-3xl font-light text-stone-800">Three simple steps</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-10">
        {steps.map(step => (
          <div>
            <p class="text-5xl font-light mb-4" style="font-family: var(--font-serif); color: var(--color-gold-400);">{step.n}</p>
            <h3 style="font-family: var(--font-serif);" class="text-2xl font-light text-stone-800 mb-3">{step.title}</h3>
            <p class="text-sm text-stone-600 leading-relaxed">{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Choose your clinic -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="mb-12">
        <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-stone-400); font-family: var(--font-sans);">Our Clinics</p>
        <h2 style="font-family: var(--font-serif);" class="text-3xl font-light text-stone-800">Choose your location</h2>
        <p class="mt-3 text-sm max-w-xl" style="color: var(--color-stone-500);">
          Southern California clinics, one standard of care. Call any location to schedule, or select directions below.
        </p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {locations.map(loc => (
          <div class="p-8 border border-stone-200 card-hover">
            <div class="flex items-start justify-between gap-4 mb-4">
              <div>
                <h3 style="font-family: var(--font-serif);" class="text-2xl font-light text-stone-800 mb-1">{loc.city}</h3>
                <p class="text-sm text-stone-500 leading-relaxed">{loc.address}</p>
              </div>
              <a
                href={`https://maps.google.com/?q=${encodeURIComponent(loc.address + ', ' + loc.city)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs tracking-widest uppercase flex-shrink-0 mt-1" style="color: var(--color-gold-600);"
              >
                Directions
              </a>
            </div>
            <a href={`tel:${loc.phone.replace(/\D/g,'')}`} class="inline-flex items-center gap-2 text-sm font-medium" style="color: var(--color-gold-600);">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              {loc.city} · {loc.phone}
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Portal / CTA -->
  <section class="py-20 lg:py-28" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10 text-center">
      <h2 style="font-family: var(--font-serif);" class="text-4xl font-light text-stone-800 mb-4">Already a patient?</h2>
      <p class="text-sm leading-relaxed mb-8 max-w-lg mx-auto" style="color: var(--color-stone-500);">
        Sign in to the IRFC patient portal to message your care team, review results, and manage upcoming visits.
      </p>
      <a
        href="/patient-portal"
        class="btn-primary"
      >
        Open Patient Portal
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>
  </section>

  <Footer />
</Layout>
