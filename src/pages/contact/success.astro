---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { BRAND_LANGUAGE, CTA, SITE_PHONE, SITE_PHONE_DISPLAY } from '../../config/brand';
---

<Layout
  title="Request Received"
  description="Your consultation request has been received. A member of the IRFC care team will contact you within one business day."
  noindex
>
  <Nav />

  <section class="lotus-watermark pt-40 pb-28" style="background: var(--color-pearl-50);">
    <div class="max-w-3xl mx-auto px-6 lg:px-10 text-center">

      <div class="flex justify-center mb-8">
        <div
          class="w-16 h-16 rounded-full flex items-center justify-center"
          style="background: var(--color-amethyst-600);"
        >
          <svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
        </div>
      </div>

      <p class="text-xs tracking-widest uppercase mb-5" style="color: var(--color-champagne-600); font-family: var(--font-sans);">
        Request Received
      </p>

      <h1
        style="font-family: var(--font-serif);"
        class="text-4xl md:text-5xl font-light text-stone-800 mb-6 leading-tight"
      >
        Thank you.<br />
        <em class="not-italic" style="color: var(--color-champagne-600);">Your beginning starts here.</em>
      </h1>

      <p class="text-lg text-stone-500 font-light leading-relaxed mb-4 max-w-xl mx-auto">
        A member of our care team will reach out within one business day to schedule your consultation.
      </p>
      <p class="text-sm text-stone-400 font-light leading-relaxed mb-12 max-w-xl mx-auto">
        {BRAND_LANGUAGE.promise.en}
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
        <a href={`tel:${SITE_PHONE}`} class="btn-primary">
          Call {SITE_PHONE_DISPLAY}
        </a>
        <a href="/locations" class="btn-outline">
          {CTA.secondary.location}
        </a>
      </div>

      <div class="pt-10" style="border-top: 1px solid var(--color-pearl-300);">
        <p class="text-sm text-stone-500 font-light mb-2">
          Need to speak with someone sooner?
        </p>
        <p class="text-sm text-stone-400 font-light">
          Our main line is open during regular business hours — or reach us on WhatsApp for a quicker reply.
        </p>
      </div>

    </div>
  </section>

  <Footer />
</Layout>

<script>
  // 仅在“真实提交到达”时打点（URL 带 ?lead=1，由表单提交成功后跳转带入）。
  // 成功页加载了 GTM，gtag 由 GA4 Configuration 标签初始化；待其就绪后发 generate_lead。
  // 发完后用 history.replaceState 去掉 ?lead=1，避免用户刷新本页造成重复计数。
  (function () {
    function fireLead() {
      if (new URLSearchParams(location.search).get('lead') !== '1') return;
      var attempts = 0;
      var tryFire = function () {
        if (window.gtag) {
          window.gtag('event', 'generate_lead');
          if (history.replaceState) {
            history.replaceState(null, '', location.pathname + location.hash);
          }
          return;
        }
        if (attempts++ < 20) setTimeout(tryFire, 200);
      };
      tryFire();
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', fireLead);
    } else {
      fireLead();
    }
  })();
</script>
