---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const locations = [
  { city: 'Torrance', phone: '(424) 212-4087', tel: 'tel:+14242124087' },
  { city: 'Beverly Hills', phone: '(213) 600-8088', tel: 'tel:+12136008088' },
  { city: 'Corona', phone: '(951) 272-2221', tel: 'tel:+19512722221' },
  { city: 'Irvine', phone: '(949) 453-8600', tel: 'tel:+19494538600' },
];

const steps = [
  {
    n: '01',
    title: 'Request a Zoom visit',
    body: 'Tell our team by phone or WhatsApp that you would like a video consultation. We will match you with the right physician.',
  },
  {
    n: '02',
    title: 'Receive your link',
    body: 'We send a secure Zoom link and confirm a time that works for you — no app download needed to join.',
  },
  {
    n: '03',
    title: 'Meet your physician',
    body: 'Join from home, the office, or anywhere. Review your history, discuss options, and plan your next steps together.',
  },
];
---

<Layout
  title="Consultation — In Person or by Zoom"
  description="Begin your fertility journey with IRFC. We recommend an in-person consultation at one of our Southern California clinics, with a secure Zoom video option available at the same consultation fee."
>
  <Nav />

  <!-- Hero -->
  <section class="pt-40 pb-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-6">
          <div class="h-px w-12" style="background: var(--color-gold-500);"></div>
          <span class="text-xs tracking-widest uppercase" style="color: var(--color-gold-600); font-family: var(--font-sans);">Phone &amp; Online Consultation</span>
        </div>
        <h1 style="font-family: var(--font-serif);" class="text-5xl md:text-6xl font-light text-stone-800 mb-6 leading-none">
          Meet your physician<br/>
          <em class="not-italic" style="color: var(--color-gold-500);">in person or by Zoom.</em>
        </h1>
        <p class="text-lg text-stone-500 font-light leading-relaxed max-w-2xl mb-10">
          We recommend beginning your journey with an in-person consultation at one of our Southern California clinics. If travel or time is hard, you can meet your physician by secure Zoom video &mdash; at the same consultation fee.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/appointment" class="btn-primary inline-flex items-center gap-2">
            Schedule an In-Person Visit
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a href="https://wa.me/14244324732" target="_blank" rel="noopener noreferrer" class="btn-outline inline-flex items-center gap-2">
            Request a Zoom Visit
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Two ways -->
  <section class="py-20 lg:py-28" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="mb-14">
        <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-stone-400); font-family: var(--font-sans);">Two ways to meet your physician</p>
        <h2 style="font-family: var(--font-serif);" class="text-3xl font-light text-stone-800">Choose what fits</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        <!-- In person: recommended -->
        <div class="p-8 border border-stone-200 bg-white relative">
          <span class="absolute top-6 right-6 text-xs tracking-widest uppercase px-3 py-1" style="background: var(--color-gold-500); color: #fff; font-family: var(--font-sans);">Recommended</span>
          <h3 style="font-family: var(--font-serif);" class="text-2xl font-light text-stone-800 mb-3 pr-28">In-person consultation</h3>
          <p class="text-sm text-stone-600 leading-relaxed mb-6">
            Meet your physician at any of our four Southern California clinics. Recommended for your first visit &mdash; exams, ultrasound, and lab work are all on site, in one place.
          </p>
          <a href="/appointment" class="btn-primary inline-flex items-center gap-2">
            Schedule a Visit
          </a>
        </div>
        <!-- Zoom: same fee -->
        <div class="p-8 border border-stone-200 bg-white relative">
          <span class="absolute top-6 right-6 text-xs tracking-widest uppercase px-3 py-1" style="background: var(--color-stone-100); color: var(--color-gold-600); font-family: var(--font-sans); border: 1px solid var(--color-gold-300);">Same fee</span>
          <h3 style="font-family: var(--font-serif);" class="text-2xl font-light text-stone-800 mb-3 pr-28">Zoom consultation</h3>
          <p class="text-sm text-stone-600 leading-relaxed mb-6">
            A secure video visit with your physician from home. Ideal for follow-ups, second opinions, or when travel is hard &mdash; priced exactly the same as an in-person consultation.
          </p>
          <a href="https://wa.me/14244324732" target="_blank" rel="noopener noreferrer" class="btn-outline inline-flex items-center gap-2">
            Request a Zoom Visit
          </a>
        </div>
      </div>
      <p class="mt-8 text-center text-sm" style="color: var(--color-stone-500);">
        Your consultation fee is identical whether you meet in person or by secure Zoom.
      </p>
    </div>
  </section>

  <!-- How a Zoom visit works -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="mb-14">
        <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-stone-400); font-family: var(--font-sans);">How a Zoom visit works</p>
        <h2 style="font-family: var(--font-serif);" class="text-3xl font-light text-stone-800">Three simple steps</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-10">
        {steps.map(step => (
          <div>
            <p class="text-5xl font-light mb-4" style="font-family: var(--font-serif); color: var(--color-gold-400);">{step.n}</p>
            <h3 style="font-family: var(--font-serif);" class="text-2xl font-light text-stone-800 mb-3">{step.title}</h3>
            <p class="text-sm text-stone-600 leading-relaxed">{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Clinic lines -->
  <section class="py-20 lg:py-28" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="mb-12">
        <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-stone-400); font-family: var(--font-sans);">Prefer a specific clinic?</p>
        <h2 style="font-family: var(--font-serif);" class="text-3xl font-light text-stone-800">Call any location directly</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {locations.map(loc => (
          <a href={loc.tel} class="p-6 border border-stone-200 bg-white card-hover flex items-center justify-between gap-3">
            <span style="font-family: var(--font-serif);" class="text-xl font-light text-stone-800">{loc.city}</span>
            <span class="text-sm font-medium" style="color: var(--color-gold-600);">{loc.phone}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
