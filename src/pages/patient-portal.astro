---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const portalLogin = 'https://portal.rfcfamily.com/PatientPortal';
const appStore = 'https://apps.apple.com/us/app/eivf-caresync/id6477145996';
const googlePlay = 'https://play.google.com/store/apps/details?id=com.practicehwy.eivf.revamp';

const features = [
  {
    title: 'Access your health information',
    desc: 'Review your records and the details of your care whenever you need them — anytime, anywhere.',
  },
  {
    title: 'View prescriptions & medications',
    desc: 'See your current prescriptions and medication instructions in one place.',
  },
  {
    title: 'Review lab results',
    desc: 'Stay up to date with your lab results as soon as they are released by your care team.',
  },
  {
    title: 'View & sign forms',
    desc: 'Read and electronically sign consents and documents required for your treatment.',
  },
];

const steps = [
  {
    n: '01',
    title: 'Receive your login credentials',
    desc: 'Before your first appointment, our front desk will provide a unique username and a temporary password for the eIVF patient portal.',
  },
  {
    n: '02',
    title: 'Log in on desktop first',
    desc: 'Use the desktop version of the portal for your first login. You will be prompted immediately to change your password to keep your account secure.',
  },
  {
    n: '03',
    title: 'Sign consents on desktop',
    desc: 'All patient consents and any documents requiring your signature (or your partner’s) must be completed in the desktop version of the portal.',
  },
  {
    n: '04',
    title: 'Complete your profile',
    desc: 'After creating your new password, you will be prompted to fill in your patient information, medical history, and consents. These must be finished before your first consultation with your physician.',
  },
  {
    n: '05',
    title: 'Download the mobile app',
    desc: 'After a successful desktop login, download the eIVF CareSync app from Google Play or the Apple App Store (links below).',
  },
  {
    n: '06',
    title: 'Enter your Practice ID',
    desc: 'The app will ask for the RFC Practice ID. Find it by clicking the “GET Your APP CODE HERE!” icon on the home screen of the desktop portal.',
  },
];

const faqDesktop = [
  {
    q: 'I can’t sign my consent form.',
    a: 'First, make sure you are using the desktop version of the patient portal — the mobile app cannot be used to sign consents. When signing, follow the on-screen prompts and click the red link to reveal the signature box. Some forms require multiple signatures and/or initials. Before clicking “Submit Your Document,” complete every action by clicking all red links.',
  },
  {
    q: 'I signed my consent, but my partner can’t see it on their portal.',
    a: 'If you and your partner were both logged in when you signed and submitted, it may take up to 30 minutes for the consent to appear on their side, and they will need to log out and back in. If your partner was not logged in when you submitted, they should see it immediately.',
  },
];

const faqMobile = [
  {
    q: 'I clicked the “Documents” tab but don’t see my patient instructions.',
    a: 'To view your patient instructions, first find the “Patient Instructions” link at the top of the Documents page. Click it to open the page listing all instructions, then click the blue underlined title of the instruction you want to view — a popup will appear.',
  },
  {
    q: 'I can’t view my lab results.',
    a: 'On the Patient Portal home screen, click the “Lab Results” tab at the top. A list page with all lab tests will appear; click the blue underlined title of the test you want to view — a popup will appear.',
  },
  {
    q: 'I can’t view my flowsheet.',
    a: 'If your cycle flowsheet isn’t showing on the “Flowsheets” page, contact your clinical coordinator and ask whether the flowsheet has been “released.” Your coordinator must release it before you can view it on the Patient Portal.',
  },
  {
    q: 'I’m having trouble with the mobile app.',
    a: 'Technical issues can happen. Try closing and reopening the app, make sure it is updated to the latest version, and check your internet connection. If the problem persists, contact our support team for help.',
  },
];

const videos = [
  { title: 'How to Log In to the Portal', url: 'https://kb.eivf.net/kbfiles/Videos/VideoCtrl/video.html?Video=A_16351107/6658175.mp4' },
  { title: 'How to Access Your Profile Information', url: 'https://kb.eivf.net/kbfiles/Videos/VideoCtrl/video.html?Video=A_576529/1766478.mp4' },
  { title: 'Home Screen Features Overview', url: 'https://kb.eivf.net/kbfiles/Videos/VideoCtrl/video.html?Video=A_9140672/13179681.mp4' },
  { title: 'Viewing Your Flowsheets', url: 'https://kb.eivf.net/kbfiles/Videos/VideoCtrl/video.html?Video=A_2417295/2189859.mp4' },
  { title: 'Viewing Your Lab Results', url: 'https://kb.eivf.net/kbfiles/Videos/VideoCtrl/video.html?Video=A_14969768/11842746.mp4' },
  { title: 'How to View Prescriptions', url: 'https://kb.eivf.net/kbfiles/Videos/VideoCtrl/video.html?Video=A_20880929/14919039.mp4' },
  { title: 'How to Electronically Sign Documents', url: 'https://kb.eivf.net/kbfiles/Videos/VideoCtrl/video.html?Video=A_207409012/222068269.mp4&t=2m25s' },
  { title: 'Submitting Patient Surveys & Feedback', url: 'https://kb.eivf.net/kbfiles/Videos/VideoCtrl/video.html?Video=A_1134761/10359403.mp4' },
];
---

<Layout
  title="Patient Portal"
  description="Access the IRFC patient portal — message your care team, review lab results, sign forms, and use the eIVF CareSync mobile app."
>
  <Nav />

  <!-- Hero -->
  <section class="relative overflow-hidden" style="background: linear-gradient(135deg, #1c1917 0%, #292524 60%, #3f3f46 100%);">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 20%, var(--color-gold-400) 0, transparent 40%);"></div>
    <div class="relative max-w-screen-xl mx-auto px-6 lg:px-10 pt-40 pb-24 lg:pt-48 lg:pb-28 text-center">
      <div class="flex items-center justify-center gap-3 mb-6">
        <div class="h-px w-12" style="background: var(--color-gold-500);"></div>
        <span class="text-xs tracking-widest uppercase" style="color: var(--color-gold-400); font-family: var(--font-sans);">Patient Portal</span>
        <div class="h-px w-12" style="background: var(--color-gold-500);"></div>
      </div>
      <h1 style="font-family: var(--font-serif);" class="text-5xl md:text-6xl font-light text-white mb-5 leading-none">
        Welcome to Your Patient Portal
      </h1>
      <p class="text-lg md:text-xl font-light mb-10" style="color: var(--color-stone-300);">Stay connected — to your care, your results, and your team.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={portalLogin}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
          style="background: var(--color-gold-500);"
        >
          Log In to Portal
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
        <a href="/appointment" class="btn-outline" style="border-color: rgba(255,255,255,0.4); color: white;">
          Book an Appointment
        </a>
      </div>
      <p class="mt-6 text-xs" style="color: var(--color-stone-400);">The portal opens in a new tab on the secure eIVF system.</p>
    </div>
  </section>

  <!-- What your portal unlocks -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="mb-14 max-w-2xl">
        <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-stone-400); font-family: var(--font-sans);">Always Within Reach</p>
        <h2 style="font-family: var(--font-serif);" class="text-3xl lg:text-4xl font-light text-stone-800">What your portal unlocks</h2>
        <p class="mt-4 text-sm leading-relaxed" style="color: var(--color-stone-500);">
          As a patient, you have 24/7 access to the information and tools you need throughout your fertility journey. Log in to your account to use the following:
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {features.map(f => (
          <div class="p-8 border border-stone-200 card-hover">
            <div class="w-10 h-10 flex items-center justify-center mb-5 rounded-full" style="background: var(--color-gold-100); color: var(--color-gold-600);">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            </div>
            <h3 style="font-family: var(--font-serif);" class="text-lg font-light text-stone-800 mb-2">{f.title}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-stone-500);">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- New Patient Guide -->
  <section class="py-20 lg:py-28" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="mb-14 max-w-2xl">
        <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-stone-400); font-family: var(--font-sans);">First-Time Setup</p>
        <h2 style="font-family: var(--font-serif);" class="text-3xl lg:text-4xl font-light text-stone-800">New Patient Guide</h2>
        <p class="mt-4 text-sm leading-relaxed" style="color: var(--color-stone-500);">
          Follow these steps to get started with the eIVF patient portal and the CareSync mobile app.
        </p>
      </div>
      <div class="grid md:grid-cols-2 gap-x-10 gap-y-8">
        {steps.map(s => (
          <div class="flex gap-5 items-start">
            <span class="text-2xl font-light flex-shrink-0 w-12 text-right" style="font-family: var(--font-serif); color: var(--color-gold-500);">{s.n}</span>
            <div class="border-t border-stone-200 pt-4">
              <h3 style="font-family: var(--font-serif);" class="text-xl font-light text-stone-800 mb-2">{s.title}</h3>
              <p class="text-sm leading-relaxed" style="color: var(--color-stone-500);">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Mobile app -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-stone-400); font-family: var(--font-sans);">On the Go</p>
          <h2 style="font-family: var(--font-serif);" class="text-3xl lg:text-4xl font-light text-stone-800 mb-4">Get the mobile app</h2>
          <p class="text-sm leading-relaxed mb-8" style="color: var(--color-stone-500);">
            Take your portal with you. Download <strong>eIVF CareSync</strong> from Google Play or the Apple App Store, then enter your RFC Practice ID (found on the desktop portal home screen) to connect your account.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href={googlePlay} target="_blank" rel="noopener noreferrer" class="btn-outline" style="border-color: var(--color-champagne-500); color: var(--color-champagne-700);">
              Google Play
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6L4 12l6 6 4-6-4-6zm0 0l4 6"/></svg>
            </a>
            <a href={appStore} target="_blank" rel="noopener noreferrer" class="btn-outline" style="border-color: var(--color-champagne-500); color: var(--color-champagne-700);">
              App Store
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18M3 12h18"/></svg>
            </a>
          </div>
        </div>
        <div class="p-10 border border-stone-200 text-center" style="background: var(--color-stone-50);">
          <div class="w-16 h-16 mx-auto mb-5 rounded-2xl flex items-center justify-center" style="background: var(--color-gold-500);">
            <svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
          </div>
          <h3 style="font-family: var(--font-serif);" class="text-xl font-light text-stone-800 mb-2">eIVF CareSync</h3>
          <p class="text-sm leading-relaxed" style="color: var(--color-stone-500);">Messages, results, and reminders — wherever your journey takes you.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 lg:py-28" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="mb-14 text-center">
        <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-stone-400); font-family: var(--font-sans);">Help & Answers</p>
        <h2 style="font-family: var(--font-serif);" class="text-3xl lg:text-4xl font-light text-stone-800">Frequently Asked Questions</h2>
      </div>

      <div class="grid lg:grid-cols-2 gap-10">
        <div>
          <h3 class="text-xs tracking-widest uppercase mb-5" style="color: var(--color-gold-600); font-family: var(--font-sans);">Desktop Version</h3>
          <div class="space-y-4">
            {faqDesktop.map(item => (
              <details class="group border border-stone-200 bg-white">
                <summary class="cursor-pointer list-none flex items-center justify-between gap-4 px-6 py-5 text-stone-800" style="font-family: var(--font-serif);">
                  <span class="text-base font-light">{item.q}</span>
                  <svg class="w-4 h-4 flex-shrink-0 transition-transform group-open:rotate-45" style="color: var(--color-gold-500);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14"/></svg>
                </summary>
                <p class="px-6 pb-6 text-sm leading-relaxed" style="color: var(--color-stone-500);">{item.a}</p>
              </details>
            ))}
          </div>
        </div>
        <div>
          <h3 class="text-xs tracking-widest uppercase mb-5" style="color: var(--color-gold-600); font-family: var(--font-sans);">Mobile App</h3>
          <div class="space-y-4">
            {faqMobile.map(item => (
              <details class="group border border-stone-200 bg-white">
                <summary class="cursor-pointer list-none flex items-center justify-between gap-4 px-6 py-5 text-stone-800" style="font-family: var(--font-serif);">
                  <span class="text-base font-light">{item.q}</span>
                  <svg class="w-4 h-4 flex-shrink-0 transition-transform group-open:rotate-45" style="color: var(--color-gold-500);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14"/></svg>
                </summary>
                <p class="px-6 pb-6 text-sm leading-relaxed" style="color: var(--color-stone-500);">{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tutorial videos -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="mb-12 max-w-2xl">
        <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-stone-400); font-family: var(--font-sans);">Learn the Portal</p>
        <h2 style="font-family: var(--font-serif);" class="text-3xl lg:text-4xl font-light text-stone-800">Tutorial Videos</h2>
        <p class="mt-4 text-sm leading-relaxed" style="color: var(--color-stone-500);">
          Step-by-step video guides from eIVF, the official patient portal platform.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {videos.map(v => (
          <a href={v.url} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 p-5 border border-stone-200 card-hover">
            <span class="w-9 h-9 flex-shrink-0 flex items-center justify-center rounded-full" style="background: var(--color-stone-100); color: var(--color-gold-600);">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </span>
            <span class="text-sm leading-snug text-stone-700 group-hover:text-stone-900">{v.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Support -->
  <section class="py-20 lg:py-28" style="background: linear-gradient(135deg, #1c1917 0%, #292524 100%);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10 text-center">
      <h2 style="font-family: var(--font-serif);" class="text-3xl lg:text-4xl font-light text-white mb-4">Having a technical issue?</h2>
      <p class="text-sm leading-relaxed mb-8 max-w-lg mx-auto" style="color: var(--color-stone-300);">
        Our dedicated support team is here to help. Submit a ticket and a team member will get back to you as soon as possible.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="mailto:support@rfcfamily.com" class="btn-primary" style="background: var(--color-gold-500);">Email Support</a>
        <a href="/contact" class="btn-outline" style="border-color: rgba(255,255,255,0.4); color: white;">Contact Us</a>
      </div>
      <p class="mt-6 text-xs tracking-wide" style="color: var(--color-stone-400);">Monday – Friday, 8:00 AM – 5:00 PM &nbsp;·&nbsp; Support@RFCfamily.com</p>
    </div>
  </section>

  <Footer />
</Layout>
