---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { BRAND_ABBREV, SITE_URL } from '../config/brand';

/* 地点数据：mapX/mapY 为标记在地图上的百分比坐标（基于南加州地理比例估算，可微调） */
const locations = [
  {
    city: 'Torrance',
    region: 'Greater Los Angeles',
    address: '21545 Hawthorne Blvd, Pavilion B',
    cityState: 'Torrance, CA 90503',
    phone: '(424) 212-4087',
    hours: 'Mon–Fri 7:00 AM – 5:00 PM · Sat 8:00 AM – 12:00 PM · Sun Closed',
    mapX: 19.9,
    mapY: 50.1,
  },
  {
    city: 'Beverly Hills',
    region: 'Greater Los Angeles',
    address: '8635 West 3rd Street, Suite 1170W',
    cityState: 'Los Angeles, CA 90048',
    phone: '(213) 600-8088',
    hours: 'Mon–Fri 7:00 AM – 5:00 PM · Sat 8:00 AM – 12:00 PM · Sun Closed',
    mapX: 18.5,
    mapY: 11.8,
  },
  {
    city: 'Corona',
    region: 'Inland Empire',
    address: '400 East Rincon Street, Suite 108',
    cityState: 'Corona, CA 92879',
    phone: '(951) 272-2221',
    hours: 'Mon–Fri 7:00 AM – 5:00 PM · Sat 8:00 AM – 12:00 PM · Sun Closed',
    mapX: 86.6,
    mapY: 43.6,
  },
  {
    city: 'Irvine',
    region: 'Orange County',
    address: '16300 Sand Canyon Avenue, 9th Floor',
    cityState: 'Irvine, CA 92618',
    phone: '(949) 453-8600',
    hours: 'Mon–Fri 7:00 AM – 5:00 PM · Sat 8:00 AM – 12:00 PM · Sun Closed',
    mapX: 67.7,
    mapY: 70.9,
  },
];

/* 诊所实拍照片墙（原样搬运自参考页真实照片） */
const bento = [
  { src: '/images/locations/network-welcome-beverly-hills.jpg', alt: 'Welcoming IRFC patient lounge', label: 'Welcoming Spaces' },
  { src: '/images/locations/network-access-corona.jpg', alt: 'IRFC Southern California clinic access', label: 'Southern California Access' },
  { src: '/images/locations/network-lab-corona.jpg', alt: 'IRFC embryology laboratory', label: 'Laboratory Technology' },
  { src: '/images/locations/network-comfort-irvine.jpg', alt: 'Comfortable private consultation room', label: 'Comfort and Privacy' },
  { src: '/images/locations/network-clinical-corona.jpg', alt: 'IRFC clinical environment', label: 'Clinical Environments' },
  { src: '/images/locations/network-welcome-irvine.jpg', alt: 'Thoughtful clinic detail', label: 'Thoughtful Details' },
  { src: '/images/locations/network-consultation-beverly-hills.jpg', alt: 'Space for conversation', label: 'Space for Conversation' },
  { src: '/images/locations/network-welcome-torrance.jpg', alt: 'Connected care network', label: 'Connected Care' },
  { src: '/images/locations/incinta-reception-desk.jpg', alt: 'Warm IRFC reception desk', label: 'Warm Reception' },
  { src: '/images/couple-clinic.webp', alt: 'Care for couples at IRFC', label: 'Care for Couples' },
];

const descriptions: Record<string, string> = {
  'Torrance': 'Consultation, monitoring, and coordinated fertility care. Contact IRFC to confirm current physician schedules and visit availability.',
  'Beverly Hills': 'Consultation, monitoring, and coordinated fertility care. Contact IRFC to confirm current physician schedules and visit availability.',
  'Corona': 'Full-service fertility care with on-site surgical and laboratory facilities serving the Inland Empire.',
  'Irvine': 'Our flagship Orange County location with a full surgery center and IVF laboratory on-site. Parking available.',
};

const clinicSchema = locations.map(loc => {
  const [city, stateZip] = loc.cityState.split(', ');
  const [stateCode, postalCode] = stateZip.split(' ');
  return {
    '@context': 'https://schema.org',
    '@type': ['MedicalClinic', 'LocalBusiness'],
    name: `IRFC — ${loc.city}`,
    parentOrganization: { '@type': 'MedicalOrganization', name: 'IRFC' },
    telephone: `+1${loc.phone.replace(/\D/g, '')}`,
    medicalSpecialty: 'Reproductive Medicine',
    address: {
      '@type': 'PostalAddress',
      streetAddress: loc.address,
      addressLocality: city,
      addressRegion: stateCode,
      postalCode,
      addressCountry: 'US',
    },
    url: SITE_URL + '/locations',
  };
});
---

<Layout
  title="Locations"
  description="IRFC has four convenient locations across Southern California — Torrance, Beverly Hills, Corona, and Irvine. Find expert fertility care near you."
  schema={clinicSchema}
>
  <Nav />

  <!-- Hero -->
  <section class="bg-stone-50">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10 py-16 md:py-20 lg:py-24">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-5">
          <div class="h-px w-12" style="background: var(--color-gold-400);"></div>
          <span class="text-xs tracking-[0.2em] uppercase" style="color: var(--color-gold-600); font-family: var(--font-sans);">Locations</span>
        </div>
        <h1 style="font-family: var(--font-serif);" class="text-stone-900 text-4xl md:text-5xl lg:text-6xl font-light leading-none mb-5">
          Southern California Locations
        </h1>
        <p class="text-stone-600 text-base md:text-lg font-light leading-relaxed max-w-2xl">
          Four clinics, one connected standard of care. Tap a location on the map to see details.
        </p>
      </div>
    </div>
  </section>

  <!-- Map with clickable location markers + detail panel -->
  <section class="py-14 md:py-20" style="background: var(--color-stone-50);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-10">
      <div class="grid lg:grid-cols-2 gap-5 lg:gap-6 items-stretch">
        <!-- Map -->
        <div class="relative rounded-[2rem] overflow-hidden shadow-xl min-h-[420px] lg:min-h-[560px] bg-stone-100">
          <img
            src="/images/locations/southern-california-irfc-map-label-free.webp"
            alt="Map of IRFC Southern California clinic locations"
            class="absolute inset-0 w-full h-full object-cover object-center"
            loading="lazy"
            decoding="async"
          />
          {locations.map((loc) => (
            <button
              type="button"
              data-marker={loc.city}
              class="map-marker"
              style={`left:${loc.mapX}%; top:${loc.mapY}%;`}
              aria-label={`Show ${loc.city} location`}
            >
              <span class="map-dot"></span>
              <span class="map-label">{loc.city}</span>
            </button>
          ))}
          <div class="absolute bottom-5 left-5 z-[2]">
            <span class="text-[10px] tracking-[0.25em] uppercase text-white/85 font-medium" style="font-family: var(--font-sans); text-shadow: 0 1px 3px rgba(0,0,0,0.4);">Southern California Locations</span>
          </div>
        </div>

        <!-- Detail panel -->
        <div class="rounded-[2rem] p-7 md:p-10 lg:p-12 shadow-xl flex flex-col bg-white">
          <!-- City tabs -->
          <div class="grid grid-cols-2 gap-3 mb-8">
            {locations.map((loc) => (
              <button
                type="button"
                data-loc={loc.city}
                class="loc-city-btn text-center px-4 py-3 rounded-full text-sm font-medium transition-all"
                style="font-family: var(--font-sans);"
              >
                {loc.city}
              </button>
            ))}
          </div>

          <div class="relative flex-1">
            {locations.map((loc) => (
              <article data-detail={loc.city} class="loc-detail">
                <p class="text-[11px] tracking-[0.2em] uppercase mb-3" style="color: var(--color-gold-600); font-family: var(--font-sans);">{loc.region}</p>
                <h2 style="font-family: var(--font-serif);" class="text-4xl md:text-5xl font-light text-stone-900 mb-6 leading-none">{loc.city}</h2>

                <div class="space-y-5 mb-8" style="font-family: var(--font-sans);">
                  <div>
                    <p class="text-[11px] tracking-[0.18em] uppercase mb-1" style="color: var(--color-stone-400);">Address</p>
                    <p class="text-stone-700 leading-relaxed">{loc.address}<br />{loc.cityState}</p>
                  </div>
                  <div>
                    <p class="text-[11px] tracking-[0.18em] uppercase mb-1" style="color: var(--color-stone-400);">Phone</p>
                    <a href={`tel:+1${loc.phone.replace(/\D/g, '')}`} class="text-stone-700 hover:underline" style="color: var(--color-gold-700);">{loc.phone}</a>
                  </div>
                  <div>
                    <p class="text-[11px] tracking-[0.18em] uppercase mb-1" style="color: var(--color-stone-400);">Hours</p>
                    <p class="text-stone-600 leading-relaxed text-sm">{loc.hours}</p>
                  </div>
                </div>

                <div class="flex flex-wrap items-center gap-4">
                  <a
                    href={`https://maps.google.com/?q=${encodeURIComponent(loc.address + ', ' + loc.cityState)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center px-7 py-3.5 rounded-full text-sm font-medium transition-colors"
                    style="background: var(--color-gold-500); color: #fff; font-family: var(--font-sans);"
                  >
                    Get Directions
                  </a>
                  <a
                    href="/appointment"
                    class="inline-flex items-center gap-1.5 text-sm font-medium underline underline-offset-4 transition-colors"
                    style="color: var(--color-stone-600); font-family: var(--font-sans);"
                  >
                    Schedule Appointment
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>

      <p class="text-center text-sm text-stone-400 mt-6">Tap a marker on the map or a city above to switch locations.</p>
    </div>
  </section>

  <!-- Inside Our Clinics (real photos) -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="bento-grid">
        {bento.map((item, i) => (
          <div class={`bento-pic-${i} relative overflow-hidden rounded-2xl group`}>
            <img
              src={item.src}
              alt={item.alt}
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(20,18,28,0.62) 0%, rgba(20,18,28,0.08) 52%, transparent 100%);"></div>
            <span class="absolute bottom-4 left-4 text-[10px] md:text-[11px] tracking-[0.16em] uppercase font-medium text-white/95" style="font-family: var(--font-sans); text-shadow: 0 1px 3px rgba(0,0,0,0.35);">
              {item.label}
            </span>
          </div>
        ))}

        <!-- Center IRFC logo image -->
        <div class="bento-logo rounded-2xl flex items-center justify-center">
          <img
            src="/images/incinta-logo.png"
            alt="IRFC"
            class="w-[86%] max-w-[300px] h-auto"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="py-16 lg:py-20 bg-stone-50">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="max-w-3xl mx-auto text-center">
        <div class="flex items-center justify-center gap-3 mb-5">
          <div class="h-px w-12" style="background: var(--color-gold-400);"></div>
          <span class="text-xs tracking-[0.2em] uppercase" style="color: var(--color-gold-600); font-family: var(--font-sans);">Begin Here</span>
          <div class="h-px w-12" style="background: var(--color-gold-400);"></div>
        </div>
        <h2 style="font-family: var(--font-serif);" class="text-3xl md:text-4xl font-light text-stone-900 mb-5">Ready to find your care team?</h2>
        <p class="text-stone-500 mb-8 leading-relaxed">Call our main line, message us on WhatsApp, or request a consultation online.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="tel:+14244324732" class="btn-primary inline-flex items-center gap-2">
            Call (424) 432-4732
          </a>
          <a href="https://wa.me/14244324732" target="_blank" rel="noopener noreferrer" class="btn-outline inline-flex items-center gap-2">
            WhatsApp (424) 432-4732
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    const detailEls = Array.from(document.querySelectorAll<HTMLElement>('[data-detail]'));
    const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-loc]'));
    const markers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-marker]'));

    function setActive(city: string) {
      btns.forEach(btn => {
        const active = btn.dataset.loc === city;
        btn.classList.toggle('loc-city-btn--active', active);
        btn.setAttribute('aria-pressed', String(active));
      });
      markers.forEach(m => {
        m.classList.toggle('map-marker--active', m.dataset.marker === city);
      });
      detailEls.forEach(el => {
        el.classList.toggle('loc-detail--active', el.dataset.detail === city);
      });
    }

    btns.forEach(btn => btn.addEventListener('click', () => setActive(btn.dataset.loc!)));
    markers.forEach(m => m.addEventListener('click', () => setActive(m.dataset.marker!)));

    setActive('Irvine');
  </script>

  <style>
    .loc-city-btn {
      background: var(--color-stone-100);
      color: var(--color-stone-700);
      border: 1px solid transparent;
    }
    .loc-city-btn:hover {
      border-color: var(--color-gold-300);
      color: var(--color-gold-700);
    }
    .loc-city-btn--active {
      background: var(--color-gold-500);
      color: #fff;
      box-shadow: 0 4px 12px rgba(194,161,77,0.22);
    }
    .loc-city-btn--active:hover {
      background: var(--color-gold-600);
      color: #fff;
      border-color: transparent;
    }

    .loc-detail {
      opacity: 0;
      visibility: hidden;
      position: absolute;
      inset: 0;
      transform: translateY(8px);
      transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s;
    }
    .loc-detail--active {
      opacity: 1;
      visibility: visible;
      position: relative;
      transform: translateY(0);
    }

    /* Map clickable markers */
    .map-marker {
      position: absolute;
      transform: translate(-50%, -50%);
      z-index: 5;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 5px;
      cursor: pointer;
      background: none;
      border: none;
      padding: 0;
    }
    .map-dot {
      width: 16px;
      height: 16px;
      border-radius: 9999px;
      background: var(--color-gold-500);
      border: 3px solid #fff;
      box-shadow: 0 2px 8px rgba(0,0,0,0.35);
      transition: transform 0.2s ease, background 0.2s ease;
    }
    .map-marker:hover .map-dot,
    .map-marker--active .map-dot {
      transform: scale(1.4);
      background: var(--color-gold-600);
    }
    .map-label {
      font-size: 11px;
      font-family: var(--font-sans);
      color: #fff;
      background: rgba(28,25,23,0.80);
      padding: 2px 9px;
      border-radius: 9999px;
      white-space: nowrap;
      letter-spacing: 0.03em;
      opacity: 0;
      transform: translateY(-4px);
      transition: opacity 0.2s ease, transform 0.2s ease;
      pointer-events: none;
    }
    .map-marker:hover .map-label,
    .map-marker--active .map-label {
      opacity: 1;
      transform: translateY(0);
    }

    /* Bento grid: 4×3 on desktop, IRFC logo centered, photos arranged around it */
    .bento-grid {
      display: grid;
      gap: 0.75rem;
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: minmax(180px, 1fr);
    }
    .bento-logo {
      display: none;
      min-height: 180px;
      background: #ffffff;
      box-shadow: inset 0 0 0 1px rgba(194,161,77,0.22);
    }
    @media (min-width: 1024px) {
      .bento-grid {
        grid-template-columns: repeat(4, 1fr);
        grid-template-rows: repeat(3, minmax(200px, 1fr));
        grid-template-areas:
          "pic0 pic1 pic2 pic3"
          "pic4 logo logo pic5"
          "pic6 pic7 pic8 pic9";
        gap: 1rem;
      }
      .bento-logo { grid-area: logo; display: flex; }
      .bento-pic-0 { grid-area: pic0; }
      .bento-pic-1 { grid-area: pic1; }
      .bento-pic-2 { grid-area: pic2; }
      .bento-pic-3 { grid-area: pic3; }
      .bento-pic-4 { grid-area: pic4; }
      .bento-pic-5 { grid-area: pic5; }
      .bento-pic-6 { grid-area: pic6; }
      .bento-pic-7 { grid-area: pic7; }
      .bento-pic-8 { grid-area: pic8; }
      .bento-pic-9 { grid-area: pic9; }
    }
  </style>

  <Footer />
</Layout>
