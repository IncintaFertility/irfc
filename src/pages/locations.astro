---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const locations = [
  {
    city: 'Torrance',
    state: 'California',
    address: '21545 Hawthorne Blvd, Pavilion B',
    cityState: 'Torrance, CA 90503',
    phone: '(424) 212-4087',
    facilities: ['Clinic'],
    note: 'Serving the South Bay area of Los Angeles. Originally home to the Incinta Fertility clinic.',
  },
  {
    city: 'Alhambra',
    state: 'California',
    address: '723 South Garfield Avenue, Suite 203',
    cityState: 'Alhambra, CA 91801',
    phone: '(626) 588-2885',
    facilities: ['Clinic'],
    note: 'Convenient to the San Gabriel Valley and greater Los Angeles area.',
  },
  {
    city: 'Beverly Hills',
    state: 'California',
    address: '8635 West 3rd Street, Suite 1170W',
    cityState: 'Los Angeles, CA 90048',
    phone: '(213) 600-8088',
    facilities: ['Clinic'],
    note: 'Located in the heart of Los Angeles, steps from Cedars-Sinai Medical Center.',
  },
  {
    city: 'Corona',
    state: 'California',
    address: '400 East Rincon Street, Suite 108',
    cityState: 'Corona, CA 92879',
    phone: '(951) 272-2221',
    facilities: ['Clinic', 'Surgery Center', 'IVF Laboratory'],
    note: 'Full-service location serving the Inland Empire with on-site surgical and laboratory facilities.',
  },
  {
    city: 'Irvine',
    state: 'California',
    address: '16300 Sand Canyon Avenue, 9th Floor',
    cityState: 'Irvine, CA 92618',
    phone: '(949) 453-8600',
    facilities: ['Clinic', 'Surgery Center', 'IVF Laboratory'],
    note: 'Our flagship location in Orange County. Full surgery center and laboratory on-site. Parking available.',
  },
];
---

<Layout
  title="Locations"
  description="IRFC has four convenient locations across Southern California — Alhambra, Beverly Hills, Corona, and Irvine. Find expert fertility care near you."
>
  <Nav />

  <!-- Hero -->
  <section class="pt-40 pb-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-6">
          <div class="h-px w-12" style="background: var(--color-gold-500);"></div>
          <span class="text-xs tracking-widest uppercase" style="color: var(--color-gold-600); font-family: var(--font-sans);">Locations</span>
        </div>
        <h1 style="font-family: var(--font-serif);" class="text-5xl md:text-6xl font-light text-stone-800 mb-6 leading-none">
          Care Close to Home
        </h1>
        <p class="text-lg text-stone-500 font-light leading-relaxed">
          With five locations across Southern California, IRFC brings world-class fertility expertise to your neighborhood. Each clinic is staffed by our expert team and supported by the same commitment to excellence.
        </p>
      </div>
    </div>
  </section>

  <!-- Location Cards -->
  <section class="py-20" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="space-y-8">
        {locations.map((loc, i) => (
          <div class="bg-white border border-stone-200 p-10 lg:p-14">
            <div class="grid lg:grid-cols-3 gap-10 items-start">
              <!-- Location Name & Number -->
              <div>
                <p class="text-xs tracking-widest uppercase mb-3" style="color: var(--color-stone-400); font-family: var(--font-sans);">0{i + 1} — {loc.state}</p>
                <h2 style="font-family: var(--font-serif);" class="text-4xl font-light text-stone-800 mb-4">{loc.city}</h2>
                <div class="flex flex-wrap gap-2">
                  {loc.facilities.map(f => (
                    <span class="text-xs px-3 py-1 border" style="color: var(--color-gold-700); border-color: var(--color-gold-300);">{f}</span>
                  ))}
                </div>
              </div>

              <!-- Address & Contact -->
              <div>
                <div class="mb-5">
                  <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-stone-400); font-family: var(--font-sans);">Address</p>
                  <p class="text-stone-700 text-sm leading-relaxed">{loc.address}</p>
                  <p class="text-stone-700 text-sm">{loc.cityState}</p>
                </div>
                <div class="mb-5">
                  <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-stone-400); font-family: var(--font-sans);">Phone</p>
                  <a href={`tel:${loc.phone.replace(/\D/g,'')}`} class="text-sm font-medium" style="color: var(--color-gold-600);">{loc.phone}</a>
                </div>
                <a
                  href={`https://maps.google.com/?q=${encodeURIComponent(loc.address + ', ' + loc.cityState)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-xs tracking-wider uppercase"
                  style="color: var(--color-stone-500);"
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  Get Directions
                </a>
              </div>

              <!-- Note & CTA -->
              <div>
                <p class="text-sm text-stone-500 leading-relaxed mb-6">{loc.note}</p>
                <a href="/contact" class="btn-outline text-xs py-2.5 px-5">Book at This Location</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact Info -->
  <section class="py-16 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="grid md:grid-cols-3 gap-8 text-center">
        <div class="p-8 bg-stone-50 border border-stone-200">
          <svg class="w-6 h-6 mx-auto mb-4" style="color: var(--color-gold-500);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-stone-400); font-family: var(--font-sans);">Main Line (English)</p>
          <a href="tel:+19494538600" class="text-xl font-light" style="font-family: var(--font-serif); color: var(--color-gold-600);">(949) 453-8600</a>
        </div>

        <div class="p-8 bg-stone-50 border border-stone-200">
          <svg class="w-6 h-6 mx-auto mb-4" style="color: var(--color-gold-500);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-stone-400); font-family: var(--font-sans);">Mandarin Chinese</p>
          <a href="tel:+16263886022" class="text-xl font-light" style="font-family: var(--font-serif); color: var(--color-gold-600);">(626) 388-6022</a>
        </div>

        <div class="p-8 bg-stone-50 border border-stone-200">
          <svg class="w-6 h-6 mx-auto mb-4" style="color: var(--color-gold-500);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-stone-400); font-family: var(--font-sans);">Email Us</p>
          <a href="mailto:contact@irfc.com" class="text-xl font-light" style="font-family: var(--font-serif); color: var(--color-gold-600);">contact@irfc.com</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Telehealth note -->
  <section class="py-14" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10 text-center">
      <h2 style="font-family: var(--font-serif);" class="text-3xl font-light text-stone-800 mb-3">
        Can't Visit in Person?
      </h2>
      <p class="text-sm leading-relaxed mb-6 max-w-md mx-auto" style="color: var(--color-stone-500);">
        IRFC offers telehealth consultations for out-of-area and international patients. Start your journey from wherever you are.
      </p>
      <a href="/contact" class="btn-primary">Book a Virtual Consultation</a>
    </div>
  </section>

  <Footer />
</Layout>
