---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { standards } from '../../data/standards';

export function getStaticPaths() {
  return standards.map((s) => ({
    params: { slug: s.slug },
    props: { standard: s },
  }));
}

const { standard } = Astro.props;
const otherStandards = standards.filter((s) => s.slug !== standard.slug);
---

<Layout
  title={`${standard.title} — The INCINTA Standard`}
  description={standard.text}
>
  <Nav />

  <!-- ═══ HERO ═══ -->
  <section class="std-hero">
    <div class="std-hero-media">
      <img src={standard.image} alt={standard.title} />
    </div>
    <div class="std-hero-body">
      <div class="std-hero-eyebrow">
        <span class="std-hero-num">{standard.number}</span>
        <span>The INCINTA Standard</span>
      </div>
      <h1 class="std-hero-title">{standard.title}</h1>
      <p class="std-hero-lead">{standard.lead}</p>
      <p class="std-hero-text">{standard.text}</p>
    </div>
  </section>

  <!-- ═══ INTRO ═══ -->
  <section class="std-intro">
    <div class="std-intro-inner">
      <div class="h-px mb-8" style="background: var(--color-gold-500); width: 3rem;"></div>
      <p class="std-intro-copy">{standard.intro}</p>
    </div>
  </section>

  <!-- ═══ PILLARS ═══ -->
  {standard.pillars && standard.pillars.length > 0 && (
    <section class="std-pillars">
      <div class="std-pillars-inner">
        <div class="h-px mb-8" style="background: var(--color-gold-500); width: 3rem;"></div>
        <h2 class="std-pillars-h2">How this standard shows up in care</h2>
        <div class="std-pillar-grid">
          {standard.pillars.map((p) => (
            <div class="std-pillar">
              <span class="std-pillar-num">{p.num}</span>
              <h3 class="std-pillar-title">{p.title}</h3>
              <p class="std-pillar-text">{p.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ═══ RELATED CONTENT ═══ -->
  <section class="std-related">
    <div class="std-related-inner">
      <h2 class="std-related-h2">Everything we do under this standard</h2>

      {standard.related.map((group) => (
        <div class="std-group">
          <h3 class="std-group-h">{group.heading}</h3>
          <div class={`std-cards ${group.items.some((i) => i.photo) ? 'std-cards-team' : ''}`}>
            {group.items.map((item) => (
              item.photo ? (
                <a href={item.href} class="std-team-card">
                  <img src={item.photo} alt={item.label} class="std-team-ava" loading="lazy" decoding="async" />
                  <span class="std-team-name">{item.label}</span>
                  {item.desc && <span class="std-team-role">{item.desc}</span>}
                  {item.bio && <span class="std-team-bio">{item.bio}</span>}
                  <span class="std-team-link">Full profile
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </span>
                </a>
              ) : (
                <a href={item.href} class="std-card">
                  <span class="std-card-label">{item.label}</span>
                  {item.desc && <span class="std-card-desc">{item.desc}</span>}
                  <span class="std-card-arrow" aria-hidden="true">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </span>
                </a>
              )
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══ EXPLORE OTHER STANDARDS ═══ -->
  <section class="std-more">
    <div class="std-more-inner">
      <h2 class="std-more-h2">Explore the other standards</h2>
      <div class="std-more-grid">
        {otherStandards.map((s) => (
          <a href={`/standards/${s.slug}`} class="std-more-card">
            <span class="std-more-num">{s.number}</span>
            <span class="std-more-title">{s.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="std-cta">
    <div class="std-cta-inner">
      <h2 class="std-cta-title">Your beginning starts here.</h2>
      <p class="std-cta-text">Every extraordinary life deserves an extraordinary beginning.</p>
      <div class="std-cta-actions">
        <a href="/contact" class="btn-primary">Schedule a Consultation</a>
        <a href="/about" class="btn-outline">Our Story</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
/* ═══ HERO ═══ */
.std-hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 72vh;
  background: var(--color-pearl-50);
  border-bottom: 1px solid var(--color-pearl-200);
}
.std-hero-media {
  position: relative;
  overflow: hidden;
  min-height: 360px;
}
.std-hero-media img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.std-hero-body {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 5rem 8vw 5rem 4rem;
}
.std-hero-eyebrow {
  display: flex;
  align-items: center;
  gap: 0.9rem;
  margin-bottom: 1.75rem;
  font-family: var(--font-sans);
  font-size: 0.62rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--color-gold-600);
}
.std-hero-num {
  font-family: var(--font-serif);
  font-size: 1.6rem;
  font-weight: 300;
  line-height: 1;
  color: var(--color-purple-400);
}
.std-hero-title {
  font-family: var(--font-serif);
  font-weight: 300;
  font-size: clamp(2.4rem, 4.6vw, 3.9rem);
  line-height: 1.08;
  color: var(--color-purple-800);
  margin: 0 0 1.4rem;
}
.std-hero-lead {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: clamp(1.1rem, 1.9vw, 1.45rem);
  line-height: 1.5;
  color: var(--color-champagne-600);
  margin: 0 0 1.1rem;
}
.std-hero-text {
  font-size: 1rem;
  line-height: 1.75;
  color: var(--color-stone-600);
  max-width: 34rem;
  margin: 0;
}

/* ═══ INTRO ═══ */
.std-intro {
  padding: 5rem 8vw 4rem 4rem;
  background: var(--color-pearl-50);
}
.std-intro-inner { max-width: 46rem; }
.std-intro-copy {
  font-family: var(--font-serif);
  font-size: clamp(1.25rem, 2.3vw, 1.7rem);
  font-weight: 300;
  line-height: 1.6;
  color: var(--color-stone-700);
  margin: 0;
}

/* ═══ PILLARS ═══ */
.std-pillars {
  background: #fff;
  padding: 4.5rem 4vw 5rem;
  border-top: 1px solid var(--color-pearl-200);
}
.std-pillars-inner { max-width: 70rem; margin: 0 auto; }
.std-pillars-h2 {
  font-family: var(--font-serif);
  font-weight: 300;
  font-size: clamp(1.8rem, 3.4vw, 2.7rem);
  color: var(--color-purple-800);
  margin: 0 0 3rem;
}
.std-pillar-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  gap: 1.5rem;
}
.std-pillar {
  padding: 1.75rem 1.6rem;
  background: var(--color-pearl-50);
  border: 1px solid var(--color-pearl-200);
}
.std-pillar-num {
  display: block;
  font-family: var(--font-serif);
  font-size: 1.5rem;
  font-weight: 300;
  color: var(--color-gold-500);
  margin-bottom: 0.75rem;
}
.std-pillar-title {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-weight: 400;
  color: var(--color-purple-800);
  margin: 0 0 0.6rem;
}
.std-pillar-text {
  font-size: 0.9rem;
  line-height: 1.6;
  color: var(--color-stone-600);
  margin: 0;
}

/* ═══ RELATED ═══ */
.std-related {
  background: #fff;
  padding: 4rem 4vw 5.5rem;
  border-top: 1px solid var(--color-pearl-200);
}
.std-related-inner { max-width: 70rem; margin: 0 auto; }
.std-related-h2 {
  font-family: var(--font-serif);
  font-weight: 300;
  font-size: clamp(1.8rem, 3.4vw, 2.7rem);
  color: var(--color-purple-800);
  margin: 0 0 3rem;
}
.std-group { margin-bottom: 3.25rem; }
.std-group:last-child { margin-bottom: 0; }
.std-group-h {
  font-family: var(--font-sans);
  font-size: 0.66rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-stone-500);
  margin: 0 0 1.4rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid var(--color-stone-200);
}
.std-cards {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
  gap: 1rem;
}
.std-cards-team {
  grid-template-columns: repeat(3, 1fr);
}
.std-card {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  padding: 1.5rem 1.6rem;
  background: var(--color-pearl-50);
  border: 1px solid var(--color-pearl-200);
  text-decoration: none;
  transition: border-color 0.25s, background 0.25s, transform 0.25s;
}
.std-card:hover {
  border-color: var(--color-gold-400);
  background: #fff;
  transform: translateY(-2px);
}
.std-card-label {
  font-family: var(--font-serif);
  font-size: 1.2rem;
  font-weight: 400;
  line-height: 1.2;
  color: var(--color-purple-800);
}
.std-card-desc {
  font-size: 0.85rem;
  line-height: 1.5;
  color: var(--color-stone-500);
}
.std-card-arrow {
  position: absolute;
  top: 1.5rem;
  right: 1.5rem;
  color: var(--color-gold-500);
  opacity: 0;
  transform: translateX(-4px);
  transition: opacity 0.25s, transform 0.25s;
}
.std-card:hover .std-card-arrow {
  opacity: 1;
  transform: translateX(0);
}

/* ═══ TEAM CARDS (photo) ═══ */
.std-team-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 0.35rem;
  padding: 1.75rem 1.4rem;
  background: var(--color-pearl-50);
  border: 1px solid var(--color-pearl-200);
  text-decoration: none;
  transition: border-color 0.25s, background 0.25s, transform 0.25s;
}
.std-team-card:hover {
  border-color: var(--color-gold-400);
  background: #fff;
  transform: translateY(-2px);
}
.std-team-ava {
  width: 5.25rem;
  height: 5.25rem;
  border-radius: 50%;
  object-fit: cover;
  margin-bottom: 0.65rem;
}
.std-team-name {
  font-family: var(--font-serif);
  font-size: 1.15rem;
  font-weight: 400;
  line-height: 1.25;
  color: var(--color-purple-800);
}
.std-team-role {
  font-family: var(--font-sans);
  font-size: 0.62rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-gold-600);
  margin-bottom: 0.4rem;
}
.std-team-bio {
  font-size: 0.82rem;
  line-height: 1.5;
  color: var(--color-stone-500);
  margin-bottom: 0.7rem;
}
.std-team-link {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-family: var(--font-sans);
  font-size: 0.66rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-gold-600);
}

/* ═══ EXPLORE OTHER ═══ */
.std-more {
  background: var(--color-stone-900);
  padding: 4rem 4vw 4.5rem;
}
.std-more-inner { max-width: 70rem; margin: 0 auto; }
.std-more-h2 {
  font-family: var(--font-serif);
  font-weight: 300;
  font-size: clamp(1.6rem, 3vw, 2.3rem);
  color: #fff;
  margin: 0 0 2.25rem;
  text-align: center;
}
.std-more-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  gap: 1rem;
}
.std-more-card {
  display: flex;
  align-items: baseline;
  gap: 0.85rem;
  padding: 1.4rem 1.5rem;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.1);
  text-decoration: none;
  transition: border-color 0.25s, background 0.25s;
}
.std-more-card:hover {
  border-color: var(--color-gold-500);
  background: rgba(255,255,255,0.08);
}
.std-more-num {
  font-family: var(--font-serif);
  font-size: 1.3rem;
  font-weight: 300;
  color: var(--color-gold-400);
}
.std-more-title {
  font-family: var(--font-serif);
  font-size: 1.05rem;
  font-weight: 300;
  color: rgba(255,255,255,0.92);
  line-height: 1.25;
}

/* ═══ CTA ═══ */
.std-cta {
  background: var(--color-pearl-50);
  border-top: 1px solid var(--color-pearl-200);
  padding: 5rem 4vw;
  text-align: center;
}
.std-cta-inner { max-width: 40rem; margin: 0 auto; }
.std-cta-title {
  font-family: var(--font-serif);
  font-weight: 300;
  font-size: clamp(2rem, 4vw, 3rem);
  color: var(--color-purple-800);
  margin: 0 0 1rem;
}
.std-cta-text {
  font-size: 1.05rem;
  color: var(--color-stone-500);
  margin: 0 0 2rem;
}
.std-cta-actions {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
}

/* ═══ RESPONSIVE ═══ */
@media (max-width: 860px) {
  .std-hero {
    grid-template-columns: 1fr;
  }
  .std-hero-media {
    min-height: 44vh;
    order: -1;
  }
  .std-hero-body,
  .std-intro {
    padding: 3rem 6vw;
  }
  .std-related,
  .std-more { padding-left: 6vw; padding-right: 6vw; }
  .std-cards-team { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 560px) {
  .std-cards-team { grid-template-columns: 1fr; }
}
</style>
