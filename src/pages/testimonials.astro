---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import {
  reviews,
  clinics,
  sourcesOf,
  type ClinicKey,
  type Review,
} from '../data/testimonials';

const clinicKeyOf = (clinic?: ClinicKey) => clinic ?? 'torrance';
const hasPublicAttribution = (review: Review) => Boolean(
  review.verified && review.avatarUrl && review.authorProfileUrl && review.reviewUrl
);
const googleStories = reviews
  .filter((review) => review.source === 'google' && review.featured && hasPublicAttribution(review))
  .map((review) => ({
    review,
    clinic: clinics.find((clinic) => clinic.key === clinicKeyOf(review.clinic)) ?? clinics[0],
  }));
const yelpReviews = reviews.filter((review) => review.source === 'yelp' && hasPublicAttribution(review));
const initialsOf = (name: string) => name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0])
  .join('')
  .toUpperCase();
const yelpClinicGroups = clinics
  .map((clinic) => ({
    clinic,
    reviews: yelpReviews.filter((review) => clinicKeyOf(review.clinic) === clinic.key),
  }))
  .filter((group) => group.reviews.length > 0);

---

<Layout
  title="Real Patient Reviews — IRFC on Google & Yelp"
  description="Real patient reviews of Incinta Fertility Center (IRFC) across our Southern California locations — public Google and Yelp profiles with star ratings, links back to the source, and verbatim excerpts."
>
  <Nav />

  <!-- Hero -->
  <section class="pt-40 pb-0 bg-white overflow-hidden">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-2 gap-12 items-end">
        <div class="pb-20">
          <div class="flex items-center gap-3 mb-6">
            <div class="h-px w-12" style="background: var(--color-gold-500);"></div>
            <span class="text-xs tracking-widest uppercase" style="color: var(--color-gold-600); font-family: var(--font-sans);">Real Patient Reviews</span>
          </div>
          <h1 style="font-family: var(--font-serif);" class="text-5xl md:text-6xl font-light text-stone-800 mb-6 leading-none">
            In Their<br/>
            <em class="not-italic" style="color: var(--color-gold-500);">Own Words.</em>
          </h1>
          <p class="text-lg text-stone-500 font-light leading-relaxed max-w-2xl">
            We let our patients speak for us. Every review below is a verbatim excerpt from our public Google and Yelp profiles — with the star rating, name, and date exactly as posted, and a link back to the original. We publish the profiles of every location, not just one.
          </p>
        </div>
        <div class="hidden lg:block overflow-hidden" style="max-height: 480px;">
          <img
            src="/images/patient-portrait.webp" srcset="/images/patient-portrait-800.webp 800w, /images/patient-portrait-1280.webp 1280w, /images/patient-portrait.webp 2400w" sizes="(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 1200px"
            alt="IRFC patient"
            class="w-full h-full object-cover object-top"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Ratings by location -->
  <section class="py-16" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="max-w-3xl mb-10">
        <div class="flex items-center gap-3 mb-5">
          <div class="h-px w-12" style="background: var(--color-gold-500);"></div>
          <span class="text-xs tracking-widest uppercase" style="color: var(--color-gold-600); font-family: var(--font-sans);">Across Our Locations</span>
        </div>
        <h2 style="font-family: var(--font-serif);" class="text-3xl md:text-4xl font-light text-stone-800 mb-4">Our ratings, location by location.</h2>
        <p class="text-base text-stone-500 font-light leading-relaxed">
          Each of our Southern California clinics keeps its own public review profile. Below is every profile we publish — including the locations listed under our affiliated
          <span class="text-stone-700">Reproductive Fertility Center (RFC Family)</span> name. Click any rating to read the reviews at the source.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {clinics.map((c) => (
          <div class="p-6 border border-stone-200 bg-white flex flex-col">
            <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-gold-600); font-family: var(--font-sans);">{c.city}</p>
            <h3 style="font-family: var(--font-serif);" class="text-lg font-light text-stone-800 leading-snug mb-2">{c.clinicName}</h3>
            <p class="text-xs leading-relaxed mb-5" style="color: var(--color-stone-400);">{c.address}</p>

            <div class="mt-auto space-y-2.5">
              {sourcesOf(c).length > 0 ? (
                sourcesOf(c).map((s) => (
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    title={`${s.listingName} on ${s.name}`}
                    class="block p-3 border border-stone-100 hover:border-stone-300 transition"
                  >
                    <span class="flex items-center justify-between gap-3">
                      <span class="text-sm font-semibold tracking-tight shrink-0" style={`color: ${s.color}; font-family: var(--font-sans);`}>{s.name}</span>
                      <span class="flex items-center gap-2 min-w-0">
                        <span class="text-sm font-light" style="font-family: var(--font-serif); color: var(--color-stone-800);">{s.rating.toFixed(1)}</span>
                        <span class="flex gap-0.5">
                          {Array.from({ length: 5 }).map((_, i) => (
                            <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill={i < Math.round(s.rating) ? 'currentColor' : 'none'} stroke="currentColor" style={i < Math.round(s.rating) ? 'color: var(--color-gold-500);' : 'color: var(--color-stone-300);'}>
                              <path stroke-linejoin="round" d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 15l-5.3 2.8 1-5.8L1.5 7.7l5.9-.9z" />
                            </svg>
                          ))}
                        </span>
                        <span class="text-xs whitespace-nowrap" style="color: var(--color-stone-400);">({s.count})</span>
                      </span>
                    </span>
                    <span class="block mt-1 text-[10px] tracking-wide" style="color: var(--color-stone-400);">Verified {s.capturedAt}</span>
                  </a>
                ))
              ) : (
                <div class="p-4 border border-dashed border-stone-200 text-center">
                  <p class="text-sm text-stone-500">Public reviews coming soon.</p>
                  <p class="mt-1 text-xs text-stone-400">No ratings are published for this location yet.</p>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Google reviews -->
  <section class="py-24 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="max-w-2xl mb-12">
        <p class="text-xs tracking-[0.24em] uppercase mb-3" style="color: var(--color-gold-600); font-family: var(--font-sans);">Featured patient stories · Google</p>
        <h2 style="font-family: var(--font-serif);" class="text-3xl md:text-5xl font-light text-stone-800">Care that patients remember</h2>
        <p class="mt-4 text-sm leading-relaxed text-stone-500">Every story below is linked to the reviewer’s original public profile and source listing.</p>
      </div>
      <div class="grid lg:grid-cols-3 gap-6">
        {googleStories.map(({ review: r, clinic }, index) => (
          <figure class="group relative overflow-hidden border border-stone-200 bg-white flex min-h-[390px] flex-col shadow-[0_20px_60px_rgba(41,37,36,0.06)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_24px_70px_rgba(41,37,36,0.11)]">
            <div class="h-1 w-full" style={index === 1 ? 'background: var(--color-gold-500);' : 'background: var(--color-stone-800);'}></div>
            <div class="p-7 md:p-8 flex flex-1 flex-col">
              <div class="flex items-start justify-between gap-4">
                <div class="flex items-center gap-4 min-w-0">
                  <span class="relative flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-full border-4 border-white text-sm font-medium shadow-md" style="background: var(--color-stone-100); color: var(--color-stone-600);">
                    {initialsOf(r.author)}
                    {r.avatarUrl && <img src={r.avatarUrl} alt={`${r.author} Google profile`} class="absolute inset-0 h-full w-full object-cover" loading="lazy" referrerpolicy="no-referrer" />}
                  </span>
                  <figcaption class="min-w-0">
                    {r.authorProfileUrl ? (
                      <a href={r.authorProfileUrl} target="_blank" rel="noopener noreferrer" class="block truncate text-base font-medium text-stone-800 hover:underline">{r.author}</a>
                    ) : (
                      <span class="block truncate text-base font-medium text-stone-800">{r.author}</span>
                    )}
                    <span class="mt-1 block text-[10px] tracking-[0.2em] uppercase text-stone-400">Public Google profile</span>
                  </figcaption>
                </div>
                <span class="shrink-0 rounded-full px-3 py-1.5 text-[10px] font-semibold tracking-wider" style="background: #f3f7fe; color: #4285f4;">Google</span>
              </div>

              <div class="mt-8 flex items-center gap-0.5" aria-label={`${r.rating} out of 5 stars`}>
                {Array.from({ length: 5 }).map((_, i) => (
                  <svg class="w-4 h-4" viewBox="0 0 20 20" fill={i < r.rating ? 'currentColor' : 'none'} stroke="currentColor" style={i < r.rating ? 'color: var(--color-gold-500);' : 'color: var(--color-stone-300);'}>
                    <path stroke-linejoin="round" d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 15l-5.3 2.8 1-5.8L1.5 7.7l5.9-.9z" />
                  </svg>
                ))}
              </div>

              <blockquote class="relative mt-5 flex-1 text-xl font-light leading-relaxed text-stone-700" style="font-family: var(--font-serif);">
                <span class="absolute -left-1 -top-5 text-5xl leading-none opacity-20" aria-hidden="true" style="color: var(--color-gold-500);">“</span>
                <span class="relative">{r.quote}</span>
              </blockquote>

              <div class="mt-8 flex items-center justify-between gap-4 border-t border-stone-100 pt-5">
                <span>
                  <span class="block text-xs font-medium text-stone-700">{clinic.city}</span>
                  <span class="mt-0.5 block text-[10px] text-stone-400">{r.date}</span>
                </span>
                <a href={r.reviewUrl ?? clinic.sources.google?.url} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-[10px] tracking-[0.18em] uppercase transition group-hover:gap-3" style="color: var(--color-gold-600);">
                  View on Google
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                </a>
              </div>
            </div>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Yelp reviews -->
  <section class="py-20" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="mb-12">
        <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-stone-400); font-family: var(--font-sans);">From Yelp · By Location</p>
        <h2 style="font-family: var(--font-serif);" class="text-3xl md:text-4xl font-light text-stone-800">What patients say on Yelp</h2>
        <p class="mt-4 text-sm leading-relaxed text-stone-500">Only reviews with a public Yelp profile, profile photo, and source listing are featured.</p>
      </div>
      <div class="space-y-16">
        {yelpClinicGroups.map(({ clinic, reviews: clinicReviews }) => {
          const yelp = clinic.sources.yelp;
          return (
            <div>
              <div class="flex items-end justify-between mb-7 flex-wrap gap-4">
                <div>
                  <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-gold-600); font-family: var(--font-sans);">{clinic.city}</p>
                  <h3 style="font-family: var(--font-serif);" class="text-2xl font-light text-stone-800">{clinic.clinicName}</h3>
                </div>
                {yelp && (
                  <a href={yelp.url} target="_blank" rel="noopener noreferrer" class="text-xs tracking-widest uppercase flex items-center gap-2" style="color: var(--color-gold-600);">
                    All {yelp.count} Yelp reviews
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                  </a>
                )}
              </div>
              <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
                {clinicReviews.map((r) => (
                  <figure class="p-7 border border-stone-200 bg-white flex flex-col">
                    <div class="flex items-center justify-between mb-4">
                      <span class="text-sm font-semibold tracking-tight" style="color: #D32323; font-family: var(--font-sans);">Yelp</span>
                      <div class="flex gap-0.5" aria-label={`${r.rating} out of 5 stars`}>
                        {Array.from({ length: 5 }).map((_, i) => (
                          <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill={i < r.rating ? 'currentColor' : 'none'} stroke="currentColor" style={i < r.rating ? 'color: var(--color-gold-500);' : 'color: var(--color-stone-300);'}>
                            <path stroke-linejoin="round" d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 15l-5.3 2.8 1-5.8L1.5 7.7l5.9-.9z" />
                          </svg>
                        ))}
                      </div>
                    </div>
                    <blockquote class="text-stone-600 leading-relaxed flex-1 text-sm mb-5">"{r.quote}"</blockquote>
                    <figcaption class="flex items-center justify-between gap-4 pt-4 border-t border-stone-100">
                      <span class="flex items-center gap-3 min-w-0">
                        <span class="relative flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-full text-xs font-medium" style="background: var(--color-stone-100); color: var(--color-stone-600);">
                          {initialsOf(r.author)}
                          {r.avatarUrl && <img src={r.avatarUrl} alt={`${r.author} Yelp profile`} class="absolute inset-0 h-full w-full object-cover" loading="lazy" referrerpolicy="no-referrer" />}
                        </span>
                        <span class="min-w-0">
                          {r.authorProfileUrl ? (
                            <a href={r.authorProfileUrl} target="_blank" rel="noopener noreferrer" class="block truncate text-xs font-medium text-stone-700 hover:underline">{r.author}</a>
                          ) : (
                            <span class="block truncate text-xs font-medium text-stone-700">{r.author}</span>
                          )}
                          <span class="block text-[10px] tracking-widest uppercase" style="color: var(--color-stone-400);">{clinic.city}</span>
                        </span>
                      </span>
                      <span class="text-xs shrink-0" style="color: var(--color-stone-400);">{r.date}</span>
                    </figcaption>
                    <a href={r.reviewUrl ?? yelp?.url} target="_blank" rel="noopener noreferrer" class="mt-4 text-[10px] tracking-widest uppercase" style="color: var(--color-gold-600);">View on Yelp →</a>
                  </figure>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Disclaimer -->
  <section class="py-10 bg-white">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <p class="text-xs leading-relaxed" style="color: var(--color-stone-400);">
        Ratings and review counts are drawn from the public Google and Yelp profiles of Incinta Fertility Center and its affiliated Reproductive Fertility Center (RFC Family) locations, and are shown as displayed at the time of writing. Excerpts are reproduced as posted; some are shortened with an ellipsis. Individual results vary — reviews reflect personal experiences and are not a guarantee of outcomes.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10 text-center">
      <h2 style="font-family: var(--font-serif);" class="text-4xl font-light text-stone-800 mb-4">Your Story Starts Here</h2>
      <p class="text-sm leading-relaxed mb-8 max-w-lg mx-auto" style="color: var(--color-stone-500);">
        Every journey on this page began with one decision: to make an appointment. We'd be honored to be part of yours.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/appointment" class="btn-primary">Schedule an In-Person Visit</a>
        <a href="/consultation" class="btn-outline">Phone &amp; Online Consultation</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
