---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL } from '../config/brand';
import { reviews, reviewSources } from '../data/testimonials';

const googleReviews = reviews.filter((r) => r.source === 'google');
const yelpReviews = reviews.filter((r) => r.source === 'yelp');

// Aggregate rating across both public profiles + a sample of individual reviews,
// emitted as Review/AggregateRating JSON-LD to enable star rich results.
const totalCount = reviewSources.google.count + reviewSources.yelp.count;
const weighted =
  reviewSources.google.rating * reviewSources.google.count +
  reviewSources.yelp.rating * reviewSources.yelp.count;
const aggregateRating = Number((weighted / totalCount).toFixed(2));

const reviewSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Incinta Reproductive Fertility Center',
  url: SITE_URL,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: aggregateRating,
    reviewCount: totalCount,
    bestRating: 5,
  },
  review: reviews.slice(0, 8).map((r) => ({
    '@type': 'Review',
    author: { '@type': 'Person', name: r.author },
    datePublished: r.date,
    reviewBody: r.quote,
    reviewRating: { '@type': 'Rating', ratingValue: r.rating, bestRating: 5 },
  })),
};
---

<Layout
  title="Real Patient Reviews — IRFC on Google & Yelp"
  description="Real patient reviews of Incinta Fertility Center from public Google and Yelp profiles — verbatim excerpts with star ratings, names, and dates, linked back to the source."
  schema={reviewSchema}
>
  <Nav />

  <!-- Hero -->
  <section class="pt-40 pb-0 bg-white overflow-hidden">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-2 gap-12 items-end">
        <div class="pb-20">
          <div class="flex items-center gap-3 mb-6">
            <div class="h-px w-12" style="background: var(--color-gold-500);"></div>
            <span class="text-xs tracking-widest uppercase" style="color: var(--color-gold-600); font-family: var(--font-sans);">Real Patient Reviews</span>
          </div>
          <h1 style="font-family: var(--font-serif);" class="text-5xl md:text-6xl font-light text-stone-800 mb-6 leading-none">
            In Their<br/>
            <em class="not-italic" style="color: var(--color-gold-500);">Own Words.</em>
          </h1>
          <p class="text-lg text-stone-500 font-light leading-relaxed max-w-2xl">
            We let our patients speak for us. Every review below is a verbatim excerpt from our public Google and Yelp profiles — with the star rating, name, and date exactly as posted, and a link back to the original.
          </p>
        </div>
        <div class="hidden lg:block overflow-hidden" style="max-height: 480px;">
          <img
            src="/images/patient-portrait.webp" srcset="/images/patient-portrait-800.webp 800w, /images/patient-portrait-1280.webp 1280w, /images/patient-portrait.webp 2400w" sizes="(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 1200px"
            alt="IRFC patient"
            class="w-full h-full object-cover object-top"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Aggregate -->
  <section class="py-16" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="grid sm:grid-cols-2 gap-6 max-w-3xl mx-auto">
        {Object.values(reviewSources).map((s) => (
          <a href={s.url} target="_blank" rel="noopener noreferrer" class="flex items-center gap-5 p-6 border border-stone-200 bg-white hover:border-stone-300 transition">
            <span class="text-2xl font-semibold tracking-tight" style={`color: ${s.color}; font-family: var(--font-sans);`}>{s.name}</span>
            <div class="flex-1">
              <div class="flex items-center gap-2">
                <span class="text-3xl font-light" style="font-family: var(--font-serif); color: var(--color-stone-800);">{s.rating.toFixed(1)}</span>
                <div class="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <svg class="w-4 h-4" viewBox="0 0 20 20" fill={i < Math.round(s.rating) ? 'currentColor' : 'none'} stroke="currentColor" style={i < Math.round(s.rating) ? 'color: var(--color-gold-500);' : 'color: var(--color-stone-300);'}>
                      <path stroke-linejoin="round" d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 15l-5.3 2.8 1-5.8L1.5 7.7l5.9-.9z" />
                    </svg>
                  ))}
                </div>
              </div>
              <p class="text-xs" style="color: var(--color-stone-400);">{s.count} reviews · Read on {s.name}</p>
            </div>
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color: var(--color-stone-400);"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Google reviews -->
  <section class="py-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="flex items-end justify-between mb-12 flex-wrap gap-4">
        <div>
          <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-stone-400); font-family: var(--font-sans);">From Google</p>
          <h2 style="font-family: var(--font-serif);" class="text-3xl md:text-4xl font-light text-stone-800">What patients say on Google</h2>
        </div>
        <a href={reviewSources.google.url} target="_blank" rel="noopener noreferrer" class="text-xs tracking-widest uppercase flex items-center gap-2" style="color: var(--color-gold-600);">
          All {reviewSources.google.count} Google reviews
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {googleReviews.map((r) => (
          <figure class="p-7 border border-stone-200 bg-white flex flex-col">
            <div class="flex items-center justify-between mb-4">
              <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor" style="color: var(--color-gold-500);"><path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 15l-5.3 2.8 1-5.8L1.5 7.7l5.9-.9z"/></svg>
              <div class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill={i < r.rating ? 'currentColor' : 'none'} stroke="currentColor" style={i < r.rating ? 'color: var(--color-gold-500);' : 'color: var(--color-stone-300);'}>
                    <path stroke-linejoin="round" d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 15l-5.3 2.8 1-5.8L1.5 7.7l5.9-.9z" />
                  </svg>
                ))}
              </div>
            </div>
            <blockquote class="text-stone-600 leading-relaxed flex-1 text-sm mb-5">"{r.quote}"</blockquote>
            <figcaption class="flex items-center justify-between pt-4 border-t border-stone-100">
              <span class="text-xs font-medium text-stone-700">{r.author}</span>
              <span class="text-xs" style="color: var(--color-stone-400);">{r.date}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Yelp reviews -->
  <section class="py-20" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="flex items-end justify-between mb-12 flex-wrap gap-4">
        <div>
          <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-stone-400); font-family: var(--font-sans);">From Yelp</p>
          <h2 style="font-family: var(--font-serif);" class="text-3xl md:text-4xl font-light text-stone-800">What patients say on Yelp</h2>
        </div>
        <a href={reviewSources.yelp.url} target="_blank" rel="noopener noreferrer" class="text-xs tracking-widest uppercase flex items-center gap-2" style="color: var(--color-gold-600);">
          All {reviewSources.yelp.count} Yelp reviews
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {yelpReviews.map((r) => (
          <figure class="p-7 border border-stone-200 bg-white flex flex-col">
            <div class="flex items-center justify-between mb-4">
              <span class="text-sm font-semibold tracking-tight" style="color: #D32323; font-family: var(--font-sans);">Yelp</span>
              <div class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill={i < r.rating ? 'currentColor' : 'none'} stroke="currentColor" style={i < r.rating ? 'color: var(--color-gold-500);' : 'color: var(--color-stone-300);'}>
                    <path stroke-linejoin="round" d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 15l-5.3 2.8 1-5.8L1.5 7.7l5.9-.9z" />
                  </svg>
                ))}
              </div>
            </div>
            <blockquote class="text-stone-600 leading-relaxed flex-1 text-sm mb-5">"{r.quote}"</blockquote>
            <figcaption class="flex items-center justify-between pt-4 border-t border-stone-100">
              <span class="text-xs font-medium text-stone-700">{r.author}</span>
              <span class="text-xs" style="color: var(--color-stone-400);">{r.date}</span>
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="mt-6 text-center text-sm" style="color: var(--color-stone-500);">
        Want to see more? <a href={reviewSources.yelp.url} target="_blank" rel="noopener noreferrer" class="underline" style="color: var(--color-gold-600);">Read all {reviewSources.yelp.count} reviews on Yelp</a>.
      </p>
    </div>
  </section>

  <!-- Disclaimer -->
  <section class="py-10 bg-white">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <p class="text-xs leading-relaxed" style="color: var(--color-stone-400);">
        These are real excerpts from public Google and Yelp reviews of Incinta Fertility Center, used with attribution. Quotes are reproduced as posted; some are shortened with an ellipsis. Individual results vary — reviews reflect personal experiences and are not a guarantee of outcomes.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10 text-center">
      <h2 style="font-family: var(--font-serif);" class="text-4xl font-light text-stone-800 mb-4">Your Story Starts Here</h2>
      <p class="text-sm leading-relaxed mb-8 max-w-lg mx-auto" style="color: var(--color-stone-500);">
        Every journey on this page began with one decision: to make an appointment. We'd be honored to be part of yours.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/appointment" class="btn-primary">Schedule an In-Person Visit</a>
        <a href="/consultation" class="btn-outline">Phone &amp; Online Consultation</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
