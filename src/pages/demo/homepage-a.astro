---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="IRFC — Southern California IVF & Fertility Specialists"
  description="Award-winning IVF and fertility care across Southern California. Free initial consultations."
>
  <Nav />

  <!-- ① HERO — full viewport, pure cream, typography only -->
  <section class="hero-section" style="min-height: 100vh; background: #fdfaf3; display: flex; flex-direction: column; justify-content: flex-end; padding: 0 10vw 5.5rem; position: relative; overflow: hidden;">

    <!-- Watermark -->
    <div aria-hidden="true" style="position: absolute; top: 50%; right: -2vw; transform: translateY(-50%); font-family: var(--font-serif); font-size: 38vw; font-weight: 300; color: rgba(198,173,92,0.045); line-height: 1; pointer-events: none; user-select: none; letter-spacing: -0.05em;">✦</div>

    <!-- Eyebrow -->
    <p style="font-size: 0.6rem; letter-spacing: 0.35em; text-transform: uppercase; color: var(--color-stone-400); font-family: var(--font-sans); margin-bottom: 2.5rem;">
      Incinta Fertility &nbsp;·&nbsp; Reproductive Fertility Center &nbsp;·&nbsp; Southern California
    </p>

    <!-- Headline -->
    <h1 style="font-family: var(--font-serif); font-weight: 300; line-height: 0.9; color: var(--color-stone-800); margin-bottom: 4.5rem; letter-spacing: -0.01em;">
      <span style="display: block; font-size: clamp(3.2rem, 9.2vw, 10rem);">Where Science</span>
      <span style="display: block; font-size: clamp(3.2rem, 9.2vw, 10rem); color: var(--color-gold-600); font-style: italic;">Meets</span>
      <span style="display: block; font-size: clamp(3.2rem, 9.2vw, 10rem);">Compassion.</span>
    </h1>

    <!-- Rule + CTAs -->
    <div style="display: flex; align-items: center; gap: 2.5rem; margin-bottom: 4.5rem; flex-wrap: wrap;">
      <div style="width: 5rem; height: 1px; background: var(--color-gold-500); flex-shrink: 0;"></div>
      <a href="/contact" class="btn-primary">Schedule a Free Consultation</a>
      <a href="/about" class="btn-outline">Our Story</a>
    </div>

    <!-- Stats row -->
    <div style="display: flex; border-top: 1px solid var(--color-stone-200); overflow-x: auto;">
      {[
        { num: '20+',  label: 'Years of Excellence',    color: 'var(--color-gold-600)' },
        { num: '#1',   label: 'US IVF Lab · 2016',      color: 'var(--color-purple-400)' },
        { num: '5',    label: 'SoCal Locations',         color: 'var(--color-gold-600)' },
        { num: 'Free', label: 'Initial Consultation',    color: 'var(--color-gold-600)' },
      ].map((s, i) => (
        <div style={`padding: 1.75rem 2.5rem; border-right: 1px solid var(--color-stone-200); flex-shrink: 0; ${i === 0 ? 'padding-left: 0;' : ''}`}>
          <p style={`font-family: var(--font-serif); font-size: 1.75rem; font-weight: 300; margin-bottom: 0.3rem; color: ${s.color};`}>{s.num}</p>
          <p style="font-size: 0.58rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-stone-400); font-family: var(--font-sans);">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ② IMAGE REVEAL -->
  <section style="line-height: 0; overflow: hidden;">
    <img
      src="/images/lobby-wide.jpg"
      alt="IRFC Clinic Interior"
      style="width: 100%; height: 78vh; object-fit: cover; object-position: center; display: block;"
    />
  </section>

  <!-- ③ MISSION QUOTE -->
  <section style="padding: 9rem 10vw; background: white; text-align: center;">
    <div style="max-width: 820px; margin: 0 auto;">
      <div style="width: 3rem; height: 1px; background: var(--color-gold-500); margin: 0 auto 4rem;"></div>
      <blockquote style="font-family: var(--font-serif); font-size: clamp(1.5rem, 3vw, 2.75rem); font-weight: 300; line-height: 1.35; color: var(--color-stone-800); font-style: italic; margin: 0 0 2rem;">
        "A fertility clinic should feel like<br/>both a family and a home."
      </blockquote>
      <cite style="font-size: 0.58rem; letter-spacing: 0.28em; text-transform: uppercase; color: var(--color-stone-400); font-family: var(--font-sans); font-style: normal;">
        — Dr. James P. Lin &nbsp;·&nbsp; Founder &amp; Medical Director
      </cite>
    </div>
  </section>

  <!-- ④ SERVICES INDEX -->
  <section style="padding: 0 10vw 9rem; background: white;">
    <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 2.5rem;">
      <p style="font-size: 0.58rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--color-stone-400); font-family: var(--font-sans);">Treatments &amp; Services</p>
      <a href="/services" style="font-size: 0.58rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-gold-600); font-family: var(--font-sans); text-decoration: none; display: flex; align-items: center; gap: 0.4rem;">
        All Services
        <svg width="10" height="10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
    <div class="services-grid" style="border: 1px solid var(--color-stone-200);">
      {[
        { abbr: 'IVF',     title: 'In Vitro Fertilization',      href: '/services/ivf' },
        { abbr: 'PGT',     title: 'Genetic Testing',              href: '/services/pgt' },
        { abbr: 'Cryo',    title: 'Fertility Preservation',       href: '/services/egg-freezing' },
        { abbr: 'IUI',     title: 'Intrauterine Insemination',    href: '/services/iui' },
        { abbr: 'Donor',   title: 'Donors &amp; Surrogacy',       href: '/services#donors' },
        { abbr: 'Surgical','title': 'Minimally Invasive Surgery', href: '/services#surgical' },
      ].map((s) => (
        <a href={s.href} class="service-cell" style="padding: 2.25rem 2rem; border-right: 1px solid var(--color-stone-200); border-bottom: 1px solid var(--color-stone-200); display: flex; flex-direction: column; gap: 0.6rem; text-decoration: none; background: white; transition: background 0.2s;">
          <span style="font-size: 0.56rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--color-stone-400); font-family: var(--font-sans);">{s.abbr}</span>
          <span style="font-family: var(--font-serif); font-size: 1.2rem; font-weight: 300; color: var(--color-stone-800);" set:html={s.title}></span>
          <span style="font-size: 0.54rem; letter-spacing: 0.2em; color: var(--color-gold-600); font-family: var(--font-sans); text-transform: uppercase; margin-top: 0.4rem; display: flex; align-items: center; gap: 0.4rem;">
            Learn more
            <svg width="9" height="9" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- ⑤ TEAM — editorial portrait strip -->
  <section style="padding: 8rem 10vw; background: #fdfaf3;">
    <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 4rem;">
      <p style="font-size: 0.58rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--color-stone-400); font-family: var(--font-sans);">Medical Leadership</p>
      <a href="/team" style="font-size: 0.58rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-gold-600); font-family: var(--font-sans); text-decoration: none; display: flex; align-items: center; gap: 0.4rem;">
        Full Team
        <svg width="10" height="10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>

    <div class="team-grid">
      {[
        {
          name: 'James P. Lin, MD',
          role: 'Founder & Medical Director',
          note: '20+ Years · Kaiser Permanente COE',
          photo: '/images/team/dr-james-lin-circle.png',
          href: '/team/dr-james-lin',
        },
        {
          name: 'Zitao Liu, MD',
          role: 'Associate Chief Medical Officer',
          note: 'Now Accepting New Patients',
          photo: '/images/team/dr-zitao-liu-circle.png',
          href: '/team/dr-zitao-liu',
          badge: true,
        },
        {
          name: 'Yufen Xie, PhD',
          role: 'IVF Laboratory Director',
          note: '#1 US IVF Lab · 2016',
          photo: '/images/team/dr-yufen-xie.png',
          href: '/team/dr-yufen-xie',
        },
      ].map((doc) => (
        <a href={doc.href} class="team-card" style="display: block; text-decoration: none; overflow: hidden;">
          <div style="overflow: hidden; margin-bottom: 1.25rem;">
            <img
              src={doc.photo}
              alt={doc.name}
              class="team-photo"
              style="width: 100%; aspect-ratio: 3 / 4; object-fit: cover; object-position: center top; display: block; transition: transform 0.6s ease;"
            />
          </div>
          <p style="font-family: var(--font-serif); font-size: 1.15rem; font-weight: 300; color: var(--color-stone-800); margin-bottom: 0.25rem;">{doc.name}</p>
          <p style="font-size: 0.57rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-stone-400); font-family: var(--font-sans); margin-bottom: 0.6rem;">{doc.role}</p>
          <p style={`font-size: 0.6rem; letter-spacing: 0.08em; font-family: var(--font-sans); color: ${doc.badge ? 'var(--color-purple-500)' : 'var(--color-stone-400)'};`}>{doc.note}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- ⑥ RECOGNITION STRIP -->
  <section style="padding: 2.25rem 10vw; background: white; border-top: 1px solid var(--color-stone-100); border-bottom: 1px solid var(--color-stone-100); overflow: hidden;">
    <div style="display: flex; align-items: center; gap: 3rem; overflow-x: auto; scrollbar-width: none;">
      <p style="font-size: 0.55rem; letter-spacing: 0.28em; text-transform: uppercase; color: var(--color-stone-400); font-family: var(--font-sans); flex-shrink: 0; white-space: nowrap;">Recognition</p>
      <div style="width: 1px; height: 1.75rem; background: var(--color-stone-200); flex-shrink: 0;"></div>
      {[
        'Kaiser Permanente Center of Excellence',
        '#1 US IVF Laboratory — SART 2016',
        'CAP / CLIA Accredited Laboratory',
        'Fairfax EggBank Premier Partner',
        'Top IVF Center — IVF Authority',
      ].map(rec => (
        <div style="display: flex; align-items: center; gap: 0.55rem; flex-shrink: 0;">
          <div style="width: 4px; height: 4px; background: var(--color-gold-400); flex-shrink: 0; border-radius: 50%;"></div>
          <span style="font-size: 0.65rem; color: var(--color-stone-500); white-space: nowrap; font-family: var(--font-sans);">{rec}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ⑦ LOCATIONS — minimal list -->
  <section style="padding: 7rem 10vw; background: white;">
    <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 6rem; align-items: start;">
      <div>
        <div style="width: 2.5rem; height: 1px; background: var(--color-gold-500); margin-bottom: 1.5rem;"></div>
        <h2 style="font-family: var(--font-serif); font-size: clamp(2rem, 3.5vw, 3rem); font-weight: 300; color: var(--color-stone-800); line-height: 1.1; margin-bottom: 1.5rem;">
          Five Locations<br/>Across Southern<br/>California
        </h2>
        <a href="/locations" class="btn-outline" style="margin-top: 1rem;">View All Locations</a>
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0; border: 1px solid var(--color-stone-200);">
        {[
          { city: 'Torrance',     phone: '(424) 212-4087', types: 'Clinic' },
          { city: 'Alhambra',     phone: '(626) 588-2885', types: 'Clinic' },
          { city: 'Beverly Hills',phone: '(213) 600-8088', types: 'Clinic' },
          { city: 'Corona',       phone: '(951) 272-2221', types: 'Clinic · Surgery · Lab' },
          { city: 'Irvine',       phone: '(949) 453-8600', types: 'Clinic · Surgery · Lab' },
        ].map((loc, i) => (
          <a href="/locations" style={`padding: 1.75rem; border-right: 1px solid var(--color-stone-200); border-bottom: 1px solid var(--color-stone-200); text-decoration: none; display: block; background: white; transition: background 0.2s; ${i === 4 ? 'grid-column: span 2;' : ''}`}
            onmouseenter="this.style.background='var(--color-stone-50)'"
            onmouseleave="this.style.background='white'">
            <p style="font-family: var(--font-serif); font-size: 1.05rem; font-weight: 300; color: var(--color-stone-800); margin-bottom: 0.3rem;">{loc.city}</p>
            <p style="font-size: 0.56rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-stone-400); font-family: var(--font-sans); margin-bottom: 0.5rem;">{loc.types}</p>
            <p style="font-size: 0.8rem; color: var(--color-gold-600);">{loc.phone}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ⑧ CTA — dark stone -->
  <section style="padding: 9rem 10vw; background: #1c1917; text-align: center; position: relative; overflow: hidden;">
    <div aria-hidden="true" style="position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 60%, rgba(198,173,92,0.07) 0%, transparent 60%); pointer-events: none;"></div>
    <div style="position: relative; z-index: 1; max-width: 600px; margin: 0 auto;">
      <div style="display: flex; align-items: center; justify-content: center; gap: 1.5rem; margin-bottom: 2.5rem;">
        <div style="height: 1px; width: 3rem; background: linear-gradient(90deg, transparent, var(--color-gold-500));"></div>
        <span style="font-size: 0.57rem; letter-spacing: 0.32em; text-transform: uppercase; color: var(--color-gold-400); font-family: var(--font-sans);">Begin Your Journey</span>
        <div style="height: 1px; width: 3rem; background: linear-gradient(90deg, var(--color-gold-500), transparent);"></div>
      </div>
      <h2 style="font-family: var(--font-serif); font-size: clamp(2.2rem, 5vw, 4rem); font-weight: 300; color: white; line-height: 1.1; margin-bottom: 1rem;">
        Your Family<br/>Starts Here
      </h2>
      <p style="font-size: 0.78rem; color: rgba(255,255,255,0.45); font-family: var(--font-sans); letter-spacing: 0.06em; margin-bottom: 3rem;">
        Free initial consultation · Board-certified physicians · 5 Southern California locations
      </p>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="/contact" class="btn-primary">Schedule Free Consultation</a>
        <a href="tel:+19494538600" style="border: 1px solid rgba(255,255,255,0.22); color: rgba(255,255,255,0.75); padding: 0.875rem 1.75rem; font-size: 0.72rem; letter-spacing: 0.12em; text-decoration: none; text-transform: uppercase; font-family: var(--font-sans); transition: border-color 0.2s;"
          onmouseenter="this.style.borderColor='rgba(255,255,255,0.5)'"
          onmouseleave="this.style.borderColor='rgba(255,255,255,0.22)'">
          Call (949) 453-8600
        </a>
      </div>
      <p style="margin-top: 2rem; font-size: 0.58rem; color: rgba(255,255,255,0.28); font-family: var(--font-sans); letter-spacing: 0.1em;">
        Telehealth available for out-of-area patients
      </p>
    </div>
  </section>

  <Footer />

  <!-- Demo badge -->
  <div style="position: fixed; bottom: 1.25rem; right: 1.25rem; z-index: 9999; background: var(--color-stone-900); color: rgba(255,255,255,0.7); font-size: 0.55rem; letter-spacing: 0.18em; text-transform: uppercase; padding: 0.45rem 0.9rem; font-family: var(--font-sans); border: 1px solid rgba(255,255,255,0.1);">
    Demo A — Editorial
  </div>
</Layout>

<style>
  .hero-section {
    padding-top: 7rem;
  }

  .team-card:hover .team-photo {
    transform: scale(1.04);
  }

  .service-cell:hover {
    background: var(--color-stone-50) !important;
  }

  /* Services 3-col grid */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  /* Team 3-col grid */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  @media (max-width: 900px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .services-grid,
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
