---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="IRFC — Southern California IVF & Fertility Specialists"
  description="Award-winning IVF and fertility care across Southern California. Free initial consultations."
>
  <!-- ─── DEMO NAV ─────────────────────────────────── -->
  <header id="demo-nav" class="dnav">
    <!-- Logo -->
    <a href="/" class="dnav-logo" aria-label="IRFC Home">
      <div class="dnav-logo-wrap">
        <img src="/images/irfc-logo.svg"       alt="IRFC" class="dnav-logo-img dnav-logo-color" />
        <img src="/images/irfc-logo-white.svg" alt="IRFC" class="dnav-logo-img dnav-logo-white" />
      </div>
    </a>

    <!-- Links -->
    <nav class="dnav-links" aria-label="Main navigation">
      <a href="/about">About</a>
      <a href="/services">Services</a>
      <a href="/outcomes">Success Rates</a>
      <a href="/team">Team</a>
      <a href="/locations">Locations</a>
    </nav>

    <!-- Right -->
    <div class="dnav-right">
      <a href="tel:+19494538600" class="dnav-phone">(949) 453-8600</a>
      <a href="/contact" class="dnav-cta">Book Consultation</a>
    </div>
  </header>

  <!-- ① HERO -->
  <section class="hero">
    <img src="/images/lobby-wide.jpg" alt="IRFC Clinic" class="hero-bg" />
    <div class="hero-overlay"></div>

    <!-- top-left eyebrow (above the fold, readable against light area) -->
    <div class="hero-top">
      <span class="hero-eyebrow">
        <span class="hero-eyebrow-line"></span>
        Incinta Fertility &nbsp;·&nbsp; Reproductive Fertility Center &nbsp;·&nbsp; Southern California
      </span>
    </div>

    <!-- main text: bottom-left -->
    <div class="hero-body">
      <h1 class="hero-h1">
        <span>Where</span>
        <span>Science <em>Meets</em></span>
        <span>Compassion.</span>
      </h1>
      <div class="hero-ctas">
        <a href="/contact" class="btn-primary">
          Schedule a Free Consultation
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href="/about" class="hero-ghost-btn">Our Story</a>
      </div>
    </div>
  </section>

  <!-- Stats strip -->
  <div class="hero-stats">
    <div class="hero-stat">
      <strong>20+</strong><span>Years of Excellence</span>
    </div>
    <div class="hero-stat hero-stat--purple">
      <strong>#1</strong><span>US IVF Lab · 2016</span>
    </div>
    <div class="hero-stat">
      <strong>5</strong><span>SoCal Locations</span>
    </div>
    <div class="hero-stat">
      <strong>Free</strong><span>Initial Consultation</span>
    </div>
  </div>

  <!-- ② QUOTE -->
  <section class="quote-section">
    <div class="quote-inner">
      <div class="section-rule"></div>
      <blockquote>
        "A fertility clinic should feel like<br/>both a family and a home."
      </blockquote>
      <cite>— Dr. James P. Lin &nbsp;·&nbsp; Founder &amp; Medical Director</cite>
    </div>
  </section>

  <!-- ③ SERVICES -->
  <section class="services-section">
    <div class="services-header">
      <p class="label">Treatments &amp; Services</p>
      <a href="/services" class="label-link">
        All Services
        <svg width="10" height="10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
    <div class="services-grid">
      {[
        { abbr: 'IVF',      title: 'In Vitro Fertilization',      href: '/services/ivf' },
        { abbr: 'PGT',      title: 'Genetic Testing',              href: '/services/pgt' },
        { abbr: 'Cryo',     title: 'Fertility Preservation',       href: '/services/egg-freezing' },
        { abbr: 'IUI',      title: 'Intrauterine Insemination',    href: '/services/iui' },
        { abbr: 'Donor',    title: 'Donors & Surrogacy',           href: '/services#donors' },
        { abbr: 'Surgical', title: 'Minimally Invasive Surgery',   href: '/services#surgical' },
      ].map(s => (
        <a href={s.href} class="service-cell">
          <span class="service-abbr">{s.abbr}</span>
          <span class="service-title">{s.title}</span>
          <span class="service-arrow">
            Learn more
            <svg width="9" height="9" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- ④ TEAM -->
  <section class="team-section">
    <div class="team-header">
      <p class="label">Medical Leadership</p>
      <a href="/team" class="label-link">
        Full Team
        <svg width="10" height="10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
    <div class="team-grid">
      {[
        { name: 'James P. Lin, MD',  role: 'Founder & Medical Director',     note: '20+ Years · Kaiser Permanente COE',    photo: '/images/team/dr-james-lin-circle.png',  href: '/team/dr-james-lin' },
        { name: 'Zitao Liu, MD',     role: 'Associate Chief Medical Officer', note: 'Now Accepting New Patients',           photo: '/images/team/dr-zitao-liu-circle.png',  href: '/team/dr-zitao-liu', accent: true },
        { name: 'Yufen Xie, PhD',    role: 'IVF Laboratory Director',         note: '#1 US IVF Lab · 2016',                 photo: '/images/team/dr-yufen-xie.png',          href: '/team/dr-yufen-xie' },
      ].map(doc => (
        <a href={doc.href} class="team-card">
          <div class="team-photo-wrap">
            <img src={doc.photo} alt={doc.name} class="team-photo" />
          </div>
          <p class="team-name">{doc.name}</p>
          <p class="team-role">{doc.role}</p>
          <p class={`team-note ${doc.accent ? 'team-note--accent' : ''}`}>{doc.note}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- ⑤ RECOGNITION -->
  <section class="recognition-section">
    <p class="label">Recognition</p>
    <div class="recognition-divider"></div>
    <div class="recognition-list">
      {[
        'Kaiser Permanente Center of Excellence',
        '#1 US IVF Laboratory — SART 2016',
        'CAP / CLIA Accredited Laboratory',
        'Fairfax EggBank Premier Partner',
        'Top IVF Center — IVF Authority',
      ].map(rec => (
        <div class="recognition-item">
          <div class="recognition-dot"></div>
          <span>{rec}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ⑥ LOCATIONS -->
  <section class="locations-section">
    <div class="locations-intro">
      <div class="section-rule"></div>
      <h2>Five Locations<br/>Across Southern<br/>California</h2>
      <a href="/locations" class="btn-outline">View All Locations</a>
    </div>
    <div class="locations-grid">
      {[
        { city: 'Torrance',      phone: '(424) 212-4087', types: 'Clinic' },
        { city: 'Alhambra',      phone: '(626) 588-2885', types: 'Clinic' },
        { city: 'Beverly Hills', phone: '(213) 600-8088', types: 'Clinic' },
        { city: 'Corona',        phone: '(951) 272-2221', types: 'Clinic · Surgery · Lab' },
        { city: 'Irvine',        phone: '(949) 453-8600', types: 'Clinic · Surgery · Lab' },
      ].map(loc => (
        <a href="/locations" class="location-cell">
          <p class="location-city">{loc.city}</p>
          <p class="location-types">{loc.types}</p>
          <p class="location-phone">{loc.phone}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- ⑦ CTA -->
  <section class="cta-section">
    <div class="cta-glow"></div>
    <div class="cta-inner">
      <div class="cta-eyebrow">
        <div class="cta-rule-left"></div>
        <span>Begin Your Journey</span>
        <div class="cta-rule-right"></div>
      </div>
      <h2>Your Family<br/>Starts Here</h2>
      <p class="cta-sub">Free initial consultation · Board-certified physicians · 5 Southern California locations</p>
      <div class="cta-btns">
        <a href="/contact" class="btn-primary">Schedule Free Consultation</a>
        <a href="tel:+19494538600" class="cta-phone-btn">Call (949) 453-8600</a>
      </div>
      <p class="cta-foot">Telehealth available for out-of-area patients</p>
    </div>
  </section>

  <Footer />

  <div class="demo-badge">Demo A — Editorial</div>
</Layout>

<script>
  const nav = document.getElementById('demo-nav');
  const onScroll = () => {
    if (window.scrollY > 40) {
      nav?.classList.add('dnav--solid');
    } else {
      nav?.classList.remove('dnav--solid');
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll(); // run once on load
</script>

<style>
/* ═══════════════════════════════════════════
   DEMO NAV
═══════════════════════════════════════════ */
.dnav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  height: 4.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10vw;
  /* starts transparent */
  background: transparent;
  border-bottom: 1px solid transparent;
  transition:
    background  0.4s ease,
    border-color 0.4s ease,
    backdrop-filter 0.4s ease;
}

/* Scrolled state */
.dnav--solid {
  background: rgba(253,250,243,0.97);
  border-bottom-color: var(--color-stone-200);
  backdrop-filter: blur(12px);
}

/* Logo */
.dnav-logo { display: block; flex-shrink: 0; }

.dnav-logo-wrap {
  position: relative;
  height: 2.4rem;
  width: 10rem;   /* enough for the logo SVG */
}

.dnav-logo-img {
  position: absolute;
  inset: 0;
  height: 100%;
  width: auto;
  object-fit: contain;
  object-position: left center;
  transition: opacity 0.35s ease;
}

/* Transparent: show white; Solid: show color */
.dnav-logo-color { opacity: 0; }
.dnav-logo-white { opacity: 1; }

.dnav--solid .dnav-logo-color { opacity: 1; }
.dnav--solid .dnav-logo-white { opacity: 0; }

/* Nav links */
.dnav-links {
  display: flex;
  align-items: center;
  gap: 2.5rem;
}

.dnav-links a {
  font-size: 0.6rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  font-family: var(--font-sans);
  text-decoration: none;
  color: rgba(255,255,255,0.8);
  transition: color 0.3s;
  white-space: nowrap;
}

.dnav--solid .dnav-links a {
  color: var(--color-stone-600);
}

.dnav-links a:hover {
  color: var(--color-gold-400) !important;
}

/* Right side */
.dnav-right {
  display: flex;
  align-items: center;
  gap: 1.75rem;
  flex-shrink: 0;
}

.dnav-phone {
  font-size: 0.62rem;
  letter-spacing: 0.08em;
  font-family: var(--font-sans);
  text-decoration: none;
  color: rgba(255,255,255,0.6);
  transition: color 0.3s;
  white-space: nowrap;
}

.dnav--solid .dnav-phone {
  color: var(--color-stone-500);
}

.dnav-phone:hover { color: var(--color-gold-400) !important; }

/* CTA button */
.dnav-cta {
  display: inline-flex;
  align-items: center;
  font-size: 0.6rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  font-family: var(--font-sans);
  text-decoration: none;
  padding: 0.6rem 1.4rem;
  border: 1px solid rgba(255,255,255,0.45);
  color: rgba(255,255,255,0.9);
  transition: border-color 0.3s, color 0.3s, background 0.3s;
  white-space: nowrap;
}

.dnav--solid .dnav-cta {
  border-color: var(--color-gold-500);
  color: var(--color-gold-700);
  background: transparent;
}

.dnav-cta:hover {
  border-color: var(--color-gold-400) !important;
  color: var(--color-gold-400) !important;
}

/* Hide desktop nav on mobile */
@media (max-width: 900px) {
  .dnav-links,
  .dnav-phone { display: none; }
  .dnav { padding: 0 6vw; }
}

/* ═══════════════════════════════════════════
   HERO
═══════════════════════════════════════════ */
.hero {
  position: relative;
  height: 100vh;
  min-height: 600px;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: right center;
}

/*
  Two-layer overlay:
  1. Bottom vignette: transparent → dark, starts at 45% — for text readability
  2. Left tint: very subtle darkening on the left so white text pops
*/
.hero-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      to bottom,
      transparent          0%,
      transparent          38%,
      rgba(10,7,4,0.38)    62%,
      rgba(10,7,4,0.78)   100%
    ),
    linear-gradient(
      to right,
      rgba(10,7,4,0.22)   0%,
      rgba(10,7,4,0.08)  40%,
      transparent        70%
    );
}

/* Eyebrow — top-left, sits in the bright upper area */
.hero-top {
  position: absolute;
  top: 7rem;           /* below transparent nav (4.5rem) + breathing room */
  left: 10vw;
  z-index: 2;
}

.hero-eyebrow {
  display: flex;
  align-items: center;
  gap: 1rem;
  font-size: 0.56rem;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.75);
  font-family: var(--font-sans);
}

.hero-eyebrow-line {
  display: inline-block;
  width: 2.5rem;
  height: 1px;
  background: var(--color-gold-400);
  flex-shrink: 0;
}

/* Main text — bottom-left */
.hero-body {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 2;
  padding: 0 10vw 5rem;
}

.hero-h1 {
  font-family: var(--font-serif);
  font-weight: 300;
  line-height: 0.88;
  color: white;
  margin-bottom: 3rem;
  letter-spacing: -0.015em;
}

.hero-h1 span {
  display: block;
  font-size: clamp(3.2rem, 7.2vw, 9rem);
}

.hero-h1 em {
  font-style: italic;
  color: var(--color-gold-400);
  font-size: inherit;
}

.hero-ctas {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.hero-ghost-btn {
  display: inline-flex;
  align-items: center;
  border: 1px solid rgba(255,255,255,0.4);
  color: rgba(255,255,255,0.9);
  padding: 0.875rem 2rem;
  font-size: 0.75rem;
  letter-spacing: 0.12em;
  text-decoration: none;
  text-transform: uppercase;
  font-family: var(--font-sans);
  transition: border-color 0.25s;
}

.hero-ghost-btn:hover {
  border-color: rgba(255,255,255,0.7);
}

/* Stats strip */
.hero-stats {
  display: flex;
  background: #fdfaf3;
  border-bottom: 1px solid var(--color-stone-200);
}

.hero-stat {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  padding: 1.75rem 2.75rem;
  border-right: 1px solid var(--color-stone-200);
  flex-shrink: 0;
}

.hero-stat strong {
  font-family: var(--font-serif);
  font-size: 1.75rem;
  font-weight: 300;
  color: var(--color-gold-600);
}

.hero-stat--purple strong {
  color: var(--color-purple-400);
}

.hero-stat span {
  font-size: 0.55rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-stone-400);
  font-family: var(--font-sans);
}

/* ═══════════════════════════════════════════
   SHARED UTILITIES
═══════════════════════════════════════════ */
.label {
  font-size: 0.57rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--color-stone-400);
  font-family: var(--font-sans);
}

.label-link {
  font-size: 0.57rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-gold-600);
  font-family: var(--font-sans);
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.section-rule {
  width: 2.5rem;
  height: 1px;
  background: var(--color-gold-500);
  margin-bottom: 1.5rem;
}

/* ═══════════════════════════════════════════
   QUOTE
═══════════════════════════════════════════ */
.quote-section {
  padding: 8rem 10vw;
  background: white;
  text-align: center;
}

.quote-inner {
  max-width: 800px;
  margin: 0 auto;
}

.quote-inner .section-rule {
  margin: 0 auto 4rem;
}

blockquote {
  font-family: var(--font-serif);
  font-size: clamp(1.5rem, 2.8vw, 2.6rem);
  font-weight: 300;
  line-height: 1.35;
  color: var(--color-stone-800);
  font-style: italic;
  margin: 0 0 2rem;
}

cite {
  font-size: 0.57rem;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--color-stone-400);
  font-family: var(--font-sans);
  font-style: normal;
}

/* ═══════════════════════════════════════════
   SERVICES
═══════════════════════════════════════════ */
.services-section {
  padding: 0 10vw 8rem;
  background: white;
}

.services-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 2.5rem;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border: 1px solid var(--color-stone-200);
}

.service-cell {
  padding: 2.25rem 2rem;
  border-right: 1px solid var(--color-stone-200);
  border-bottom: 1px solid var(--color-stone-200);
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  text-decoration: none;
  background: white;
  transition: background 0.2s;
}

.service-cell:hover {
  background: var(--color-stone-50);
}

.service-abbr {
  font-size: 0.55rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--color-stone-400);
  font-family: var(--font-sans);
}

.service-title {
  font-family: var(--font-serif);
  font-size: 1.2rem;
  font-weight: 300;
  color: var(--color-stone-800);
  flex: 1;
}

.service-arrow {
  font-size: 0.54rem;
  letter-spacing: 0.2em;
  color: var(--color-gold-600);
  font-family: var(--font-sans);
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 0.4rem;
  margin-top: 0.5rem;
}

/* ═══════════════════════════════════════════
   TEAM
═══════════════════════════════════════════ */
.team-section {
  padding: 8rem 10vw;
  background: #fdfaf3;
}

.team-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 3.5rem;
}

.team-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}

.team-card {
  display: block;
  text-decoration: none;
}

.team-photo-wrap {
  overflow: hidden;
  margin-bottom: 1.25rem;
}

.team-photo {
  width: 100%;
  aspect-ratio: 3 / 4;
  object-fit: cover;
  object-position: center top;
  display: block;
  transition: transform 0.6s ease;
}

.team-card:hover .team-photo {
  transform: scale(1.04);
}

.team-name {
  font-family: var(--font-serif);
  font-size: 1.1rem;
  font-weight: 300;
  color: var(--color-stone-800);
  margin-bottom: 0.25rem;
}

.team-role {
  font-size: 0.56rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-stone-400);
  font-family: var(--font-sans);
  margin-bottom: 0.5rem;
}

.team-note {
  font-size: 0.6rem;
  letter-spacing: 0.06em;
  font-family: var(--font-sans);
  color: var(--color-stone-400);
}

.team-note--accent {
  color: var(--color-purple-500);
}

/* ═══════════════════════════════════════════
   RECOGNITION
═══════════════════════════════════════════ */
.recognition-section {
  padding: 2rem 10vw;
  background: white;
  border-top: 1px solid var(--color-stone-100);
  border-bottom: 1px solid var(--color-stone-100);
  display: flex;
  align-items: center;
  gap: 2.5rem;
  overflow: hidden;
}

.recognition-divider {
  width: 1px;
  height: 1.5rem;
  background: var(--color-stone-200);
  flex-shrink: 0;
}

.recognition-list {
  display: flex;
  align-items: center;
  gap: 2.5rem;
  overflow-x: auto;
  scrollbar-width: none;
  flex: 1;
}

.recognition-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-shrink: 0;
}

.recognition-dot {
  width: 4px;
  height: 4px;
  background: var(--color-gold-400);
  border-radius: 50%;
  flex-shrink: 0;
}

.recognition-item span {
  font-size: 0.64rem;
  color: var(--color-stone-500);
  white-space: nowrap;
  font-family: var(--font-sans);
}

/* ═══════════════════════════════════════════
   LOCATIONS
═══════════════════════════════════════════ */
.locations-section {
  padding: 7rem 10vw;
  background: white;
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 6rem;
  align-items: start;
}

.locations-intro h2 {
  font-family: var(--font-serif);
  font-size: clamp(1.8rem, 3.2vw, 2.8rem);
  font-weight: 300;
  color: var(--color-stone-800);
  line-height: 1.1;
  margin-bottom: 2rem;
}

.locations-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
