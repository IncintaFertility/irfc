---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Demo A — Editorial Whitespace"
  description="Homepage concept A — typography-led luxury"
>
  <!-- Minimal fixed nav -->
  <header style="position: fixed; top: 0; left: 0; right: 0; z-index: 100; padding: 1.75rem 10vw; display: flex; align-items: center; justify-content: space-between; background: rgba(253,250,243,0.92); backdrop-filter: blur(8px); border-bottom: 1px solid transparent;" id="demo-nav">
    <span style="font-family: var(--font-serif); font-size: 0.9rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-stone-800);">IRFC</span>
    <nav style="display: flex; gap: 2.5rem; align-items: center;">
      <a href="/team" style="font-size: 0.6rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--color-stone-500); font-family: var(--font-sans); text-decoration: none;">Team</a>
      <a href="/services" style="font-size: 0.6rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--color-stone-500); font-family: var(--font-sans); text-decoration: none;">Services</a>
      <a href="/outcomes" style="font-size: 0.6rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--color-stone-500); font-family: var(--font-sans); text-decoration: none;">Outcomes</a>
      <a href="/contact" style="font-size: 0.6rem; letter-spacing: 0.22em; text-transform: uppercase; padding: 0.6rem 1.4rem; border: 1px solid var(--color-gold-500); color: var(--color-gold-700); font-family: var(--font-sans); text-decoration: none;">Consult</a>
    </nav>
  </header>

  <!-- ① HERO — full viewport, pure cream, typography only -->
  <section style="min-height: 100vh; background: #fdfaf3; display: flex; flex-direction: column; justify-content: flex-end; padding: 0 10vw 6rem; position: relative; overflow: hidden;">

    <!-- Background watermark number -->
    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-30%, -52%); font-family: var(--font-serif); font-size: 40vw; font-weight: 300; color: rgba(198,173,92,0.04); line-height: 1; pointer-events: none; user-select: none; white-space: nowrap;">Rx</div>

    <!-- Eyebrow -->
    <p style="font-size: 0.6rem; letter-spacing: 0.35em; text-transform: uppercase; color: var(--color-stone-400); font-family: var(--font-sans); margin-bottom: 2.5rem;">
      Incinta Fertility &nbsp;·&nbsp; Reproductive Fertility Center &nbsp;·&nbsp; Southern California
    </p>

    <!-- Giant headline -->
    <h1 style="font-family: var(--font-serif); font-weight: 300; line-height: 0.9; color: var(--color-stone-800); margin-bottom: 4.5rem;">
      <span style="display: block; font-size: clamp(3.5rem, 9.5vw, 10.5rem); letter-spacing: -0.01em;">Where Science</span>
      <span style="display: block; font-size: clamp(3.5rem, 9.5vw, 10.5rem); letter-spacing: -0.01em; color: var(--color-gold-600); font-style: italic;">Meets</span>
      <span style="display: block; font-size: clamp(3.5rem, 9.5vw, 10.5rem); letter-spacing: -0.01em;">Compassion.</span>
    </h1>

    <!-- Rule + CTAs -->
    <div style="display: flex; align-items: center; gap: 3rem; margin-bottom: 5rem; flex-wrap: wrap;">
      <div style="width: 5rem; height: 1px; background: var(--color-gold-500); flex-shrink: 0;"></div>
      <a href="/contact" class="btn-primary" style="margin: 0;">Schedule a Free Consultation</a>
      <a href="/about" class="btn-outline" style="margin: 0;">Our Story</a>
    </div>

    <!-- Stats strip -->
    <div style="display: flex; border-top: 1px solid var(--color-stone-200); overflow-x: auto;">
      {[
        { num: '20+', label: 'Years of Excellence', color: 'var(--color-gold-600)' },
        { num: '#1', label: 'US IVF Lab · 2016',  color: 'var(--color-purple-400)' },
        { num: '5',   label: 'SoCal Locations',    color: 'var(--color-gold-600)' },
        { num: 'Free', label: 'Initial Consultation', color: 'var(--color-gold-600)' },
      ].map((s, i) => (
        <div style={`padding: 1.75rem 2.5rem; border-right: 1px solid var(--color-stone-200); flex-shrink: 0; ${i === 0 ? 'padding-left: 0;' : ''}`}>
          <p style={`font-family: var(--font-serif); font-size: 1.75rem; font-weight: 300; margin-bottom: 0.3rem; color: ${s.color};`}>{s.num}</p>
          <p style="font-size: 0.58rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-stone-400); font-family: var(--font-sans);">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ② IMAGE REVEAL — full-bleed, no overlay -->
  <section style="overflow: hidden; line-height: 0;">
    <img
      src="/images/lobby-wide.jpg"
      alt="IRFC Clinic"
      style="width: 100%; height: 78vh; object-fit: cover; object-position: center; display: block;"
    />
  </section>

  <!-- ③ MISSION QUOTE — centered, minimal -->
  <section style="padding: 9rem 10vw; background: white; text-align: center;">
    <div style="max-width: 820px; margin: 0 auto;">
      <div style="width: 3rem; height: 1px; background: var(--color-gold-500); margin: 0 auto 4rem;"></div>
      <blockquote style="font-family: var(--font-serif); font-size: clamp(1.6rem, 3.2vw, 2.8rem); font-weight: 300; line-height: 1.35; color: var(--color-stone-800); font-style: italic; margin: 0 0 2rem;">"A fertility clinic should feel like<br/>both a family and a home."</blockquote>
      <cite style="font-size: 0.58rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--color-stone-400); font-family: var(--font-sans); font-style: normal;">— Dr. James P. Lin, Founder & Medical Director</cite>
    </div>
  </section>

  <!-- ④ SERVICES — minimal index grid -->
  <section style="padding: 0 10vw 9rem; background: white;">
    <div style="border: 1px solid var(--color-stone-200); display: grid; grid-template-columns: repeat(3, 1fr);">
      {[
        { abbr: 'IVF',   title: 'In Vitro Fertilization',   href: '/services/ivf' },
        { abbr: 'PGT',   title: 'Genetic Testing',           href: '/services/pgt' },
        { abbr: 'Cryo',  title: 'Fertility Preservation',    href: '/services/egg-freezing' },
        { abbr: 'IUI',   title: 'Intrauterine Insemination', href: '/services/iui' },
        { abbr: 'Donor', title: 'Donors & Surrogacy',        href: '/services#donors' },
        { abbr: 'Rx',    title: 'Surgical Services',         href: '/services#surgical' },
      ].map((s) => (
        <a href={s.href}
          style="padding: 2.25rem 2rem; border-right: 1px solid var(--color-stone-200); border-bottom: 1px solid var(--color-stone-200); display: flex; flex-direction: column; gap: 0.6rem; text-decoration: none; background: white; transition: background 0.2s;"
          onmouseenter="this.style.background='var(--color-stone-50)'"
          onmouseleave="this.style.background='white'">
          <span style="font-size: 0.56rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--color-stone-400); font-family: var(--font-sans);">{s.abbr}</span>
          <span style="font-family: var(--font-serif); font-size: 1.2rem; font-weight: 300; color: var(--color-stone-800);">{s.title}</span>
          <span style="font-size: 0.56rem; letter-spacing: 0.2em; color: var(--color-gold-600); font-family: var(--font-sans); text-transform: uppercase; margin-top: 0.5rem; display: flex; align-items: center; gap: 0.4rem;">
            Learn more
            <svg width="10" height="10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </span>
        </a>
      ))}
    </div>
    <div style="text-align: center; margin-top: 3rem;">
      <a href="/services" class="btn-outline">All Treatments</a>
    </div>
  </section>

  <!-- ⑤ TEAM — editorial portrait strip -->
  <section style="padding: 8rem 10vw; background: #fdfaf3;">
    <p style="font-size: 0.58rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--color-stone-400); font-family: var(--font-sans); margin-bottom: 4rem;">Medical Leadership</p>
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-bottom: 3rem;">
      {[
        { name: 'James P. Lin, MD',  role: 'Founder & Medical Director',      photo: '/images/team/dr-james-lin-circle.png',  href: '/team/dr-james-lin' },
        { name: 'Zitao Liu, MD',     role: 'Associate Chief Medical Officer',  photo: '/images/team/dr-zitao-liu-circle.png',  href: '/team/dr-zitao-liu' },
        { name: 'Yufen Xie, PhD',    role: 'IVF Laboratory Director',          photo: '/images/team/dr-yufen-xie.png',          href: '/team/dr-yufen-xie' },
      ].map((doc) => (
        <a href={doc.href} style="display: block; text-decoration: none; overflow: hidden;" class="team-card">
          <div style="overflow: hidden; margin-bottom: 1.25rem;">
            <img
              src={doc.photo}
              alt={doc.name}
              style="width: 100%; aspect-ratio: 3/4; object-fit: cover; object-position: center top; display: block; transition: transform 0.6s ease;"
              class="team-photo"
            />
          </div>
          <p style="font-family: var(--font-serif); font-size: 1.15rem; font-weight: 300; color: var(--color-stone-800); margin-bottom: 0.3rem;">{doc.name}</p>
          <p style="font-size: 0.58rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-stone-400); font-family: var(--font-sans);">{doc.role}</p>
        </a>
      ))}
    </div>
    <a href="/team" class="btn-outline">Meet the Full Team</a>
  </section>

  <!-- ⑥ RECOGNITION — horizontal scroll strip -->
  <section style="padding: 2.5rem 10vw; background: white; border-top: 1px solid var(--color-stone-100); border-bottom: 1px solid var(--color-stone-100);">
    <div style="display: flex; align-items: center; gap: 3rem; overflow-x: auto;">
      <p style="font-size: 0.56rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--color-stone-400); font-family: var(--font-sans); flex-shrink: 0; white-space: nowrap;">Recognition</p>
      <div style="width: 1px; height: 2rem; background: var(--color-stone-200); flex-shrink: 0;"></div>
      {[
        'Kaiser Permanente Center of Excellence',
        '#1 US IVF Laboratory — SART 2016',
        'CAP / CLIA Accredited Laboratory',
        'Fairfax EggBank Premier Partner',
        'Top IVF Center — IVF Authority',
      ].map(rec => (
        <div style="display: flex; align-items: center; gap: 0.6rem; flex-shrink: 0;">
          <div style="width: 4px; height: 4px; background: var(--color-gold-400); flex-shrink: 0;"></div>
          <span style="font-size: 0.68rem; color: var(--color-stone-500); white-space: nowrap;">{rec}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ⑦ CTA — dark stone -->
  <section style="padding: 9rem 10vw; background: #1c1917; text-align: center; position: relative; overflow: hidden;">
    <div style="position: absolute; inset: 0; background: radial-gradient(ellipse at center, rgba(198,173,92,0.06) 0%, transparent 65%); pointer-events: none;"></div>
    <div style="position: relative; z-index: 1; max-width: 640px; margin: 0 auto;">
      <div style="display: flex; align-items: center; justify-content: center; gap: 1.5rem; margin-bottom: 2.5rem;">
        <div style="height: 1px; width: 3rem; background: linear-gradient(90deg, transparent, var(--color-gold-500));"></div>
        <span style="font-size: 0.58rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--color-gold-400); font-family: var(--font-sans);">Begin Your Journey</span>
        <div style="height: 1px; width: 3rem; background: linear-gradient(90deg, var(--color-gold-500), transparent);"></div>
      </div>
      <h2 style="font-family: var(--font-serif); font-size: clamp(2.2rem, 5vw, 4rem); font-weight: 300; color: white; line-height: 1.15; margin-bottom: 3rem;">Your Family<br/>Starts Here</h2>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="/contact" class="btn-primary">Schedule Free Consultation</a>
        <a href="tel:+19494538600" style="border: 1px solid rgba(255,255,255,0.25); color: rgba(255,255,255,0.8); padding: 0.875rem 1.75rem; font-size: 0.75rem; letter-spacing: 0.12em; text-decoration: none; text-transform: uppercase; font-family: var(--font-sans);">Call (949) 453-8600</a>
      </div>
      <p style="margin-top: 2rem; font-size: 0.6rem; color: rgba(255,255,255,0.3); font-family: var(--font-sans); letter-spacing: 0.12em; text-transform: uppercase;">Free initial consultations &nbsp;·&nbsp; Telehealth available</p>
    </div>
  </section>

  <!-- Demo label -->
  <div style="position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 200; background: var(--color-stone-800); color: white; font-size: 0.6rem; letter-spacing: 0.15em; text-transform: uppercase; padding: 0.5rem 1rem; font-family: var(--font-sans); opacity: 0.85;">
    Demo A — Editorial
  </div>
</Layout>

<style>
  .team-card:hover .team-photo {
    transform: scale(1.04);
  }
</style>
