---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Homepage Concept A — Internal Design Review"
  description="Internal design concept. Not for public distribution or indexing."
  noindex
>
  <!-- ─── DEMO NAV ─────────────────────────────────── -->
  <header id="demo-nav" class="dnav">
    <!-- Logo -->
    <a href="/" class="dnav-logo" aria-label="INCINTA Home">
      <div class="dnav-logo-wrap">
        <img src="/images/incinta-logo.png"       alt="INCINTA" class="dnav-logo-img dnav-logo-color" />
        <img src="/images/incinta-logo-white.png" alt="INCINTA" class="dnav-logo-img dnav-logo-white" />
      </div>
    </a>

    <!-- Links -->
    <nav class="dnav-links" aria-label="Main navigation">
      <a href="/about">About</a>
      <a href="/services">Services</a>
      <a href="/outcomes">Success Rates</a>
      <a href="/team">Team</a>
      <a href="/locations">Locations</a>
    </nav>

    <!-- Right (desktop) -->
    <div class="dnav-right">
      <a href="tel:+19494538600" class="dnav-phone">(949) 453-8600</a>
      <a href="/contact" class="dnav-cta">Book Consultation</a>
    </div>

    <!-- Hamburger (mobile) -->
    <button class="dnav-hamburger" id="dnav-hamburger" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </header>

  <!-- Mobile menu overlay -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <div class="mobile-menu-inner">
      <nav class="mobile-menu-links">
        <a href="/about">About IRFC</a>
        <a href="/services">Services</a>
        <a href="/outcomes">Success Rates</a>
        <a href="/patient-journey">Patient Journey</a>
        <a href="/team">Our Team</a>
        <a href="/locations">Locations</a>
      </nav>
      <div class="mobile-menu-bottom">
        <a href="tel:+19494538600" class="mobile-menu-phone">(949) 453-8600</a>
        <a href="/contact" class="btn-primary mobile-menu-cta">Schedule a Consultation</a>
      </div>
    </div>
  </div>

  <!-- ① HERO -->
  <section class="hero">
    <img src="/images/lobby-wide.jpg" alt="IRFC Clinic" class="hero-bg" />
    <div class="hero-overlay"></div>

    <!-- top-left eyebrow (above the fold, readable against light area) -->
    <div class="hero-top">
      <span class="hero-eyebrow">
        <span class="hero-eyebrow-line"></span>
        Incinta Fertility &nbsp;·&nbsp; Reproductive Fertility Center &nbsp;·&nbsp; Southern California
      </span>
    </div>

    <!-- main text: bottom-left -->
    <div class="hero-body">
      <h1 class="hero-h1">
        <span>Where</span>
        <span>Science <em>Meets</em></span>
        <span>Compassion.</span>
      </h1>
      <div class="hero-ctas">
        <a href="/contact" class="btn-primary">
          Schedule a Consultation
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href="/about" class="hero-ghost-btn">Our Story</a>
      </div>
    </div>
  </section>

  <!-- Stats strip -->
  <div class="hero-stats">
    <div class="hero-stat">
      <strong>20+</strong><span>Years of Excellence</span>
    </div>
    <div class="hero-stat hero-stat--purple">
      <strong>#1</strong><span>US IVF Lab · 2016</span>
    </div>
    <div class="hero-stat">
      <strong>5</strong><span>SoCal Locations</span>
    </div>
    <div class="hero-stat">
      <strong>5</strong><span>Languages Spoken</span>
    </div>
  </div>

  <!-- ② QUOTE -->
  <section class="quote-section">
    <div class="quote-inner">
      <div class="section-rule"></div>
      <blockquote>
        "A fertility clinic should feel like<br/>both a family and a home."
      </blockquote>
      <cite>— Dr. James P. Lin &nbsp;·&nbsp; Founder &amp; Medical Director</cite>
    </div>
  </section>

  <!-- ③ SERVICES -->
  <section class="services-section">
    <div class="services-header">
      <p class="label">Treatments &amp; Services</p>
      <a href="/services" class="label-link">
        All Services
        <svg width="10" height="10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
    <div class="services-grid">
      {[
        { abbr: 'IVF',      title: 'In Vitro Fertilization',      href: '/services/ivf' },
        { abbr: 'PGT',      title: 'Genetic Testing',              href: '/services/pgt' },
        { abbr: 'Cryo',     title: 'Fertility Preservation',       href: '/services/egg-freezing' },
        { abbr: 'IUI',      title: 'Intrauterine Insemination',    href: '/services/iui' },
        { abbr: 'Donor',    title: 'Donors & Surrogacy',           href: '/services#donors' },
        { abbr: 'Surgical', title: 'Minimally Invasive Surgery',   href: '/services#surgical' },
      ].map(s => (
        <a href={s.href} class="service-cell">
          <span class="service-abbr">{s.abbr}</span>
          <span class="service-title">{s.title}</span>
          <span class="service-arrow">
            Learn more
            <svg width="9" height="9" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- ④ TEAM -->
  <section class="team-section">
    <div class="team-header">
      <p class="label">Medical Leadership</p>
      <a href="/team" class="label-link">
        Full Team
        <svg width="10" height="10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
    <div class="team-grid">
      {[
        { name: 'James P. Lin, MD',  role: 'Founder & Medical Director',     note: '20+ Years · Kaiser Permanente COE',    photo: '/images/team/dr-james-lin-circle.png',  href: '/team/dr-james-lin' },
        { name: 'Zitao Liu, MD',     role: 'Associate Chief Medical Officer', note: 'Now Accepting New Patients',           photo: '/images/team/dr-zitao-liu-circle.png',  href: '/team/dr-zitao-liu', accent: true },
        { name: 'Yufen Xie, PhD',    role: 'IVF Laboratory Director',         note: '#1 US IVF Lab · 2016',                 photo: '/images/team/dr-yufen-xie.png',          href: '/team/dr-yufen-xie' },
      ].map(doc => (
        <a href={doc.href} class="team-card">
          <div class="team-photo-wrap">
            <img src={doc.photo} alt={doc.name} class="team-photo" />
          </div>
          <p class="team-name">{doc.name}</p>
          <p class="team-role">{doc.role}</p>
          <p class={`team-note ${doc.accent ? 'team-note--accent' : ''}`}>{doc.note}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- ⑤ RECOGNITION -->
  <section class="recognition-section">
    <p class="label">Recognition</p>
    <div class="recognition-divider"></div>
    <div class="recognition-list">
      {[
        'Kaiser Permanente Center of Excellence',
        '#1 US IVF Laboratory — SART 2016',
        'CAP / CLIA Accredited Laboratory',
        'Fairfax EggBank Premier Partner',
        'Top IVF Center — IVF Authority',
      ].map(rec => (
        <div class="recognition-item">
          <div class="recognition-dot"></div>
          <span>{rec}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ⑥ LOCATIONS -->
  <section class="locations-section">
    <div class="locations-intro">
      <div class="section-rule"></div>
      <h2>Five Locations<br/>Across Southern<br/>California</h2>
      <a href="/locations" class="btn-outline">View All Locations</a>
    </div>
    <div class="locations-grid">
      {[
        { city: 'Torrance',      phone: '(424) 212-4087', types: 'Clinic' },
        { city: 'Alhambra',      phone: '(626) 588-2885', types: 'Clinic' },
        { city: 'Beverly Hills', phone: '(213) 600-8088', types: 'Clinic' },
        { city: 'Corona',        phone: '(951) 272-2221', types: 'Clinic · Surgery · Lab' },
        { city: 'Irvine',        phone: '(949) 453-8600', types: 'Clinic · Surgery · Lab' },
      ].map(loc => (
        <a href="/locations" class="location-cell">
          <p class="location-city">{loc.city}</p>
          <p class="location-types">{loc.types}</p>
          <p class="location-phone">{loc.phone}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- ⑦ CTA -->
  <section class="cta-section">
    <div class="cta-glow"></div>
    <div class="cta-inner">
      <div class="cta-eyebrow">
        <div class="cta-rule-left"></div>
        <span>Begin Your Journey</span>
        <div class="cta-rule-right"></div>
      </div>
      <h2>Your Family<br/>Starts Here</h2>
      <p class="cta-sub">Initial consultation · Board-certified physicians · 5 Southern California locations</p>
      <div class="cta-btns">
        <a href="/contact" class="btn-primary">Schedule a Consultation</a>
        <a href="tel:+19494538600" class="cta-phone-btn">Call (949) 453-8600</a>
      </div>
      <p class="cta-foot">Telehealth available for out-of-area patients</p>
    </div>
  </section>

  <Footer />

  <div class="demo-badge">Demo A — Editorial</div>
</Layout>

<script>
  // Scroll → solid nav
  const nav = document.getElementById('demo-nav');
  const onScroll = () => {
    if (window.scrollY > 40) nav?.classList.add('dnav--solid');
    else nav?.classList.remove('dnav--solid');
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Mobile menu
  const hamburger = document.getElementById('dnav-hamburger');
  const mobileMenu = document.getElementById('mobile-menu');

  const openMenu = () => {
    hamburger?.classList.add('is-open');
    mobileMenu?.classList.add('mobile-menu--open');
    hamburger?.setAttribute('aria-expanded', 'true');
    mobileMenu?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  };

  const closeMenu = () => {
    hamburger?.classList.remove('is-open');
    mobileMenu?.classList.remove('mobile-menu--open');
    hamburger?.setAttribute('aria-expanded', 'false');
    mobileMenu?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  };

  hamburger?.addEventListener('click', () => {
    hamburger.classList.contains('is-open') ? closeMenu() : openMenu();
  });

  mobileMenu?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
</script>

<style>
/* ═══════════════════════════════════════════
   DEMO NAV
═══════════════════════════════════════════ */
.dnav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  height: 4.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10vw;
  /* Subtle frosted cream — readable on any image brightness */
  background: rgba(253,250,243,0.82);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid rgba(214,209,197,0.5);
  transition:
    background   0.4s ease,
    border-color 0.4s ease;
}

/* Scrolled state: fully opaque */
.dnav--solid {
  background: rgba(253,250,243,0.98);
  border-bottom-color: var(--color-stone-200);
}

/* Logo */
.dnav-logo { display: block; flex-shrink: 0; }

.dnav-logo-wrap {
  position: relative;
  height: 2.4rem;
  width: 10rem;   /* enough for the logo SVG */
}

.dnav-logo-img {
  position: absolute;
  inset: 0;
  height: 100%;
  width: auto;
  object-fit: contain;
  object-position: left center;
  transition: opacity 0.35s ease;
}

/* Always show color logo — image is light so color logo is readable */
.dnav-logo-color { opacity: 1; }
.dnav-logo-white { opacity: 0; }

/* Nav links — dark text always (bright image) */
.dnav-links {
  display: flex;
  align-items: center;
  gap: 2.5rem;
}

.dnav-links a {
  font-size: 0.6rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  font-family: var(--font-sans);
  text-decoration: none;
  color: var(--color-stone-700);
  transition: color 0.3s;
  white-space: nowrap;
}

.dnav-links a:hover {
  color: var(--color-gold-600) !important;
}

/* Right side */
.dnav-right {
  display: flex;
  align-items: center;
  gap: 1.75rem;
  flex-shrink: 0;
}

.dnav-phone {
  font-size: 0.62rem;
  letter-spacing: 0.08em;
  font-family: var(--font-sans);
  text-decoration: none;
  color: var(--color-stone-500);
  transition: color 0.3s;
  white-space: nowrap;
}

.dnav-phone:hover { color: var(--color-gold-600) !important; }

/* CTA button — gold border, dark text */
.dnav-cta {
  display: inline-flex;
  align-items: center;
  font-size: 0.6rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  font-family: var(--font-sans);
  text-decoration: none;
  padding: 0.6rem 1.4rem;
  border: 1px solid var(--color-gold-500);
  color: var(--color-gold-700);
  transition: border-color 0.3s, color 0.3s, background 0.3s;
  white-space: nowrap;
}

.dnav-cta:hover {
  background: var(--color-gold-500);
  color: white;
}

/* Hide desktop nav items; show hamburger */
@media (max-width: 900px) {
  .dnav-links,
  .dnav-phone,
  .dnav-cta { display: none; }
  .dnav { padding: 0 5vw; }
  .dnav-hamburger { display: flex; }
}

/* ═══════════════════════════════════════════
   HERO
═══════════════════════════════════════════ */
.hero {
  position: relative;
  height: 100vh;
  min-height: 600px;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: right center;
}

/*
  Three-layer overlay:
  1. Top vignette: dark at top for nav + eyebrow readability → fades out quickly
  2. Bottom vignette: transparent → dark from 40% for headline readability
  3. Left tint: subtle left darkening so left-anchored text has depth
*/
.hero-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      to bottom,
      rgba(8,5,2,0.55)   0%,
      rgba(8,5,2,0.2)   18%,
      transparent        32%,
      transparent        40%,
      rgba(8,5,2,0.42)   62%,
      rgba(8,5,2,0.82)  100%
    ),
    linear-gradient(
      to right,
      rgba(8,5,2,0.18)   0%,
      rgba(8,5,2,0.06)  45%,
      transparent        70%
    );
}

/* Eyebrow — top-left, sits in the bright upper area */
.hero-top {
  position: absolute;
  top: 7rem;           /* below transparent nav (4.5rem) + breathing room */
  left: 10vw;
  z-index: 2;
}

.hero-eyebrow {
  display: flex;
  align-items: center;
  gap: 1rem;
  font-size: 0.56rem;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.75);
  font-family: var(--font-sans);
}

.hero-eyebrow-line {
  display: inline-block;
  width: 2.5rem;
  height: 1px;
  background: var(--color-gold-400);
  flex-shrink: 0;
}

/* Main text — bottom-left */
.hero-body {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 2;
  padding: 0 10vw 5rem;
}

.hero-h1 {
  font-family: var(--font-serif);
  font-weight: 300;
  line-height: 0.88;
  color: white;
  margin-bottom: 3rem;
  letter-spacing: -0.015em;
}

.hero-h1 span {
  display: block;
  font-size: clamp(3.2rem, 7.2vw, 9rem);
}

.hero-h1 em {
  font-style: italic;
  color: var(--color-gold-400);
  font-size: inherit;
}

.hero-ctas {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.hero-ghost-btn {
  display: inline-flex;
  align-items: center;
  border: 1px solid rgba(255,255,255,0.4);
  color: rgba(255,255,255,0.9);
  padding: 0.875rem 2rem;
  font-size: 0.75rem;
  letter-spacing: 0.12em;
  text-decoration: none;
  text-transform: uppercase;
  font-family: var(--font-sans);
  transition: border-color 0.25s;
}

.hero-ghost-btn:hover {
  border-color: rgba(255,255,255,0.7);
}

/* Stats strip */
.hero-stats {
  display: flex;
  background: #fdfaf3;
  border-bottom: 1px solid var(--color-stone-200);
}

.hero-stat {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  padding: 1.75rem 2.75rem;
  border-right: 1px solid var(--color-stone-200);
  flex-shrink: 0;
}

.hero-stat strong {
  font-family: var(--font-serif);
  font-size: 1.75rem;
  font-weight: 300;
  color: var(--color-gold-600);
}

.hero-stat--purple strong {
  color: var(--color-purple-400);
}

.hero-stat span {
  font-size: 0.55rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-stone-400);
  font-family: var(--font-sans);
}

/* ═══════════════════════════════════════════
   SHARED UTILITIES
═══════════════════════════════════════════ */
.label {
  font-size: 0.57rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--color-stone-400);
  font-family: var(--font-sans);
}

.label-link {
  font-size: 0.57rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-gold-600);
  font-family: var(--font-sans);
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.section-rule {
  width: 2.5rem;
  height: 1px;
  background: var(--color-gold-500);
  margin-bottom: 1.5rem;
}

/* ═══════════════════════════════════════════
   QUOTE
═══════════════════════════════════════════ */
.quote-section {
  padding: 8rem 10vw;
  background: white;
  text-align: center;
}

.quote-inner {
  max-width: 800px;
  margin: 0 auto;
}

.quote-inner .section-rule {
  margin: 0 auto 4rem;
}

blockquote {
  font-family: var(--font-serif);
  font-size: clamp(1.5rem, 2.8vw, 2.6rem);
  font-weight: 300;
  line-height: 1.35;
  color: var(--color-stone-800);
  font-style: italic;
  margin: 0 0 2rem;
}

cite {
  font-size: 0.57rem;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--color-stone-400);
  font-family: var(--font-sans);
  font-style: normal;
}

/* ═══════════════════════════════════════════
   SERVICES
═══════════════════════════════════════════ */
.services-section {
  padding: 0 10vw 8rem;
  background: white;
}

.services-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 2.5rem;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border: 1px solid var(--color-stone-200);
}

.service-cell {
  padding: 2.25rem 2rem;
  border-right: 1px solid var(--color-stone-200);
  border-bottom: 1px solid var(--color-stone-200);
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  text-decoration: none;
  background: white;
  transition: background 0.2s;
}

.service-cell:hover {
  background: var(--color-stone-50);
}

.service-abbr {
  font-size: 0.55rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--color-stone-400);
  font-family: var(--font-sans);
}

.service-title {
  font-family: var(--font-serif);
  font-size: 1.2rem;
  font-weight: 300;
  color: var(--color-stone-800);
  flex: 1;
}

.service-arrow {
  font-size: 0.54rem;
  letter-spacing: 0.2em;
  color: var(--color-gold-600);
  font-family: var(--font-sans);
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 0.4rem;
  margin-top: 0.5rem;
}

/* ═══════════════════════════════════════════
   TEAM
═══════════════════════════════════════════ */
.team-section {
  padding: 8rem 10vw;
  background: #fdfaf3;
}

.team-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 3.5rem;
}

.team-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}

.team-card {
  display: block;
  text-decoration: none;
}

.team-photo-wrap {
  overflow: hidden;
  margin-bottom: 1.25rem;
}

.team-photo {
  width: 100%;
  aspect-ratio: 3 / 4;
  object-fit: cover;
  object-position: center top;
  display: block;
  transition: transform 0.6s ease;
}

.team-card:hover .team-photo {
  transform: scale(1.04);
}

.team-name {
  font-family: var(--font-serif);
  font-size: 1.1rem;
  font-weight: 300;
  color: var(--color-stone-800);
  margin-bottom: 0.25rem;
}

.team-role {
  font-size: 0.56rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-stone-400);
  font-family: var(--font-sans);
  margin-bottom: 0.5rem;
}

.team-note {
  font-size: 0.6rem;
  letter-spacing: 0.06em;
  font-family: var(--font-sans);
  color: var(--color-stone-400);
}

.team-note--accent {
  color: var(--color-purple-500);
}

/* ═══════════════════════════════════════════
   RECOGNITION
═══════════════════════════════════════════ */
.recognition-section {
  padding: 2rem 10vw;
  background: white;
  border-top: 1px solid var(--color-stone-100);
