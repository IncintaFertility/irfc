---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="IRFC — Southern California IVF & Fertility Specialists"
  description="Award-winning IVF and fertility care across Southern California. Free initial consultations."
>
  <Nav />

  <!-- ① HERO -->
  <section class="hero">

    <!-- Left: cream, text -->
    <div class="hero-left">
      <div class="hero-spacer"></div>

      <div class="hero-content">
        <p class="hero-eyebrow">
          Incinta Fertility &nbsp;·&nbsp; Reproductive Fertility Center &nbsp;·&nbsp; Southern California
        </p>

        <h1 class="hero-h1">
          <span>Where Science</span>
          <em>Meets</em>
          <span>Compassion.</span>
        </h1>

        <div class="hero-ctas">
          <div class="hero-rule"></div>
          <a href="/contact" class="btn-primary">Schedule a Free Consultation</a>
          <a href="/about" class="btn-outline">Our Story</a>
        </div>
      </div>

      <div class="hero-stats">
        <div class="hero-stat">
          <strong>20+</strong><span>Years of Excellence</span>
        </div>
        <div class="hero-stat hero-stat--purple">
          <strong>#1</strong><span>US IVF Lab · 2016</span>
        </div>
        <div class="hero-stat">
          <strong>5</strong><span>SoCal Locations</span>
        </div>
        <div class="hero-stat">
          <strong>Free</strong><span>Initial Consultation</span>
        </div>
      </div>
    </div>

    <!-- Right: photo -->
    <div class="hero-right">
      <img src="/images/lobby-wide.jpg" alt="IRFC Clinic" />
    </div>

  </section>

  <!-- ② QUOTE -->
  <section class="quote-section">
    <div class="quote-inner">
      <div class="section-rule"></div>
      <blockquote>
        "A fertility clinic should feel like<br/>both a family and a home."
      </blockquote>
      <cite>— Dr. James P. Lin &nbsp;·&nbsp; Founder &amp; Medical Director</cite>
    </div>
  </section>

  <!-- ③ SERVICES -->
  <section class="services-section">
    <div class="services-header">
      <p class="label">Treatments &amp; Services</p>
      <a href="/services" class="label-link">
        All Services
        <svg width="10" height="10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
    <div class="services-grid">
      {[
        { abbr: 'IVF',      title: 'In Vitro Fertilization',      href: '/services/ivf' },
        { abbr: 'PGT',      title: 'Genetic Testing',              href: '/services/pgt' },
        { abbr: 'Cryo',     title: 'Fertility Preservation',       href: '/services/egg-freezing' },
        { abbr: 'IUI',      title: 'Intrauterine Insemination',    href: '/services/iui' },
        { abbr: 'Donor',    title: 'Donors & Surrogacy',           href: '/services#donors' },
        { abbr: 'Surgical', title: 'Minimally Invasive Surgery',   href: '/services#surgical' },
      ].map(s => (
        <a href={s.href} class="service-cell">
          <span class="service-abbr">{s.abbr}</span>
          <span class="service-title">{s.title}</span>
          <span class="service-arrow">
            Learn more
            <svg width="9" height="9" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- ④ TEAM -->
  <section class="team-section">
    <div class="team-header">
      <p class="label">Medical Leadership</p>
      <a href="/team" class="label-link">
        Full Team
        <svg width="10" height="10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
    <div class="team-grid">
      {[
        { name: 'James P. Lin, MD',  role: 'Founder & Medical Director',     note: '20+ Years · Kaiser Permanente COE',    photo: '/images/team/dr-james-lin-circle.png',  href: '/team/dr-james-lin' },
        { name: 'Zitao Liu, MD',     role: 'Associate Chief Medical Officer', note: 'Now Accepting New Patients',           photo: '/images/team/dr-zitao-liu-circle.png',  href: '/team/dr-zitao-liu', accent: true },
        { name: 'Yufen Xie, PhD',    role: 'IVF Laboratory Director',         note: '#1 US IVF Lab · 2016',                 photo: '/images/team/dr-yufen-xie.png',          href: '/team/dr-yufen-xie' },
      ].map(doc => (
        <a href={doc.href} class="team-card">
          <div class="team-photo-wrap">
            <img src={doc.photo} alt={doc.name} class="team-photo" />
          </div>
          <p class="team-name">{doc.name}</p>
          <p class="team-role">{doc.role}</p>
          <p class={`team-note ${doc.accent ? 'team-note--accent' : ''}`}>{doc.note}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- ⑤ RECOGNITION -->
  <section class="recognition-section">
    <p class="label">Recognition</p>
    <div class="recognition-divider"></div>
    <div class="recognition-list">
      {[
        'Kaiser Permanente Center of Excellence',
        '#1 US IVF Laboratory — SART 2016',
        'CAP / CLIA Accredited Laboratory',
        'Fairfax EggBank Premier Partner',
        'Top IVF Center — IVF Authority',
      ].map(rec => (
        <div class="recognition-item">
          <div class="recognition-dot"></div>
          <span>{rec}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ⑥ LOCATIONS -->
  <section class="locations-section">
    <div class="locations-intro">
      <div class="section-rule"></div>
      <h2>Five Locations<br/>Across Southern<br/>California</h2>
      <a href="/locations" class="btn-outline">View All Locations</a>
    </div>
    <div class="locations-grid">
      {[
        { city: 'Torrance',      phone: '(424) 212-4087', types: 'Clinic' },
        { city: 'Alhambra',      phone: '(626) 588-2885', types: 'Clinic' },
        { city: 'Beverly Hills', phone: '(213) 600-8088', types: 'Clinic' },
        { city: 'Corona',        phone: '(951) 272-2221', types: 'Clinic · Surgery · Lab' },
        { city: 'Irvine',        phone: '(949) 453-8600', types: 'Clinic · Surgery · Lab' },
      ].map(loc => (
        <a href="/locations" class="location-cell">
          <p class="location-city">{loc.city}</p>
          <p class="location-types">{loc.types}</p>
          <p class="location-phone">{loc.phone}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- ⑦ CTA -->
  <section class="cta-section">
    <div class="cta-glow"></div>
    <div class="cta-inner">
      <div class="cta-eyebrow">
        <div class="cta-rule-left"></div>
        <span>Begin Your Journey</span>
        <div class="cta-rule-right"></div>
      </div>
      <h2>Your Family<br/>Starts Here</h2>
      <p class="cta-sub">Free initial consultation · Board-certified physicians · 5 Southern California locations</p>
      <div class="cta-btns">
        <a href="/contact" class="btn-primary">Schedule Free Consultation</a>
        <a href="tel:+19494538600" class="cta-phone-btn">Call (949) 453-8600</a>
      </div>
      <p class="cta-foot">Telehealth available for out-of-area patients</p>
    </div>
  </section>

  <Footer />

  <div class="demo-badge">Demo A — Editorial</div>
</Layout>

<style>
/* ═══════════════════════════════════════════
   HERO
═══════════════════════════════════════════ */
.hero {
  display: grid;
  grid-template-columns: 58% 42%;
  height: 100vh;
  overflow: hidden;
}

.hero-left {
  background: #fdfaf3;
  display: flex;
  flex-direction: column;
  padding-left: 10vw;
  padding-right: 5vw;
  overflow: hidden;
}

/* Flexible spacer — pushes content down, stays ≥ nav height */
.hero-spacer {
  flex: 1;
  min-height: 6.5rem; /* nav ~96px */
}

.hero-content {
  padding-bottom: 3rem;
}

.hero-eyebrow {
  font-size: 0.58rem;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: var(--color-stone-400);
  font-family: var(--font-sans);
  margin-bottom: 2rem;
}

.hero-h1 {
  font-family: var(--font-serif);
  font-weight: 300;
  line-height: 0.9;
  color: var(--color-stone-800);
  margin-bottom: 3.5rem;
  letter-spacing: -0.01em;
}

.hero-h1 span,
.hero-h1 em {
  display: block;
  font-size: clamp(2.6rem, 5.4vw, 7rem);
}

.hero-h1 em {
  font-style: italic;
  color: var(--color-gold-600);
}

.hero-ctas {
  display: flex;
  align-items: center;
  gap: 1.75rem;
  flex-wrap: wrap;
}

.hero-rule {
  width: 4rem;
  height: 1px;
  background: var(--color-gold-500);
  flex-shrink: 0;
}

/* Stats pinned to the bottom of the left column */
.hero-stats {
  display: flex;
  border-top: 1px solid var(--color-stone-200);
  margin-top: auto;
}

.hero-stat {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  padding: 1.4rem 2rem;
  border-right: 1px solid var(--color-stone-200);
  flex-shrink: 0;
}

.hero-stat strong {
  font-family: var(--font-serif);
  font-size: 1.6rem;
  font-weight: 300;
  color: var(--color-gold-600);
}

.hero-stat--purple strong {
  color: var(--color-purple-400);
}

.hero-stat span {
  font-size: 0.55rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-stone-400);
  font-family: var(--font-sans);
}

/* Right column: full-bleed photo */
.hero-right {
  position: relative;
  overflow: hidden;
}

.hero-right img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

/* ═══════════════════════════════════════════
   SHARED UTILITIES
═══════════════════════════════════════════ */
.label {
  font-size: 0.57rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--color-stone-400);
  font-family: var(--font-sans);
}

.label-link {
  font-size: 0.57rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-gold-600);
  font-family: var(--font-sans);
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.section-rule {
  width: 2.5rem;
  height: 1px;
  background: var(--color-gold-500);
  margin-bottom: 1.5rem;
}

/* ═══════════════════════════════════════════
   QUOTE
═══════════════════════════════════════════ */
.quote-section {
  padding: 8rem 10vw;
  background: white;
  text-align: center;
}

.quote-inner {
  max-width: 800px;
  margin: 0 auto;
}

.quote-inner .section-rule {
  margin: 0 auto 4rem;
}

blockquote {
  font-family: var(--font-serif);
  font-size: clamp(1.5rem, 2.8vw, 2.6rem);
  font-weight: 300;
  line-height: 1.35;
  color: var(--color-stone-800);
  font-style: italic;
  margin: 0 0 2rem;
}

cite {
  font-size: 0.57rem;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--color-stone-400);
  font-family: var(--font-sans);
  font-style: normal;
}

/* ═══════════════════════════════════════════
   SERVICES
═══════════════════════════════════════════ */
.services-section {
  padding: 0 10vw 8rem;
  background: white;
}

.services-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 2.5rem;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border: 1px solid var(--color-stone-200);
}

.service-cell {
  padding: 2.25rem 2rem;
  border-right: 1px solid var(--color-stone-200);
  border-bottom: 1px solid var(--color-stone-200);
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  text-decoration: none;
  background: white;
  transition: background 0.2s;
}

.service-cell:hover {
  background: var(--color-stone-50);
}

.service-abbr {
  font-size: 0.55rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--color-stone-400);
  font-family: var(--font-sans);
}

.service-title {
  font-family: var(--font-serif);
  font-size: 1.2rem;
  font-weight: 300;
  color: var(--color-stone-800);
  flex: 1;
}

.service-arrow {
  font-size: 0.54rem;
  letter-spacing: 0.2em;
  color: var(--color-gold-600);
  font-family: var(--font-sans);
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 0.4rem;
  margin-top: 0.5rem;
}

/* ═══════════════════════════════════════════
   TEAM
═══════════════════════════════════════════ */
.team-section {
  padding: 8rem 10vw;
  background: #fdfaf3;
}

.team-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 3.5rem;
}

.team-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}

.team-card {
  display: block;
  text-decoration: none;
}

.team-photo-wrap {
  overflow: hidden;
  margin-bottom: 1.25rem;
}

.team-photo {
  width: 100%;
  aspect-ratio: 3 / 4;
  object-fit: cover;
  object-position: center top;
  display: block;
  transition: transform 0.6s ease;
}

.team-card:hover .team-photo {
  transform: scale(1.04);
}

.team-name {
  font-family: var(--font-serif);
  font-size: 1.1rem;
  font-weight: 300;
  color: var(--color-stone-800);
  margin-bottom: 0.25rem;
}

.team-role {
  font-size: 0.56rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-stone-400);
  font-family: var(--font-sans);
  margin-bottom: 0.5rem;
}

.team-note {
  font-size: 0.6rem;
  letter-spacing: 0.06em;
  font-family: var(--font-sans);
  color: var(--color-stone-400);
}

.team-note--accent {
  color: var(--color-purple-500);
}

/* ═══════════════════════════════════════════
   RECOGNITION
═══════════════════════════════════════════ */
.recognition-section {
  padding: 2rem 10vw;
  background: white;
  border-top: 1px solid var(--color-stone-100);
  border-bottom: 1px solid var(--color-stone-100);
  display: flex;
  align-items: center;
  gap: 2.5rem;
  overflow: hidden;
}

.recognition-divider {
  width: 1px;
  height: 1.5rem;
  background: var(--color-stone-200);
  flex-shrink: 0;
}

.recognition-list {
  display: flex;
  align-items: center;
  gap: 2.5rem;
  overflow-x: auto;
  scrollbar-width: none;
  flex: 1;
}

.recognition-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-shrink: 0;
}

.recognition-dot {
  width: 4px;
  height: 4px;
  background: var(--color-gold-400);
  border-radius: 50%;
  flex-shrink: 0;
}

.recognition-item span {
  font-size: 0.64rem;
  color: var(--color-stone-500);
  white-space: nowrap;
  font-family: var(--font-sans);
}

/* ═══════════════════════════════════════════
   LOCATIONS
═══════════════════════════════════════════ */
.locations-section {
  padding: 7rem 10vw;
  background: white;
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 6rem;
  align-items: start;
}

.locations-intro h2 {
  font-family: var(--font-serif);
  font-size: clamp(1.8rem, 3.2vw, 2.8rem);
  font-weight: 300;
  color: var(--color-stone-800);
  line-height: 1.1;
  margin-bottom: 2rem;
}

.locations-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border: 1px solid var(--color-stone-200);
}

.location-cell {
  padding: 1.75rem;
  border-right: 1px solid var(--color-stone-200);
  border-bottom: 1px solid var(--color-stone-200);
  display: block;
  text-decoration: none;
  background: white;
  transition: background 0.2s;
}

.location-cell:hover {
  background: var(--color-stone-50);
}

.location-city {
  font-family: var(--font-serif);
  font-size: 1.05rem;
  font-weight: 300;
  color: var(--color-stone-800);
  margin-bottom: 0.3rem;
}

.location-types {
  font-size: 0.55rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--color-stone-400);
  font-family: var(--font-sans);
  margin-bottom: 0.5rem;
}

.location-phone {
  font-size: 0.8rem;
  color: var(--color-gold-600);
}

/* ═══════════════════════════════════════════
   CTA
═══════════════════════════════════════════ */
.cta-section {
  padding: 9rem 10vw;
  background: #1c1917;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.cta-glow {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 50% 55%, rgba(198,173,92,0.07) 0%, transparent 60%);
  pointer-events: none;
}

.cta-inner {
  position: relative;
  z-index: 1;
  max-width: 580px;
  margin: 0 auto;
}

.cta-eyebrow {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1.5rem;
  margin-bottom: 2.5rem;
}

.cta-eyebrow span {
  font-size: 0.56rem;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: var(--color-gold-400);
  font-family: var(--font-sans);
  white-space: nowrap;
}

.cta-rule-left {
  height: 1px;
  width: 3rem;
  background: linear-gradient(90deg, transparent, var(--color-gold-500));
}

.cta-rule-right {
  height: 1px;
  width: 3rem;
  background: linear-gradient(90deg, var(--color-gold-500), transparent);
}

.cta-inner h2 {
  font-family: var(--font-serif);
  font-size: clamp(2.2rem, 4.5vw, 3.75rem);
  font-weight: 300;
  color: white;
  line-height: 1.1;
  margin-bottom: 1.25rem;
}

.cta-sub {
  font-size: 0.72rem;
  color: rgba(255,255,255,0.4);
  font-family: var(--font-sans);
  letter-spacing: 0.06em;
  margin-bottom: 3rem;
}

.cta-btns {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
}

.cta-phone-btn {
  border: 1px solid rgba(255,255,255,0.2);
  color: rgba(255,255,255,0.7);
  padding: 0.875rem 1.75rem;
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  text-decoration: none;
  text-transform: uppercase;
  font-family: var(--font-sans);
  transition: border-color 0.2s;
}

.cta-phone-btn:hover {
  border-color: rgba(255,255,255,0.45);
}

.cta-foot {
  margin-top: 2rem;
  font-size: 0.57rem;
  color: rgba(255,255,255,0.25);
  font-family: var(--font-sans);
  letter-spacing: 0.1em;
}

/* ═══════════════════════════════════════════
   DEMO BADGE
═══════════════════════════════════════════ */
.demo-badge {
  position: fixed;
  bottom: 1.25rem;
  right: 1.25rem;
  z-index: 9999;
  background: var(--color-stone-900);
  color: rgba(255,255,255,0.65);
  font-size: 0.54rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  padding: 0.45rem 0.9rem;
  font-family: var(--font-sans);
  border: 1px solid rgba(255,255,255,0.08);
}

/* ═══════════════════════════════════════════
   RESPONSIVE
═══════════════════════════════════════════ */
@media (max-width: 1024px) {
  .hero {
    grid-template-columns: 1fr;
    height: auto;
  }

  .hero-left {
    padding: 8rem 6vw 0;
    min-height: auto;
  }

  .hero-spacer {
    min-height: 0;
    flex: 0;
  }

  .hero-right {
    height: 55vw;
    min-height: 320px;
    position: relative;
  }

  .hero-right img {
    position: absolute;
  }

  .locations-section {
    grid-template-columns: 1fr;
    gap: 3rem;
  }
}

@media (max-width: 768px) {
  .services-grid,
  .team-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .locations-grid {
    grid-template-columns: 1fr;
  }

  .recognition-section {
    flex-wrap: wrap;
    gap: 1rem;
  }
}

@media (max-width: 500px) {
  .services-grid,
  .team-grid {
    grid-template-columns: 1fr;
  }

  .hero-stats {
    overflow-x: auto;
    scrollbar-width: none;
  }
}
</style>
