---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const faqs = [
  {
    q: 'How much does IVF cost at IRFC?',
    a: 'IVF costs vary based on your individual treatment protocol, medications, and any additional procedures such as genetic testing. Our financial coordinator will provide a detailed, personalized cost estimate during your consultation. We are committed to full transparency — no hidden fees.',
  },
  {
    q: 'Does my insurance cover fertility treatments?',
    a: 'Coverage varies significantly by insurance plan and employer. Some plans cover diagnostics and monitoring; others cover IVF cycles. We encourage you to contact your insurance provider directly and ask specifically about "infertility benefits." Our team can help you navigate this process.',
  },
  {
    q: 'What is CapexMD and how does it work?',
    a: 'CapexMD is a specialized medical lender that offers personal loans for fertility treatments. Once approved, funds are deposited directly so you can begin treatment without delay. IRFC facilitates the connection — all loan terms and repayment questions should be directed to CapexMD. IRFC is a separate entity and does not act as a financing institution.',
  },
  {
    q: 'Is the initial consultation really free?',
    a: 'Yes. Your first consultation with an IRFC physician is completely free of charge. We want every patient to have the opportunity to understand their options and meet our team before making any financial commitment.',
  },
  {
    q: 'Are there multi-cycle discount programs?',
    a: 'We offer various package options depending on your treatment plan. Please speak with our financial coordinator during your consultation to learn which options may be appropriate for your situation.',
  },
  {
    q: 'Can I use HSA or FSA funds?',
    a: 'Yes. Fertility treatments are generally considered qualified medical expenses under IRS guidelines, making them eligible for payment with Health Savings Account (HSA) or Flexible Spending Account (FSA) funds. We recommend confirming with your plan administrator.',
  },
];
---

<Layout
  title="Financing & Cost"
  description="Fertility treatment financing options at IRFC — CapexMD lending, insurance guidance, HSA/FSA, and free initial consultations. We help remove financial barriers to care."
>
  <Nav />

  <!-- Hero -->
  <section class="pt-40 pb-24 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-6">
          <div class="h-px w-12" style="background: var(--color-gold-500);"></div>
          <span class="text-xs tracking-widest uppercase" style="color: var(--color-gold-600); font-family: var(--font-sans);">Financing & Cost</span>
        </div>
        <h1 style="font-family: var(--font-serif);" class="text-5xl md:text-6xl font-light text-stone-800 mb-6 leading-none">
          Cost Shouldn't Stand<br/>
          <em class="not-italic" style="color: var(--color-gold-500);">Between You and Family.</em>
        </h1>
        <p class="text-lg text-stone-500 font-light leading-relaxed max-w-2xl">
          We believe every person deserves access to exceptional fertility care. That's why IRFC works with trusted financing partners and provides transparent cost guidance from day one — so you can focus on your journey, not the paperwork.
        </p>
      </div>
    </div>
  </section>

  <!-- Key Facts Bar -->
  <section class="py-10 border-y border-stone-100" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="grid sm:grid-cols-3 gap-6 text-center">
        {[
          { label: 'Free Initial Consultation', detail: 'No cost, no obligation to begin' },
          { label: 'Flexible Financing Available', detail: 'Through our lending partner CapexMD' },
          { label: 'HSA / FSA Accepted', detail: 'Use pre-tax dollars for treatment' },
        ].map(item => (
          <div class="flex flex-col items-center gap-1">
            <div class="w-6 h-px mb-3" style="background: var(--color-gold-500);"></div>
            <p class="text-sm font-medium text-stone-800" style="font-family: var(--font-serif);">{item.label}</p>
            <p class="text-xs" style="color: var(--color-stone-500);">{item.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Financing Options -->
  <section class="py-24 lg:py-28" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="mb-14">
        <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-gold-600); font-family: var(--font-sans);">Your Options</p>
        <h2 style="font-family: var(--font-serif);" class="text-4xl font-light text-stone-800">Ways to Pay for Treatment</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-6">

        <!-- CapexMD -->
        <div class="bg-white p-8 border border-stone-200 card-hover flex flex-col">
          <div class="w-10 h-10 mb-6 flex items-center justify-center border" style="border-color: var(--color-gold-400);">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" style="color: var(--color-gold-600);">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z"/>
            </svg>
          </div>
          <h3 style="font-family: var(--font-serif);" class="text-xl font-light text-stone-800 mb-3">Medical Financing via CapexMD</h3>
          <p class="text-sm text-stone-500 leading-relaxed flex-1 mb-6">
            IRFC partners with CapexMD, a specialized lender for fertility and medical treatments. Upon approval, funds are disbursed quickly so treatment can begin without delay. Loan terms, rates, and repayment questions are handled directly through CapexMD.
          </p>
          <p class="text-xs mb-4" style="color: var(--color-stone-400);">
            IRFC is a separate entity and does not act as a financing institution. Please direct all loan questions to CapexMD.
          </p>
          <a
            href="https://www.capexmd.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs tracking-widest uppercase flex items-center gap-2"
            style="color: var(--color-gold-600);"
          >
            Learn more at CapexMD.com
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>

        <!-- Insurance -->
        <div class="bg-white p-8 border border-stone-200 card-hover flex flex-col">
          <div class="w-10 h-10 mb-6 flex items-center justify-center border" style="border-color: var(--color-gold-500);">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" style="color: var(--color-gold-500);">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>
            </svg>
          </div>
          <h3 style="font-family: var(--font-serif);" class="text-xl font-light text-stone-800 mb-3">Insurance Coverage</h3>
          <p class="text-sm text-stone-500 leading-relaxed flex-1 mb-6">
            Fertility coverage varies widely by plan. Some insurance policies cover diagnostics, hormonal testing, and monitoring. Others — especially employer-sponsored plans in mandated states — include IVF cycles. We recommend calling your insurer before your first visit and asking specifically about "infertility treatment benefits."
          </p>
          <div class="text-xs space-y-1.5" style="color: var(--color-stone-400);">
            <p>✓ Kaiser Permanente patients: IRFC is a designated Center of Excellence</p>
            <p>✓ We accept most major insurance plans</p>
            <p>✓ Our team can assist with benefit verification</p>
          </div>
        </div>

        <!-- Self-pay & HSA/FSA -->
        <div class="bg-white p-8 border border-stone-200 card-hover flex flex-col">
          <div class="w-10 h-10 mb-6 flex items-center justify-center border" style="border-color: var(--color-gold-400);">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" style="color: var(--color-gold-600);">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 style="font-family: var(--font-serif);" class="text-xl font-light text-stone-800 mb-3">Self-Pay & HSA / FSA</h3>
          <p class="text-sm text-stone-500 leading-relaxed flex-1 mb-6">
            Patients paying out of pocket benefit from IRFC's transparent pricing model. We provide itemized estimates before treatment begins. Additionally, fertility treatments are generally qualified medical expenses — meaning you can use HSA or FSA pre-tax dollars to cover costs.
          </p>
          <div class="text-xs space-y-1.5" style="color: var(--color-stone-400);">
            <p>✓ Itemized estimates provided upfront</p>
            <p>✓ HSA and FSA funds accepted</p>
            <p>✓ Free initial consultation — always</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Process Steps -->
  <section class="py-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-14">
          <h2 style="font-family: var(--font-serif);" class="text-3xl font-light text-stone-800">How Financial Planning Works at IRFC</h2>
        </div>
        <div class="space-y-0">
          {[
            { n: '01', title: 'Free Consultation', desc: 'Meet your physician. Understand your diagnosis and recommended path. No cost, no obligation.' },
            { n: '02', title: 'Cost Estimate', desc: 'Our financial coordinator provides a transparent, itemized estimate for your recommended treatment plan.' },
            { n: '03', title: 'Insurance Verification', desc: 'We help verify your insurance benefits and identify what may be covered under your plan.' },
            { n: '04', title: 'Financing Application', desc: 'If needed, apply through CapexMD or explore HSA/FSA options. Most decisions are fast.' },
            { n: '05', title: 'Begin Treatment', desc: 'With a plan in place, you can focus entirely on your fertility journey — we handle the rest.' },
          ].map((step, i, arr) => (
            <div class="flex gap-8 pb-10 relative">
              {i < arr.length - 1 && (
                <div class="absolute left-6 top-12 bottom-0 w-px" style="background: var(--color-stone-200);"></div>
              )}
              <div class="flex-shrink-0 w-12 h-12 flex items-center justify-center border z-10 bg-white" style="border-color: var(--color-gold-400);">
                <span class="text-xs font-medium" style="color: var(--color-gold-600); font-family: var(--font-sans);">{step.n}</span>
              </div>
              <div class="pt-2">
                <h3 style="font-family: var(--font-serif);" class="text-lg font-light text-stone-800 mb-1">{step.title}</h3>
                <p class="text-sm text-stone-500 leading-relaxed">{step.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-14">
          <h2 style="font-family: var(--font-serif);" class="text-3xl font-light text-stone-800">Common Financing Questions</h2>
        </div>
        <div class="border border-stone-200">
          {faqs.map(faq => (
            <details class="group border-b border-stone-200 last:border-b-0">
              <summary class="flex items-center justify-between px-7 py-5 cursor-pointer list-none">
                <h3 class="text-base font-medium text-stone-800 pr-4">{faq.q}</h3>
                <svg class="w-4 h-4 flex-shrink-0 transition-transform group-open:rotate-45" style="color: var(--color-gold-500);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                </svg>
              </summary>
              <div class="px-7 pb-6">
                <p class="text-sm text-stone-500 leading-relaxed">{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden" style="height: 360px;">
    <img src="/images/lobby-detail.jpg" alt="IRFC clinic lobby" class="w-full h-full object-cover object-center" />
    <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(20,18,15,0.5) 0%, transparent 60%);"></div>
    <div class="absolute inset-0 flex items-center px-10 lg:px-20">
      <p style="font-family: var(--font-serif);" class="text-2xl font-light text-white max-w-sm leading-relaxed">
        Transparent costs, from day one.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10 text-center">
      <h2 style="font-family: var(--font-serif);" class="text-4xl font-light text-stone-800 mb-4">
        Let's Talk Through Your Options
      </h2>
      <p class="text-sm leading-relaxed mb-8 max-w-lg mx-auto" style="color: var(--color-stone-500);">
        Our financial coordinator is here to walk you through costs, insurance benefits, and financing options — free of charge, no pressure.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="btn-primary">Schedule Free Consultation</a>
        <a href="tel:+19494538600" class="btn-outline">Call (949) 453-8600</a>
      </div>
      <p class="mt-5 text-xs" style="color: var(--color-stone-400);">
        Mandarin-speaking coordinator available: <a href="tel:+16263886022" class="hover:underline" style="color: var(--color-gold-600);">(626) 388-6022</a>
      </p>
    </div>
  </section>

  <Footer />
</Layout>
