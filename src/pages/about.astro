---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const timeline = [
  { year: '2003', event: 'RFC Founded', detail: 'Dr. James P. Lin establishes Reproductive Fertility Center in Irvine, CA, with a mission to provide patient-centered fertility care built on Safety, Quality, and Integrity.' },
  { year: '2010', event: 'Incinta Fertility Opens', detail: 'Incinta Fertility Center opens, pioneering an open-concept laboratory model and a philosophy that treats patients as whole people, not diagnoses.' },
  { year: '2013', event: 'Kaiser COE Designation', detail: 'RFC earns designation as a Kaiser Permanente Center of Excellence across Southern California — an independent validation of clinical quality and outcomes.' },
  { year: '2016', event: '#1 US IVF Laboratory', detail: 'The Incinta embryology lab, led by Dr. Yufen Xie, achieves the remarkable milestone of ranking #1 in US IVF success rates.' },
  { year: '2018', event: 'Technology Leadership', detail: 'IRFC becomes among the first fertility centers in Orange County to deploy EmbryoScope+ time-lapse incubation technology.' },
  { year: '2024', event: 'IRFC is Born', detail: 'Incinta Fertility and Reproductive Fertility Center unite to form IRFC — Incinta Reproductive Fertility Center — combining two decades of clinical excellence into one practice, under one standard.' },
];

const achievements = [
  { number: '20+', label: 'Years of Clinical Experience' },
  { number: '#1', label: 'US IVF Lab Ranking, 2016' },
  { number: '5', label: 'Southern California Clinics' },
  { number: '5', label: 'Languages Spoken' },
];
---

<Layout
  title="About IRFC"
  description="INCINTA — Life Is the Ultimate Art. Learn about Incinta Reproductive Fertility Center (IRFC) and over 20 years of reproductive medicine excellence across Southern California."
>
  <Nav />

  <!-- Hero -->
  <section class="pt-40 pb-24 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-6">
          <div class="h-px w-12" style="background: var(--color-gold-500);"></div>
          <span class="text-xs tracking-widest uppercase" style="color: var(--color-gold-600); font-family: var(--font-sans);">About IRFC</span>
        </div>
        <h1 style="font-family: var(--font-serif);" class="text-5xl md:text-6xl font-light text-stone-800 mb-6 leading-none">
          Two Legacies.<br/>
          <em class="not-italic" style="color: var(--color-gold-500);">One Mission.</em>
        </h1>
        <p class="text-lg text-stone-500 font-light leading-relaxed max-w-2xl">
          INCINTA began with a conviction: every extraordinary life deserves an extraordinary beginning. IRFC — Incinta Reproductive Fertility Center — was formed when two practices built on that same belief came together as one.
        </p>
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="py-20 lg:py-28" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 items-center">
        <!-- RFC Story -->
        <div>
          <p class="text-xs tracking-widest uppercase mb-4" style="color: var(--color-gold-600); font-family: var(--font-sans);">Reproductive Fertility Center</p>
          <h2 style="font-family: var(--font-serif);" class="text-3xl font-light text-stone-800 mb-5">
            20 Years of Trust
          </h2>
          <p class="text-stone-600 leading-relaxed mb-4 text-sm">
            Founded by Dr. James P. Lin, Reproductive Fertility Center was built on a promise: that patients navigating the challenges of infertility would find "both a family and a home" within these walls. Over two decades, RFC grew from a single clinic into one of Southern California's most respected fertility practices.
          </p>
          <p class="text-stone-600 leading-relaxed mb-4 text-sm">
            RFC became a Kaiser Permanente Center of Excellence across Southern California and was designated one of the largest production facilities for Fairfax EggBank, the largest egg bank in the United States. The practice earned recognition from IVF Authority as a top-ranked California IVF center, particularly for patients aged 38–40.
          </p>
          <p class="text-stone-600 leading-relaxed text-sm">
            Through it all, the three pillars of <strong class="text-stone-800">Safety</strong>, <strong class="text-stone-800">Quality</strong>, and <strong class="text-stone-800">Integrity</strong> remained the foundation of everything RFC does.
          </p>
        </div>

        <!-- Incinta Story -->
        <div class="border-l-2 pl-10 lg:pl-14" style="border-color: var(--color-gold-500);">
          <p class="text-xs tracking-widest uppercase mb-4" style="color: var(--color-gold-500); font-family: var(--font-sans);">Incinta Fertility</p>
          <h2 style="font-family: var(--font-serif);" class="text-3xl font-light text-stone-800 mb-5">
            Science &amp; Art of Life
          </h2>
          <p class="text-stone-600 leading-relaxed mb-4 text-sm">
            Incinta Fertility was built around a different kind of belief: that a fertility clinic should be more than clinical. "You're more than your fertility. We're more than a fertility clinic." Artfully designed spaces, open-concept laboratories, and a team-based care model were central to the Incinta philosophy from day one.
          </p>
          <p class="text-stone-600 leading-relaxed mb-4 text-sm">
            The Incinta laboratory achieved what few in the field have: a national ranking of <strong class="text-stone-800">#1 in US IVF success rates in 2016</strong>. Under the direction of Dr. Yufen Xie, the lab has maintained a commitment to world-class embryology and innovative technique.
          </p>
          <p class="text-stone-600 leading-relaxed text-sm">
            The guiding principle at Incinta remains simple: "What you are seeking will also find you."
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Achievement Stats Bar -->
  <section class="py-12 bg-white border-y border-stone-100">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-px" style="background: var(--color-stone-200);">
        {achievements.map(a => (
          <div class="bg-white py-8 px-10 text-center">
            <p class="text-4xl lg:text-5xl font-light mb-1" style="font-family: var(--font-serif); color: var(--color-gold-600);">{a.number}</p>
            <p class="text-xs tracking-wide" style="color: var(--color-stone-500); font-family: var(--font-sans);">{a.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Clinic Photos -->
  <section class="py-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-2 gap-6">
        <div class="overflow-hidden">
          <img
            src="/images/clinic-scene.jpg"
            alt="IRFC clinic interior"
            class="w-full h-72 object-cover"
          />
        </div>
        <div class="grid grid-rows-2 gap-6">
          <div class="overflow-hidden">
            <img
              src="/images/hero-incinta.jpg"
              alt="Incinta Fertility Center"
              class="w-full h-32 object-cover object-center"
            />
          </div>
          <div class="overflow-hidden">
            <img
              src="/images/consultant.jpg"
              alt="IRFC consultation"
              class="w-full h-32 object-cover object-center"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quote -->
  <section class="py-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="max-w-3xl mx-auto text-center">
        <svg class="w-8 h-8 mx-auto mb-8 opacity-20" fill="currentColor" viewBox="0 0 32 32" style="color: var(--color-gold-600);">
          <path d="M10 8C6.686 8 4 10.686 4 14v10h10V14H8c0-1.1.9-2 2-2V8zm16 0c-3.314 0-6 2.686-6 6v10h10V14h-6c0-1.1.9-2 2-2V8z"/>
        </svg>
        <blockquote style="font-family: var(--font-serif);" class="text-3xl md:text-4xl font-light text-stone-800 leading-relaxed italic mb-6">
          "Here you will find both a family and a home for every step of your fertility journey."
        </blockquote>
        <p class="text-sm tracking-wider uppercase" style="color: var(--color-gold-600);">— Dr. James P. Lin, Founder</p>
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="py-24 lg:py-28" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="mb-14">
        <div class="h-px w-12 mb-6" style="background: var(--color-gold-500);"></div>
        <h2 style="font-family: var(--font-serif);" class="text-4xl font-light text-stone-800">Our Journey</h2>
        <p class="mt-3 text-sm max-w-xl" style="color: var(--color-stone-500);">
          Two decades of milestones that shaped who we are today.
        </p>
      </div>

      <div class="relative">
        <!-- Vertical line -->
        <div class="absolute left-6 top-0 bottom-0 w-px hidden md:block" style="background: var(--color-stone-200);"></div>

        <div class="space-y-0">
          {timeline.map((item, i) => (
            <div class="grid md:grid-cols-12 gap-4 md:gap-8 pb-10 relative">
              <!-- Year dot + line -->
              <div class="md:col-span-2 flex md:flex-col items-center md:items-start gap-4 md:gap-0">
                <div class="flex-shrink-0 w-12 h-12 flex items-center justify-center bg-white border-2 z-10 relative" style={`border-color: ${i === timeline.length - 1 ? 'var(--color-gold-500)' : 'var(--color-stone-200)'};`}>
                  <span class="text-xs font-medium" style={`font-family: var(--font-sans); color: ${i === timeline.length - 1 ? 'var(--color-gold-600)' : 'var(--color-stone-500)'};`}>{item.year}</span>
                </div>
              </div>
              <!-- Content -->
              <div class="md:col-span-10 pb-10 md:pb-0">
                <div class={`p-7 border ${i === timeline.length - 1 ? 'border-gold-200' : 'border-stone-200'} bg-white`} style={i === timeline.length - 1 ? 'border-color: var(--color-gold-200);' : ''}>
                  <h3 style="font-family: var(--font-serif);" class="text-xl font-light text-stone-800 mb-2">{item.event}</h3>
                  {i === timeline.length - 1 && (
                    <div class="w-6 h-px mb-3" style="background: var(--color-gold-500);"></div>
                  )}
                  <p class="text-sm text-stone-500 leading-relaxed">{item.detail}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Mission & Values -->
  <section class="py-20 lg:py-28" style="background: var(--color-stone-900);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-2 gap-16 items-start">
        <div>
          <div class="h-px w-12 mb-6" style="background: var(--color-gold-500);"></div>
          <h2 style="font-family: var(--font-serif);" class="text-4xl font-light text-white mb-6">
            Our Mission
          </h2>
          <p class="leading-relaxed mb-5 text-sm" style="color: var(--color-stone-300);">
            IRFC exists to give every individual and couple the best possible chance at building their family — through world-class science, compassionate care, and an unwavering commitment to each patient's unique journey.
          </p>
          <p class="leading-relaxed text-sm" style="color: var(--color-stone-400);">
            We believe fertility care should be both technically excellent and deeply human. Our integrated model combines a nationally top-ranked laboratory with the kind of personal attention that makes patients feel genuinely seen and supported.
          </p>
        </div>

        <div class="space-y-6">
          {[
            {
              title: 'Safety First',
              desc: 'Every procedure performed at IRFC follows the highest clinical standards, in state-of-the-art, professionally accredited surgery centers and CAP-certified laboratories.',
            },
            {
              title: 'Quality Without Compromise',
              desc: 'From our embryology lab to our clinical team, we invest relentlessly in the skills, systems, and technology that translate to better outcomes for our patients.',
            },
            {
              title: 'Integrity in Everything',
              desc: 'Transparency, authenticity, and honest communication are at the core of how we work. We tell patients the truth — and stand behind every decision we make together.',
            },
          ].map(value => (
            <div class="border-l-2 pl-8" style="border-color: var(--color-gold-700);">
              <h3 style="font-family: var(--font-serif);" class="text-xl font-light text-white mb-2">{value.title}</h3>
              <p class="text-sm leading-relaxed" style="color: var(--color-stone-400);">{value.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Recognitions -->
  <section class="py-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="text-center mb-14">
        <div class="h-px w-12 mx-auto mb-6" style="background: var(--color-gold-500);"></div>
        <h2 style="font-family: var(--font-serif);" class="text-4xl font-light text-stone-800">
          Recognition &amp; Achievements
        </h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          {
            label: 'Center of Excellence',
            detail: 'Designated by Kaiser Permanente across Southern California',
          },
          {
            label: 'Top IVF Center',
            detail: 'Ranked among California\'s best by IVF Authority, especially for patients 38–40',
          },
          {
            label: '#1 US IVF Lab',
            detail: 'IRFC\'s laboratory ranked number one in US IVF success rates in 2016',
          },
          {
            label: 'Fairfax EggBank Partner',
            detail: 'One of the largest production facilities for the largest US egg bank',
          },
        ].map(rec => (
          <div class="p-8 bg-stone-50 border border-stone-200 card-hover">
            <div class="w-8 h-px mb-5" style="background: var(--color-gold-500);"></div>
            <h3 style="font-family: var(--font-serif);" class="text-xl font-light text-stone-800 mb-3">{rec.label}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-stone-500);">{rec.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 lg:py-24" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10 text-center">
      <h2 style="font-family: var(--font-serif);" class="text-4xl font-light text-stone-800 mb-4">
        Ready to Meet Our Team?
      </h2>
      <p class="text-sm leading-relaxed mb-8 max-w-lg mx-auto" style="color: var(--color-stone-500);">
        Every journey starts with a conversation. Schedule your consultation today and let us learn about you.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/team" class="btn-outline">Meet Our Physicians</a>
        <a href="/contact" class="btn-primary">Schedule a Consultation</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
