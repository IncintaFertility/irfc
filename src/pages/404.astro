---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found"
  description="The page you were looking for could not be found. Return to Incinta Reproductive Fertility Center."
  noindex={true}
>
  <main class="lotus-watermark min-h-[78vh] flex items-center justify-center px-6 py-24">
    <div class="relative z-10 max-w-xl text-center">
      <span class="brand-eyebrow justify-center">Error 404</span>

      <h1 class="mt-6 font-serif text-5xl sm:text-6xl text-stone-800">
        This page has not yet begun.
      </h1>

      <div class="section-divider mx-auto mt-8"></div>

      <p class="mt-8 text-base leading-relaxed text-stone-600">
        The page you were looking for may have moved, or perhaps it was never
        planted. Every extraordinary life deserves an extraordinary beginning —
        let us help you find your way back.
      </p>

      <div class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/" class="btn-primary">Return Home</a>
        <a href="/contact" class="btn-outline">Request a Consultation</a>
      </div>

      <p class="mt-10 text-sm text-stone-400">
        Incinta Reproductive Fertility Center &middot; Southern California
      </p>
    </div>
  </main>
</Layout>
