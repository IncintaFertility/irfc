---
import Layout from '../../layouts/Layout.astro';
import { blogPosts, getPost } from '../../data/blog';
import { SITE_URL, LEGAL_ENTITY, BRAND_ABBREV } from '../../config/brand';

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const fmtDate = (iso: string) =>
  new Date(iso + 'T00:00:00').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const url = new URL(Astro.url.pathname, SITE_URL).href;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.description,
  datePublished: post.date,
  dateModified: post.date,
  author: { '@type': 'Organization', name: `${BRAND_ABBREV} — ${LEGAL_ENTITY}` },
  publisher: {
    '@type': 'Organization',
    name: `${BRAND_ABBREV} — ${LEGAL_ENTITY}`,
    logo: { '@type': 'ImageObject', url: `${SITE_URL}/favicon.svg` },
  },
  image: `${SITE_URL}${post.cover}`,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
};

const related = blogPosts.filter((p) => p.slug !== post.slug).slice(0, 2);
---

<Layout title={post.title} description={post.description} schema={articleSchema}>
  <main class="article">
    <article>
      <header class="article-head">
        <p class="article-cat">{post.category}</p>
        <h1 class="article-title">{post.title}</h1>
        <p class="article-meta">{fmtDate(post.date)} · {post.readingTime}</p>
      </header>

      <figure class="article-cover">
        <img src={post.cover} alt={post.coverAlt} width="1200" height="675" decoding="async" />
      </figure>

      <div class="blog-prose" set:html={post.body}></div>

      <p class="article-disclaimer">
        This article is for general informational purposes only and does not constitute medical advice.
        Please consult with a qualified healthcare provider about your individual circumstances.
      </p>
    </article>

    <section class="article-cta">
      <h2 class="article-cta-title">Ready to talk it through with a physician?</h2>
      <p class="article-cta-text">
        Book a consultation at any of our four Southern California clinics, or meet by secure video visit —
        same consultation fee either way.
      </p>
      <a class="article-cta-btn" href="/consultation">Schedule a Consultation →</a>
    </section>

    {related.length > 0 && (
      <section class="article-related" aria-label="More insights">
        <h2 class="article-related-title">More insights</h2>
        <div class="article-related-grid">
          {related.map((r) => (
            <a class="article-related-card" href={`/blog/${r.slug}`}>
              <div class="article-related-media">
                <img src={r.cover} alt={r.coverAlt} loading="lazy" decoding="async" width="600" height="400" />
              </div>
              <div class="article-related-body">
                <span class="article-related-cat">{r.category}</span>
                <h3 class="article-related-cardtitle">{r.title}</h3>
                <p class="article-related-meta">{fmtDate(r.date)} · {r.readingTime}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>

<style>
  .article { max-width: 760px; margin: 0 auto; padding: 7rem 6vw 5rem; }
  .article-head { margin-bottom: 2.5rem; }
  .article-cat {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold-600);
    margin: 0 0 0.9rem;
  }
  .article-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    line-height: 1.18;
    color: var(--color-stone-800);
    margin: 0 0 1rem;
  }
  .article-cover {
    margin: 0 0 2.75rem;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 14px;
    background: var(--color-stone-100);
  }
  .article-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .article-meta {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    color: var(--color-stone-400);
    margin: 0;
  }

  /* Prose — set:html content is opted into global scope */
  .blog-prose :global(p) {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-stone-700);
    margin: 0 0 1.4rem;
  }
  .blog-prose :global(h2) {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.6rem;
    line-height: 1.3;
    color: var(--color-stone-800);
    margin: 2.5rem 0 1rem;
  }
  .blog-prose :global(ul) { margin: 0 0 1.4rem; padding-left: 1.25rem; }
  .blog-prose :global(li) {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-stone-700);
    margin-bottom: 0.5rem;
  }
  .blog-prose :global(strong) { color: var(--color-stone-900); font-weight: 600; }
  .blog-prose :global(a) {
    color: var(--color-gold-600);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .blog-prose :global(a:hover) { color: var(--color-gold-700); }
  .blog-prose :global(blockquote) {
    margin: 0 0 1.4rem;
    padding: 0.9rem 1.4rem;
    border-left: 3px solid var(--color-gold-400);
    background: #FAEEDA;
    border-radius: 0 10px 10px 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--color-stone-800);
  }

  .article-disclaimer {
    margin-top: 2.5rem;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--color-stone-400);
    border-top: 1px solid var(--color-stone-200);
    padding-top: 1.25rem;
  }

  .article-cta {
    margin-top: 3rem;
    padding: 2.5rem;
    background: #FAEEDA;
    border-radius: 16px;
    text-align: center;
  }
  .article-cta-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.6rem;
    color: var(--color-stone-800);
    margin: 0 0 0.75rem;
  }
  .article-cta-text {
    max-width: 520px;
    margin: 0 auto 1.4rem;
    font-size: 0.96rem;
    line-height: 1.65;
    color: var(--color-stone-600);
  }
  .article-cta-btn {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.78rem 1.5rem;
    background: var(--color-gold-500);
    color: #fff;
    border-radius: 999px;
    transition: background 0.25s;
  }
  .article-cta-btn:hover { background: var(--color-gold-600); }

  .article-related { margin-top: 3.5rem; }
  .article-related-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.4rem;
    color: var(--color-stone-800);
    margin: 0 0 1.5rem;
  }
  .article-related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }
  .article-related-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--color-stone-200);
    border-radius: 12px;
    padding: 0;
    overflow: hidden;
    text-decoration: none;
    transition: border-color 0.25s, transform 0.25s;
  }
  .article-related-card:hover {
    border-color: var(--color-gold-400);
    transform: translateY(-2px);
  }
  .article-related-media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-stone-100);
  }
  .article-related-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }
  .article-related-card:hover .article-related-media img { transform: scale(1.05); }
  .article-related-cat {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold-600);
    margin-bottom: 0.7rem;
  }
  .article-related-body { padding: 1.5rem; }
  .article-related-cardtitle {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.15rem;
    line-height: 1.3;
    color: var(--color-stone-800);
    margin: 0 0 0.7rem;
    flex: 1;
  }
  .article-related-meta {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    color: var(--color-stone-400);
    margin: 0;
  }
</style>
