---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const steps = [
  { n: '01', title: 'Initial Consultation & Evaluation', desc: 'Your physician reviews your complete medical history and orders baseline tests: bloodwork (hormonal panel, AMH, CBC), antral follicle count via ultrasound, and — for couples — a semen analysis. This workup paints a complete picture before any decision is made.' },
  { n: '02', title: 'Ovarian Stimulation', desc: 'Over 8–14 days, injectable medications stimulate your ovaries to develop multiple mature follicles. Our nurses guide you through every injection, and you return for monitoring ultrasounds and blood draws to track response and adjust dosing precisely.' },
  { n: '03', title: 'Trigger Shot & Egg Retrieval', desc: 'When follicles reach optimal size, a precisely timed trigger shot matures the eggs. Approximately 36 hours later, eggs are retrieved under light sedation via a transvaginal ultrasound-guided needle. The procedure takes about 20 minutes; most patients go home the same morning.' },
  { n: '04', title: 'Fertilization & Embryo Culture', desc: 'Mature eggs are fertilized with prepared sperm — either by conventional insemination or ICSI (intracytoplasmic sperm injection). Resulting embryos develop in our EmbryoScope+ incubators, which capture time-lapse video without disturbing the culture environment.' },
  { n: '05', title: 'Embryo Monitoring & Selection', desc: 'Our embryologists observe development daily. By day 5–6, embryos that have reached the blastocyst stage are assessed for quality. If PGT-A testing is ordered, embryos are biopsied and sent for chromosomal analysis before transfer.' },
  { n: '06', title: 'Embryo Transfer', desc: 'The highest-quality embryo is placed into the uterus through a thin catheter — a quick, painless procedure performed under ultrasound guidance. Most patients transfer one embryo to maximize safety while preserving excellent success rates.' },
  { n: '07', title: 'Pregnancy Test & Early Monitoring', desc: 'A blood pregnancy test is performed 10–12 days after transfer. If positive, we monitor closely with HCG levels and an early ultrasound before transitioning care to your OB-GYN or Maternal-Fetal Medicine specialist.' },
];

const faqs = [
  { q: 'How many IVF cycles will I need?', a: 'Most patients conceive within 1–3 cycles, though individual outcomes vary based on age, diagnosis, and embryo quality. Your physician will give you a realistic success rate estimate based on your specific profile during your consultation.' },
  { q: 'Is IVF painful?', a: 'The stimulation injections are mild — most patients describe them as similar to a pinch. The egg retrieval is performed under sedation, so you will not feel it. Post-retrieval bloating and mild cramping are common and typically resolve within a day or two.' },
  { q: 'What is the difference between fresh and frozen embryo transfer?', a: 'A fresh transfer occurs within the same cycle as egg retrieval. A frozen transfer (FET) freezes the embryo and transfers it in a subsequent, separate cycle — which can improve uterine receptivity in some patients. Your physician will recommend the best approach for you.' },
  { q: 'Does IRFC offer low-stimulation or mini-IVF?', a: 'Yes. Dr. Liu specializes in mild stimulation protocols that reduce medication doses while maintaining strong outcomes for appropriate candidates. These protocols may be a good fit for patients with certain diagnoses or preferences.' },
  { q: 'Can I use donor eggs or donor sperm for IVF?', a: 'Absolutely. IRFC has a comprehensive donor egg program through our partnership with Fairfax EggBank, and coordinates sperm donor selection through licensed cryobanks. Our third-party coordinator guides every step.' },
];
---

<Layout
  title="IVF — In Vitro Fertilization"
  description="IVF at IRFC — step-by-step guide to in vitro fertilization with EmbryoScope+ monitoring. Learn what to expect, who is a candidate, and how to get started."
>
  <Nav />

  <!-- Hero -->
  <section class="pt-40 pb-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-4">
          <div class="h-px w-12" style="background: var(--color-gold-500);"></div>
          <a href="/services" class="text-xs tracking-widest uppercase hover:underline" style="color: var(--color-stone-400); font-family: var(--font-sans);">All Services</a>
          <span style="color: var(--color-stone-300);">/</span>
          <span class="text-xs tracking-widest uppercase" style="color: var(--color-gold-600); font-family: var(--font-sans);">IVF</span>
        </div>
        <h1 style="font-family: var(--font-serif);" class="text-5xl md:text-6xl font-light text-stone-800 mb-5 leading-none">
          In Vitro Fertilization
        </h1>
        <p class="text-xs tracking-widest uppercase mb-6" style="color: var(--color-stone-400); font-family: var(--font-sans);">Assisted Reproductive Technology</p>
        <p class="text-lg text-stone-500 font-light leading-relaxed max-w-2xl">
          IVF is the most effective fertility treatment available — and at IRFC, it is supported by a #1-ranked laboratory team, EmbryoScope+ time-lapse monitoring, and physicians who have guided thousands of families to success.
        </p>
      </div>
    </div>
  </section>

  <!-- What Is IVF -->
  <section class="py-20" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-2 gap-14 items-start">
        <div>
          <h2 style="font-family: var(--font-serif);" class="text-3xl font-light text-stone-800 mb-5">What Is IVF?</h2>
          <p class="text-stone-600 leading-relaxed mb-4 text-sm">
            In vitro fertilization (IVF) is a process in which eggs are retrieved from the ovaries, fertilized with sperm in the laboratory, and the resulting embryos are cultured for several days before the best candidate is transferred to the uterus.
          </p>
          <p class="text-stone-600 leading-relaxed mb-4 text-sm">
            IVF bypasses the most common causes of infertility — including blocked fallopian tubes, male factor, ovulation disorders, and unexplained infertility — by bringing the egg and sperm together under controlled, optimized laboratory conditions.
          </p>
          <p class="text-stone-600 leading-relaxed text-sm">
            IRFC's IVF program includes optional add-ons such as ICSI, assisted hatching, preimplantation genetic testing (PGT), and mild-stimulation protocols — all tailored to each patient's individual profile.
          </p>
        </div>

        <div class="space-y-4">
          <p class="text-xs tracking-widest uppercase mb-4" style="color: var(--color-stone-400); font-family: var(--font-sans);">IVF may be recommended if you have:</p>
          {[
            'Blocked or absent fallopian tubes',
            'Severe or moderate male factor infertility',
            'Ovarian reserve concerns (low AMH or antral follicle count)',
            'Endometriosis affecting fertility',
            'Failed IUI cycles (typically 3+ attempts)',
            'Unexplained infertility after evaluation',
            'A need for preimplantation genetic testing (PGT)',
            'Plans to use donor eggs or gestational surrogacy',
          ].map(item => (
            <div class="flex items-start gap-3 p-4 bg-white border border-stone-200">
              <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color: var(--color-gold-500);">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
              </svg>
              <span class="text-sm text-stone-600">{item}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Step-by-Step Process -->
  <section class="py-24 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="mb-14">
        <h2 style="font-family: var(--font-serif);" class="text-3xl font-light text-stone-800 mb-3">Your IVF Journey, Step by Step</h2>
        <p class="text-sm max-w-xl" style="color: var(--color-stone-500);">No two cycles are identical, but every IRFC patient follows a carefully structured process designed for safety, comfort, and the best possible outcome.</p>
      </div>
      <div class="space-y-4">
        {steps.map(step => (
          <div class="grid lg:grid-cols-12 gap-6 p-8 border border-stone-200 bg-stone-50">
            <div class="lg:col-span-1">
              <span class="text-xs font-medium tracking-widest" style="color: var(--color-gold-500); font-family: var(--font-sans);">{step.n}</span>
            </div>
            <div class="lg:col-span-11">
              <h3 style="font-family: var(--font-serif);" class="text-xl font-light text-stone-800 mb-2">{step.title}</h3>
              <p class="text-sm text-stone-500 leading-relaxed">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Technology Callout -->
  <section class="py-16" style="background: var(--color-stone-900);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="grid md:grid-cols-3 gap-6">
        {[
          { name: 'EmbryoScope+', desc: 'Time-lapse incubation captures continuous embryo development images without disturbing the culture environment.' },
          { name: 'RI Witness™', desc: 'Electronic witnessing system ensures your eggs, sperm, and embryos are correctly matched at every step.' },
          { name: 'TMRW Vault', desc: 'Military-grade cryogenic storage with RFID tracking protects any frozen embryos for your future use.' },
        ].map(tech => (
          <div class="p-7 border" style="border-color: var(--color-stone-800);">
            <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--color-gold-500); font-family: var(--font-sans);">Technology</p>
            <h3 style="font-family: var(--font-serif);" class="text-lg font-light text-white mb-2">{tech.name}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-stone-400);">{tech.desc}</p>
          </div>
        ))}
      </div>
      <div class="mt-6 text-center">
        <a href="/technology" class="text-xs tracking-widest uppercase flex items-center justify-center gap-2" style="color: var(--color-gold-400);">
          Learn more about our lab technology
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-24" style="background: var(--color-stone-50);">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10">
      <div class="max-w-3xl mx-auto">
        <h2 style="font-family: var(--font-serif);" class="text-3xl font-light text-stone-800 mb-10">Common IVF Questions</h2>
        <div class="border border-stone-200">
          {faqs.map(faq => (
            <details class="group border-b border-stone-200 last:border-b-0">
              <summary class="flex items-center justify-between px-7 py-5 cursor-pointer list-none">
                <h3 class="text-base font-medium text-stone-800 pr-4">{faq.q}</h3>
                <svg class="w-4 h-4 flex-shrink-0 transition-transform group-open:rotate-45" style="color: var(--color-gold-500);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                </svg>
              </summary>
              <div class="px-7 pb-6">
                <p class="text-sm text-stone-500 leading-relaxed">{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-white">
    <div class="max-w-screen-xl mx-auto px-6 lg:px-10 text-center">
      <h2 style="font-family: var(--font-serif);" class="text-4xl font-light text-stone-800 mb-4">Ready to Learn More?</h2>
      <p class="text-sm leading-relaxed mb-8 max-w-lg mx-auto" style="color: var(--color-stone-500);">
        Schedule a free consultation with one of our physicians. We'll review your history, answer every question, and give you an honest assessment of your options.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="btn-primary">Book Free Consultation</a>
        <a href="/services" class="btn-outline">All Services</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
