/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # G2 — 强制 HTTPS + 防降级（HIPAA 传输安全）
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Upgrade-Insecure-Requests: 1
  # G2 — 内容安全策略
  # 同源优先；放开以下"有意使用"的第三方（否则会破坏既有功能）：
  #   - fonts.googleapis.com / fonts.gstatic.com ：Google Fonts（无 PHI）
  #   - www.googletagmanager.com            ：Google Tag Manager（GTM-TLN399PK，见 G11）
  #   - challenges.cloudflare.com           ：可选 Turnstile（G3）
  #   - s3-media0.fl.yelpcdn.com            ：Yelp 头像静态图
  #   - www.googletagmanager.com            ：GTM 容器（见 G11；表单页已不加载）
  #   - *.google-analytics.com              ：GA4 事件上报（g/collect）。仅用于非表单页常规统计；
  #     表单页（/contact、/appointment）不加载 GTM，故这些页面既无 GTM 也无 GA 上报。
  #   - *.zoho.com / *.zohostatic.com / static.zohocrm.com ：Zoho CRM Web Form 嵌入（G12）。
  #     表单浏览器直连 crm.zoho.com 提交（form-action 已放行），PHI 不经本站服务器/Google。
  #     注：表单页（/contact、/appointment）仍不加载本站 GTM；Zoho 脚本为独立第三方，与 GTM 无关。
  # 表单 fetch / 页面导航均限制为同源（form-action 'self' + 显式放行的 zoho 域），杜绝表单数据被注入脚本外泄到非预期域。
  Content-Security-Policy: default-src 'self' https://*.zoho.com https://*.zohostatic.com; base-uri 'self'; form-action 'self' https://crm.zoho.com https://*.zoho.com; frame-ancestors 'none'; frame-src 'self' https://www.googletagmanager.com https://challenges.cloudflare.com https://crm.zoho.com https://*.zoho.com https://*.zohostatic.com; child-src 'self' https://www.googletagmanager.com https://challenges.cloudflare.com https://crm.zoho.com https://*.zoho.com https://*.zohostatic.com; object-src 'none'; img-src 'self' https://s3-media0.fl.yelpcdn.com https://challenges.cloudflare.com https://*.google-analytics.com https://*.zohostatic.com https://crm.zoho.com https://*.zoho.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://css.zohostatic.com https://*.zoho.com; font-src 'self' data: https://fonts.gstatic.com https://*.zohostatic.com https://*.zoho.com; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://challenges.cloudflare.com https://crm.zoho.com https://www.zoho.com https://js.zohostatic.com https://static.zohocrm.com; connect-src 'self' https://*.google-analytics.com https://crm.zoho.com https://www.zoho.com https://*.zohostatic.com

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
